// This macro, SVG_PART_INTERPOLATE, creates a composite UI element from two parts: a RECT ('bg') and a VECTOR ('vg').
// The RECT part 'bg' acts as a container and a clickable hot-spot, positioned relatively.
// The VECTOR part 'vg' displays an SVG. It is aligned to fill the 'bg' part.
// It features two states: "default" and "clicked". In the "default" state, it displays image 'id1' at a 130x130 pixel size.
// In the "clicked" state, it switches to image 'id2' and enlarges to 150x150 pixels.
// This allows for both a size and image change on interaction, suitable for animated feedback.
#define SVG_PART_INTERPOLATE(bg, vg, rel1x, rel1y, rel2x, rel2y,id1, id2)\
         rect { bg; \
            description { state: "default" 0.0; \
               // color: #FFFFFFFF (white, fully opaque)
               color: 255 255 255 255; \
               rel1.relative: rel1x rel1y; \
               rel2.relative: rel2x rel2y; \
               rel1.offset: 1 1; \
               rel2.offset: -1 -1; \
            } \
         }\
         vector { vg;\
            description { state: "default" 0.0; \
               color: 255 255 255 255; \
               rel1.to: bg; \
               rel2.to: bg; \
               min: 130 130; \
               max: 130 130; \
               image.normal: id1; \
            } \
            description { state: "clicked" 0.0; \
               inherit: "default" 0.0; \
               image.normal: id2; \
               min: 150 150; \
               max: 150 150; \
            } \
         }
// The SVG_PART macro is a simplified variant of SVG_PART_INTERPOLATE.
// It's a convenient shorthand for when the icon's image does not change upon being clicked.
// It uses the same image ('id1') for both "default" and "clicked" states.
// The visual feedback for interaction is limited to the size change animation defined in SVG_PART_INTERPOLATE (130px to 150px).
#define SVG_PART(bg, vg, rel1x, rel1y, rel2x, rel2y,id1)\
         SVG_PART_INTERPOLATE(bg, vg, rel1x, rel1y, rel2x, rel2y,id1, id1)

 // This macro, SVG_PROGRAM, defines the interaction logic that triggers the state changes in a vector part ('vg').
 // It creates two programs that respond to mouse events.
 // The first program triggers on "mouse,down,1" (left mouse button press). It changes the state of the 'vg' part to "clicked".
 // The second program triggers on "mouse,up,1" (left mouse button release), reverting the state to "default".
 // Both state changes are animated with a linear transition over 0.2 seconds.
 // NOTE: The 'source' of the signal is specified as 'vg'. By default, VECTOR parts do not emit mouse signals.
 // For this program to work as intended, the signal's source should typically be the 'bg' RECT part, which does capture mouse events.
 #define SVG_PROGRAM(bg, vg) \
         program { bg; \
            signal: "mouse,down,1"; \
            source: vg; \
            action: STATE_SET "clicked"; \
            transition: LINEAR .2; \
            target: vg; \
         }\
         program { vg; \
            signal: "mouse,up,1"; \
            source: vg; \
            action: STATE_SET "default"; \
            transition: LINEAR .2; \
            target: vg; \
         }

// The 'collections' block is the root element of an Edje file, containing all resources and group definitions.
collections {
   // 'base_scale' defines the default scaling factor for the UI. 1.0 means no scaling.
   base_scale: 1.0;
   // The 'images' block lists all image assets required by this collection.
   // Using 'vector:' indicates that these are SVG files, which will be rendered by the vector graphics engine.
   images {
      vector: "dst.svg";
      vector: "atom.svg";
      vector: "bojo.svg";
      vector: "bzrfeed.svg";
      vector: "yinyang.svg";
      vector: "ubuntu.svg";
      vector: "duke.svg";
      vector: "cartman.svg";
      vector: "ibm.svg";
      vector: "hg0.svg";
      vector: "fsm.svg";
      vector: "osa.svg";
      vector: "wikimedia.svg";
      vector: "scion.svg";
      vector: "eee.svg";
      vector: "google.svg";
      vector: "tiger.svg";
      vector: "venus.svg";
      vector: "lineargrad1.svg";
      vector: "radialgrad1.svg";
      vector: "yadis.svg";
      vector: "favorite_on.svg";
      vector: "favorite_off.svg";
      vector: "batman1.svg";
      vector: "batman2.svg";
      vector: "gradients.svg";
   }
   // A 'group' defines a single, self-contained UI layout or widget.
   // This group is named "svg-test" and demonstrates a grid of interactive SVG icons.
   group {
      name: "svg-test";
      // The 'parts' block declares all the components that make up this group's UI.
      parts {
         // This creates the first icon in a 5x5 grid.
         // It occupies the top-left cell, spanning from (0%, 0%) to (20%, 20%) of the group's area.
         // It uses "dst.svg" for its visual representation.
         SVG_PART("bg1", "vg1", 0.0, 0.0, .2, .2,"dst.svg")
         SVG_PART("bg2", "vg2", 0.2, 0.0, .4, .2,"atom.svg")
         SVG_PART("bg3", "vg3", 0.4, 0.0, .6, .2,"bojo.svg")
         SVG_PART("bg4", "vg4", 0.6, 0.0, 0.8, .2,"bzrfeed.svg")
         SVG_PART("bg5", "vg5", 0.8, 0.0, 1.0, .2,"yinyang.svg")

         SVG_PART("bg6", "vg6", 0.0, 0.2, .2, .4,"ibm.svg")
         SVG_PART("bg7", "vg7", 0.2, 0.2, .4, .4,"ubuntu.svg")
         SVG_PART("bg8", "vg8", 0.4, 0.2, .6, .4,"hg0.svg")
         SVG_PART("bg9", "vg9", 0.6, 0.2, .8, .4,"duke.svg")
         SVG_PART("bg10", "vg10", 0.8, 0.2, 1.0, .4,"cartman.svg")

         SVG_PART("bg11", "vg11", 0.0, 0.4, .2, .6,"fsm.svg")
         SVG_PART("bg12", "vg12", 0.2, 0.4, .4, .6,"osa.svg")
         SVG_PART("bg13", "vg13", 0.4, 0.4, .6, .6,"wikimedia.svg")
         SVG_PART("bg14", "vg14", 0.6, 0.4, .8, .6,"eee.svg")
         SVG_PART("bg15", "vg15", 0.8, 0.4, 1.0, .6,"google.svg")

         SVG_PART("bg16", "vg16", 0.0, 0.6, .2, 0.8,"scion.svg")
         SVG_PART("bg17", "vg17", 0.2, 0.6, .4, 0.8,"tiger.svg")
         SVG_PART("bg18", "vg18", 0.4, 0.6, .6, 0.8,"venus.svg")
         SVG_PART("bg19", "vg19", 0.6, 0.6, .8, 0.8,"lineargrad1.svg")
         SVG_PART("bg20", "vg20", 0.8, 0.6, 1.0, 0.8,"radialgrad1.svg")

         SVG_PART("bg21", "vg21", 0.0, 0.8, .2, 1.0,"yadis.svg")
         SVG_PART("bg22", "vg22", 0.2, 0.8, .4, 1.0,"favorite_on.svg")
         SVG_PART("bg23", "vg23", 0.4, 0.8, .6, 1.0,"favorite_off.svg")
         // This part uses SVG_PART_INTERPOLATE directly to specify different images for its states.
         // It shows "batman1.svg" by default and switches to "batman2.svg" when clicked.
         SVG_PART_INTERPOLATE("bg24", "vg24", 0.6, 0.8, .8, 1.0,"batman1.svg", "batman2.svg")
         SVG_PART("bg25", "vg25", 0.8, 0.8, 1.0, 1.0,"gradients.svg")
      }
      // The 'programs' block defines the interactive logic for the group.
      // It connects signals from parts to actions that modify the state of other parts.
      programs {
         // This instantiates the SVG_PROGRAM macro for the first icon ('vg1').
         // It sets up the logic to handle mouse clicks on 'vg1', triggering the state change between "default" and "clicked".
         SVG_PROGRAM("bg1", "vg1")
         SVG_PROGRAM("bg2", "vg2")
         SVG_PROGRAM("bg3", "vg3")
         SVG_PROGRAM("bg4", "vg4")
         SVG_PROGRAM("bg5", "vg5")
         SVG_PROGRAM("bg6", "vg6")
         SVG_PROGRAM("bg7", "vg7")
         SVG_PROGRAM("bg8", "vg8")
         SVG_PROGRAM("bg9", "vg9")
         SVG_PROGRAM("bg10", "vg10")
         SVG_PROGRAM("bg11", "vg11")
         SVG_PROGRAM("bg12", "vg12")
         SVG_PROGRAM("bg13", "vg13")
         SVG_PROGRAM("bg14", "vg14")
         SVG_PROGRAM("bg15", "vg15")
         SVG_PROGRAM("bg16", "vg16")
         SVG_PROGRAM("bg17", "vg17")
         SVG_PROGRAM("bg18", "vg18")
         SVG_PROGRAM("bg19", "vg19")
         SVG_PROGRAM("bg20", "vg20")
         SVG_PROGRAM("bg21", "vg21")
         SVG_PROGRAM("bg22", "vg22")
         SVG_PROGRAM("bg23", "vg23")
         SVG_PROGRAM("bg24", "vg24")
         SVG_PROGRAM("bg25", "vg25")
      }
   }
}
