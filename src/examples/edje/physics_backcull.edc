/* This example demonstrates how to customize movement freedom and backface
 * culling.
 *
 * By default, bodies only will move on x and y axis, and rotate only
 * aroud the z axis. To modify it, the block "movement freedom" should be used.
 * This block consists of the "linear" and "angular" attributes, each one
 * receiving 3 booleans, to set if movement in each axis is allowed or not.
 *
 * When a body has backface culling activated, it will be hidden when
 * it's not facing the camera. It's deactivated by default.
 *
 * It can be tested with edje_player slave mode
 * $ edje_player -S -p physics_backcull.edj
 *
 * signal on backcull -> allow movement in all axes, enable backface cull
 * signal off backcull -> allow movement in all axes, disable backface cull
 *
 * message 1 FLOAT_SET 3 50 -100 0 -> apply an impulse on red box with
 *    x = 50, y = -100, z = 0, for example
 * message 2 FLOAT_SET 3 0 0 8.2 -> apply a torque impulse on red box with
 *    x = 4, y = 0, z = 0.8, for example
 * message 3 FLOAT_SET 3 0 1 0 -> allow linear movement on axes x, y, z
 * message 4 FLOAT_SET 3 0 1 0 -> allow angular movement on axes x, y, z
 * message 5 STRING "linear" -> return a message with part's movement freedom
 *                              for "linear" or "angular.
 */

// Defines message IDs for the script to identify different actions.
#define ID_IMPULSE (1)
#define ID_TORQUE_IMPULSE (2)
#define ID_LIN_SET (3)
#define ID_ANG_SET (4)
#define ID_GET (5)

collections {

   // A group is a self-contained unit of an interface, with its own parts,
   // scripts, and programs.
   group {
      name: "example_group";

      // The script block contains Embryo script code that allows for dynamic
      // behavior and interaction with the application. This script handles
      // messages to control the physics of the "red_box" part.
      script {
         public message(Msg_Type:type, id, ...) {
            // Checks for an impulse message to apply a linear force to the "red_box" part.
            if ((id == ID_IMPULSE) && (type == MSG_FLOAT_SET)) {
               new Float:x, Float:y, Float:z;
               new n = numargs();
               if (n < 5) return;
               x = getfarg(2);
               y = getfarg(3);
               z = getfarg(4);
               physics_impulse(PART:"red_box", x, y, z);
            }
            // Checks for a torque impulse message to apply a rotational force to the "red_box".
            else if ((id == ID_TORQUE_IMPULSE) && (type == MSG_FLOAT_SET)) {
               new Float:x, Float:y, Float:z;
               new n = numargs();
               if (n < 5) return;
               x = getfarg(2);
               y = getfarg(3);
               z = getfarg(4);
               physics_torque_impulse(PART:"red_box", x, y, z);
            }
            // Sets the linear movement freedom on x, y, and z axes for the "red_box".
            // This determines which axes the box can move along.
            else if ((id == ID_LIN_SET) && (type == MSG_FLOAT_SET)) {
               new Float:x, Float:y, Float:z;
               new n = numargs();
               if (n < 5) return;
               x = getfarg(2);
               y = getfarg(3);
               z = getfarg(4);
               custom_state(PART:"red_box", "default", 0.0);
               set_state_val(PART:"red_box", STATE_PHYSICS_MOV_FREEDOM_LIN,
                  x, y, z);
               set_state(PART:"red_box", "custom", 0.0);
            }
            // Sets the angular movement freedom on x, y, and z axes for the "red_box".
            // This determines which axes the box can rotate around.
            else if ((id == ID_ANG_SET) && (type == MSG_FLOAT_SET)) {
               new Float:x, Float:y, Float:z;
               new n = numargs();
               if (n < 5) return;
               x = getfarg(2);
               y = getfarg(3);
               z = getfarg(4);
               custom_state(PART:"red_box", "default", 0.0);
               set_state_val(PART:"red_box", STATE_PHYSICS_MOV_FREEDOM_ANG,
                  x, y, z);
               set_state(PART:"red_box", "custom", 0.0);
            }
            // Retrieves the current movement freedom values and sends them back as a message.
            // This is useful for querying the current state from an application.
            else if ((id == ID_GET) && (type == MSG_STRING)) {
               new Float:x, Float:y, Float:z;
               new name[1024];
               getsarg(2, name, sizeof(name));
               if (!strcmp(name, "linear"))
               {
                  get_state_val(PART:"red_box",
                     STATE_PHYSICS_MOV_FREEDOM_LIN, x, y, z);
                  send_message(MSG_STRING_FLOAT_SET, 1, "Linear", x, y, z);
               }
               else if (!strcmp(name, "angular"))
               {
                  get_state_val(PART:"red_box",
                     STATE_PHYSICS_MOV_FREEDOM_ANG, x, y, z);
                  send_message(MSG_STRING_FLOAT_SET, 1, "Angular", x, y, z);
               }
            }
         }
      }

      // The 'parts' block defines all the visual and physical elements of the group.
      parts {
         // This part serves as the background of the scene. It's a non-physical
         // rectangle that covers the entire area.
         part {
            name: "background";
            type: RECT;
            physics_body: NONE;
            description {
               state: "default" 0.0;
               // Opaque white color (#FFFFFFFF).
               color: 255 255 255 255;
               rel1.relative: 0.0 0.0;
               rel2.relative: 1.0 1.0;
            }
         }

         // This part is a red box with rigid body physics. It is the main object
         // for physics interaction in this example.
         part {
            name: "red_box";
            type: RECT;
            physics_body: RIGID_BOX;
            description {
               state: "default" 0.0;
               // Opaque light red color (#FF0000FF).
               color: 255 0 0 255;
               rel1.relative: 0.45 0.1;
               rel2.relative: 0.55 0.2;
               aspect: 1 1;
               // Physics properties define the behavior of the object in the simulation.
               physics {
                  mass: 30;
                  restitution: 0.85;
                  // movement_freedom allows specifying which axes the body can move or rotate on.
                  // Here, it's enabled for all axes, allowing 3D movement.
                  movement_freedom {
                     linear: 1 1 1;
                     angular: 1 1 1;
                  }
               }
            }
            // This description is used to enable backface culling. When this state is
            // active, the object will not be rendered if its back face is towards the camera.
            description {
               state: "backface_culled" 0.0;
               inherit: "default" 0.0;
               physics.backface_cull: 1;
            }
         }

         // The following parts define the invisible boundaries of the physics world,
         // creating a container for the 'red_box'. They are set to be invisible
         // but have physics properties to interact with other physical objects.
         part {
            name: "floor";
            type: RECT;
            physics_body: BOUNDARY_BOTTOM;
            description {
               state: "default" 0.0;
               visible: 0;
               physics {
                  restitution: 0.8;
               }
            }
         }

         part {
            name: "front";
            type: RECT;
            physics_body: BOUNDARY_FRONT;
            description {
               state: "default" 0.0;
               visible: 0;
               physics {
                  restitution: 0.4;
               }
            }
         }

         part {
            name: "back";
            type: RECT;
            physics_body: BOUNDARY_BACK;
            description {
               state: "default" 0.0;
               visible: 0;
               physics {
                  restitution: 0.4;
               }
            }
         }

         part {
            name: "left";
            type: RECT;
            physics_body: BOUNDARY_LEFT;
            description {
               state: "default" 0.0;
               visible: 0;
               physics {
                  restitution: 0.4;
               }
            }
         }

         part {
            name: "right";
            type: RECT;
            physics_body: BOUNDARY_RIGHT;
            description {
               state: "default" 0.0;
               visible: 0;
               physics {
                  restitution: 0.4;
               }
            }
         }
      }

      // The 'programs' block defines responses to signals. These can be used to
      // change the state of parts, run scripts, or emit other signals.
      programs {
         // This program is triggered by the "on" signal from the "backcull" source.
         // It sets the state of "red_box" to "backface_culled", enabling the culling.
         program {
            name: "backcull,on";
            signal: "on";
            source: "backcull";
            action: STATE_SET "backface_culled" 0.0;
            target: "red_box";
         }

         // This program is triggered by the "off" signal from the "backcull" source.
         // It reverts the "red_box" to its "default" state, disabling backface culling.
         program {
            name: "backcull,off";
            signal: "off";
            source: "backcull";
            action: STATE_SET "default" 0.0;
            target: "red_box";
         }

      }

   }
}
