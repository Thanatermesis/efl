efl_version: 1 22;

collections {

   styles {
      // Defines a reusable style for text entries.
      // - font="sans": Specifies the font family.
      // - font_size=10: Sets the font size to 10 points.
      // - color=#000: Sets the text color to black (#000000).
      // - wrap="word": Enables word wrapping.
      // - left_margin=2, right_margin=2: Adds horizontal margins.
      style {
         name: "entry_style";
         base: "font="sans" font_size=10 color=#000 wrap="word" left_margin=2 right_margin=2";
      }
   }

   // This group defines the main layout of the multiseat filter example.
   // It demonstrates how to restrict input events from different seats (e.g., pointers)
   // to specific widgets. The layout is divided into four quadrants, each with
   // different seat filtering rules.
   group {
      name: "example/main";
      min: 400 400;

      parts {
         // A simple background rectangle that does not react to mouse events.
         part {
            name: "bg";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
            }
         }

         // The main title of the example window.
         part {
            name: "title";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: Black (#000000)
               color: 0 0 0 255;
               rel1 {
                  relative: 0.0 0.0;
                  offset: 0 0;
                  to: "bg";
               }
               rel2 {
                  relative: 1.0 0.2;
                  offset: -1 -1;
                  to: "bg";
               }
               text {
                  text: "Multiseat Filter Example";
                  size: 16;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         // This button is used to test whether focus actions respect the allowed seats list.
         // It consists of a RECT part for the button background and visuals, and a TEXT
         // part for the label. The 'focus_bt' part handles mouse events and changes color
         // based on its state (default, over, pressed).
         part {
            name: "focus_bt";
            type: RECT;
            mouse_events: 1;
            description {
               state: "default" 0.0;
               rel1.relative: 0.3 0.2;
               rel2.relative: 0.7 0.25;
               // color: Reddish (#C03232)
               color: 192 50 50 255;
            }
            description {
               state: "over" 0.0;
               inherit: "default" 0.0;
               // color: Darker Reddish (#8E1E1E) for mouse-over
               color: 142 30 30 255;
            }
            description {
               state: "pressed" 0.0;
               inherit: "default" 0.0;
               // color: Brighter Reddish (#DC4646) for pressed state
               color: 220 70 70 255;
            }
         }

         // The label for the focus button, positioned in the center of "focus_bt".
         part {
            name: "focus_bt,label";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: Dark Red (#5C0000)
               color: 92 0 0 255;
               rel1 {
                  relative: 0.5 0.5;
                  to: "focus_bt";
               }
               rel2 {
                  relative: 0.5 0.5;
                  to: "focus_bt";
               }
               text {
                  text: "Focus 'Seat 1 Only' Entry";
                  size: 11;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         // This is the container for the top-left widget area. It defines the background
         // and boundaries for child elements.
         part {
            name: "widget1";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               rel1.relative: 0.0 0.3;
               rel2.relative: 0.5 0.65;
               // color: Yellow (#FFFF00)
               color: 255 255 0 255;
            }
         }

         // Bottom-left widget area.
         part {
            name: "widget2";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               rel1.relative: 0.0 0.65;
               rel2.relative: 0.5 1.0;
               // color: Magenta (#FF00FF)
               color: 255 0 255 255;
            }
         }

         // Top-right widget area.
         part {
            name: "widget3";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               rel1.relative: 0.5 0.3;
               rel2.relative: 1.0 0.65;
               // color: Cyan (#00FFFF)
               color: 0 255 255 255;
            }
         }

         // Bottom-right widget area.
         part {
            name: "widget4";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               rel1.relative: 0.5 0.65;
               rel2.relative: 1.0 1.0;
               // color: Light Green (#82FF82)
               color: 130 255 130 255;
            }
         }

         // Title for the "widget1" area, indicating its function.
         part {
           name: "widget1,title";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: Black (#000000)
               color: 0 0 0 255;
               rel1 {
                  relative: 0.0 0.02;
                  offset: 0 0;
                  to: "widget1";
               }
               rel2 {
                  relative: 1.0 0.1;
                  offset: -1 -1;
                  to: "widget1";
               }
               text {
                  text: "Seat1 Only";
                  size: 10;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         // A visual guide and confinement area for the draggable knob. The knob
         // cannot be dragged outside of this part's boundaries.
         part {
            name: "widget1,drag_area";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: Dark Gray (#141414)
               color: 20 20 20 255;
               rel1 {
                  relative: 0.1 0.2;
                  offset: -5 0;
                  to: "widget1";
               }
               rel2 {
                  relative: 0.1 0.8;
                  offset: 4 0;
                  to: "widget1";
               }
            }
         }

         // A draggable knob.
         // - allowed_seats: "seat1" - This is the key property. It restricts all
         //   mouse and keyboard events for this part to "seat1" only. Events from
         //   other seats will be ignored.
         // - dragable.confine: "widget1,drag_area" - Restricts dragging within the
         //   "widget1,drag_area" part.
         // - dragable.y: 1 1 0 - Allows vertical dragging but not horizontal.
         part {
            name: "widget,knob,1";
            type: RECT;
            mouse_events: 1;
            allowed_seats: "seat1";
            dragable {
               confine: "widget1,drag_area";
               x: 0 0 0;
               y: 1 1 0;
            }
            description {
               state: "default" 0.0;
               min: 10 30;
               // color: Gray (#787878)
               color: 120 120 120 255;
            }
            description {
               state: "focused" 0.0;
               inherit: "default" 0.0;
               // color: Light Gray (#C8C8C8) when focused/dragged
               color: 200 200 200 255;
            }
         }

         // Background for the text entry area. It changes color when the
         // associated text entry ("widget,text,1") receives focus.
         part {
            name: "widget,bg_text,1";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               min: 10 50;
               rel1 {
                  to: "widget1";
                  relative: 0.25 0.2;
               }
               rel2 {
                  to: "widget1";
                  relative: 0.85 0.8;
               }
               // color: Gray (#787878)
               color: 120 120 120 255;
            }
            description {
               state: "focused" 0.0;
               inherit: "default" 0.0;
               // color: Light Gray (#C8C8C8) when focused
               color: 200 200 200 255;
            }
         }

         // An editable text block.
         // - entry_mode: EDITABLE - Allows the text to be modified.
         // - allowed_seats: "seat1" - Restricts interaction to "seat1".
         // - source: "example/selection" - Uses the "example/selection" group to
         //   render text selections.
         // - source4: "example/cursor" - Uses the "example/cursor" group to render
         //   the text cursor.
         part {
            name: "widget,text,1";
            type: TEXTBLOCK;
            scale: 1;
            entry_mode: EDITABLE;
            select_mode: DEFAULT;
            cursor_mode: UNDER;
            mouse_events: 1;
            allowed_seats: "seat1";
            multiline: 1;
            source: "example/selection";
            source4: "example/cursor";
            description {
               state: "default" 0.0;
               min: 12 50;
               rel1 {
                  to: "widget,bg_text,1";
                  offset: 2 2;
               }
               rel2 {
                  to: "widget,bg_text,1";
                  offset: -3 -3;
               }
               text {
                  style: "entry_style";
                  min: 0 1;
                  align: 0.0 0.0;
               }
            }
         }

        // Title for the "widget2" area.
        part {
           name: "widget2,title";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: Black (#000000)
               color: 0 0 0 255;
               rel1 {
                  relative: 0.0 0.02;
                  offset: 0 0;
                  to: "widget2";
               }
               rel2 {
                  relative: 1.0 0.1;
                  offset: -1 -1;
                  to: "widget2";
               }
               text {
                  text: "Seat2 Only";
                  size: 10;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         part {
            name: "widget2,drag_area";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               color: 20 20 20 255;
               rel1 {
                  relative: 0.1 0.2;
                  offset: -5 0;
                  to: "widget2";
               }
               rel2 {
                  relative: 0.1 0.8;
                  offset: 4 0;
                  to: "widget2";
               }
            }
         }

         // Draggable knob for widget 2, restricted to "seat2".
         part {
            name: "widget,knob,2";
            type: RECT;
            mouse_events: 1;
            allowed_seats: "seat2";
            dragable {
               confine: "widget2,drag_area";
               x: 0 0 0;
               y: 1 1 0;
            }
            description {
               state: "default" 0.0;
               min: 10 30;
               color: 120 120 120 255;
            }
            description {
               state: "focused" 0.0;
               inherit: "default" 0.0;
               color: 200 200 200 255;
            }
         }

         part {
            name: "widget,bg_text,2";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               min: 10 50;
               rel1 {
                  to: "widget2";
                  relative: 0.25 0.2;
               }
               rel2 {
                  to: "widget2";
                  relative: 0.85 0.8;
               }
               color: 120 120 120 255;
            }
            description {
               state: "focused" 0.0;
               inherit: "default" 0.0;
               color: 200 200 200 255;
            }
         }

         // Editable text block for widget 2, restricted to "seat2".
         part {
            name: "widget,text,2";
            type: TEXTBLOCK;
            scale: 1;
            entry_mode: EDITABLE;
            select_mode: DEFAULT;
            cursor_mode: UNDER;
            mouse_events: 1;
            allowed_seats: "seat2";
            multiline: 1;
            source: "example/selection";
            source4: "example/cursor";
            description {
               state: "default" 0.0;
               min: 12 50;
               rel1 {
                  to: "widget,bg_text,2";
                  offset: 2 2;
               }
               rel2 {
                  to: "widget,bg_text,2";
                  offset: -3 -3;
               }
               text {
                  style: "entry_style";
                  min: 0 1;
                  align: 0.0 0.0;
               }
            }
         }

        // Title for the "widget3" area.
        part {
           name: "widget3,title";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: Black (#000000)
               color: 0 0 0 255;
               rel1 {
                  relative: 0.0 0.02;
                  offset: 0 0;
                  to: "widget3";
               }
               rel2 {
                  relative: 1.0 0.1;
                  offset: -1 -1;
                  to: "widget3";
               }
               text {
                  text: "Seat 1 + Seat2";
                  size: 10;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         part {
            name: "widget3,drag_area";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               color: 20 20 20 255;
               rel1 {
                  relative: 0.1 0.2;
                  offset: -5 0;
                  to: "widget3";
               }
               rel2 {
                  relative: 0.1 0.8;
                  offset: 4 0;
                  to: "widget3";
               }
            }
         }

         // Draggable knob for widget 3.
         // - allowed_seats: "seat1" "seat2" - Allows interaction from both
         //   "seat1" and "seat2".
         part {
            name: "widget,knob,3";
            type: RECT;
            mouse_events: 1;
            allowed_seats: "seat1" "seat2";
            dragable {
               confine: "widget3,drag_area";
               x: 0 0 0;
               y: 1 1 0;
            }
            description {
               state: "default" 0.0;
               min: 10 30;
               color: 120 120 120 255;
            }
            description {
               state: "focused" 0.0;
               inherit: "default" 0.0;
               color: 200 200 200 255;
            }
         }

         part {
            name: "widget,bg_text,3";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               min: 10 50;
               rel1 {
                  to: "widget3";
                  relative: 0.25 0.2;
               }
               rel2 {
                  to: "widget3";
                  relative: 0.85 0.8;
               }
               color: 120 120 120 255;
            }
            description {
               state: "focused" 0.0;
               inherit: "default" 0.0;
               color: 200 200 200 255;
            }
         }

         // Editable text block for widget 3, allows both "seat1" and "seat2".
         part {
            name: "widget,text,3";
            type: TEXTBLOCK;
            scale: 1;
            entry_mode: EDITABLE;
            select_mode: DEFAULT;
            cursor_mode: UNDER;
            mouse_events: 1;
            allowed_seats: "seat1" "seat2";
            multiline: 1;
            source: "example/selection";
            source4: "example/cursor";
            description {
               state: "default" 0.0;
               min: 12 50;
               rel1 {
                  to: "widget,bg_text,3";
                  offset: 2 2;
               }
               rel2 {
                  to: "widget,bg_text,3";
                  offset: -3 -3;
               }
               text {
                  style: "entry_style";
                  min: 0 1;
                  align: 0.0 0.0;
               }
            }
         }

        // Title for the "widget4" area.
        part {
           name: "widget4,title";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: Black (#000000)
               color: 0 0 0 255;
               rel1 {
                  relative: 0.0 0.02;
                  offset: 0 0;
                  to: "widget4";
               }
               rel2 {
                  relative: 1.0 0.1;
                  offset: -1 -1;
                  to: "widget4";
               }
               text {
                  text: "Any seat";
                  size: 10;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         part {
            name: "widget4,drag_area";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               color: 20 20 20 255;
               rel1 {
                  relative: 0.1 0.2;
                  offset: -5 0;
                  to: "widget4";
               }
               rel2 {
                  relative: 0.1 0.8;
                  offset: 4 0;
                  to: "widget4";
               }
            }
         }

         // Draggable knob for widget 4. Since `allowed_seats` is not specified,
         // it accepts input from any seat by default.
         part {
            name: "widget,knob,4";
            type: RECT;
            mouse_events: 1;
            dragable {
               confine: "widget4,drag_area";
               x: 0 0 0;
               y: 1 1 0;
            }
            description {
               state: "default" 0.0;
               min: 10 30;
               color: 120 120 120 255;
            }
            description {
               state: "focused" 0.0;
               inherit: "default" 0.0;
               color: 200 200 200 255;
            }
         }

         part {
            name: "widget,bg_text,4";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               min: 10 50;
               rel1 {
                  to: "widget4";
                  relative: 0.25 0.2;
               }
               rel2 {
                  to: "widget4";
                  relative: 0.85 0.8;
               }
               color: 120 120 120 255;
            }
            description {
               state: "focused" 0.0;
               inherit: "default" 0.0;
               color: 200 200 200 255;
            }
         }

         // Editable text block for widget 4, accepts input from any seat.
         part {
            name: "widget,text,4";
            type: TEXTBLOCK;
            scale: 1;
            entry_mode: EDITABLE;
            select_mode: DEFAULT;
            cursor_mode: UNDER;
            mouse_events: 1;
            multiline: 1;
            source: "example/selection";
            source4: "example/cursor";
            description {
               state: "default" 0.0;
               min: 12 50;
               rel1 {
                  to: "widget,bg_text,4";
                  offset: 2 2;
               }
               rel2 {
                  to: "widget,bg_text,4";
                  offset: -3 -3;
               }
               text {
                  style: "entry_style";
                  min: 0 1;
                  align: 0.0 0.0;
               }
            }
         }
      }

      // The 'programs' section defines the interactive behavior of the interface.
      // It connects signals (like mouse clicks or focus changes) from specific parts
      // to actions or scripts.
      programs {
         // This program is triggered when any of the "widget,text,*" parts are clicked
         // by any seat.
         program {
            name: "clicked";
            signal: "seat,*,mouse,clicked,1";
            source: "widget,text,*";
            // The script extracts the seat name that originated the click from the
            // signal string (e.g., "seat,seat1,mouse,clicked,1") and then uses it
            // to set the focus on the clicked text part for that specific seat.
            // This ensures that focus is managed on a per-seat basis.
            // - strchr(sig[...], ","): Finds the first comma after "seat," to isolate the seat name.
            // - strncpy(...): Copies the seat name into the 'seat' variable.
            // - set_focus(partid, seat): Sets focus on the source part for the identified seat.
            script {
                new seat[256];
                new partid, idx;

                idx = strchr(sig[strlen("seat,")], ",");
                strncpy(seat, sig[strlen("seat,")], idx);

                partid = get_part_id(src);
                set_focus(partid, seat);
            }
         }

         // These programs manage the visual feedback for focused text entries.
         // When a text part gains focus ("focus,part,in"), its corresponding
         // background part is set to the "focused" state. When it loses focus
         // ("focus,part,out"), the background is reset to the "default" state.
         // The script dynamically constructs the background part's name from the
         // text part's name using a common EDC string manipulation trick.
         program {
            name: "focused";
            signal: "seat,*,focus,part,in";
            source: "widget,text,*";
            script {
               new buf[256];
               new partid;

               snprintf(buf, sizeof(buf), "widget,bg_text,%s",
                        src[strlen("widget,text,")]);
               partid = get_part_id(buf);
               set_state(partid, "focused", 0.0);
            }
         }

         program {
            name: "unfocused";
            signal: "seat,*,focus,part,out";
            source: "widget,text,*";
            script {
               new buf[256];
               new partid;

               snprintf(buf, sizeof(buf), "widget,bg_text,%s",
                        src[strlen("widget,text,")]);
               partid = get_part_id(buf);
               set_state(partid, "default", 0.0);
            }
         }

         // Change the visual state of a knob when it is being dragged.
         // On "drag,start", the knob's state is set to "focused" (making it lighter).
         // On "drag,stop", it returns to the "default" state.
         program {
            name: "drag,start";
            signal: "seat,*,drag,start";
            source: "widget,knob,*";
            script {
                new partid;
                partid = get_part_id(src);
                set_state(partid, "focused", 0.0);
            }
         }

         program {
            name: "drag,stop";
            signal: "seat,*,drag,stop";
            source: "widget,knob,*";
            script {
                new partid;
                partid = get_part_id(src);
                set_state(partid, "default", 0.0);
            }
         }

         // These programs handle the visual states of the "focus_bt" button,
         // such as mouse-over and pressed states. These are standard for creating
         // button-like behavior.
         program {
            name: "focus_bt,in";
            signal: "mouse,in";
            source: "focus_bt";
            action: STATE_SET "over" 0.0;
            target: "focus_bt";
         }

         program {
            name: "focus_bt,out";
            signal: "mouse,out";
            source: "focus_bt";
            action: STATE_SET "default" 0.0;
            target: "focus_bt";
         }

         program {
            name: "focus_bt,down";
            signal: "mouse,down,1";
            source: "focus_bt";
            action: STATE_SET "pressed" 0.0;
            target: "focus_bt";
         }

         program {
            name: "focus_bt,up";
            signal: "mouse,up,1";
            source: "focus_bt";
            action: STATE_SET "default" 0.0;
            target: "focus_bt";
         }

         // This program is triggered when the "focus_bt" button is clicked.
         program {
            name: "focus_bt,clicked";
            signal: "seat,*,mouse,clicked,1";
            source: "focus_bt";
            // The script extracts the seat name from the click signal. It then
            // tries to set focus on "widget,text,1" for that seat.
            // This demonstrates a key concept: an action from any seat (since the
            // button is not restricted) can attempt to focus a restricted widget.
            // Edje will only grant focus if the seat from the click event is
            // in the target's `allowed_seats` list (which is "seat1" for this widget).
            script {
                new seat[256];
                new idx;

                idx = strchr(sig[strlen("seat,")], ",");
                strncpy(seat, sig[strlen("seat,")], idx);

                set_focus(PART:"widget,text,1", seat);
            }
         }
      }
   }

   // This group defines the visual appearance of text selection.
   // When text is selected in a TEXTBLOCK, a part from this group is used to
   // render the selection highlight.
   group {
      name: "example/selection";

      parts {
         part {
            name: "selection";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: Light Gray (#B4B4B4) for selection highlight.
               color: 180 180 180 255;
            }
         }
      }
   }

   // This group defines the text cursor for editable text parts.
   // It includes a simple rectangle for the cursor and a set of programs
   // that create a blinking animation.
   group {
      name: "example/cursor";
      min: 1 0;

      parts {
         // The visual representation of the cursor. It's a black rectangle
         // that can be hidden by setting its color to transparent.
         part {
            name: "cursor";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               min: 2 12;
               // color: Black (#000000)
               color: 0 0 0 255;
            }
            description {
               state: "hidden" 0.0;
               inherit: "default" 0.0;
               // color: Transparent black
               color: 0 0 0 0;
            }
         }
      }

      // These programs create a classic blinking cursor effect.
      // On "load", the cursor starts a hide->show->hide loop using chained
      // programs and timers.
      programs {
         program {
            name: "cursor_hide";
            signal: "load";
            source: "";
            action: STATE_SET "hidden" 0.0;
            target: "cursor";
            transition: SINUSOIDAL 0.2;
            after: "cursor_hide_timer";
         }
         program {
            name: "cursor_hide_timer";
            in: 0.2 0.0;
            after: "cursor_show";
         }
         program {
            name: "cursor_show";
            action: STATE_SET "default" 0.0;
            target: "cursor";
            after: "cursor_show_timer";
         }
         program {
            name: "cursor_show_timer";
            in: 0.5 0.0;
            after: "cursor_hide";
         }
      }
   }
}
