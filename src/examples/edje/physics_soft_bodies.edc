/* This example shows how to use soft bodies.
 *
 * Soft bodies have an attribute to change how much it will
 * deforms when colliding. It's called "hardness", and can
 * be set to any value between 0.0 (soft) and 1.0 (hard).
 * By default, all the soft bodies are hard (1.0).
 *
 * This example will make a box and a sphere collide
 * many times against the floor and will be placed at
 * top of the screen again. They will have their hardness
 * modified each time, going from the default to a very
 * soft state.
 *
 * It can be tested with edje_player
 * $ edje_player physics_soft_bodies.edj
 */

collections {

   // Preload images to be used by parts.
   // COMP indicates that the image data is stored compressed in the
   // final .edj file, which is generally recommended.
   images {
      image: "bubble-blue.png" COMP;
   }

   // Defines the main layout and behavior of the example.
   // It contains all visual elements (parts) and interactive logic (programs).
   group {
      name: "example_group";

      // The 'parts' block contains all the visible and invisible elements of the interface.
      parts {
         // The background is a simple white rectangle that fills the entire window.
         // It has no physics properties, so it won't interact with other objects.
         part {
            name: "background";
            type: RECT;
            physics_body: NONE;
            description {
               state: "default" 0.0;
               // color: white (#FFFFFFFF)
               color: 255 255 255 255; /* white */
               rel1.relative: 0.0 0.0;
               rel2.relative: 1.0 1.0;
            }
         }

         // This is a red square that behaves as a soft body in the physics simulation.
         part {
            name: "red_box";
            type: RECT;
            // SOFT_BOX makes this part a deformable box in the physics world.
            physics_body: SOFT_BOX;
            description {
               state: "default" 0.0;
               // color: red (#FF0000FF)
               color: 255 0 0 255; /* red */
               rel1.relative: 0.75 0.1;
               rel2.relative: 0.95 0.3;
               aspect: 1 1;
               physics {
                  // When set to 0, the part's initial position is determined by the
                  // physics engine, not its relative positioning after simulation starts.
                  ignore_part_pos: 0;
                  // Restitution defines the "bounciness" of the object.
                  // A value of 0.85 means it retains 85% of its energy after a collision.
                  restitution: 0.85;
               }
            }
            // The "soft" state makes the box more deformable.
            description {
               state: "soft" 0.0;
               inherit: "default" 0.0;
               physics {
                  // Hardness ranges from 0.0 (very soft) to 1.0 (rigid).
                  hardness: 0.8;
               }
            }
            // The "very_soft" state makes the box even more deformable.
            description {
               state: "very_soft" 0.0;
               inherit: "default" 0.0;
               physics {
                  hardness: 0.4;
               }
            }
         }

         // This is a circle-shaped image that also behaves as a soft body.
         part {
            name: "blue_circle";
            type: IMAGE;
            // SOFT_CYLINDER is used for circular or spherical soft bodies.
            physics_body: SOFT_CYLINDER;
            description {
               state: "default" 0.0;
               rel1.relative: 0.25 0.1;
               rel2.relative: 0.45 0.3;
               aspect: 1 1;
               image {
                  normal: "bubble-blue.png";
               }
               physics {
                  ignore_part_pos: 0;
                  restitution: 0.85;
                  // Hardness is explicitly set to 1.0 (rigid), which is the default value.
                  hardness: 1;
               }
            }
            // The "soft" state description, with reduced hardness.
            // Note the alternative 'physics.hardness' syntax, which is equivalent
            // to using a 'physics' block.
            description {
               state: "soft" 0.0;
               inherit: "default" 0.0;
               physics.hardness: 0.8;
            }
            // The "very_soft" state, with even lower hardness.
            description {
               state: "very_soft" 0.0;
               inherit: "default" 0.0;
               physics.hardness: 0.4;
            }
         }

         // An invisible boundary at the bottom of the screen to act as a floor.
         // Physics boundaries are static and used to contain other physics objects.
         part {
            name: "floor";
            type: RECT;
            physics_body: BOUNDARY_BOTTOM;
            description {
               state: "default" 0.0;
               visible: 0;
               physics {
                  // The floor has its own restitution, affecting how objects bounce off it.
                  restitution: 0.7;
               }
            }
         }

         // Invisible boundaries for the sides of the screen.
         // They have a restitution of 1.0, making collisions with them perfectly elastic.
         part {
            name: "right_wall";
            type: RECT;
            physics_body: BOUNDARY_RIGHT;
            description {
               state: "default" 0.0;
               visible: 0;
               physics {
                  restitution: 1.0;
               }
            }
         }

         part {
            name: "left_wall";
            type: RECT;
            physics_body: BOUNDARY_LEFT;
            description {
               state: "default" 0.0;
               visible: 0;
               physics {
                  restitution: 1.0;
               }
            }
         }

      }

      // Programs define the dynamic behavior and logic of the interface.
      // These programs create a loop that cycles through the different hardness
      // states of the soft bodies every 3 seconds.
      programs {
         // This program is triggered 3 seconds after the 'load' signal, which
         // is emitted when the Edje object is created.
         program {
            name: "stop,go_soft";
            signal: "load";
            // 'in: 3 0;' specifies a delay of 3.0 seconds before the action runs.
            in: 3 0;
            // The action stops the physics simulation for the specified targets.
            // This is done to reset their positions and apply state changes cleanly.
            action: PHYSICS_STOP;
            target: "red_box";
            target: "blue_circle";
            // After this program completes, it runs the 'go_soft' program.
            after: "go_soft";
         }

         program {
            name: "go_soft";
            // This action changes the state of the targets to "soft".
            action: STATE_SET "soft" 0.0;
            target: "red_box";
            target: "blue_circle";
            // It then chains to the next program in the sequence.
            after: "stop,go_very_soft";
         }

         // After another 3 seconds, this program stops the physics again.
         program {
            name: "stop,go_very_soft";
            in: 3 0;
            action: PHYSICS_STOP;
            target: "red_box";
            target: "blue_circle";
            after: "go_very_soft";
         }

         program {
            name: "go_very_soft";
            // Sets the state to "very_soft", making the objects more deformable.
            action: STATE_SET "very_soft" 0.0;
            target: "red_box";
            target: "blue_circle";
            after: "stop,go_default";
         }

         // After another 3-second interval, physics is stopped.
         program {
            name: "stop,go_default";
            in: 3 0;
            action: PHYSICS_STOP;
            target: "red_box";
            target: "blue_circle";
            after: "go_default";
         }

         program {
            name: "go_default";
            // Resets the objects to their original "default" state.
            action: STATE_SET "default" 0.0;
            target: "red_box";
            target: "blue_circle";
            // 'after' points back to 'stop,go_soft', creating an infinite loop
            // that cycles through the states.
            after: "stop,go_soft";
         }
      }

   }
}
