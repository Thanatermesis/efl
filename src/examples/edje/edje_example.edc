// compile: edje_cc edje_example.edc
// An Edje file is composed of collections, which are libraries of UI components.
collections {
   // A group is a self-contained UI layout or widget. It encapsulates
   // a set of parts and the logic that governs their behavior.
   group {
      // The name is used to reference this group from the C code,
      // allowing the application to instantiate this UI component.
      name: "my_group";

      // The 'parts' block contains all the visual elements that make up this group.
      // Parts are stacked on top of each other in the order they are defined.
      parts {
         // This is the first part, a background rectangle. It will be drawn first.
         part {
            name: "background";
            type: RECT; // A simple rectangle primitive.
            // Mouse events are disabled for this part. This is an optimization; if a part
            // doesn't need to react to the mouse, turning events off prevents Edje
            // from doing unnecessary calculations.
            mouse_events: 0;

            // A 'description' defines the state of a part. A part can have multiple
            // descriptions to represent different states (e.g., "clicked", "disabled").
            description {
               // Every part must have a "default" state. The '0.0' is the state value,
               // used for animations between states.
               state: "default" 0.0;
               color: 255 255 255 255; // Opaque white (#FFFFFFFF).

               // The geometry of the part is defined by its corner points, rel1 and rel2.
               // 'rel1' corresponds to the top-left corner.
               rel1 {
                  // 'relative' positions the corner as a fraction of the parent container's size.
                  // '0.0 0.0' means the top-left corner of the container.
                  relative: 0.0 0.0;
                  // 'offset' provides an additional displacement in pixels.
                  offset: 0 0;
               }
               // 'rel2' corresponds to the bottom-right corner.
               rel2 {
                  // '1.0 1.0' means the bottom-right corner of the container.
                  relative: 1.0 1.0;
                  // Offsets of '-1 -1' make the part fit exactly within the container's
                  // boundaries, as coordinates are 0-indexed.
                  offset: -1 -1;
               }
            }
         }

         // This part is for the text. It's defined after the background,
         // so it will be rendered on top of it.
         part {
            name: "text";
            type: TEXT;
            // Mouse events are enabled because this part is interactive.
            // This allows it to be a 'source' for signals in the 'programs' block.
            mouse_events: 1;

            // This part has two states: "default" and "over". This allows it to
            // visually change when the mouse pointer is over it.

            // The 'default' description for the text part.
            description {
               state: "default" 0.0;
               color: 255 0 0 255; // Opaque red (#FF0000FF).

               // Here, the relative positioning and offsets are used to create
               // margins around the text, placing it inside the background part
               // without touching the edges.
               rel1 {
                  relative: 0.1 0.2;
                  offset: 5 10;
               }
               rel2 {
                  relative: 0.9 0.8;
                  offset: -6 -11;
               }

               // The 'text' block is specific to parts of type TEXT and defines
               // text-related properties.
               text {
                  font: "Sans"; // Font name, resolved by Fontconfig.
                  size: 10;
                  text: "hello world";
               }
            }

            // The 'over' description for when the mouse is over the text.
            description {
               state: "over" 0.0;
               // 'inherit' is a powerful property that copies all attributes from another
               // state. This avoids repetition. Here, it copies from the "default"
               // state of this same part.
               inherit: "default" 0.0;

               // We only need to specify what changes. In this case, the color is
               // overridden to green.
               color: 0 255 0 255; // Opaque green (#00FF00FF).
            }
         }

         // The 'programs' block defines the logic and interactivity of the group.
         // Programs listen for signals (events) and execute actions in response.
         programs {
            // This program handles the mouse entering the 'text' part's area.
            program {
               // Trigger: emitted when the mouse cursor enters the source part.
               signal: "mouse,in";
               // The part that emits the signal.
               source: "text";

               // Action: what to do when the signal is received.
               // 'STATE_SET' changes the state of a target part.
               action: STATE_SET "over" 0.0;
               // The part to which the action is applied.
               target: "text";

               // A transition animates the state change. Here, the properties
               // (just the color) will animate from the "default" state to the
               // "over" state over 0.1 seconds using a linear interpolator.
               transition: LINEAR 0.1;
            }

            // This program handles the mouse leaving the 'text' part's area,
            // resetting it to its original state.
            program {
               // Trigger: emitted when the mouse cursor leaves the source part.
               signal: "mouse,out";
               source: "text";

               // Action: change the state of the 'text' part back to "default".
               action: STATE_SET "default" 0.0;
               target: "text";

               // The transition back to the default state is also animated.
               transition: LINEAR 0.1;
            }
         }
      }
   }
}
