collections {
   // Defines the main UI layout, containing all visual elements.
   group { "main";
      parts {
         // A red (#f00) rectangle anchored to the top-left corner of the parent group.
         rect { "rect1";
            desc {
               anchors.top: GROUP TOP;
               // 'anchors.left: GROUP;' is a shorthand for 'anchors.left: GROUP LEFT;'.
               anchors.left: GROUP;
               color: "#f00";
               min: 50 50;
            }
         }
         // A blue (#00f) rectangle placed to the bottom-right of "rect1".
         rect { "rect2";
            desc {
               anchors.top: "rect1" BOTTOM;
               anchors.left: "rect1" RIGHT;
               color: "#00f";
               min: 50 50;
            }
         }
         // A green (#0f0) rectangle positioned relative to "rect2".
         rect { "rect3";
            desc {
               // Aligns its left side with "rect2"'s left side ('rect2' LEFT).
               anchors.left: "rect2";
               // Fills the vertical space of "rect2", matching its height and vertical position.
               anchors.fill: "rect2" VERTICAL;
               // Adds a 20px margin on the left.
               anchors.margin: 20 0 0 0;
               color: "#0f0";
               min: 100 0;
            }
         }
         // A transparent rectangle that fills the area from "rect3" to the
         // bottom-right of the group, with margins.
         rect { "rect4";
            desc {
               // The anchors block provides a convenient way to set multiple anchors at once.
               anchors {
                  top: "rect3";
                  left: "rect3";
                  right: GROUP;
                  bottom: GROUP;
                  // Sets margins: 0 top, 10 right, 0 bottom, 50 left.
                  margin: 0 10 0 50;
               }
            }
         }
         // A black (#000) rectangle centered vertically inside "rect4".
         rect { "rect5";
            desc {
               anchors.vertical_center: "rect4";
               // Fills the horizontal space of "rect4", matching its width and horizontal position.
               anchors.fill: "rect4" HORIZONTAL;
               min: 0 50;
               color: "#000";
            }
         }
         // A yellow (#ff0) rectangle positioned relative to "rect5".
         rect { "rect6";
            desc {
               // Aligns its right edge with the horizontal center of "rect5".
               anchors.right: "rect5" HORIZONTAL_CENTER;
               // Matches the height and vertical position of "rect5".
               anchors.fill: "rect5" VERTICAL;
               min: 30 0;
               color: "#ff0";
            }
         }
      }
   }
}
