efl_version: 1 22;

collections {

   styles {
      // Defines a reusable style for text entries.
      // This ensures consistency across different textblock parts.
      style {
         name: "entry_style";
         base: "font="sans" font_size=10 color=#000 wrap="word" left_margin=2 right_margin=2";
      }
   }

   // This is the main group for the multiseat example UI.
   // It demonstrates how different input devices (seats) can interact with
   // UI elements independently.
   group {
      name: "example/main";
      min: 400 400;

      parts {
         // A basic rectangle for the background of the window.
         part {
            name: "bg";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
            }
         }

         // A simple title for the example window.
         part {
            name: "title";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: #000000FF
               color: 0 0 0 255;
               rel1 {
                  relative: 0.0 0.0;
                  offset: 0 0;
                  to: "bg";
               }
               rel2 {
                  relative: 1.0 0.2;
                  offset: -1 -1;
                  to: "bg";
               }
               text {
                  text: "Multiseat Example";
                  size: 16;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         // This is a container that defines the boundaries for the draggable knob.
         // It is a black vertical line where the knob can be moved.
         part {
            name: "drag_area1";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: #000000FF
               color: 0 0 0 255;
               rel1 {
                  relative: 0.1 0.25;
                  offset: -5 0;
               }
               rel2 {
                  relative: 0.1 0.9;
                  offset: 4 0;
               }
            }
         }

         // This is a draggable knob. Its movement is confined to "drag_area1".
         // The 'dragable' property confines movement along the y-axis within 'drag_area1'.
         // It changes color to indicate which seat is currently dragging it.
         part {
            name: "example/knob1";
            type: RECT;
            mouse_events: 1;
            dragable {
               confine: "drag_area1";
               x: 0 0 0;
               y: 1 1 0;
            }
            description {
               state: "default" 0.0;
               min: 10 10;
               // color: #C8C8C8FF
               color: 200 200 200 255;
            }
            // State when dragged by seat1.
            description {
               state: "focused,s1" 0.0;
               inherit: "default" 0.0;
               // color: #C80000FF (Red)
               color: 200 0 0 255;
            }
            // State when dragged by seat2.
            description {
               state: "focused,s2" 0.0;
               inherit: "default" 0.0;
               // color: #00C800FF (Green)
               color: 0 200 0 255;
            }
         }

         // A second drag area and knob, demonstrating that multiple draggable
         // elements can be handled independently.
         part {
            name: "drag_area2";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               color: 0 0 0 255;
               rel1 {
                  relative: 0.2 0.25;
                  offset: -5 0;
               }
               rel2 {
                  relative: 0.2 0.9;
                  offset: 4 0;
               }
            }
         }

         part {
            name: "example/knob2";
            type: RECT;
            mouse_events: 1;
            dragable {
               confine: "drag_area2";
               x: 0 0 0;
               y: 1 1 0;
            }
            description {
               state: "default" 0.0;
               min: 10 10;
               // color: #C8C8C8FF
               color: 200 200 200 255;
            }
            description {
               state: "focused,s1" 0.0;
               inherit: "default" 0.0;
               // color: #C80000FF (Red)
               color: 200 0 0 255;
            }
            description {
               state: "focused,s2" 0.0;
               inherit: "default" 0.0;
               // color: #00C800FF (Green)
               color: 0 200 0 255;
            }
         }

         // This is the background for the first text entry.
         // It changes color to indicate which seat has focus on the text entry.
         part {
            name: "bg_text1";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               min: 10 50;
               rel1.relative: 0.3 0.25;
               rel2.relative: 0.9 0.4;
               // color: #C8C8C8FF
               color: 200 200 200 255;
            }
            // When focused by seat1, the background becomes red.
            description {
               state: "focused,s1" 0.0;
               inherit: "default" 0.0;
               // color: #C80000FF
               color: 200 0 0 255;
            }
            // When focused by seat2, the background becomes green.
            description {
               state: "focused,s2" 0.0;
               inherit: "default" 0.0;
               // color: #00C800FF
               color: 0 200 0 255;
            }
         }

         // An editable textblock. It is positioned inside "bg_text1".
         // 'source' and 'source4' are used to theme the selection and cursor,
         // pointing to other groups ("example/selection", "example/cursor") that
         // define their appearance. This is a powerful feature for custom styling.
         part {
            name: "example/text1";
            type: TEXTBLOCK;
            scale: 1;
            entry_mode: EDITABLE;
            select_mode: DEFAULT;
            cursor_mode: UNDER;
            mouse_events: 1;
            multiline: 1;
            source: "example/selection";
            source4: "example/cursor";
            description {
               state: "default" 0.0;
               min: 12 50;
               rel1 {
                  to: "bg_text1";
                  offset: 2 2;
               }
               rel2 {
                  to: "bg_text1";
                  offset: -3 -3;
               }
               text {
                  style: "entry_style";
                  min: 0 1;
                  align: 0.0 0.0;
               }
            }
         }

         // The background for the second text entry field.
         part {
            name: "bg_text2";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               min: 10 50;
               rel1.relative: 0.3 0.45;
               rel2.relative: 0.9 0.6;
               // color: #C8C8C8FF
               color: 200 200 200 255;
            }
            description {
               state: "focused,s1" 0.0;
               inherit: "default" 0.0;
               // color: #C80000FF
               color: 200 0 0 255;
            }
            description {
               state: "focused,s2" 0.0;
               inherit: "default" 0.0;
               // color: #00C800FF
               color: 0 200 0 255;
            }
         }

         // The second editable textblock.
         part {
            name: "example/text2";
            type: TEXTBLOCK;
            scale: 1;
            entry_mode: EDITABLE;
            select_mode: DEFAULT;
            cursor_mode: UNDER;
            mouse_events: 1;
            multiline: 1;
            source: "example/selection";
            source4: "example/cursor";
            description {
               state: "default" 0.0;
               min: 12 50;
               rel1 {
                  to: "bg_text2";
                  offset: 2 2;
               }
               rel2 {
                  to: "bg_text2";
                  offset: -3 -3;
               }
               text {
                  style: "entry_style";
                  min: 0 1;
                  align: 0.0 0.0;
               }
            }
         }

         // A large clickable area that acts as a button. It demonstrates how
         // different regions can react to mouse_over and focus from multiple seats.
         part {
            name: "button_bg";
            type: RECT;
            mouse_events: 1;
            description {
               state: "default" 0.0;
               rel1.relative: 0.45 0.65;
               rel2.relative: 0.9 0.9;
               // color: #C8C8C8FF
               color: 200 200 200 255;
            }
         }

         // An invisible rectangle defining the inner area of the button where
         // feedback indicators will be displayed.
         part {
            name: "button_area";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               rel1 {
                  to: "button_bg";
                  offset: 10 10;
               }
               rel2 {
                  to: "button_bg";
                  offset: -11 -11;
               }
               color: 0 0 0 0;
            }
         }

         // Visual indicator for mouse-over from seat1.
         // It's a semi-transparent red rectangle (#FF000064) that becomes
         // fully opaque (#FF0000FF) on mouse-over.
         part {
            name: "button_left_over";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               rel1 {
                  to: "button_area";
                  relative: 0.0 0.0;
               }
               rel2 {
                  to: "button_area";
                  relative: 0.5 0.5;
               }
               color: 255 0 0 100;
            }
            description {
               state: "on" 0.0;
               inherit: "default" 0.0;
               color: 255 0 0 255;
            }
         }

         part {
            name: "button_left_over_label";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               color: 0 0 0 255;
               rel1.to: "button_left_over";
               rel2.to: "button_left_over";
               text {
                  text: "Seat 1 over";
                  size: 10;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         // Visual indicator for focus from seat1.
         // This also becomes fully opaque red when the button is focused by seat1.
         part {
            name: "button_left_focus";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               rel1 {
                  to: "button_area";
                  relative: 0.0 0.5;
               }
               rel2 {
                  to: "button_area";
                  relative: 0.5 1.0;
               }
               color: 255 0 0 100;
            }
            description {
               state: "on" 0.0;
               inherit: "default" 0.0;
               color: 255 0 0 255;
            }
         }

         part {
            name: "button_left_focus_label";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               color: 0 0 0 255;
               rel1.to: "button_left_focus";
               rel2.to: "button_left_focus";
               text {
                  text: "Seat 1 focus";
                  size: 10;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         // Visual indicator for mouse-over from seat2, colored green.
         part {
            name: "button_right_over";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               rel1 {
                  to: "button_area";
                  relative: 0.5 0.0;
               }
               rel2 {
                  to: "button_area";
                  relative: 1.0 0.5;
               }
               color: 0 255 0 100;
            }
            description {
               state: "on" 0.0;
               inherit: "default" 0.0;
               color: 0 255 0 255;
            }
         }

         part {
            name: "button_right_over_label";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               color: 0 0 0 255;
               rel1.to: "button_right_over";
               rel2.to: "button_right_over";
               text {
                  text: "Seat 2 over";
                  size: 10;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         // Visual indicator for focus from seat2, colored green.
         part {
            name: "button_right_focus";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               rel1 {
                  to: "button_area";
                  relative: 0.5 0.5;
               }
               rel2 {
                  to: "button_area";
                  relative: 1.0 1.0;
               }
               color: 0 255 0 100;
            }
            description {
               state: "on" 0.0;
               inherit: "default" 0.0;
               color: 0 255 0 255;
            }
         }

         part {
            name: "button_right_focus_label";
            type: TEXT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               color: 0 0 0 255;
               rel1.to: "button_right_focus";
               rel2.to: "button_right_focus";
               text {
                  text: "Seat 2 focus";
                  size: 10;
                  font: "sans";
                  min: 1 1;
               }
            }
         }

         // An invisible, clickable area that covers the whole window.
         // Clicking it removes focus from any focused object for a given seat.
         part {
            name: "unfocus_area";
            type: RECT;
            mouse_events: 1;
            repeat_events: 1;
            description {
               state: "default" 0.0;
               color: 255 255 255 0;
            }
         }

         // A SWALLOW part acts as a container for an external Evas object.
         // This allows native C code to inject widgets into the Edje layout.
         part {
            name: "example/swallow";
            type: SWALLOW;
            mouse_events: 1;
            description {
               state: "default" 0.0;
               rel1.relative: 0.3 0.65;
               rel2.relative: 0.4 0.9;
            }
         }
      }

      programs {
         // On load, set the initial focus for "seat1" to the first text entry.
         program {
            name: "focus";
            signal: "load";
            source: "";
            action: FOCUS_SET "seat1";
            target: "example/text1";
         }

         // --- Text Entry Focus Logic ---
         // When text1 is clicked by seat1, it gains focus for seat1.
         program {
            name: "focus,t1,s1";
            signal: "seat,seat1,mouse,clicked,1";
            source: "example/text1";
            action: FOCUS_SET "seat1";
            target: "example/text1";
         }

         // When text1 gains focus from seat1, its background ("bg_text1")
         // changes to the "focused,s1" state (red).
         program {
            name: "focus,color,t1,s1";
            signal: "seat,seat1,focus,part,in";
            source: "example/text1";
            action: STATE_SET "focused,s1" 0.0;
            target: "bg_text1";
         }

         // When text1 loses focus from seat1, its background reverts to default.
         program {
            name: "unfocus,color,t1,s1";
            signal: "seat,seat1,focus,part,out";
            source: "example/text1";
            action: STATE_SET "default" 0.0;
            target: "bg_text1";
         }

         // The following programs repeat the focus logic for text2 and for both seats.

         program {
            name: "focus,t2,s1";
            signal: "seat,seat1,mouse,clicked,1";
            source: "example/text2";
            action: FOCUS_SET "seat1";
            target: "example/text2";
         }

         program {
            name: "focus,color,t2,s1";
            signal: "seat,seat1,focus,part,in";
            source: "example/text2";
            action: STATE_SET "focused,s1" 0.0;
            target: "bg_text2";
         }

         program {
            name: "unfocus,color,t2,s1";
            signal: "seat,seat1,focus,part,out";
            source: "example/text2";
            action: STATE_SET "default" 0.0;
            target: "bg_text2";
         }

         program {
            name: "focus,t1,s2";
            signal: "seat,seat2,mouse,clicked,1";
            source: "example/text1";
            action: FOCUS_SET "seat2";
            target: "example/text1";
         }

         program {
            name: "focus,color,t1,s2";
            signal: "seat,seat2,focus,part,in";
            source: "example/text1";
            action: STATE_SET "focused,s2" 0.0;
            target: "bg_text1";
         }

         program {
            name: "unfocus,color,t1,s2";
            signal: "seat,seat2,focus,part,out";
            source: "example/text1";
            action: STATE_SET "default" 0.0;
            target: "bg_text1";
         }

         program {
            name: "focus,t2,s2";
            signal: "seat,seat2,mouse,clicked,1";
            source: "example/text2";
            action: FOCUS_SET "seat2";
            target: "example/text2";
         }

         program {
            name: "focus,color,t2,s2";
            signal: "seat,seat2,focus,part,in";
            source: "example/text2";
            action: STATE_SET "focused,s2" 0.0;
            target: "bg_text2";
         }

         program {
            name: "unfocus,color,t2,s2";
            signal: "seat,seat2,focus,part,out";
            source: "example/text2";
            action: STATE_SET "default" 0.0;
            target: "bg_text2";
         }

         // --- Button Interaction Logic for Seat 1 (Left Indicators) ---

         // When seat1's cursor enters the button, show the "over" state for the left indicator.
         program {
            name: "button,left,in";
            signal: "seat,seat1,mouse,in";
            source: "button_bg";
            action: STATE_SET "on" 0.0;
            target: "button_left_over";
         }

         // When seat1's cursor leaves, revert the "over" state.
         program {
            name: "button,left,out";
            signal: "seat,seat1,mouse,out";
            source: "button_bg";
            action: STATE_SET "default" 0.0;
            target: "button_left_over";
         }

         // When clicked by seat1, the button itself gets focus for seat1.
         program {
            name: "button,left,focus";
            signal: "seat,seat1,mouse,clicked,1";
            source: "button_bg";
            action: FOCUS_SET "seat1";
            target: "button_bg";
         }

         // When the button gains focus from seat1, show the "focus" state for the left indicator.
         program {
            name: "button,left,focused";
            signal: "seat,seat1,focus,part,in";
            source: "button_bg";
            action: STATE_SET "on" 0.0;
            target: "button_left_focus";
         }

         // When focus from seat1 is lost, revert the "focus" state.
         program {
            name: "button,left,unfocused";
            signal: "seat,seat1,focus,part,out";
            source: "button_bg";
            action: STATE_SET "default" 0.0;
            target: "button_left_focus";
         }

         // --- Button Interaction Logic for Seat 2 (Right Indicators) ---
         program {
            name: "button,right,in";
            signal: "seat,seat2,mouse,in";
            source: "button_bg";
            action: STATE_SET "on" 0.0;
            target: "button_right_over";
         }

         program {
            name: "button,right,out";
            signal: "seat,seat2,mouse,out";
            source: "button_bg";
            action: STATE_SET "default" 0.0;
            target: "button_right_over";
         }

         program {
            name: "button,right,focus";
            signal: "seat,seat2,mouse,clicked,1";
            source: "button_bg";
            action: FOCUS_SET "seat2";
            target: "button_bg";
         }

         program {
            name: "button,right,focused";
            signal: "seat,seat2,focus,part,in";
            source: "button_bg";
            action: STATE_SET "on" 0.0;
            target: "button_right_focus";
         }

         program {
            name: "button,right,unfocused";
            signal: "seat,seat2,focus,part,out";
            source: "button_bg";
            action: STATE_SET "default" 0.0;
            target: "button_right_focus";
         }

         // --- Knob Drag Logic ---
         // When knob1 is dragged by seat1, it changes to its "focused,s1" state (red).
         program {
            name: "knob1,s1";
            signal: "seat,seat1,drag,start";
            source: "example/knob1";
            action: STATE_SET "focused,s1" 0.0;
            target: "example/knob1";
         }

         // When knob1 is dragged by seat2, it changes to its "focused,s2" state (green).
         program {
            name: "knob1,s2";
            signal: "seat,seat2,drag,start";
            source: "example/knob1";
            action: STATE_SET "focused,s2" 0.0;
            target: "example/knob1";
         }

         // When dragging stops (by any seat, hence the '*' wildcard),
         // the knob reverts to its default state.
         program {
            name: "knob1,seat1";
            signal: "seat,*,drag,stop";
            source: "example/knob1";
            action: STATE_SET "default" 0.0;
            target: "example/knob1";
         }

         // The logic is repeated for the second knob.

         program {
            name: "knob2,s1";
            signal: "seat,seat1,drag,start";
            source: "example/knob2";
            action: STATE_SET "focused,s1" 0.0;
            target: "example/knob2";
         }

         program {
            name: "knob2,s2";
            signal: "seat,seat2,drag,start";
            source: "example/knob2";
            action: STATE_SET "focused,s2" 0.0;
            target: "example/knob2";
         }

         program {
            name: "knob2,seat1";
            signal: "seat,*,drag,stop";
            source: "example/knob2";
            action: STATE_SET "default" 0.0;
            target: "example/knob2";
         }

         // --- Swallowed Object Focus Logic ---
         // When the swallow part is clicked by seat1, focus is given to the
         // object contained within it for seat1.
         program {
            name: "rect,focus,s1";
            signal: "seat,seat1,mouse,clicked,1";
            source: "example/swallow";
            action: FOCUS_OBJECT "seat1";
            target: "example/swallow";
         }

         // When the unfocus area is clicked by seat1, it unfocuses the object.
         program {
            name: "rect,unfocus,s1";
            signal: "seat,seat1,mouse,clicked,1";
            source: "unfocus_area";
            // The target is intentionally omitted. This special syntax means
            // "unfocus whatever object has focus" for the given seat.
            action: FOCUS_OBJECT "seat1";
         }

         program {
            name: "rect,focus,s2";
            signal: "seat,seat2,mouse,clicked,1";
            source: "example/swallow";
            action: FOCUS_OBJECT "seat2";
            target: "example/swallow";
         }

         program {
            name: "rect,unfocus,s2";
            signal: "seat,seat2,mouse,clicked,1";
            source: "unfocus_area";
            action: FOCUS_OBJECT "seat2";
         }
      }
   }

   // This group defines the visual appearance of text selection.
   // It's referenced by the 'source' property of the TEXTBLOCK parts.
   group {
      name: "example/selection";

      parts {
         part {
            name: "selection";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               // color: #B4B4B4FF
               color: 180 180 180 255;
            }
         }
      }
   }

   // This group defines the appearance and animation of the text cursor.
   // It's referenced by the 'source4' property of the TEXTBLOCK parts.
   group {
      name: "example/cursor";
      min: 1 0;

      parts {
         part {
            name: "cursor";
            type: RECT;
            mouse_events: 0;
            description {
               state: "default" 0.0;
               min: 2 12;
               // color: #000000FF
               color: 0 0 0 255;
            }
            description {
               state: "hidden" 0.0;
               inherit: "default" 0.0;
               color: 0 0 0 0;
            }
         }
      }

      programs {
         // This set of programs creates a blinking cursor animation.
         // It works like a state machine, using 'after' to chain programs with delays.

         // 1. On load, "cursor_hide" starts, fading out the cursor over 0.2s.
         program {
            name: "cursor_hide";
            signal: "load";
            source: "";
            action: STATE_SET "hidden" 0.0;
            target: "cursor";
            transition: SINUSOIDAL 0.2;
            after: "cursor_hide_timer";
         }
         // 2. After the transition ends, "cursor_hide_timer" does nothing but
         //    wait for 0.2s then trigger "cursor_show".
         program {
            name: "cursor_hide_timer";
            in: 0.2 0.0;
            after: "cursor_show";
         }
         // 3. "cursor_show" makes the cursor visible again.
         program {
            name: "cursor_show";
            action: STATE_SET "default" 0.0;
            target: "cursor";
            after: "cursor_show_timer";
         }
         // 4. "cursor_show_timer" waits for 0.5s (the 'on' duration) and then
         //    triggers "cursor_hide", restarting the cycle.
         program {
            name: "cursor_show_timer";
            in: 0.5 0.0;
            after: "cursor_hide";
         }
      }
   }
}
