collections {
   // A group defining a complex animated layout.
   // It includes several image parts, text, and swallow parts for external content.
   // The layout features continuous background animations.
   group { name: "layout";
      // Defines images used in this group, specifying compression methods.
      // COMP (or COMPRESS) is lossless (PNG), while LOSSY is for formats like JPEG.
      // The number after LOSSY (e.g., 80) is the quality level.
      images {
         image: "over.png" COMP;
         image: "under.png" COMP;
         image: "sky.jpg" LOSSY 80;
         image: "clo.png" LOSSY 60;
      }
      parts {
         // A RECT part used as a clipper. Other parts assigned to 'clip_to: "clip"'
         // will be masked by this rectangle's geometry.
         part { name: "clip";
            type: RECT;
            description { state: "default" 0.0;
            }
         }
         // The "sky" image part, which is clipped by the "clip" part.
         // 'mouse_events: 1' allows this part to receive mouse interactions.
         part { name: "sky";
            mouse_events: 1;
            clip_to: "clip";
            description { state: "default" 0.0;
               aspect: 2.6225 2.6225;
               aspect_preference: NONE;
               image.normal: "sky.jpg";
            }
            // The "drift" state is used for animation. It inherits properties from
            // the "default" state and overrides the fill origin. This change in
            // origin creates a horizontal scrolling effect.
            description { state: "drift" 0.0;
               inherit: "default" 0.0;
               fill {
                  origin {
                     relative: 1.0 0.0;
                     offset: 0 0;
                  }
               }
            }
         }
         // The "under" image part. 'mouse_events: 0' makes it ignore mouse input.
         // 'aspect_preference: HORIZONTAL' maintains the image's aspect ratio,
         // fitting it to the part's horizontal space.
         part { name: "under";
            mouse_events: 0;
            clip_to: "clip";
            description { state: "default" 0.0;
               align: 0.5 0.0;
               aspect: 1.486068111 1.486068111;
               aspect_preference: HORIZONTAL;
               image.normal: "under.png";
            }
         }
         // A TEXT part to display static text.
         part { name: "text";
            type: TEXT;
            clip_to: "clip";
            description { state: "default" 0.0;
               // Color is yellow with full alpha (#FFFF00FF).
               color: 255 255 0 255;
               rel1.relative: 0.3 0.02;
               rel2.relative: 0.6 0.12;
               align: 0.5 0.5;
               text {
                  font: "Sans:style=Bold";
                  size: 14;
                  min: 1 1;
                  ellipsis: -1;
                  text: "some edje text here";
               }
            }
         }
         // A SWALLOW part, which acts as a container for an external Evas object.
         // This is a powerful feature for embedding custom widgets or other complex
         // UI components into an Edje layout.
         part { name: "element1";
            type: SWALLOW;
            clip_to: "clip";
            description { state: "default" 0.0;
               rel1.relative: 0.2 0.2;
               rel2.relative: 0.4 0.3;
            }
         }
         part { name: "element2";
            type: SWALLOW;
            clip_to: "clip";
            description { state: "default" 0.0;
               rel1.relative: 0.6 0.3;
               rel2.relative: 0.9 0.5;
            }
         }
         part { name: "element3";
            type: SWALLOW;
            clip_to: "clip";
            description { state: "default" 0.0;
               rel1.relative: 0.1 0.7;
               rel2.relative: 0.9 0.9;
            }
         }
         part { name: "over";
            mouse_events: 0;
            clip_to: "clip";
            description { state: "default" 0.0;
               align: 0.0 1.0;
               aspect: 2.238095238 2.238095238;
               max: 329 147;
               aspect_preference: HORIZONTAL;
               image.normal: "over.png";
            }
         }
         part { name: "clo";
            mouse_events: 0;
            clip_to: "clip";
            description { state: "default" 0.0;
               fill {
                  smooth: 0;
                  origin {
                     relative: 0.0 0.0;
                     offset: 0 0;
                  }
                  size {
                     relative: 1.84722 1.0;
                     offset: 0 0;
                  }
               }
               image.normal: "clo.png";
            }
            description { state: "drift" 0.0;
               inherit: "default" 0.0;
               fill {
                  origin {
                     relative: 1.84722 0.0;
                     offset: 0 0;
                  }
                  size {
                     relative: 1.84722 1.0;
                     offset: 0 0;
                  }
               }
            }
         }
      }
      // Programs define the dynamic behavior of the group.
      programs {
         // This program triggers on the "load" signal (when the object is created).
         // It animates the "clo" part to its "drift" state over 10 seconds.
         // 'after: "anim2"' chains the next program to run after this one completes.
         program { name: "anim1";
            signal: "load";
            source: "";
            action: STATE_SET "drift" 0.0;
            transition: LINEAR 10.0;
            target: "clo";
            after: "anim2";
         }
         // This program animates "clo" back to the "default" state and then
         // triggers "anim1" again, creating an infinite animation loop.
         program { name: "anim2";
            action: STATE_SET "default" 0.0;
            target: "clo";
            after: "anim1";
         }
         // A similar animation loop for the "sky" part, but with a much
         // longer transition time (40 seconds), creating a slow drift effect.
         program { name: "anim3";
            signal: "load";
            source: "";
            action: STATE_SET "drift" 0.0;
            transition: LINEAR 40.0;
            target: "sky";
            after: "anim4";
         }
         program { name: "anim4";
            action: STATE_SET "default" 0.0;
            target: "sky";
            after: "anim3";
         }
      }
   }
   // This group is a variation of the "layout" group, but without the
   // animation programs and with mouse events disabled for the "sky" part.
   // It reuses the same image resources.
   group { name: "layout2";
      images {
         image: "over.png" COMP;
         image: "under.png" COMP;
         image: "sky.jpg" LOSSY 80;
         image: "clo.png" LOSSY 60;
      }
      parts {
         part { name: "clip";
            type: RECT;
            description { state: "default" 0.0;
            }
         }
         part { name: "sky";
            mouse_events: 0;
            clip_to: "clip";
            description { state: "default" 0.0;
               aspect: 2.6225 2.6225;
               aspect_preference: NONE;
               image.normal: "sky.jpg";
            }
            description { state: "drift" 0.0;
               inherit: "default" 0.0;
               fill {
                  origin {
                     relative: 1.0 0.0;
                     offset: 0 0;
                  }
               }
             }
         }
         part { name: "under";
            mouse_events: 0;
            clip_to: "clip";
            description { state: "default" 0.0;
               align: 0.5 0.0;
               aspect: 1.486068111 1.486068111;
               aspect_preference: HORIZONTAL;
               image.normal: "under.png";
            }
         }
         part { name: "text";
            type: TEXT;
            clip_to: "clip";
            description { state: "default" 0.0;
               color: 255 255 0 255;
               rel1.relative: 0.3 0.02;
               rel2.relative: 0.6 0.12;
               align: 0.5 0.5;
               text {
                  font: "Sans:style=Bold";
                  size: 14;
                  min: 1 1;
                  ellipsis: -1;
                  text: "some edje text here";
               }
            }
         }
         part { name: "element1";
            type: SWALLOW;
            clip_to: "clip";
            description { state: "default" 0.0;
               rel1.relative: 0.2 0.2;
               rel2.relative: 0.4 0.3;
            }
         }
         part { name: "element2";
            type: SWALLOW;
            clip_to: "clip";
            description { state: "default" 0.0;
               rel1.relative: 0.6 0.3;
               rel2.relative: 0.9 0.5;
            }
         }
         part { name: "element3";
            type: SWALLOW;
            clip_to: "clip";
            description { state: "default" 0.0;
               rel1.relative: 0.1 0.7;
               rel2.relative: 0.9 0.9;
            }
         }
         part { name: "over";
            mouse_events: 0;
            clip_to: "clip";
            description { state: "default" 0.0;
               align: 0.0 1.0;
               aspect: 2.238095238 2.238095238;
               max: 329 147;
               aspect_preference: HORIZONTAL;
               image.normal: "over.png";
            }
         }
         part { name: "clo";
            mouse_events: 0;
            clip_to: "clip";
            description { state: "default" 0.0;
               fill {
                  smooth: 0;
                  origin {
                     relative: 0.0 0.0;
                     offset: 0 0;
                  }
                  size {
                     relative: 1.84722 1.0;
                     offset: 0 0;
                  }
               }
               image.normal: "clo.png";
            }
            description { state: "drift" 0.0;
               inherit: "default" 0.0;
               fill {
                  origin {
                     relative: 1.84722 0.0;
                     offset: 0 0;
                  }
                  size {
                     relative: 1.84722 1.0;
                     offset: 0 0;
                  }
               }
            }
         }
      }
   }
   // Defines a 4x4 grid layout, likely for a launcher or home screen.
   // Each cell in the grid is a SWALLOW part, intended to hold an application icon or widget.
   // The naming convention "slot.X.Y" corresponds to grid coordinates.
   group { name: "launcher_page";
      parts {
         // This is the top-left cell (0,0) of the grid, occupying the
         // top-left quarter of the layout's space.
         part { name: "slot.0.0"; type: SWALLOW;
            description { state: "default" 0.0;
              rel2.relative: 0.25 0.25;
            }
         }
         part { name: "slot.1.0"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.25 0.0;
              rel2.relative: 0.50 0.25;
            }
         }
         part { name: "slot.2.0"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.50 0.0;
              rel2.relative: 0.75 0.25;
            }
         }
         part { name: "slot.3.0"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.75 0.0;
              rel2.relative: 1.00 0.25;
            }
         }
         part { name: "slot.0.1"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.0  0.25;
              rel2.relative: 0.25 0.50;
            }
         }
         part { name: "slot.1.1"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.25 0.25;
              rel2.relative: 0.50 0.50;
            }
         }
         part { name: "slot.2.1"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.50 0.25;
              rel2.relative: 0.75 0.50;
            }
         }
         part { name: "slot.3.1"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.75 0.25;
              rel2.relative: 1.00 0.50;
            }
         }
         part { name: "slot.0.2"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.0  0.50;
              rel2.relative: 0.25 0.75;
            }
         }
         part { name: "slot.1.2"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.25 0.50;
              rel2.relative: 0.50 0.75;
            }
         }
         part { name: "slot.2.2"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.50 0.50;
              rel2.relative: 0.75 0.75;
            }
         }
         part { name: "slot.3.2"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.75 0.50;
              rel2.relative: 1.00 0.75;
            }
         }
         part { name: "slot.0.3"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.0  0.75;
              rel2.relative: 0.25 1.00;
            }
         }
         part { name: "slot.1.3"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.25 0.75;
              rel2.relative: 0.50 1.00;
            }
         }
         part { name: "slot.2.3"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.50 0.75;
              rel2.relative: 0.75 1.00;
            }
         }
         part { name: "slot.3.3"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.75 0.75;
              // rel2 is not specified, so it defaults to 1.0 1.0, making the part
              // fill the bottom-right quadrant of the layout.
            }
         }
      }
   }
   // This group defines the appearance and behavior of a single launcher icon.
   // It consists of a SWALLOW part for the icon image and a TEXT part for its label.
   // It includes multiple states and programs to handle user interactions like
   // clicks and drags, providing visual feedback.
   group { name: "launcher_icon";
      parts {
         // The SWALLOW part for the icon itself.
         part { name: "slot"; type: SWALLOW;
            description { state: "default" 0.0;
              // The bottom of the slot is aligned with the top of the "label" part.
              // This positions the icon directly above its text label.
              rel2 {
                relative: 1.00 0.00;
                to_y: "label";
              }
            }
            description { state: "drag1" 0.0;
              inherit: "default" 0.0;
              rel1.offset: -5 -3;
              rel2.offset: -5 -3;
            }
            // These states are used in a looping animation to give a "wiggling"
            // effect when the icon is being dragged.
            description { state: "drag2" 0.0;
              inherit: "default" 0.0;
              rel1.offset: 10 3;
              rel2.offset: 10 3;
            }
            description { state: "drag3" 0.0;
              inherit: "default" 0.0;
              rel1.offset: -1  6;
              rel2.offset: -1  6;
            }
         }
         // The text label for the icon.
         part { name: "label"; type: TEXT;
            effect: SOFT_SHADOW;
            scale: 1;
            description { state: "default" 0.0;
              fixed: 1 1;
              align: 0.5 1.0;
              rel1.relative: 0.0  1.00;
              color: 224 224 224 255;
              color3: 0 0 0 64;
              text {
                font: "Sans:style=Bold,Edje-Vera-Bold";
                size: 10;
                min: 0 1;
                max: 1 1;
                align: 0.5 0.0;
              }
            }
            description { state: "hi" 0.0;
              inherit: "default" 0.0;
              color: 255 0 0 255;
              color3: 0 0 0 255;
            }
            description { state: "drag1" 0.0;
              inherit: "default" 0.0;
              color: 255 0 0 255;
              color3: 0 0 0 255;
              rel1.offset: -5 -3;
              rel2.offset: -5 -3;
            }
            description { state: "drag2" 0.0;
              inherit: "default" 0.0;
              color: 255 0 0 255;
              color3: 0 0 0 255;
              rel1.offset: 10 3;
              rel2.offset: 10 3;
            }
            description { state: "drag3" 0.0;
              inherit: "default" 0.0;
              color: 255 0 0 255;
              color3: 0 0 0 255;
              rel1.offset: -1  6;
              rel2.offset: -1  6;
            }
         }
      }
      programs {
         // When a "click" signal is received from the "app" source,
         // the "label" part transitions to the "hi" state (red text) over 0.5s.
         program { name: "click";
            signal: "click"; source: "app";
            action: STATE_SET "hi" 0.0;
            transition: LINEAR 0.5;
            target: "label";
         }
         // When a "drag" signal is received, this program starts a looping
         // animation sequence (drag1 -> drag2 -> drag3 -> drag1...).
         // This creates a visual effect while the icon is being dragged.
         // Both the "label" and "slot" parts are targeted.
         program { name: "drag1";
            signal: "drag"; source: "app";
            action: STATE_SET "drag1" 0.0;
            transition: LINEAR 0.1;
            target: "label";
            target: "slot";
            after: "drag2";
         }
         program { name: "drag2";
            action: STATE_SET "drag2" 0.0;
            transition: LINEAR 0.2;
            target: "label";
            target: "slot";
            after: "drag3";
         }
         program { name: "drag3";
            action: STATE_SET "drag3" 0.0;
            transition: LINEAR 0.1;
            target: "label";
            target: "slot";
            after: "drag1";
         }
         // When the drag is finished ("drop" signal), everything returns to the "default" state.
         program { name: "drop";
            signal: "drop"; source: "app";
            action: STATE_SET "default" 0.0;
            target: "label";
            target: "slot";
         }
         // When the click is released ("unclick" signal), the label animates back to default.
         program { name: "unclick";
            signal: "unclick"; source: "app";
            action: STATE_SET "default" 0.0;
            transition: LINEAR 0.5;
            target: "label";
            target: "slot";
         }
         // If the drag is cancelled, everything returns to the default state.
         program { name: "cancel";
            signal: "cancel"; source: "app";
            action: STATE_SET "default" 0.0;
            transition: LINEAR 0.5;
            target: "label";
            target: "slot";
         }
      }
   }
   // A simple layout for displaying two lines of content.
   group { name: "twolines";
      parts {
         // A clipper to contain the parts.
         part { name: "clip";
            type: RECT;
            description { state: "default" 0.0;
            }
         }
         // A semi-transparent background rectangle (color #0080C81E).
         part { name: "under";
            mouse_events: 0;
            clip_to: "clip";
            type: RECT;
            description { state: "default" 0.0;
               color: 0 128 200 30;
            }
         }
         // A SWALLOW part for the top line of content.
         part { name: "element1";
            type: SWALLOW;
            clip_to: "clip";
            description { state: "default" 0.0;
               rel1 {
                  relative: 0.0 0.0;
                  offset: 4 4;
               }
               rel2 {
                  relative: 1.0 0.5;
                  offset: -5 -3;
               }
            }
         }
         part { name: "element2";
            type: SWALLOW;
            clip_to: "clip";
            description { state: "default" 0.0;
               rel1 {
                  relative: 0.0 0.5;
                  offset: 4 2;
               }
               rel2 {
                  relative: 1.0 1.0;
                  offset: -5 -5;
               }
            }
         }
      }
   }

   // This group defines a background overlay with a horizontally scrolling image.
   // The animation logic is identical to the "clo" animation in the "layout" group,
   // creating a continuous loop.
   group { name: "bg_overlay";
      images {
          image: "clo.png" LOSSY 60;
      }
      parts {
         part { name: "clip";
            type: RECT;
            description { state: "default" 0.0;
            }
         }
         part { name: "clo";
            mouse_events: 0;
            clip_to: "clip";
            description { state: "default" 0.0;
               fill {
                  smooth: 0;
                  origin {
                     relative: 0.0 0.0;
                     offset: 0 0;
                  }
                  size {
                     relative: 1.84722 1.0;
                     offset: 0 0;
                  }
               }
               image.normal: "clo.png";
            }
            description { state: "drift" 0.0;
               inherit: "default" 0.0;
               fill {
                  origin {
                     relative: 1.84722 0.0;
                     offset: 0 0;
                  }
                  size {
                     relative: 1.84722 1.0;
                     offset: 0 0;
                  }
               }
            }
         }
      }
      programs {
         program { name: "anim1";
            signal: "load";
            source: "";
            action: STATE_SET "drift" 0.0;
            transition: LINEAR 10.0;
            target: "clo";
            after: "anim2";
         }
         program { name: "anim2";
            action: STATE_SET "default" 0.0;
            target: "clo";
            after: "anim1";
         }
      }
   }
   // A test layout with a background image and a content area.
   group {
      name: "test/layout";
      images {
         image: "sky.jpg" LOSSY 80;
      }
      parts {
            // The background part uses "sky.jpg".
            part {
                 name: "bg";
                 description {
                     state: "default" 0.0;
                     // The image is tinted with a semi-transparent white (#FFFFFF64).
                     color: 255 255 255 100;
                     image.normal: "sky.jpg";
                 }
            }
            // A swallow part for content, with an 8-pixel margin.
            part {
                 name: "swallow";
                 type: SWALLOW;
                 description {
                     state: "default" 0.0;
                     rel1.offset: 8 8;
                     rel2.offset: -7 -7;
                 }
            }
      }
   }
   // A group used for window configuration, containing a single SWALLOW part.
   // The minimum size constraint is likely used to enforce a minimum window content size.
   group {
      name: "win_config";
      parts {
           part {
                 name: "swallow";
                 type: SWALLOW;
                 description {
                     state: "default" 0.0;
                     min: 10 150;
                }
            }
      }
   }
   // Defines a 3x3 grid layout for an accessibility interface.
   group { name: "access_page";
      parts {
         // Top-left cell of the 3x3 grid.
         part { name: "slot.0.0"; type: SWALLOW;
            description { state: "default" 0.0;
              rel2.relative: 0.33 0.33;
            }
         }
         part { name: "slot.1.0"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.33 0.0;
              rel2.relative: 0.66 0.33;
            }
         }
         part { name: "slot.2.0"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.66 0.0;
              rel2.relative: 1.0. 0.33;
            }
         }
         part { name: "slot.0.1"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.0  0.33;
              rel2.relative: 0.33 0.66;
            }
         }
         part { name: "slot.1.1"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.33 0.33;
              rel2.relative: 0.66 0.66;
            }
         }
         part { name: "slot.2.1"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.63 0.33;
              rel2.relative: 1.0 0.66;
            }
         }
         part { name: "slot.0.2"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.0  0.66;
              rel2.relative: 0.33 1.0;
            }
         }
         part { name: "slot.1.2"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.33 0.66;
              rel2.relative: 0.66 1.0;
            }
         }
         part { name: "slot.2.2"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.66 0.66;
            }
         }
      }
   }
   // Defines an accessibility icon.
   group { name: "access_icon";
      parts {
         part { name: "slot"; type: SWALLOW;
            description { state: "default" 0.0;
            }
         }
         // This is a transparent rectangle placed exactly over the "slot" part.
         // It can be used as a hit area for mouse events without being visible.
         part { name: "access"; type: RECT;
            description { state: "default" 0.0;
              rel1.to: "slot";
              rel2.to: "slot";
              color: 0 0 0 0; // Transparent color (#00000000)
            }
         }
      }
   }
   // A layout for a color selection page, possibly for accessibility settings.
   // It features four colored rectangles and a central SWALLOW area.
   group { name: "access_color_page";
      parts {
         // A red rectangle (#FF0000FF).
         part { name: "red"; type: RECT;
            description { state: "default" 0.0;
              rel1.relative: 0.1  0.1;
              rel2.relative: 0.35 0.35;
              color: 255 0 0 255;
            }
         }
         part { name: "green"; type: RECT;
            description { state: "default" 0.0;
              rel1.relative: 0.65 0.1;
              rel2.relative: 0.9 0.35;
              color: 0 255 0 255;
            }
         }
         part { name: "blue"; type: RECT;
            description { state: "default" 0.0;
              rel1.relative: 0.1 0.65;
              rel2.relative: 0.35. 0.9;
              color: 0 0 255 255;
            }
         }
         part { name: "black"; type: RECT;
            description { state: "default" 0.0;
              rel1.relative: 0.65  0.65;
              rel2.relative: 0.9 0.9;
              color: 0 0 0 255;
            }
         }
         part { name: "center"; type: SWALLOW;
            description { state: "default" 0.0;
              rel1.relative: 0.35 0.35;
              rel2.relative: 0.65 0.65;
            }
         }
      }
   }
   // A complex page layout with multiple SWALLOW parts.
   // 'scale: 1' enables scaling for all parts in this group.
   group { name: "page_layout";
      parts {
         // The main background part. 'min' and 'max' are set to the same values,
         // effectively fixing the size of this part at 400x500 pixels.
         // It serves as an anchor for other parts in the layout.
         part { name: "bg";
            type: RECT;
            scale: 1;
            description { state: "default" 0.0;
              min: 400 500;
              max: 400 500;
              color: 0 0 0 0;
           }
         }
         // The main content area, positioned relative to the "bg" part with a 10% margin.
         part { name: "page";
            type: SWALLOW;
            scale: 1;
            description { state: "default" 0.0;
              rel1.relative: 0.1 0.1;
              rel1.to:"bg";
              rel2.relative: 0.9 0.9;
              rel2.to:"bg";
            }
         }
         part { name: "text";
            type: TEXT;
            scale: 1;
            description { state: "default" 0.0;
              fixed: 1 1;
              rel1.relative: 0.5 0.5;
              rel2.relative: 0.5 0.5;
              text {
                 min: 1 1;
                 size: 50;
                 ellipsis: -1;
              }
            }
         }
         part { name: "element1";
            type: SWALLOW;
            scale: 1;
            description { state: "default" 0.0;
              rel1.relative: 0.4 0.2;
              rel1.to:"bg";
              rel2.relative: 0.6 0.4;
              rel2.to:"bg";
            }
         }
         part { name: "element2";
            type: SWALLOW;
            scale: 1;
            description { state: "default" 0.0;
              rel1.relative: 0.4 0.6;
              rel1.to:"bg";
              rel2.relative: 0.6 0.7;
              rel2.to:"bg";
            }
         }
         part { name: "element3";
            type: SWALLOW;
            scale: 1;
            description { state: "default" 0.0;
              rel1.relative: 0.4 0.7;
              rel1.to:"bg";
              rel2.relative: 0.6 0.8;
              rel2.to:"bg";
            }
         }
      }
   }
   // This group demonstrates shorthand syntax and advanced features.
   // 'group "name"' is equivalent to 'group { name: "name"; ... }'.
   group { "layout_edje";
      parts {
         // 'rect' is a shorthand for 'part { type: RECT; ... }'.
         // 'desc' is a shorthand for 'description { ... }'.
         rect { "red";
            desc {
               // 'color_class' allows styling parts from a central theme definition,
               // promoting consistency and making theming easier.
               color_class: "red";
            }
         }
         rect { "blue";
            desc { "default";
            }
            desc { "changed";
               color: 0 0 255 255; // Blue color (#0000FFFF)
               // 'link.base' is an advanced feature for parameterization. It allows properties
               // of this description to be modified externally at runtime, which is useful
               // for creating dynamic and reusable components.
               link.base: "change" "test";
            }
         }
      }
   }
   // This group demonstrates the use of styles for text formatting.
   group { name: "font_overlay_layout";
      // Styles allow defining reusable sets of properties. This is highly
      // recommended for maintaining a consistent look and feel.
      styles {
         style { name: "test_class_style";
            base: "font=Sans font_size=20 color=#fff text_class=font_overlay_test wrap=mixed";
         }
      }
      parts {
         part { name: "bg";
            type: RECT;
            scale: 1;
            description { state: "default" 0.0;
               min: 400 300;
               color: 0 0 0 0;
            }
         }
         // This TEXTBLOCK part uses the defined style. TEXTBLOCK is a powerful part
         // that supports rich text features like markup, wrapping, and styles.
         part { name: "elm.text";
            type: TEXTBLOCK;
            scale: 1;
            description { state: "default" 0.0;
               fixed: 1 1;
               text {
                  style: "test_class_style";
               }
            }
         }
      }
   }
   // A test layout featuring a very large background part and a small SWALLOW part.
   // This could be used for testing performance with large surfaces or scaling behavior.
   group { name: "layout3";
      parts {
         part { name: "bg";
            type: RECT;
            scale: 1;
            description { state: "default" 0.0;
               min: 4000 4000;
               color: 0 255 0 100; // Semi-transparent green (#00FF0064)
            }
         }
         part { name: "swallow";
            type: SWALLOW;
            scale: 1;
            description { state: "default" 0.0;
               min: 100 100;
               rel1.relative: 0.3 0.3;
               rel2.relative: 0.325 0.325;
            }
         }
      }
   }
   // This group demonstrates how to overlay one part on top of another.
   group { name: "image_align";
      parts {
         // This red rectangle is positioned to exactly cover the "swallow" part.
         // This is a common technique for creating visual overlays, highlights, or debug rectangles.
         part { name: "color";
            type: RECT;
            description { state: "default" 0.0;
               rel1.to: "swallow";
               rel2.to: "swallow";
               color: 255 0 0 50; // Semi-transparent red (#FF000032)
            }
         }
         part { name: "swallow";
            type: SWALLOW;
            description { state: "default" 0.0;
               rel1.relative: 0.1 0.1;
               rel2.relative: 0.9 0.9;
            }
         }

      }
   }
   // This group defines the content layout for a scrollable popup.
   // It uses shorthand syntax ('rect' for 'part { type: RECT; ... }').
   group { "efl_ui_popup_scroll_content";
      parts {
         rect { "base";
            desc { "default";
               min: 200 200;
               color: 255 0 0 255; // Red (#FF0000FF)
            }
         }
         // A rectangle at the top of the "base" part, possibly a header.
         // 'fixed: 0 1' means its height is fixed, but its width is scalable.
         rect { "top";
            desc { "default";
               fixed: 0 1;
               min: 100 20;
               color: 255 255 0 255; // Yellow (#FFFF00FF)
               rel1.to: "base";
               rel2.to: "base";
               rel2.relative: 1.0 0.0;
               align: 0.5 0;
            }
         }
         rect { "bottom";
            desc { "default";
              fixed: 0 1;
              min: 100 20;
              color: 255 255 0 255;
              rel1.to: "base";
              rel2.to: "base";
              rel1.relative: 0.0 1.0;
              align: 0.5 1.0;
           }
         }
      }
   }
   // A layout for a popup with multiple anchor points, which are SWALLOW parts.
   // This could be used for tooltips or popups that need to be positioned
   // relative to specific points in the UI.
   group { "efl_ui_popup_anchor_layout";
      parts {
         // A 'spacer' is an invisible part that takes up no space but can be used
         // as a reference for positioning other parts. Here it acts as a base anchor.
         spacer { "base";
            desc { "default";
            }
         }
         // 'swallow' is a shorthand for 'part { type: SWALLOW; ... }'.
         swallow { "anchor1";
            scale;
            desc { "default";
               rel.to: "base";
               rel1.relative: 0.15 0.25;
               rel2.relative: 0.15 0.25;
               fixed: 1 1;
               min: 50 50;
            }
         }
         swallow { "anchor2";
            scale;
            desc { "default";
               rel.to: "base";
               rel1.relative: 0.75 0.15;
               rel2.relative: 0.75 0.15;
               fixed: 1 1;
               min: 50 50;
            }
         }
         swallow { "anchor3";
            scale;
            desc { "default";
               rel.to: "base";
               rel1.relative: 0.25 0.85;
               rel2.relative: 0.25 0.85;
               fixed: 1 1;
               min: 50 50;
            }
         }
         swallow { "anchor4";
            scale;
            desc { "default";
               rel.to: "base";
               rel1.relative: 0.85 0.75;
               rel2.relative: 0.85 0.75;
               fixed: 1 1;
               min: 50 50;
            }
         }
         swallow { "anchor5";
            scale;
            desc { "default";
               rel.to: "base";
               rel1.relative: 0.45 0.35;
               rel2.relative: 0.45 0.35;
               fixed: 1 1;
               min: 50 50;
            }
         }
         swallow { "anchor6";
            scale;
            desc { "default";
               rel.to: "base";
               rel2.relative: 0.0 0.0;
               rel1.offset: 150 300;
               rel2.offset: 200 350;
               fixed: 1 1;
            }
         }
         swallow { "anchor_none";
            scale;
            desc { "default";
               rel.to: "base";
               rel1.relative: 0.60 0.45;
               rel2.relative: 0.60 0.45;
               fixed: 1 1;
               min: 70 50;
            }
         }
      }
   }
   // A layout designed for testing focus management between different UI components.
   group { "focus_test_6";
      parts {
         // Background for the list area for visual debugging.
         rect { "list_bg";
            description { state: "default";
               color: 200 0 0 100; // Semi-transparent red (#C8000064)
               rel1.to: "list_swallow";
               rel2.to: "list_swallow";
            }
         }
         rect { "box_bg";
            description { state: "default";
               color: 0 200 0 100;
               rel1.to: "box";
               rel2.to: "box";
            }
         }
         // A 'box' part is a container that arranges its children according to a
         // specified layout (e.g., horizontal, vertical).
         box { "box";
            description { state: "default";
               rel1.relative: 0.0 0.0;
               rel2.relative: 1.0 0.1;
               box {
                  layout: "horizontal";
                  padding: 4 4;
                  align: 1.0 0.5;
                  min: 1 0;
               }
            }
         }
         // SWALLOW part for a list widget.
         swallow { "list_swallow";
            description { state: "default";
               rel1.relative: 0.0 0.2;
               rel2.relative: 0.5 1.0;
            }
         }
         swallow { "label_swallow";
            description { state: "default";
               rel1.relative: 0.0 0.1;
               rel2.relative: 1.0 0.2;
            }
         }
      }
   }
}
