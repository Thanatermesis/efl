
collections {
// This group defines the layout for a multibutton entry test widget.
// It consists of two main swallow parts: 'box' at the top and
// 'multibuttonentry' which fills the remaining space. Helper parts are used
// for precise positioning.
group {
   name: "multibuttonentry_test";
   parts{
      // A transparent background rectangle that covers the entire widget area,
      // used for capturing mouse events on empty areas.
      part {
         name: "bg";
         type: RECT;
         mouse_events: 1;
         scale:1;
         description {
            state: "default" 0.0;
            // Transparent color (#00000000).
            color: 0 0 0 0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 1.0;
         }
      }
      // The 'top.left' and 'bottom.right' parts are 1x1 pixel invisible
      // rectangles used as anchors for positioning other elements within the
      // layout. This is a common technique in EDC for creating robust and
      // scalable interfaces.
      part{
         name: "top.left";
         type: RECT;
         scale: 1;
         description {
            state: "default" 0.0;
            min : 0 0;
            fixed: 1 1;
            rel1 { relative: 0.0 0.0;to:bg; }
            rel2 { relative: 0.0 0.0;to:bg; }
            align: 0.0 0.0;
            color: 0 0 0 0;
         }
      }
      part{
         name: "bottom.right";
         type: RECT;
         scale: 1;
         description {
            state: "default" 0.0;
            min : 0 0;
            fixed: 1 1;
            rel1 { relative: 1.0 1.0;to:bg; }
            rel2 { relative: 1.0 1.0;to:bg; }
            align: 1.0 1.0;
            color: 0 0 0 0;
         }
      }
      // This is a decorative background for the 'box' part. It has mouse
      // events disabled and its geometry is tied directly to the 'box' part.
      part {
         name: "bg.box";
         type: RECT;
         mouse_events: 0;
         scale:1;
         description {
            state: "default" 0.0;
            rel1.to: box;
            rel2.to: box;
            // Beige color (#E6DCBCFF).
            color: 230 220 188 255;
         }
      }
      // A SWALLOW part that acts as a container for external content. It's
      // positioned as a bar across the top of the widget, with a fixed height
      // of 5 pixels.
      part {
         name: "box";
         type: SWALLOW;
         mouse_events: 1;
         scale:1;
         description {
            state: "default" 0.0;
            min : 0 5;
            fixed: 0 1;
            // Positioned from the bottom-right of 'top.left' anchor...
            rel1 { relative: 1.0  1.0;to: top.left;}
            // ...to the left of 'bottom.right' and bottom of 'top.left' anchors,
            // effectively spanning the width of the container at the top.
            rel2 { relative: 0.0  1.0;to_x: bottom.right;to_y: top.left;}
            align: 0.0 0.0;
         }
      }
      // A decorative, transparent background for the 'multibuttonentry' part.
      part {
         name: "bg.multibuttonentry";
         type: RECT;
         mouse_events: 0;
         scale:1;
         description {
            state: "default" 0.0;
            rel1.to: multibuttonentry;
            rel2.to: multibuttonentry;
            // Transparent light beige (#F6F5ED00).
            color: 246 245 237 0;
         }
      }
      // The main content area, a SWALLOW part for external UI components. It's
      // positioned to fill the area below the top 'box' part, down to the
      // bottom of the widget.
      part {
         name: "multibuttonentry";
         type: SWALLOW;
         mouse_events: 1;
         scale:1;
         description {
            state: "default" 0.0;
            min : 0 5;
            fixed: 0 1;
            // Positioned to start at the bottom-left of the 'box' part...
            rel1 { relative: 0.0 1.0; to: box; }
            // ...and extend to the top-left of the 'bottom.right' anchor,
            // effectively filling the remaining space.
            rel2 { relative: 0.0 0.0; to:bottom.right; }
            align: 0.0 0.0;
         }
      }
   }
}
}
