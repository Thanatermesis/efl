// This group defines the appearance of the start menu button. It primarily consists
// of an arrow icon that changes direction based on the orientation of the shelf
// where the start module is placed.
group { name: "e/modules/start/main";
   parts {
      // The base rectangle for the arrow, serving as its background.
      // It changes color based on focus, handled by programs below.
      part { name: "arrow_base"; type: RECT;
         description { state: "default" 0.0;
            // Uses a color class for theming, allowing the color to be defined
            // externally in the theme's color definitions.
            color_class: "/fg/normal/gadgets/start";
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            // The color class used when the gadget is focused or selected.
            color_class: "/fg/selected/gadgets/start";
         }
      }
      // This part displays the arrow image itself.
      part { name: "arrow";
         // The arrow is clipped to the 'arrow_base' part, ensuring it
         // does not draw outside the background's boundaries.
         clip_to: "arrow_base";
         description { state: "default" 0.0;
            // By default (e.g., for a bottom shelf), the arrow points up.
            image.normal: "i-arrow-u";
            // The relative positioning creates a margin around the arrow,
            // making it smaller than the 'arrow_base'.
            rel1.relative: (5/40) (5/40);
            rel2.relative: (35/40) (35/40);
         }
         // The following states change the arrow's direction based on shelf orientation,
         // triggered by programs that listen for 'e,state,orientation' signals.
         description { state: "down" 0.0;
            inherit: "default" 0.0;
            image.normal: "i-arrow-d";
         }
         description { state: "left" 0.0;
            inherit: "default" 0.0;
            image.normal: "i-arrow-l";
         }
         description { state: "right" 0.0;
            inherit: "default" 0.0;
            image.normal: "i-arrow-r";
         }
      }
      // This is an invisible rectangle used to capture all input events (like
      // mouse clicks) over the entire gadget area. This is a common technique
      // to provide a reliable, single event source for a complex object.
      part { name: "events"; type: RECT;
         description { state: "default" 0.0;
            // Color is transparent black (RGBA: 0, 0, 0, 0 or #00000000).
            // It has no color class to ensure it remains invisible.
            color: 0 0 0 0; // no cc
         }
      }
   }
   programs {
      // When the gadget receives focus, it changes the state of 'arrow_base'
      // to "active", which typically applies a different color or visual
      // effect to indicate selection.
      program { signal: "e,state,focused"; source: "e";
         action: STATE_SET "active" 0.0;
         target: "arrow_base";
      }
      // When the gadget loses focus, it reverts 'arrow_base' to its
      // "default" state.
      program { signal: "e,state,unfocused"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "arrow_base";
      }
// This macro simplifies the creation of programs that react to shelf
// orientation changes. It generates a program that listens for a specific
// orientation signal from Enlightenment ("e") and sets the state of the "arrow"
// part accordingly. This avoids repeating the same program block for each orientation.
#define ORIENT_SATE(_ORIENT, _STATE) \
      program { \
         signal: "e,state,orientation,"_ORIENT; source: "e"; \
         action: STATE_SET _STATE 0.0; \
         target: "arrow"; \
      }
      // The following macro calls set up programs for all possible shelf orientations.
      // The arrow's state is changed to make it point away from the shelf and
      // towards the center of the screen. For example, a shelf on top of the
      // screen will cause the arrow to point down.
      ORIENT_SATE("top", "down")
      ORIENT_SATE("top_left", "down")
      ORIENT_SATE("top_right", "down")
      // A bottom shelf uses the "default" state, which corresponds to an upward-pointing arrow.
      ORIENT_SATE("bottom", "default")
      ORIENT_SATE("bottom_left", "default")
      ORIENT_SATE("bottom_right", "default")
      ORIENT_SATE("left", "right")
      ORIENT_SATE("left_top", "right")
      ORIENT_SATE("left_bottom", "right")
      ORIENT_SATE("right", "left")
      ORIENT_SATE("right_top", "left")
      ORIENT_SATE("right_bottom", "left")
#undef ORIENT_SATE
   }
}
