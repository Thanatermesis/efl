// This group defines the main splash screen, which appears during application
// startup. It includes a logo, text elements, and a series of animations for
// a smooth fade-in and fade-out effect. The logic is designed to synchronize
// with the application's loading process.
group { name: "e/init/splash";
   // This image set provides multiple versions of the logo for different
   // display sizes, allowing the interface to adapt responsively.
   set { name: "logo_mono";
      image { image: "logo.png" COMP;  size: 601 601 99999 99999; }
      image { image: "logo2.png" COMP; size: 301 301   600   600; }
      image { image: "logo3.png" COMP; size: 151 151   300   300; }
      image { image: "logo4.png" COMP; size:  76  76   150   150; }
      image { image: "logo5.png" COMP; size:  0    0    75    75; }
   }
   // This script block defines variables for state management.
   // These are 'public' so they can be accessed and modified from the C
   // application code to coordinate the splash screen's lifecycle.
   script {
      // is_ready: A flag set to 1 when the splash screen's intro animations
      // have completed. The application can check this before proceeding.
      public is_ready;
      // do_end: A flag set to 1 by the application when it has finished
      // loading and is ready for the splash screen to disappear.
      public do_end;
   }
   parts {
      // A background rectangle that fills the screen. It is clipped by the
      // "fader" part, which allows it to fade out along with all other
      // elements when the splash screen exits.
      part { name: "bg"; type: RECT;
         clip_to: "fader";
         description { state: "default" 0.0;
            color_class: "/bg-dark/normal/init/base";
         }
      }
      // The main logo part, centered on the screen. It's also clipped by
      // "fader" to ensure it fades out correctly.
      part { name: "logo";
         // 'scale: 1' enables smooth scaling of the image.
         scale: 1;
         clip_to: "fader";
         description { state: "default" 0.0;
            image.normal: "logo_mono";
            rel1.relative: 0.5 0.5;
            rel2.relative: 0.5 0.5;
            color_class: "/fg/normal/init/logo";
            // The logo starts as fully transparent white (#FFFFFF00).
            color: 255 255 255 0; // no cc
            // This macro sets the minimum and maximum size of the part,
            // effectively fixing its size.
            FIXED_SIZE(150, 150)
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            // In the "active" state, the logo becomes fully opaque white
            // (#FFFFFFFF), making it visible.
            color: 255 255 255 255; // no cc
         }
      }
      // Title text, positioned above the status text.
      part { name: "e.text.title"; type: TEXT; mouse_events: 0;
         scale: 1;
         clip_to: "fader";
         description { state: "default" 0.0;
            align: 0.5 1.0;
            rel1.relative: 0.05 0.0;
            rel1.offset: 4 -16;
            rel1.to_y: "e.text.status";
            rel2.relative: 0.95 0.0;
            rel2.offset: -5 -16;
            rel2.to_y: "e.text.status";
            color_class: "/fg/normal/init/text/title";
            text { font: FNBD; size: 20;
               text: "Title here";
               min: 0 1;
               text_class: "init_title";
            }
            fixed: 0 1;
         }
      }
      // Status text, displayed below the logo. This is intended to show
      // loading progress messages from the application.
      part { name: "e.text.status"; type: TEXT;
         scale: 1;
         clip_to: "fader";
         description { state: "default" 0.0;
            align: 0.5 1.0;
            rel1.relative: 0.05 0.0;
            rel1.to_y: "logo";
            rel1.offset: 4 -16;
            rel2.relative: 0.95 0.0;
            rel2.offset: -5 -16;
            rel2.to_y: "logo";
            color_class: "/fg/normal/init/text/status";
            text { font: FN; size: 10;
               text: "Status here";
               min: 0 1;
               text_class: "init_status";
            }
            fixed: 0 1;
         }
      }
      // Version text, anchored to the bottom-right of the screen.
      part { name: "e.text.version"; type: TEXT;
         scale: 1;
         clip_to: "fader";
         description { state: "default" 0.0;
            align: 1.0 1.0;
            rel1.relative: 1.0 1.0;
            rel1.offset: -16 -16;
            rel2.relative: 1.0 1.0;
            rel2.offset: -16  -16;
            color_class: "/fg/normal/init/text/version";
            text { font: FN; size: 8;
               text: "0.22.0";
               min: 1 1;
               ellipsis: -1;
               align: 1.0 1.0;
               text_class: "init_version";
            }
            fixed: 1 1;
         }
      }
      // This part is a black rectangle covering the entire screen. It's used
      // to create a fade-from-black effect when the splash screen first appears.
      part { name: "blanker"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            // Starts as fully opaque black (#000000FF).
            color: 0 0 0 255; // no cc
            visible: 1;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            // Transitions to transparent black (#00000000).
            color: 0 0 0 0; // no cc
            // 'visible: 0' is a performance optimization; once transparent,
            // the part is no longer drawn.
            visible: 0;
         }
      }
      // This part is a white rectangle used as a clipping mask for all other
      // visible elements. Animating its alpha channel from opaque to
      // transparent effectively fades out the entire splash screen.
      part { name: "fader"; type: RECT;
         description { state: "default" 0.0;
            // Starts as fully opaque white (#FFFFFFFF).
            color: 255 255 255 255; // no cc
         }
         description { state: "faded" 0.0;
            // Transitions to fully transparent white (#FFFFFF00).
            color: 255 255 255 0; // no cc
         }
      }
   }
   programs {
      // On load, this program initializes the state variables to ensure a
      // clean state each time the splash screen is created.
      program { signal: "load"; source: "";
         script {
            set_int(is_ready, 0);
            set_int(do_end, 0);
         }
      }
      // When the "show" signal is received, this program starts the initial
      // fade-from-black animation on the "blanker" part after a 1.0s delay.
      program { signal: "show"; source: "";
         action: STATE_SET "visible" 0.0;
         transition: DECELERATE 1.0 USE_DURATION_FACTOR 1;
         in: 1.0 0.0;
         target: "blanker";
      }
      // This program fades in the logo after a 1.5s delay. Once the logo
      // animation is complete, it runs the "ready" program to signal that
      // the intro animation sequence is finished.
      program { signal: "show"; source: "";
         action: STATE_SET "active" 0.0;
         target: "logo";
         in: 1.5 0.0;
         transition: SINUSOIDAL 0.8 USE_DURATION_FACTOR 1;
         after: "ready";
      }
      // Plays a "splash" sound effect when the splash screen is shown.
      program { signal: "show"; source: "";
         action: PLAY_SAMPLE "splash" 1.0 EFFECT;
      }
      // This program acts as a synchronization point. It is triggered after
      // the intro animations complete.
      program { name: "ready";
         script {
            new val;
            val = get_int(do_end);
            // If the application has already signaled it's done loading
            // (do_end == 1), immediately start the exit animation.
            if (val == 1)
              run_program(PROGRAM:"exit1");
            // Otherwise, set is_ready to 1, indicating the splash is idle
            // and waiting for the application to finish loading.
            else
              set_int(is_ready, 1);
         }
      }
      // This program listens for the "e,state,done" signal from the application,
      // which indicates that application loading is complete.
      program { signal: "e,state,done"; source: "e";
         script {
            new val;
            // Record that the application is done.
            set_int(do_end, 1);
            val = get_int(is_ready);
            // If the splash intro animation is also done (is_ready == 1),
            // start the exit sequence. This prevents the splash from closing
            // before its animations are finished.
            if (val == 1)
            run_program(PROGRAM:"exit1");
         }
      }
      // "exit1" starts the fade-out animation by transitioning the "fader"
      // part. Once complete, it chains to "exit2".
      program { name: "exit1";
         action: STATE_SET "faded" 0.0;
         transition: SINUSOIDAL 1.0 CURRENT USE_DURATION_FACTOR 1;
         target: "fader";
         after: "exit2";
      }
      // "exit2" emits a signal back to the application to confirm that the
      // splash screen has finished fading out and can be safely destroyed.
      program { name: "exit2";
         action: SIGNAL_EMIT "e,state,done_ok" "e";
      }
   }
}

// This group defines a simpler splash screen for secondary displays. It does
// not contain a logo or text, only a black background that fades in and out
// in sync with the main splash screen.
group { name: "e/init/extra_screen";
   script {
      public is_ready;
      public do_end;
   }
   parts {
      // A simple background that is clipped by the fader for fade-out effects.
      part { name: "bg"; type: RECT;
         clip_to: "fader";
         description { state: "default" 0.0;
            color_class: "/bg-dark/normal/init/base";
         }
      }
      part { name: "blanker"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            color: 0 0 0 255; // no cc
            visible: 1;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color: 0 0 0 0; // no cc
            visible: 0;
         }
      }
      part { name: "fader"; type: RECT;
         description { state: "default" 0.0;
            color: 255 255 255 255; // no cc
         }
         description { state: "faded" 0.0;
            color: 255 255 255 0; // no cc
         }
      }
   }
   programs {
      program { signal: "load"; source: "";
         script {
            set_int(is_ready, 0);
            set_int(do_end, 0);
         }
      }
      // On "show", this program fades in from black. Once complete, it
      // runs the "ready" program. The timing is designed to match the main
      // splash screen's initial fade-in.
      program { signal: "show"; source: "";
         action: STATE_SET "visible" 0.0;
         transition: DECELERATE 1.0 USE_DURATION_FACTOR 1;
         in: 1.0 0.0;
         target: "blanker";
         after: "ready";
      }
      // The "ready" program acts as a synchronization point, similar to the
      // main splash screen, but with a small delay.
      program { name: "ready";
         in: 0.5 0.0;
         script {
            new val;
            val = get_int(do_end);
            // It checks if the application is ready to close the splash
            // screen and acts accordingly.
            if (val == 1)
              run_program(PROGRAM:"exit1");
            else
              set_int(is_ready, 1);
         }
      }
      program { signal: "e,state,done"; source: "e";
         script {
            new val;
            set_int(do_end, 1);
            val = get_int(is_ready);
            if (val == 1)
            run_program(PROGRAM:"exit1");
         }
      }
      program { name: "exit1";
         action: STATE_SET "faded" 0.0;
         transition: SINUSOIDAL 1.0 CURRENT USE_DURATION_FACTOR 1;
         target: "fader";
         after: "exit2";
      }
      program { name: "exit2";
         action: SIGNAL_EMIT "e,state,done_ok" "e";
      }
   }
}
