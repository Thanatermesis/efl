// This group defines the visual style and behavior of a standard button widget.
// It is composed of several parts: a shadow, a base rectangle, an icon, and a label.
// The 'e/widgets/button' name is a convention used to identify this theme element.
group { name: "e/widgets/button";
   // The 'win_shadow.png' image will be used for the button's shadow effect.
   // 'COMP' indicates that the image should be compressed to save memory.
   images.image: "win_shadow.png" COMP;
   parts {
      // The 'shadow' part creates a drop-shadow effect for the button.
      // It is positioned relative to the 'base' part and has no mouse events.
      part { name: "shadow"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "base";
            // The WIN_SHADOW_SMALL macro is used to define the shadow's geometry.
            WIN_SHADOW_SMALL;
            // The color is defined by a color class, allowing for theme-wide changes.
            color_class: "/shadow/normal/button";
         }
         // When the button is clicked, the shadow changes to give a pressed look.
         description { state: "clicked" 0.0;
            inherit;
            // The image border is scaled down to create a subtle pressed effect.
            image.border_scale_by: 0.25;
            rel1.offset: -2 -1;
            rel2.offset: 0 1;
            offscale;
            color_class: "/shadow/pressed/button";
         }
      }
      // The 'base' part is a rectangle that serves as the main body of the button.
      rect { "base";
         scale: 1;
         desc { "default";
            // Color classes are used for theming, making it easy to change colors consistently.
            color_class: "/bg/normal/button";
            rel1.offset: 2 2;
            rel2.offset: -3 -3;
            offscale;
         }
         // The 'clicked' state changes the color to give feedback to the user.
         desc { "clicked"; inherit;
            color_class: "/bg/pressed/button";
         }
         // The 'disabled' state uses a different color to indicate the button is not interactive.
         desc { "disabled"; inherit;
            color_class: "/bg/disabled/button";
         }
      }
      // The 'icon_clip' part is an invisible rectangle that acts as a clipper for the icon.
      // This ensures that the icon does not draw outside of its designated area.
      part { name: "icon_clip"; type: RECT;
         description { state: "default" 0.0;
            // The color is solid white (255 255 255 255 -> #FFFFFFFF), which is typical for clippers.
            // No color class is used here because this part is not meant to be themed.
            color: 255 255 255 255; // no cc
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            // When disabled, the icon is faded by making the clipper semi-transparent.
            // Color is white with alpha at 64 (255 255 255 64 -> #FFFFFF40).
            color: 255 255 255 64; // no cc
         }
      }
      // The 'e.swallow.icon' part is a SWALLOW type, which means it can hold an external Evas object.
      // This is typically used to display an icon inside the button, provided by the application.
      // It is clipped by 'icon_clip' to stay within its bounds.
      part { name: "e.swallow.icon"; type: SWALLOW; mouse_events: 0;
         clip_to: "icon_clip";
         scale: 1;
         // The 'default' state description is for buttons with only text.
         // 'visible: 0' ensures the icon is not displayed.
         desc { "default";
            fixed: 1 0;
            align: 0.0 0.5;
            rel.to: "base";
            rel1.offset: 0 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: -1 -5;
            visible: 0;
            max: 0 999999;
            offscale;
         }
         // The 'combo' state is for buttons with both an icon and text.
         desc { "combo"; inherit;
            fixed: 1 0;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            visible: 1;
            // The ICMIN macro is likely defined elsewhere to set a standard minimum icon size.
            min: ICMIN ICMIN;
         }
         // The 'icon' state is for buttons that only display an icon.
         description { state: "icon" 0.0;
            fixed: 0 0;
            align: 0.5 0.5;
            rel1.offset: 4 4;
            rel2.relative: 1.0 1.0;
            rel2.offset: -5 -5;
            visible: 1;
            min: ICMIN ICMIN;
         }
      }
      // The 'label_clip' part is an invisible rectangle that clips the button's text label.
      // This prevents the text from overflowing its container.
      part { name: "label_clip"; type: RECT;
         description { state: "default" 0.0;
         }
         // The 'disabled' state would hide the clipper, and thus the label.
         // However, no program in this group transitions 'label_clip' to this state,
         // so it appears to be unused.
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // The 'e.text.label' part displays the button's text.
      // It is a TEXT part, clipped by 'label_clip', and does not receive mouse events directly.
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         scale: 1;
         clip_to: "label_clip";
         description { state: "default" 0.0;
            fixed: 0 0;
            color_class: "/fg/normal/button";
            // The label is positioned to the right of the icon area.
            // rel1.to_x: "e.swallow.icon" anchors the left side of the label
            // to the right side of the icon's container.
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "e.swallow.icon";
            rel1.to_y: "base";
            rel2.to: "base";
            rel2.offset: -5 -5;
            text { font: FN; size: 10;
               align: 0.5 0.5;
               min: 1 1;
               // An ellipsis (...) is used to truncate text that doesn't fit.
               // A value of -1 means the ellipsis is at the end of the text.
               ellipsis: -1;
            }
            offscale;
            min: 0 ICMIN;
         }
         // 'disabled' state inherits from default and applies a 'disabled' color class.
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/button";
         }
         // 'combo' state is for when there's an icon and text. It's the same as default.
         description { state: "combo" 0.0;
            inherit: "default" 0.0;
         }
         // In 'icon' only mode, the label is hidden.
         description { state: "icon" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         // 'clicked' state inherits from default and applies a 'pressed' color class.
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/button";
         }
      }
      // This is an invisible rectangle that covers the entire button area.
      // Its purpose is to capture all mouse events, simplifying event handling.
      // By using a dedicated event layer, visual parts don't need to handle events themselves.
      // 'ignore_flags: ON_HOLD' prevents this part from getting stuck in a pressed
      // state if the user holds the mouse button down and moves the cursor away.
      part { name: "event"; type: RECT;
         ignore_flags: ON_HOLD;
         description { state: "default" 0.0;
            rel.to: "base";
            // Transparent color, making it invisible. (0 0 0 0 -> #00000000)
            color: 0 0 0 0; // no cc
         }
         // When disabled, this part is hidden, effectively disabling all mouse input for the button.
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   // The 'programs' section defines the button's behavior in response to events (signals).
   // These programs change the state of the button's parts or emit signals to the application.
   programs {
      // When the left mouse button is pressed down on the 'event' part...
      program {
         signal: "mouse,down,1"; source: "event";
         // ...the shadow, base, and label parts transition to the "clicked" state.
         action: STATE_SET "clicked" 0.0;
         target: "shadow";
         target: "base";
         target: "e.text.label";
      }
      // When the left mouse button is released...
      program {
         signal: "mouse,up,1"; source: "event";
         // ...the same parts transition back to the "default" state.
         action: STATE_SET "default" 0.0;
         target: "shadow";
         target: "base";
         target: "e.text.label";
      }
      // When a click event occurs, this program emits a "e,action,click" signal.
      // The application can listen for this signal to perform an action.
      // The '*' in "mouse,clicked,1*" allows the event to propagate further,
      // which is useful in widget hierarchies.
      program {
         signal: "mouse,clicked,1*"; source: "event";
         action: SIGNAL_EMIT "e,action,click" "";
      }
      // The following programs handle state changes for different button types
      // (text-only, icon-only, or both). These signals are typically emitted
      // by the widget's code in response to content being set. The 'source: "e"'
      // indicates the signal originates from the Elementary widget itself.

      // Handles the state for a button with only text.
      // This sets icon to its 'default' state (hidden) and text to 'default' (visible).
      program {
         signal: "e,state,text"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "e.swallow.icon";
         target: "e.text.label";
      }
      // Handles the state for a button with only an icon.
      // This sets icon to its 'icon' state (visible) and text to 'icon' (hidden).
      program {
         signal: "e,state,icon"; source: "e";
         action: STATE_SET "icon" 0.0;
         target: "e.swallow.icon";
         target: "e.text.label";
      }
      // Handles the state for a button with both an icon and text.
      // This sets both icon and text to their 'combo' state (visible).
      program {
         signal: "e,state,combo"; source: "e";
         action: STATE_SET "combo" 0.0;
         target: "e.swallow.icon";
         target: "e.text.label";
      }
      // This program is triggered when the widget is disabled.
      program {
         signal: "e,state,disabled"; source: "e";
         // It sets several parts to the "disabled" state, visually changing them
         // and deactivating the 'event' part to block mouse interaction.
         action: STATE_SET "disabled" 0.0;
         target: "event";
         target: "base";
         target: "icon_clip";
         target: "e.text.label";
      }
      // This program is triggered when the widget is re-enabled.
      program {
         signal: "e,state,enabled"; source: "e";
         // It reverts the parts back to their "default" state.
         action: STATE_SET "default" 0.0;
         target: "event";
         target: "base";
         target: "icon_clip";
         target: "e.text.label";
      }
   }
}
