// The icon for the music control module, displayed in shelves or other containers.
group { name: "e/modules/music-control/icon";
   alias: "modules/music-control/icon";
   max: 160 160;
   // Defines a set of images that can be used as a single named resource.
   // This allows for resolution independence by providing different image
   // files for different size ranges.
   set { name: "efm_drive_cd_icon";
      image { image: "efm_drive_cd_160.png" COMP; size: 81 81 16000 16000; }
      image { image: "efm_drive_cd_080.png" COMP; size: 41 41 80 80; }
      image { image: "efm_drive_cd_040.png" COMP; size: 0 0 40 40; }
   }
   parts {
      // A single part that displays the icon.
      // 'mouse_events: 0' means it doesn't react to mouse input.
      part { name: "icon"; mouse_events: 0;
         description { state: "default" 0.0;
            // 'aspect: 1.0 1.0' maintains a square aspect ratio.
            aspect: 1.0 1.0; aspect_preference: BOTH;
            // Uses the image set defined above.
            image.normal: "efm_drive_cd_icon";
         }
      }
   }
}

// The main view of the music control gadget. This is what you see when the
// gadget is placed on a desktop or panel. It's designed to be simple,
// primarily showing album art.
group { name: "e/modules/music-control/main";
   alias: "modules/music-control/main";
   // Re-uses the same image set from the icon group. This is efficient
   // as the images are already loaded in memory if the icon is visible.
   set { name: "efm_drive_cd_icon";
      image { image: "efm_drive_cd_160.png" COMP; size: 81 81 16000 16000; }
      image { image: "efm_drive_cd_080.png" COMP; size: 41 41 80 80; }
      image { image: "efm_drive_cd_040.png" COMP; size: 0 0 40 40; }
   }
   parts {
      // A background part that displays a default CD icon. It also defines the
      // aspect ratio for the entire gadget.
      part { name: "image";
         description { state: "default" 0.0;
            aspect: 1.0 1.0; aspect_preference: BOTH;
            image.normal: "efm_drive_cd_icon";
         }
      }
      // This part acts as a clipper. The actual cover art will be clipped by
      // this part's geometry. It's positioned relative to the "image" part,
      // ensuring it scales correctly.
      part { name: "cover_clip"; mouse_events: 0;
         description { state: "default" 0.0;
            rel.to: "image";
            image.normal: "efm_drive_cd_icon";
         }
      }
      // The SWALLOW part is a container for external Evas objects. Here, it's
      // used to display the album cover image, which is provided by the
      // module's C code. It's clipped by "cover_clip".
      part { name: "e.swallow.cover"; type: SWALLOW; mouse_events: 0;
         clip_to: "cover_clip";
         description { state: "default" 0.0;
            rel.to: "image";
         }
      }
   }
}

// Defines the detailed popup window for the music control module.
// This view appears when the user interacts with the main gadget, offering
// playback controls, track information, and progress.
group { name: "e/modules/music-control/popup";
   alias: "modules/music-control/popup";
#ifdef SKIP_NAMESPACE_VALIDATION
   skip_namespace_validation: 1;
#endif
   images.image: "grad-v-bi.png" COMP;
   min: 160 160;
   // Defines text styles for rich text in TEXTBLOCK parts. This allows for
   // complex formatting like different fonts and colors within a single
   // text element. It's used here for the song metadata.
   styles {
      style { name: "music_control_metadata_style";
         base: "font="FN" font_size=10 align=left text_class=tb_plain color=cc:/fg/normal/gadgets/music_control/text";
         tag: "title" "+ font_size=10 font="FNBD" text_class=tb_big color=cc:/fg/normal/gadgets/music_control/text/title";
         tag: "tag" "+ font_size=8 color_class=/fg/normal/gadgets/music_control/text/tag";
         tag: "br" "\n";
      }
   }
   // Embryo script block. This allows for C-like scripting within the EDC
   // file itself, enabling dynamic behavior without needing to recompile the
   // module's C code. It's powerful for UI logic.
   script {
      // Custom function to format time from seconds into a human-readable
      // string (e.g., "HH:MM:SS" or "MM:SS"). This avoids complex string
      // manipulation in the C code, keeping the logic within the theme.
      timeprint(dst[], dstn, Float:pos, Float:fmt) {
         new h, m, s, fh, fm;
         m  = round(pos / 60.0, FLOOR);
         h  = round(float(m) / 60.0, FLOOR);
         m  = m - (h * 60);
         s  = round(pos - float((h * 3600) + (m * 60)), FLOOR);

         fm = round(fmt / 60.0, FLOOR);
         fh = round(float(fm) / 60.0, FLOOR);
         if      (fh > 0) {
            if (m >= 10) {
               if (s >= 10) snprintf(dst, dstn, "%i:%i:%i",  h, m, s);
               else         snprintf(dst, dstn, "%i:%i:0%i", h, m, s);
            } else {
               if (s >= 10) snprintf(dst, dstn, "%i:0%i:%i",  h, m, s);
               else         snprintf(dst, dstn, "%i:0%i:0%i", h, m, s);
            }
         }
         else if (fm > 0) {
            if (s >= 10) snprintf(dst, dstn, "%i:%i",  m, s);
            else         snprintf(dst, dstn, "%i:0%i", m, s);
         }
         else {
            if (s >= 10)  snprintf(dst, dstn, "0%i",  s);
            else          snprintf(dst, dstn, "%i",  s);
         }
      }
      // This function handles messages sent from the C code via
      // edje_object_message_send(). It's the primary way the module's logic
      // communicates with its visual representation.
      public message(Msg_Type:type, id, ...) {
         // Message ID 0: Update the player name.
         if (id == 0) {
            new txt[128];
            getsarg(2, txt, 128);
            set_text(PART:"player_name", txt);
         // Message ID 1: Update playback position and duration.
         } else if (id == 1) {
            new Float:pos, Float:len, txt[128];
            pos = getfarg(2);
            len = getfarg(3);

            if (len > 0.0) {
               // Use the custom timeprint function to format times.
               timeprint(txt, 128, pos, len);
               set_text(PART:"pos_txt", txt);
               timeprint(txt, 128, len, len);
               set_text(PART:"len_txt", txt);

               // Update the progress bar ("pos" part) by creating a
               // custom state. The width of the progress bar is
               // dynamically set based on the playback position.
               custom_state(PART:"pos", "default", 0.0);
               set_state_val(PART:"pos", STATE_REL2, (pos / len), 1.0);
               set_state(PART:"pos", "custom", 0.0)
            } else {
               // If there is no length (e.g., a stream), clear time texts
               // and reset the progress bar.
               set_text(PART:"pos_txt", "");
               set_text(PART:"len_txt", "");

               custom_state(PART:"pos", "default", 0.0);
               set_state_val(PART:"pos", STATE_REL2, 0.0, 1.0);
               set_state(PART:"pos", "custom", 0.0)
            }
         }
      }
   }
   parts {
      alias: "cover_swallow" "e.cover_swallow";
      // A SPACER part to enforce a minimum size for the whole layout.
      part { name: "min"; type: SPACER;
         scale: 1;
         description { state: "default" 0;
            min: 160 160;
         }
      }
      // A background for the album art, visible if the art isn't loaded.
      part { name: "cover_bg";
         description { state: "default" 0;
            rel1.relative: 0.25 0.25;
            rel2.relative: 0.75 0.75;
            image.normal: "efm_drive_cd_icon";
            // Semi-transparent white: #FFFFFF80
            color: 255 255 255 128; // no cc
         }
      }
      // SWALLOW part for the album cover. 'offscale' means scaling is
      // applied before offsets, useful for precise borders.
      part { name: "e.cover_swallow"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0;
            rel1.offset: -4 -4;
            rel2.offset: 3 3;
            offscale;
         }
      }
      // A rectangular background for the player name text.
      part { name: "player_name_back"; type: RECT;
         scale: 1;
         description { state: "default" 0;
            color_class: "/bg/normal/gadgets/music_control/base";
            rel1.offset: -4 -4;
            rel2.offset: 3 3;
            rel2.to_y: "player_name";
            offscale;
         }
      }
      // A gradient part that sits between the player name and the buttons,
      // creating a visual separation.
      part { name: "player_mid";
         scale: 1;
         description { state: "default" 0;
            color_class: "/bg/normal/gadgets/music_control/base";
            rel1.to: "player_name_back";
            rel1.relative: 0.0 1.0;
            rel2.to: "btn_back";
            rel2.relative: 1.0 0.0;
            image.normal: "grad-v-bi.png";
         }
      }
      // A background for the control buttons (prev, play, next). It changes
      // color when a button is pressed for visual feedback.
      part { name: "btn_back"; type: RECT;
         scale: 1;
         description { state: "default" 0;
            color_class: "/bg/normal/gadgets/music_control/base";
            rel1.to_y: "previous_btn";
            rel1.offset: -4 -4;
            rel2.offset: 3 3;
            offscale;
         }
         description { state: "pressed" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/pressed/gadgets/music_control/base";
         }
      }
      // Displays the name of the current music player (e.g., "MPRIS").
      part { name: "player_name"; type: TEXT;
         scale : 1;
         description { state: "default" 0;
            align: 0.5 0.0;
            color_class: "/fg/normal/gadgets/music_control/text/title";
            text.size: 10;
            text.text: "Music player";
            text.min: 0 1;
            text.font: FNBD;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 0.0;
            rel1.offset: 8 0;
            rel2.offset: -9 0;
            offscale;
         }
      }
      // A TEXTBLOCK part to display formatted track metadata (title, artist,
      // etc.) using the style defined earlier.
      part { name: "metadata"; type: TEXTBLOCK;
         scale : 1;
         description { state: "default" 0;
            align: 0.5 0.0;
            text { style: "music_control_metadata_style";
               text: "Song Title";
               align: 0.0 0.0;
               min: 0 0;
               ellipsis: 0.0;
            }
            rel1.to_y: "player_name";
            rel1.relative: 0.0 1.0;
            rel1.offset: 8 8;
            rel2.offset: -9 8;
            offscale;
         }
      }
      // Displays the current playback position (e.g., "1:23").
      part { name: "pos_txt"; type: TEXT;
         scale : 1;
         description { state: "default" 0;
            min: 64 15;
            rel.to: "btn_back";
            color_class: "/fg/normal/gadgets/music_control/text/position";
            align: 0.5 1.0;
            text.size: 10;
            text.font: FN;
            text.align: 0.0 1.0;
            text.min: 0 1;
            rel1.offset: 4 -5;
            rel2.offset: -5 -5;
            rel2.relative: 1.0 0.0;
            offscale;
         }
      }
      // Displays the total length of the track (e.g., "3:45").
      part { name: "len_txt"; type: TEXT;
         scale : 1;
         description { state: "default" 0;
            min: 64 15;
            rel.to: "btn_back";
            color_class: "/fg/normal/gadgets/music_control/text/length";
            align: 0.5 1.0;
            text.size: 10;
            text.font: FN;
            text.align: 1.0 1.0;
            text.min: 0 1;
            rel1.offset: 4 -5;
            rel2.offset: -5 -5;
            rel2.relative: 1.0 0.0;
            offscale;
         }
      }
      // The central play/pause button. It has two states: "default" which
      // shows a pause icon, and "play" which shows a play icon. The state is
      // toggled by programs.
      part { name: "play_btn";
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 15 15;
            max: 15 15;
            align: 0.5 1.0;
            image.normal: "i-media-pause";
            color_class: "/fg/normal/gadgets/music_control/button/pause";
         }
         description { state: "play" 0.0;
            inherit: "default" 0.0;
            image.normal: "i-media-play";
            color_class: "/fg/normal/gadgets/music_control/button/play";
         }
      }
      // The repeat/loop button icon. It's hidden by default ('visible: 0')
      // and made visible when looping is active by switching to the "loop" state.
      part { name: "loop";
         scale: 1;
         description { state: "default" 0;
            fixed: 1 1;
            rel.to: "player_name_back";
            min: 15 15;
            max: 15 15;
            align: 1.0 0.5;
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            offscale;
            image.normal: "i-reload";
            visible: 0;
            color_class: "/fg/normal/gadgets/music_control/button/loop";
         }
         description { state: "loop" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // The "previous track" button.
      part { name: "previous_btn";
         scale: 1;
         description { state: "default" 0;
            fixed: 1 1;
            min: 15 15;
            max: 15 15;
            rel.to: "play_btn";
            rel1.relative: -2.0 0.0;
            rel2.relative: -1.0  1.0;
            image.normal: "i-media-prev";
            color_class: "/fg/normal/gadgets/music_control/button/prev";
         }
      }
      // The "next track" button.
      part { name: "next_btn";
         scale: 1;
         description { state: "default" 0;
            fixed: 1 1;
            min: 15 15;
            max: 15 15;
            rel.to: "play_btn";
            rel1.relative: 2.0 0.0;
            rel2.relative: 3.0 1.0;
            image.normal: "i-media-next";
            color_class: "/fg/normal/gadgets/music_control/button/next";
         }
      }
      // A simple RECT part used as the track progress bar. Its width is
      // dynamically controlled by the Embryo script.
      part { name: "pos"; type: RECT;
         scale: 1;
         mouse_events: 0;
         description { state: "default" 0;
            fixed: 1 1;
            color_class: "/fg/normal/gadgets/music_control/progress";
            rel.to: "btn_back";
            rel1.offset: 0 -1;
            rel1.relative: 0.0 1.0;
            min: 0 5;
            align: 0.0 1.0;
         }
      }
   }
   programs {
      // When any button (*_btn) is pressed, this program changes the state
      // of "btn_back" to "pressed", providing visual feedback.
      program { signal: "mouse,down,1"; source: "*_btn";
         action: STATE_SET "pressed" 0.0;
         target: "btn_back";
      }
      // When the mouse button is released over any button, "btn_back"
      // returns to its default state with a brief transition.
      program { signal: "mouse,up,1"; source: "*_btn";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 1.0 USE_DURATION_FACTOR 1;
         target: "btn_back";
      }
      // When the control buttons are clicked, these programs emit signals that
      // are caught by the module's C code to perform the corresponding action
      // (e.g., change track, play/pause).
      program { signal: "mouse,clicked,*"; source: "previous_btn";
         action: SIGNAL_EMIT "btn,clicked" "previous";
      }
      program { signal: "mouse,clicked,*"; source: "play_btn";
         action: SIGNAL_EMIT "btn,clicked" "play";
      }
      program { signal: "mouse,clicked,*"; source: "next_btn";
         action: SIGNAL_EMIT "btn,clicked" "next";
      }
      // These programs handle changing the icon of the play/pause button.
      // They are triggered by signals from the C code, ensuring the UI is
      // synchronized with the actual player state. 'no_delay' version is
      // for immediate state change.
      program { signal: "btn,state,image,play"; source: "play";
         action: STATE_SET "play" 0.0;
         transition: LINEAR 0.1;
         target: "play_btn";
      }
      program { signal: "btn,state,image,play,no_delay"; source: "play";
         action: STATE_SET "play" 0.0;
         transition: LINEAR 0.0;
         target: "play_btn";
      }
      program { signal: "btn,state,image,pause"; source: "play";
         action: STATE_SET "default" 0.0;
         transition: LINEAR 0.1;
         target: "play_btn";
      }
      // Emits a signal when the player name label is clicked. This could be
      // used, for example, to open the full music player application.
      program { signal: "mouse,clicked,*"; source: "player_name";
         action: SIGNAL_EMIT "label,clicked" "player_name";
      }
      // These programs toggle the visibility of the loop icon based on
      // signals from the C code.
      program { signal: "loop,state,on"; source: "play";
         action: STATE_SET "loop" 0.0;
         target: "loop";
      }
      program { signal: "loop,state,off"; source: "play";
         action: STATE_SET "default" 0.0;
         target: "loop";
      }
   }
}
