// Pager popup group
// This group defines the main container for the pager popup, which appears
// when clicking on the pager gadget. It consists of a background, a content
// area for the desktop grid, and a title label.
group { name: "e/modules/pager/popup";
   parts {
      // Base rectangle for the popup background.
      part { name: "base"; type: RECT;
         description { state: "default" 0.0;
            // The color is defined by the theme's color class for pager popups.
            color_class: "/bg/normal/popup/pager";
         }
      }
      // Swallow part to host the actual pager content (desktop grid).
      // The application will place its content here.
      part { name: "e.swallow.content"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            // Positioned below the 'e.text.label' part.
            rel1.to_y: "e.text.label";
            rel1.relative: 0.0 1.0;
            rel1.offset: 0 8;
            rel2.relative: 1.0 1.0;
            rel2.offset: -1 -9;
            // 'offscale' ensures the part is initially scaled to zero,
            // allowing for an animated appearance (e.g., zoom in).
            offscale;
         }
      }
      // Text part for the popup's title. It does not receive mouse events.
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "base";
            rel1.offset: 8 8;
            rel2.relative: 1.0 0.0;
            rel2.offset: -9 8;
            align: 0.5 0.0;
            color_class: "/fg/normal/popup/pager/text/title";
            text { font: FNBD; size: 10;
               text_class: "title_bar";
               align: 0.5 0.0;
               min: 0 1;
            }
            offscale;
            // Height is fixed, width is scalable.
            fixed: 0 1;
         }
      }
   }
}

// Pager desk group
// This group defines the appearance of a single virtual desktop within the pager.
// It includes a background, areas for window previews, a selection highlight,
// and drop zone indicators for drag-and-drop operations.
group { name: "e/modules/pager/desk";
   // BACKGROUND_IMG is a macro that sets up a scalable background image.
   BACKGROUND_IMG
   // Pre-loading images for the drag-and-drop target glow effect.
   images.image: "mini_blue_glow_arrow_0.png" COMP;
   images.image: "mini_blue_glow_arrow_1.png" COMP;
   images.image: "mini_blue_glow_arrow_2.png" COMP;
   images.image: "mini_blue_glow_arrow_3.png" COMP;
   parts {
      // The 'base' part is configured via the BACKGROUND_IMG and ASPECT_FILL
      // macros. It serves as the main background for the desk representation.
      part { name: "base";
         description { state: "default" 0.0;
            image.normal: "background";
            image.scale_hint: STATIC;
            // ASPECT_FILL macro ensures the background image fills the area
            // while maintaining its aspect ratio. The ratio (16:9) is
            // provided as an argument.
            ASPECT_FILL((7680/4320))
         }
      }
      // A clipping rectangle to contain the desk's contents. It is not interactive.
      part { name: "clip"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            rel.to: "base";
         }
      }
      // Swallow part for displaying the desktop's wallpaper preview.
      // It's clipped by the "clip" part.
      part { name: "e.background"; type: SWALLOW;
         clip_to: "clip";
         description { state: "default" 0.0;
            rel.to: "base";
         }
         // The 'hidden' state makes this part invisible, used to toggle wallpaper preview.
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Swallow part for the miniature window representations.
      part { name: "e.swallow.content"; type: SWALLOW;
         clip_to: "clip";
         description { state: "default" 0.0;
            rel.to: "base";
         }
      }
      // Text part to display the desk name.
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         // In 'default' state, the label is invisible.
         desc { "default";
            rel.to: "e.swallow.content";
            color_class: "/fg/normal/gadgets/pager/desk/text";
            text { font: FN; size: 10;
               text_class: "module_small";
               align: 0.5 0.5;
            }
            visible: 0;
         }
         // In 'active' state, it becomes visible.
         desc { "active"; inherit;
            visible: 1;
         }
      }
      // Selection indicator, shows which desk is currently active.
      part { name: "sel"; type: RECT; mouse_events: 0;
         scale: 1;
         clip_to: "clip";
         // By default, the indicator is hidden.
         desc { "default";
            color_class: "/bg/selected/gadgets/pager/desk";
            visible: 0;
            rel.to: "e.swallow.content";
            rel1.relative: 0.0 1.0;
            align: 0.5 1.0;
            // Limit height to 5 pixels.
            max: 99999 5;
         }
         // When active, it becomes a visible bar. The change in 'rel1.relative'
         // animates its vertical position to indicate selection.
         desc { "active"; inherit;
            inherit: "default" 0.0;
            rel1.relative: 0.0 0.5;
            visible: 1;
         }
      }
      // Drop zone indicators (arrows) for drag-and-drop operations.
      // There are four, one for each corner ('drop0' to 'drop3'), creating a
      // glowing corner effect when a draggable object is over the desk.
      // They are normally invisible, become visible in 'active' state, and
      // have a 'hidden' state for fade-out animations.
      part { name: "drop0"; mouse_events: 0; // Top-left
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "mini_blue_glow_arrow_0.png";
            rel.to: "base";
            rel1.offset: -1 -1;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 0.0;
            rel2.offset: -1 -1;
            align: 0.0 0.0;
            min: 10 10;
            fixed: 1 1;
            visible: 0;
            offscale;
            color_class: "/fg/selected/gadgets/pager/desk/drop/arrows";
         }
         // Becomes visible when a drag operation enters the desk area.
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
         // The 'hidden' state is used for a fade-out animation. It shrinks the part
         // and sets its color to fully transparent.
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            rel1.offset: 11 11;
            rel2.offset: 11 11;
            min: 1 1;
            // Transparent white (#FFFFFF00). The 'no cc' comment indicates
            // that this color is not from a color class.
            color: 255 255 255 0; // no cc
         }
      }
      part { name: "drop1"; mouse_events: 0; // Top-right
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "mini_blue_glow_arrow_1.png";
            rel.to: "base";
            rel1.offset: 0 -1;
            rel1.relative: 1.0 0.0;
            rel2.relative: 1.0 0.0;
            rel2.offset: 0 -1;
            align: 1.0 0.0;
            min: 10 10;
            fixed: 1 1;
            visible: 0;
            offscale;
            color_class: "/fg/selected/gadgets/pager/desk/drop/arrows";
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            rel1.offset: -12 11;
            rel2.offset: -12 11;
            min: 1 1;
            color: 255 255 255 0; // no cc
         }
      }
      part { name: "drop2"; mouse_events: 0; // Bottom-right
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "mini_blue_glow_arrow_2.png";
            rel.to: "base";
            rel1.offset: 0 0;
            rel1.relative: 1.0 1.0;
            rel2.relative: 1.0 1.0;
            rel2.offset: 0 0;
            align: 1.0 1.0;
            min: 10 10;
            fixed: 1 1;
            visible: 0;
            offscale;
            color_class: "/fg/selected/gadgets/pager/desk/drop/arrows";
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            rel1.offset: -12 -12;
            rel2.offset: -12 -12;
            min: 1 1;
            color: 255 255 255 0; // no cc
         }
      }
      part { name: "drop3"; mouse_events: 0; // Bottom-left
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "mini_blue_glow_arrow_3.png";
            rel.to: "base";
            rel1.offset: -1 0;
            rel1.relative: 0.0 1.0;
            rel2.relative: 0.0 1.0;
            rel2.offset: -1 0;
            align: 0.0 1.0;
            min: 10 10;
            fixed: 1 1;
            visible: 0;
            offscale;
            color_class: "/fg/selected/gadgets/pager/desk/drop/arrows";
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            rel1.offset: 11 -12;
            rel2.offset: 11 -12;
            min: 1 1;
            color: 255 255 255 0; // no cc
         }
      }
      // Transparent rectangle to capture all mouse events for the desk area.
      part { name: "e.eventarea"; type: RECT; mouse_events: 1;
         // 'repeat_events' allows continuous events while a mouse button is held,
         // useful for things like press-and-hold actions.
         repeat_events: 1;
         description { state: "default" 0.0;
            // Transparent white (#FFFFFF00).
            color: 255 255 255 0; // no cc
         }
      }
   }
   programs {
      // This program animates the 'sel' part to its 'active' state when
      // the desk is selected.
      program { name: "sel";
         signal: "e,state,selected"; source: "e";
         action: STATE_SET "active" 0.0;
         transition: DECELERATE 0.2 USE_DURATION_FACTOR 1;
         target: "sel";
      }
      // When unselected, first stop any ongoing animation on 'sel'.
      program { signal: "e,state,unselected"; source: "e";
         action: ACTION_STOP;
         target: "sel";
      }
      // Then, animate 'sel' back to its 'default' (hidden) state.
      program { signal: "e,state,unselected"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.2 USE_DURATION_FACTOR 1;
         target: "sel";
      }
      // Show desktop wallpaper preview.
      program { signal: "e,preview,on"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "e.background";
      }
      // Hide desktop wallpaper preview.
      program { signal: "e,preview,off"; source: "e";
         action: STATE_SET "hidden" 0.0;
         target: "e.background";
      }
      // This program chain creates a pulsing effect for the drop indicators.
      // When a drag enters, 'drop1' is triggered.
      program { name: "drop1";
         signal: "e,action,drag,in"; source: "e";
         // Make the drop arrows visible.
         action: STATE_SET "active" 0.0;
         target: "drop0";
         target: "drop1";
         target: "drop2";
         target: "drop3";
         // After this, run the 'drop2' program.
         after: "drop2";
      }
      // 'drop2' animates the arrows to the 'hidden' state (fading them out).
      program { name: "drop2";
         action: STATE_SET "hidden" 0.0;
         transition: LINEAR 0.5;
         target: "drop0";
         target: "drop1";
         target: "drop2";
         target: "drop3";
         // After fading out, run 'drop1' again to make them reappear, creating a loop.
         after: "drop1";
      }
      // When the drag leaves the area, reset the drop indicators to their default
      // (invisible) state. This stops the pulsing animation.
      program { signal: "e,action,drag,out"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "drop0";
         target: "drop1";
         target: "drop2";
         target: "drop3";
      }
      // Show the desk name label.
      program { signal: "e,name,show"; source: "e";
         action: STATE_SET "active" 0.0;
         target: "e.text.label";
      }
      // Hide the desk name label.
      program { signal: "e,name,hide"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "e.text.label";
      }
   }
}

// Pager window group
// Defines the appearance of a miniature window representation inside a pager desk.
// It includes a shadow, the window body, an icon, and a content preview area.
// It also handles animations for focus and urgency states.
group { name: "e/modules/pager/window";
   images.image: "pager_mini_win_shadow.png" COMP;
   parts {
      // A shadow effect for the miniature window. It's not interactive.
      part { name: "shadow"; mouse_events: 0;
         description { state: "default" 0.0;
            image.normal: "pager_mini_win_shadow.png";
            // The image is a border image.
            image.border: 7 7 7 7;
            // 'image.middle: 0' specifies that the center of the image should not be drawn,
            // which is an optimization for scalable frame-like images.
            image.middle: 0;
            // The shadow is positioned around the "win" part.
            rel1.to: "win";
            rel1.offset: -5 -5;
            rel2.to: "win";
            rel2.offset: 4 4;
            // 'fill.smooth: 0' disables anti-aliasing for a sharper look.
            fill.smooth: 0;
            color_class: "/shadow/normal/border";
         }
      }
      // This SPACER part acts as a base for positioning other elements.
      // It is used to create the "urgent" animation by shifting its position.
      part { name: "base"; type: SPACER;
         scale: 1;
         description { state: "default" 0.0;
            offscale;
         }
         // In the 'urgent' state, the part is offset, which will move any
         // parts relative to it.
         description { state: "urgent" 0.0;
            rel1.offset: 0 -5;
            rel2.offset: -1 -6;
         }
      }
      // The main rectangle for the miniature window's body.
      part { name: "win"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            color_class: "/bg/normal/titlebar";
         }
         // The 'active' state is used when the window is focused, changing its color.
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/selected/titlebar";
         }
      }
      // Swallow part for the window's icon.
      part { name: "e.swallow.icon"; type: SWALLOW; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "base";
            rel1.offset: 2 2;
            rel2.offset: -3 -3;
            align: 1.0 1.0;
            max: 24 24;
            offscale;
            // 'aspect_preference: BOTH' ensures the icon scales correctly while
            // maintaining its aspect ratio.
            aspect: 1.0 1.0; aspect_preference: BOTH;
         }
         // The icon is hidden when in 'preview' mode (to show content instead).
         description { state: "preview" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Swallow part for a preview of the window's content.
      part { name: "e.swallow.content"; type: SWALLOW; mouse_events: 0;
         // Invisible by default.
         description { state: "default" 0.0;
            rel.to: "base";
            visible: 0;
         }
         // Becomes visible in 'preview' mode.
         description { state: "preview" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // Transparent rectangle for capturing mouse events on the miniature window.
      part { name: "event"; type: RECT;
         description { state: "default" 0.0;
            // Fully transparent black (#00000000).
            color: 0 0 0 0; // no cc
         }
      }
   }
   programs {
      // When the window receives focus, change the 'win' part to 'active' state.
      program { signal: "e,state,focused"; source: "e";
         action: STATE_SET "active" 0.0;
         target: "win";
      }
      // When the window loses focus, revert to 'default' state.
      program { signal: "e,state,unfocused"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "win";
      }
      // When preview is turned on, set both content and icon parts to 'preview' state.
      // This will show the content and hide the icon.
      program { signal: "e,preview,on"; source: "e";
         action: STATE_SET "preview" 0.0;
         target: "e.swallow.content";
         target: "e.swallow.icon";
      }
      // When preview is off, revert to 'default' state.
      program { signal: "e,preview,off"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "e.swallow.content";
         target: "e.swallow.icon";
      }
      // The 'urgent' animation is a chain of two programs creating a bouncing effect.
      // 'urg1' is triggered when the window becomes urgent.
      program { name: "urg1";
         signal: "e,state,urgent"; source: "e";
         // Animate the 'base' part to the 'urgent' state (offset position).
         action: STATE_SET "urgent" 0.0;
         transition: DECELERATE 0.2;
         target: "base";
         // After completing, trigger 'urg2'.
         after: "urg2";
      }
      // 'urg2' animates the 'base' part back to the 'default' state.
      // It is also triggered by the 'urgent' signal, but is typically started by 'urg1'.
      program { name: "urg2";
         signal: "e,state,urgent"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: ACCELERATE 0.2;
         target: "base";
         // After completing, it triggers 'urg1' again, creating a continuous loop
         // as long as the window is urgent.
         after: "urg1";
      }
      // This program stops the urgent animation loop.
      program {
         signal: "e,state,not_urgent"; source: "e";
         // Explicitly stop the 'urg1' and 'urg2' programs.
         action: ACTION_STOP;
         target: "urg1";
         target: "urg2";
         // Then, run 'urg0' to reset the state.
         after: "urg0";
      }
      // 'urg0' resets the 'base' part to its default position.
      program { name: "urg0";
         action: STATE_SET "default" 0.0;
         target: "base";
      }
   }
}
