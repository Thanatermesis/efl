// This group defines the style for the type-ahead search buffer in a list.
// It appears when the user starts typing to filter/search the list.
group { name: "e/ilist";
   parts {
      // A clipping rectangle used to show/hide the type buffer with a fade effect.
      // It's transparent and invisible by default, and becomes opaque and visible when active.
      part { name: "typebuf_clip"; type: RECT;
         description { state: "default" 0.0;
            visible: 0;
            // Transparent white (#FFFFFF00).
            color: 255 255 255 0; // no cc
         }
         description { state: "active" 0.0;
            visible: 1;
            // Opaque white (#FFFFFFFF).
            color: 255 255 255 255; // no cc
         }
      }
      // The background of the type buffer, clipped by "typebuf_clip".
      // It is positioned relative to the "e.text.label" part, providing padding.
      // 'offscale' ensures it animates into view.
      part { name: "base"; type: RECT; mouse_events: 0;
         clip_to: "typebuf_clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "e.text.label";
            rel1.offset: -8 -8;
            rel2.offset: 7 7;
            color_class: "/dim/normal/list/typebuf/base";
            offscale;
         }
      }
      // Alias for the text part, providing a more descriptive name for use in C code.
      alias: "e.text.typebuf_label" "e.text.label";
      // The text part that displays the characters typed by the user.
      // It is also clipped by "typebuf_clip" and centered within the container.
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         clip_to: "typebuf_clip";
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: 0.5 0.5;
            rel1.offset: -8 -8;
            rel2.relative: 0.5 0.5;
            rel2.offset: 7 7;
            color_class: "/fg/normal/list/typebuf/text";
            text { font: FNBD; size: 10;
               min: 1 1;
               ellipsis: -1;
               align: 0.5 0.5;
               text_class: "ilist_typebuf";
            }
            offscale;
         }
      }
   }
   // Programs manage the visibility of the type buffer.
   programs {
      // When the "e,state,typebuf,start" signal is received, this program
      // triggers a fade-in animation for the "typebuf_clip" part, making the
      // type buffer visible.
      program { signal: "e,state,typebuf,start"; source: "e";
         action: STATE_SET "active" 0.0;
         transition: SINUSOIDAL 0.25;
         target: "typebuf_clip";
      }
      // When the "e,state,typebuf,stop" signal is received, this program
      // triggers a fade-out animation, hiding the type buffer.
      program { signal: "e,state,typebuf,stop"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 1.0;
         target: "typebuf_clip";
      }
   }
}

// Defines the style for a standard list item. It includes an icon, a label,
// and an end-aligned content area, with support for selection and disabled states.
group { name: "e/widgets/ilist";
//   data.item: "stacking" "above"; // When selected, item is raised above others
//   data.item: "stacking" "below"; // When selected, item is pushed below others
//   data.item: "selectraise" "on"; // Raise on select
   parts {
      // The base background of the list item.
      part { name: "base"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            color_class: "/bg/normal/list/item";
         }
      }
      // A rectangle used as a selection highlight. It is invisible by default
      // and becomes visible when the item is in the "selected" state.
      part { name: "sel_base"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            color_class: "/bg/selected/list/item";
            visible: 0;
         }
         description { state: "selected" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // A container (swallow part) for an icon at the start of the list item.
      // 'offscale' is used for animation effects when the item appears.
      part { name: "e.swallow.icon"; type: SWALLOW; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            align: 0.0 0.5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
            offscale;
         }
      }
      // The main text label of the list item. It's positioned between the
      // icon and the end swallow part. Its color changes based on the
      // item's state (selected, disabled).
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "e.swallow.icon";
            rel2.offset: -5 -5;
            rel2.relative: 0.0 1.0;
            rel2.to_x: "e.swallow.end";
            color_class: "/fg/normal/list/item";
            text { font: FN; size: 10;
               min: 1 1;
               ellipsis: -1;
               align: 0.0 0.5;
               text_class: "ilist_item";
            }
            offscale;
         }
         description { state: "selected" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/selected/list/item";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/list/item";
         }
      }
      // A container for content at the end of the list item, like a checkbox or an icon.
      part { name: "e.swallow.end"; type: SWALLOW; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            align: 1.0 0.5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            rel1.offset: -5 4;
            rel1.relative: 1.0 0.0;
            rel2.offset: -5 -5;
            offscale;
         }
      }
      // An invisible rectangle that covers the entire item to capture mouse events.
      // This is a common technique to make the entire item clickable.
      // It becomes invisible when the item is disabled.
      part { name: "event"; type: RECT;
         description { state: "default" 0.0;
            // Transparent black (#00000000).
            color: 0 0 0 0; // no cc
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   // These programs handle the visual state changes of the list item.
   programs {
      // On "e,state,selected", the item's background and text change to
      // their "selected" state, highlighting the item.
      program { signal: "e,state,selected"; source: "e";
         action: STATE_SET "selected" 0.0;
         target: "sel_base";
         target: "e.text.label";
      }
      // On "e,state,unselected", the item returns to its default appearance.
      program { signal: "e,state,unselected"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "sel_base";
         target: "e.text.label";
      }
      // On "e,state,disabled", the item's visuals change to indicate
      // it is not interactive.
      program { signal: "e,state,disabled"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "sel_base";
         target: "e.text.label";
      }
      // On "e,state,enabled", the item returns to its default state from disabled.
      program { signal: "e,state,enabled"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "sel_base";
         target: "e.text.label";
      }
   }
}

// Defines the style for an odd-row list item, used for creating a "zebra"
// or alternating row color effect in lists. It inherits all properties from
// "e/widgets/ilist" and only overrides the background color.
group { name: "e/widgets/ilist_odd";
   inherit: "e/widgets/ilist";
   parts {
      part { name: "base";
         description { state: "default" 0.0;
            color_class: "/bg-alt/normal/list/item";
         }
      }
   }
}

// Defines the style for a list header. Headers are used to group items.
// It is styled to be visually distinct from regular list items.
group { name: "e/widgets/ilist_header";
   // Aliased for odd headers, meaning they will look the same as regular headers.
   // This is an optimization to avoid duplicating data.
   alias: "e/widgets/ilist_header_odd";
   // Ensures the header is always drawn above list items.
   data.item: "stacking" "above";
   parts {
      // The background of the header.
      part { name: "base"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            color_class: "/bg/normal/list/group";
         }
      }
      // A swallow part for an optional icon in the header.
      part { name: "e.swallow.icon"; type: SWALLOW; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            align: 0.0 0.5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
            offscale;
         }
      }
      // The text label for the header. It uses a bold font (FNBD) to stand out.
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 8 8;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "e.swallow.icon";
            rel2.offset: -8 -9;
            rel2.relative: 0.0 1.0;
            rel2.to_x: "e.swallow.end";
            color_class: "/fg/normal/list/group";
            text { font: FNBD; size: 10;
               min: 0 1;
               align: 0.0 0.5;
               text_class: "ilist_item";
            }
            offscale;
         }
      }
      // A swallow part for optional content at the end of the header.
      part { name: "e.swallow.end"; type: SWALLOW; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            align: 1.0 0.5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            rel1.offset: -5 4;
            rel1.relative: 1.0 0.0;
            rel2.offset: -5 -5;
            offscale;
         }
      }
   }
}

// This group defines a toggle widget, intended to be swallowed into the
// "e.swallow.end" part of a list item. It displays an icon that changes
// color to indicate its state (e.g., on/off).
group { name: "e/widgets/ilist/toggle_end";
   images.image: "speaker_vol.png" COMP;
   parts {
      // The main part displaying the toggle icon. It has two states: "default"
      // and "visible" (representing checked), which use different color classes.
      part { name: "base"; mouse_events: 0;
         description { state: "default" 0.0;
            image.normal: "speaker_vol.png";
            aspect: 1.0 1.0; aspect_preference: BOTH;
            color_class: "/fg/normal/list/toggle";
            rel1.relative: 0.2 0.2;
            rel2.relative: 0.8 0.8;
         }
         // This state is used when the toggle is "checked" or "on".
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/selected/list/toggle";
         }
      }
   }
   // Programs to handle the state changes of the toggle.
   programs {
      // On the "e,state,checked" signal, the icon smoothly transitions to its
      // "visible" (checked) state, changing its color.
      program { signal: "e,state,checked"; source: "e";
         action: STATE_SET "visible" 0.0;
         transition: SINUSOIDAL 0.3;
         target: "base";
      }
      // On the "e,state,unchecked" signal, the icon transitions back to its
      // default state.
      program { signal: "e,state,unchecked"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.3;
         target: "base";
      }
   }
}

