// This group defines the standard radio button widget. It's composed of several parts:
// - A "base" image for the radio circle.
// - An "indicator" image that appears when the radio is selected.
// - A "e.text.label" for the descriptive text.
// - A "clip" rectangle for masking.
// - An "event" rectangle to handle user input.
// This structure separates visual elements from interactive logic, a common and effective
// practice in Edje.
group { name: "e/widgets/radio";
   parts {
      // "base" is the background of the radio button. It's an image part that doesn't
      // handle mouse events itself (`mouse_events: 0`), as the "event" part is used for that.
      // It has a fixed size and is aligned to the left of the widget area. `offscale`
      // ensures it does not scale with the global Edje scale factor.
      part { name: "base"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/bg/normal/radio/base";
            min: 15 15;
            max: 15 15;
            rel1.offset: 3 3;
            rel2.offset: 3 -4;
            rel2.relative: 0.0 1.0;
            image.normal: "i-radio";
            align: 0.0 0.5;
            offscale;
            fixed: 1 1;
         }
         // In the "disabled" state, a different color class is applied to give it a
         // visually distinct look, indicating it's not interactive.
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/disabled/radio/base";
         }
      }
      // "clip" is a rectangle used to mask other parts, like the "indicator". This is
      // useful for ensuring that animations or state changes of other parts are
      // contained within a specific area.
      part { name: "clip"; type: RECT;
         description { state: "default" 0.0;
         }
         // When disabled, this part becomes a semi-transparent white overlay
         // (#FFFFFF99), which contributes to the disabled look of the widget.
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 153; // no cc
         }
      }
      // "indicator" is the part that visually shows the radio button's selected state.
      // It's clipped by the "clip" part and positioned relative to the "base".
      // It's invisible by default.
      part { name: "indicator"; mouse_events: 0;
         clip_to: "clip";
         description { state: "default" 0.0;
            rel.to: "base";
            image.normal: "i-radio";
            color_class: "/fg/normal/radio/radio";
            visible: 0;
         }
         // The indicator becomes visible when in the "selected" or "pressed" state.
         description { state: "selected" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/normal/radio/radio";
            visible: 1;
         }
         // The "pressed" state can use a different color to provide feedback during a click.
         description { state: "pressed" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/selected/radio/radio";
            visible: 1;
         }
      }
      // This is the text label displayed next to the radio button.
      part { name: "e.text.label"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 4 4;
            rel1.to_x: "base";
            rel1.relative: 1.0 0.0;
            rel2.offset: -5 -5;
            color_class: "/fg/normal/radio/text";
            text { font: FN; size: 10;
               min: 1 1;
               ellipsis: -1;
               align: 0.0 0.5;
               text_class: "radio_button";
            }
            offscale;
         }
         // The text color changes for "disabled" and "pressed" states to provide clear
         // visual cues to the user about the widget's status.
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/radio/text";
         }
         description { state: "pressed" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/radio/text";
         }
      }
      // This is an invisible rectangle that covers the entire widget area. Its purpose
      // is to capture all mouse events, separating the clickable area from the visual
      // representation. Using an "event" part like this is a robust way to manage user
      // interaction. `ignore_flags: ON_HOLD` prevents it from sending hold-related
      // signals, which are not needed for a radio button.
      part { name: "event"; type: RECT;
         ignore_flags: ON_HOLD;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   // The 'programs' section defines the logic and behavior of the widget. These programs
   // listen for signals (like mouse clicks or state changes) and trigger actions
   // (like changing the state of a part or emitting another signal).
   programs {
      // When the widget receives "e,state,on" or "e,state,off" signals from the application
      // code, it changes the state of the "indicator" part accordingly. This is how the
      // application logic controls the visual checked/unchecked state of the radio button.
      program { signal: "e,state,on"; source: "e";
         action: STATE_SET "selected" 0.0;
         target: "indicator";
      }
      program { signal: "e,state,off"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "indicator";
      }
      // These programs provide visual feedback when the user clicks on the widget.
      // On "mouse,down,1", the label changes to its "pressed" state (e.g., different color).
      // On "mouse,up,1", it reverts to the "default" state.
      program { signal: "mouse,down,1"; source: "event";
         action: STATE_SET "pressed" 0.0;
//         target: "indicator";
         target: "e.text.label";
      }
      program { signal: "mouse,up,1"; source: "event";
         action: STATE_SET "default" 0.0;
//         target: "indicator";
         target: "e.text.label";
      }
      // After a full click event, this program emits the "e,action,toggle" signal.
      // This is the primary signal that the application code will listen for to react
      // to the user selecting this radio button.
      program { signal: "mouse,clicked,1"; source: "event";
         action: SIGNAL_EMIT "e,action,toggle" "";
      }
      // These programs handle the enabled/disabled state of the entire widget.
      // When "e,state,disabled" is received, all relevant parts are set to their
      // "disabled" state. The "event" part is also disabled, preventing any user interaction.
      program { signal: "e,state,disabled"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "base";
         target: "clip";
         target: "e.text.label";
         target: "event";
      }
      // Re-enables the widget by setting parts back to their "default" state.
      program { signal: "e,state,enabled"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "base";
         target: "clip";
         target: "e.text.label";
         target: "event";
      }
   }
}

// This group defines a variation of the radio button that includes an icon.
// It inherits all the properties and parts from "e/widgets/radio" and then adds
// or modifies parts to accommodate the icon.
group { name: "e/widgets/radio_icon";
   inherit: "e/widgets/radio";
   parts {
      // This "SWALLOW" part is a placeholder for an external Evas object (an icon).
      // The application code can "swallow" an icon object into this part. It is
      // positioned between the radio circle ("base") and the text label.
      part { name: "e.swallow.icon"; type: SWALLOW;
         scale: 1;
         insert_before: "event";
         clip_to: "clip";
         description { state: "default" 0.0;
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "base";
            rel2.offset: 4 -5;
            rel2.relative: 1.0 1.0;
            rel1.to_x: "base";
            align: 0.0 0.5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            offscale;
         }
      }
      // This modifies the inherited "e.text.label" part. By redefining only the `rel1.to_x`
      // property, we reposition the label to be to the right of the new "e.swallow.icon"
      // part, rather than the "base" part. All other properties of the label are
      // inherited from the base "e/widgets/radio" group.
      part { name: "e.text.label";
         description { state: "default" 0.0;
            rel1.to_x: "e.swallow.icon";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/radio/text";
         }
      }
   }
}
