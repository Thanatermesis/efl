// This group defines the style for a standard label widget.
// It consists of a single text part that displays the label's content.
group { name: "e/widgets/label";
   parts {
      // The main text part of the label, where the actual text is rendered.
      part { name: "e.text.label"; type: TEXT;
         // Enables scaling of this part if the widget is scaled.
         scale: 1;
         description { state: "default" 0.0;
            // The 'rel' properties define padding. These offsets create 2px padding
            // on the top/left and 3px on the bottom/right.
            rel1.offset: 2 2;
            rel2.offset: -3 -3;
            // Use the standard text color from the theme (e.g., #000000 in a light theme).
            color_class: "/fg/normal/text";
            text { font: FN; size: 10;
               // Don't allow the part to become invisible.
               min: 1 1;
               // Add "..." at the end if text overflows. -1 is equivalent to 1.0 (end).
               ellipsis: -1;
               // Align text to the left (0.0), and centered vertically (0.5).
               align: 0.0 0.5;
               // Use the 'label' text style defined in the theme for font, etc.
               text_class: "label";
            }
         }
         description { state: "disabled" 0.0;
            // Inherits all properties from the "default" state.
            inherit: "default" 0.0;
            // Overrides only the color_class to use the disabled text color,
            // which is usually a shade of gray (e.g., #808080).
            color_class: "/fg/disabled/text";
         }
      }
   }
   // Programs handle state changes based on signals from the application code.
   programs {
      // On "e,state,disabled", set the "disabled" state on the text part.
      program { signal: "e,state,disabled"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "e.text.label";
      }
      // On "e,state,enabled", revert to the "default" state.
      program { signal: "e,state,enabled"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "e.text.label";
      }
   }
}
