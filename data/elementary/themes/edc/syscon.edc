// This group defines the main container for the system control (syscon) widget.
// It sets up a background and three swallow areas for content, along with a label
// that acts as a close button.
group { name: "e/widgets/syscon/main";
   parts {
      // The background rectangle, styled by the theme's 'syscon' color class.
      part { name: "bg"; type: RECT;
         description { state: "default" 0.0;
            color_class: "/bg/normal/syscon";
         }
      }
      // Main content area. 'SWALLOW' parts are containers where other UI components
      // can be placed at runtime. This one is at the top.
      part { name: "e.swallow.main"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 8 8;
            rel2.offset: -9 8;
            rel2.relative: 1.0 0.0;
            align: 0.5 0.0;
            // The part's width is scalable, but its height is fixed.
            fixed: 0 1;
            // offscale is an optimization to avoid rendering parts outside the viewport.
            offscale;
         }
      }
      // Secondary content area, positioned directly below the main swallow part.
      part { name: "e.swallow.secondary"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            // Positioned relative to the bottom of "e.swallow.main".
            rel.to: "e.swallow.main";
            rel1.relative: 0.0 1.0;
            align: 0.5 0.0;
            fixed: 0 1;
            offscale;
         }
      }
      // Extra content area, positioned below the secondary swallow part.
      part { name: "e.swallow.extra"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            // Positioned relative to the bottom of "e.swallow.secondary".
            rel1.to: "e.swallow.secondary";
            rel1.relative: 0.0 1.0;
            rel2.to: "e.swallow.secondary";
            align: 0.5 0.0;
            fixed: 0 1;
            offscale;
         }
      }
      // A text label, typically used for a title or action text.
      part { name: "e.text.label"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            // Positioned below the 'extra' swallow area, centered horizontally.
            rel1.offset: 0 16;
            rel1.relative: 0.5 0.0;
            rel1.to_y: "e.swallow.extra";
            rel2.offset: -1 -17;
            rel2.relative: 0.5 1.0;
            align: 0.5 1.0;
            color_class: "/fg/normal/syscon/text";
            text { font: FN; size: 10;
               min: 1 1;
               // Truncate text with '...' if it doesn't fit.
               ellipsis: -1;
               align: 0.5 0.5;
               text_class: "button";
            }
            fixed: 1 0;
            offscale;
         }
         // The 'clicked' state changes the text color to give feedback.
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/syscon/text";
         }
      }
      // An invisible rectangle that serves as the clickable area for the label.
      // This is a common technique to extend the touch/click area of a smaller element.
      part { name: "button"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            // Sized and positioned to encompass the text label with some padding.
            rel1.to: "e.text.label";
            rel1.offset: -12 -12;
            rel2.to: "e.text.label";
            rel2.offset: 11 11;
            // Transparent color (RGBA: 255, 255, 255, 0 or #FFFFFF00).
            color: 255 255 255 0; // no cc
            offscale;
         }
      }
   }
   programs {
      // When the button area is pressed (mouse down), the label's state changes to 'clicked'.
      program { signal: "mouse,down,1*"; source: "button";
         action: STATE_SET "clicked" 0.0;
         target: "e.text.label";
      }
      // When the mouse button is released, the label returns to its 'default' state.
      program { signal: "mouse,up,1"; source: "button";
         action: STATE_SET "default" 0.0;
         target: "e.text.label";
      }
      // A complete click on the button emits a 'e,action,close' signal,
      // which typically instructs the parent container to close.
      program { signal: "mouse,clicked,1*"; source: "button";
         action: SIGNAL_EMIT "e,action,close" "";
      }
   }
}

// This group defines a standard button item for use within a syscon widget.
// It includes an icon, a label, and visual feedback for different states like
// 'disabled', 'focused', and 'clicked'. The alias allows it to be used in
// the desklock UI as well, promoting reusability.
group { name: "e/widgets/syscon/item/button";
   alias: "e/desklock/pin_button";
   parts {
      // A clipping rectangle for the entire button. It has mouse events disabled
      // to avoid interfering with the main event-handling rectangle.
      part { name: "clip"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
         }
      }
      // A clipping rectangle for the icon. This is used to apply effects like
      // transparency to the icon when the button is disabled.
      part { name: "icon_clip"; type: RECT;
         description { state: "default" 0.0;
            // Fully opaque white, allows the icon to be fully visible.
            color: 255 255 255 255; // no cc
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            // Semi-transparent white (RGBA: 255, 255, 255, 64 or #FFFFFF40),
            // which dims the icon by 75%.
            color: 255 255 255 64; // no cc
         }
      }
      // A swallow part to hold the button's icon.
      part { name: "e.swallow.icon"; type: SWALLOW; mouse_events: 0;
         // The icon is clipped by 'icon_clip', so effects on 'icon_clip' (like
         // transparency) will affect the icon's appearance.
         clip_to: "icon_clip";
         scale: 1;
         description { state: "default" 0.0;
            align: 0.5 0.0;
            rel1.offset: 5 5;
            rel2.relative: 1.0 0.0;
            rel2.offset: -6 -6;
            // Positioned above the label.
            rel2.to_y: "e.text.label";
            // Maintains a square aspect ratio, with height as the reference.
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            offscale;
         }
      }
      // The text label for the button. Mouse events are disabled because the 'event'
      // part handles them.
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            // Positioned at the bottom of the button.
            rel1.relative: 0.0 1.0;
            rel1.offset: 8 -9;
            rel2.offset: -9 -9;
            align: 0.5 1.0;
            color_class: "/fg/normal/syscon/button/text";
            text { font: FN; size: 10;
               min: 1 1;
               ellipsis: -1;
               align: 0.5 0.5;
               text_class: "button";
            }
            offscale;
         }
         // Defines text color for the 'disabled' state.
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/syscon/button/text";
         }
         // Defines text color for the 'clicked' (pressed) state.
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/syscon/button/text";
         }
         // Defines text color for the 'focused' state.
         description { state: "focused" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/selected/syscon/button/text";
         }
      }
      // A visual indicator for when the button is focused, usually a colored bar.
      part { name: "sel"; type: RECT; mouse_events: 0;
         scale: 1;
         clip_to: "clip";
         description { state: "default" 0.0;
            color_class: "/bg/selected/syscon/button/bar";
            // Initially invisible.
            visible: 0;
            rel2.offset: -1 0;
            rel1.relative: 0.0 1.0;
            align: 0.5 1.0;
            // A thin bar, max height of 6 pixels.
            max: 99999 6;
            offscale;
         }
         // Becomes visible when the button is focused.
         description { state: "focused" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.0 0.5;
            visible: 1;
         }
      }
      // An invisible rectangle that captures all mouse events for the button.
      // This ensures a consistent clickable area.
      part { name: "event"; type: RECT;
         // This flag prevents the 'hold' event from being emitted, which can be
         // useful to avoid unwanted repeated actions.
         ignore_flags: ON_HOLD;
         description { state: "default" 0.0;
            // Transparent color (RGBA: 0, 0, 0, 0 or #00000000).
            color: 0 0 0 0; // no cc
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   programs {
      // On mouse down, sets the label to the 'clicked' state for visual feedback.
      program { signal: "mouse,down,1"; source: "event";
         action: STATE_SET "clicked" 0.0;
         target: "e.text.label";
      }
      // On mouse up, reverts the label to the 'default' state.
      program { signal: "mouse,up,1"; source: "event";
         action: STATE_SET "default" 0.0;
         target: "e.text.label";
      }
      // A complete click emits a generic 'e,action,click' signal. The parent widget
      // is responsible for handling this signal and performing the action.
      program { signal: "mouse,clicked,1*"; source: "event";
         action: SIGNAL_EMIT "e,action,click" "";
      }
      // When the widget is externally set to a disabled state, this program updates
      // the state of various parts to reflect this.
      program { signal: "e,state,disabled"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "event";
         target: "icon_clip";
         target: "e.text.label";
      }
      // Re-enables the button parts when the widget's state returns to enabled.
      program { signal: "e,state,enabled"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "event";
         target: "icon_clip";
         target: "e.text.label";
      }
      // When the widget gains focus (e.g., through keyboard navigation).
      program { signal: "e,state,focused"; source: "e";
         action: STATE_SET "focused" 0.0;
         // A short animation for a smoother state transition.
         transition: DECELERATE 0.2 USE_DURATION_FACTOR 1;
         target: "e.text.label";
         target: "sel";
      }
      // When the widget loses focus.
      program { signal: "e,state,unfocused"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.2 USE_DURATION_FACTOR 1;
         target: "e.text.label";
         target: "sel";
      }
   }
}

// This group defines a standalone syscon button, likely used as a gadget on a
// shelf or desktop. It uses an image and provides visual feedback for mouse
// interactions, ultimately triggering a system shutdown dialog.
group { name: "e/modules/syscon/button";
   parts {
      // The main part of the button, containing an image.
      part { name: "base";
         scale: 1;
         description { state: "default" 0.0;
            // Slightly inset from the edges of the gadget area.
            rel1.relative: 0.05 0.05;
            rel2.relative: 0.95 0.95;
            // The icon to display.
            image.normal: "i-system-shutdown";
            // Maintain a square aspect ratio, respecting both width and height.
            aspect: 1.0 1.0; aspect_preference: BOTH;
            color_class: "/fg/normal/gadgets/syscon";
            offscale;
         }
         // 'hilight' state is used for mouse-over.
         description { state: "hilight" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/selected/gadgets/syscon";
         }
         // 'clicked' state provides a "pressed in" visual effect.
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            // Shrinks and offsets the part to simulate being pressed.
            rel1.relative: 0.07 0.07;
            rel2.relative: 0.93 0.93;
            rel1.offset: 1 1;
            rel2.offset: -2 -2;
            color_class: "/fg/pressed/gadgets/syscon";
         }
      }
   }
   programs {
      // On mouse down, switch to the 'clicked' state.
      program { signal: "mouse,down,1"; source: "base";
         action: STATE_SET "clicked" 0.0;
         target: "base";
      }
      // On mouse up, switch to 'hilight' as the cursor is still over the button.
      program { signal: "mouse,up,1"; source: "base";
         action: STATE_SET "hilight" 0.0;
         target: "base";
      }
      // When the mouse enters the button area, switch to the 'hilight' state.
      program { signal: "mouse,in"; source: "base";
         action: STATE_SET "hilight" 0.0;
         target: "base";
      }
      // When the mouse leaves, return to the 'default' state.
      program { signal: "mouse,out"; source: "base";
         action: STATE_SET "default" 0.0;
         target: "base";
      }
      // On a full click, emit a signal to show the shutdown dialog.
      // The 'e' source targets the Elementary core application.
      program { signal: "mouse,clicked,1*"; source: "base";
         action: SIGNAL_EMIT "e,action,shutdown,show" "e";
      }
   }
}
