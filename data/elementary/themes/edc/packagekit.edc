// This group defines the main packagekit gadget, which shows update status.
// It includes a base icon, status indicators, and a busy animation.
group { name: "e/modules/packagekit/main";
   max: 160 160;
   // Image sets are used for resolution independence. Edje selects the best image
   // based on the part's size. This avoids scaling artifacts and improves performance.
   set { name: "pkg_base";
      image { image: "pkg-base-160.png"  COMP; size: 81 81 99999 99999; }
      image { image: "pkg-base-080.png"  COMP; size: 41 41 80 80 99999; }
      image { image: "pkg-base-040.png"  COMP; size:  0  0 40 40; }
   }
   set { name: "pkg_shade";
      image { image: "pkg-shade-160.png"  COMP; size: 81 81 99999 99999; }
      image { image: "pkg-shade-080.png"  COMP; size: 41 41 80 80 99999; }
      image { image: "pkg-shade-040.png"  COMP; size:  0  0 40 40; }
   }
   set { name: "pkg_label";
      image { image: "pkg-label-160.png"  COMP; size: 81 81 99999 99999; }
      image { image: "pkg-label-080.png"  COMP; size: 41 41 80 80 99999; }
      image { image: "pkg-label-040.png"  COMP; size:  0  0 40 40; }
   }
   images.image: "pkg-ok.png" COMP;
   images.image: "pkg-err.png" COMP;

   images.image: "pkg-busy1.png" COMP;
   images.image: "pkg-busy2.png" COMP;
   images.image: "pkg-busy3.png" COMP;
   images.image: "pkg-busy4.png" COMP;
   parts {
      // The 'base' part is the background of the gadget.
      part { name: "base";
         description { state: "default" 0.0;
            aspect: 1.0 1.0; aspect_preference: BOTH;
            color_class: "/fg/normal/gadgets/packagekit/base";
            image.normal: "pkg_base";
         }
      }
      // The 'shade' part is an overlay on the 'base' part, likely for a shadow or highlight effect.
      part { name: "shade";
         description { state: "default" 0.0;
            // 'rel.to' positions this part exactly on top of the 'base' part.
            rel.to: "base";
            image.normal: "pkg_shade";
         }
      }
      // The 'label' part is another overlay, probably for text or branding.
      part { name: "label";
         description { state: "default" 0.0;
            rel.to: "base";
            image.normal: "pkg_label";
            color_class: "/fg/normal/gadgets/packagekit/label";
         }
      }
      // Displays the number of available updates. 'scale: 1' enables smooth scaling of the text.
      part { name: "num_updates"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            // The position is defined relative to a 40x40 grid, making it resolution-independent.
            rel1.relative: (8/40) (8/40);
            rel2.relative: (32/40) (32/40);
            color_class: "/fg/normal/gadgets/packagekit/text/updates";
            text { font: FN; size: 10;
            }
         }
      }
      // This part displays a status icon (e.g., ok, error) based on the current state.
      // It has multiple descriptions, one for each state, and is mostly invisible by default.
      part { name: "status";
         description { state: "default" 0.0;
            fixed: 1 1;
            visible: 0;
         }
         // The 'running' and 'updates' states are handled by other visuals (busy animation/text).
         description { state: "running" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         description { state: "updates" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         // In 'updated' state, it shows a checkmark icon.
         description { state: "updated" 0.0;
            inherit: "default" 0.0;
            visible: 1;
            rel1.relative: (15/40) (15/40);
            rel2.relative: (25/40) (25/40);
            image.normal: "pkg-ok.png";
            color_class: "/fg/normal/gadgets/packagekit/status/ok";
         }
         // In 'error' state, it shows an error icon.
         description { state: "error" 0.0;
            inherit: "default" 0.0;
            visible: 1;
            rel1.relative: (15/40) (15/40);
            rel2.relative: (25/40) (25/40);
            image.normal: "pkg-err.png";
            color_class: "/fg/normal/gadgets/packagekit/status/error";
         }
      }
      // 'busy_clip' is a rectangle used as a clipper for the busy animation parts.
      // It controls the visibility of the animation by transitioning its color's alpha channel.
      part { name: "busy_clip"; type: RECT;
         description { state: "default" 0.0;
            // Initially transparent (#FFFFFF00) and invisible.
            color: 255 255 255 0; // no cc
            visible: 0;
         }
         description { state: "busy" 0.0;
            inherit: "default" 0.0;
            // Becomes opaque white (#FFFFFFFF) and visible when in the 'busy' state.
            color: 255 255 255 255; // no cc
            visible: 1;
         }
      }
      // The four 'busy' parts form a spinning animation to indicate work in progress.
      // They are all clipped by 'busy_clip' and rotate around the center of 'busy1'.
      // The different rotation angles (360, -360, 720, -720) create a complex visual effect.
      part { name: "busy1"; mouse_events: 0;
         clip_to: "busy_clip";
         description { state: "default" 0.0;
            fixed: 1 1;
            image.normal: "pkg-busy1.png";
            rel1.relative: (7/40) (7/40);
            rel2.relative: (33/40) (33/40);
            // 'map.on: 1' enables transformations like rotation. 'map.smooth: 1' ensures it looks good.
            map.on: 1;
            map.smooth: 1;
            map.rotation.center: "busy1";
            color_class: "/fg/normal/gadgets/packagekit/status/busy/1";
         }
         // The 'spin' state defines a 360-degree rotation.
         description { state: "spin" 0.0;
            inherit: "default" 0.0;
            map.rotation.z: 360;
         }
      }
      part { name: "busy2"; mouse_events: 0;
         clip_to: "busy_clip";
         description { state: "default" 0.0;
            fixed: 1 1;
            image.normal: "pkg-busy2.png";
            rel1.relative: (7/40) (7/40);
            rel2.relative: (33/40) (33/40);
            map.on: 1;
            map.smooth: 1;
            map.rotation.center: "busy1";
            color_class: "/fg/normal/gadgets/packagekit/status/busy/2";
         }
         description { state: "spin" 0.0;
            inherit: "default" 0.0;
            map.rotation.z: -360;
         }
      }
      part { name: "busy3"; mouse_events: 0;
         clip_to: "busy_clip";
         description { state: "default" 0.0;
            fixed: 1 1;
            image.normal: "pkg-busy3.png";
            rel1.relative: (7/40) (7/40);
            rel2.relative: (33/40) (33/40);
            map.on: 1;
            map.smooth: 1;
            map.rotation.center: "busy1";
            color_class: "/fg/normal/gadgets/packagekit/status/busy/3";
         }
         description { state: "spin" 0.0;
            inherit: "default" 0.0;
            map.rotation.z: 720;
         }
      }
      part { name: "busy4"; mouse_events: 0;
         clip_to: "busy_clip";
         description { state: "default" 0.0;
            fixed: 1 1;
            image.normal: "pkg-busy4.png";
            rel1.relative: (7/40) (7/40);
            rel2.relative: (33/40) (33/40);
            map.on: 1;
            map.smooth: 1;
            map.rotation.center: "busy1";
            color_class: "/fg/normal/gadgets/packagekit/status/busy/4";
         }
         description { state: "spin" 0.0;
            inherit: "default" 0.0;
            map.rotation.z: -720;
         }
      }
   }
   programs {
      // The 'spin' and 'spin2' programs create a continuous looping animation for the 'busy' parts.
      // This is triggered by an 'e,state,hung' signal, which is typically emitted when the application is busy.
      program { name: "spin";
         signal: "e,state,hung"; source: "e";
         // Sets the state of the busy parts to 'spin', initiating the rotation.
         action: STATE_SET "spin" 0.0;
         transition: LINEAR 1.0;
         target: "busy1";
         target: "busy2";
         target: "busy3";
         target: "busy4";
         // After the transition, it calls 'spin2' to reset.
         after: "spin2";
      }
      program { name: "spin2";
         // Resets the state of the busy parts back to 'default'.
         action: STATE_SET "default" 0.0;
         target: "busy1";
         target: "busy2";
         target: "busy3";
         target: "busy4";
         // Calls 'spin' again to continue the loop.
         after: "spin";
      }
      // The 'busy-on' program fades in the 'busy_clip', making the spinner visible.
      program { name: "busy-on";
         signal: "e,state,hung"; source: "e";
         action: STATE_SET "busy" 0.0;
         transition: SINUSOIDAL 0.25;
         target: "busy_clip";
      }
      // The 'busy-off' program fades out the 'busy_clip'. The 'after' chain ensures
      // that the animation is stopped and reset cleanly.
      program { name: "busy-off";
         signal: "e,state,unhung"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 1.0;
         target: "busy_clip";
         after: "spin3";
      }
      // 'spin3' stops the animation loop.
      program { name: "spin3";
         action: ACTION_STOP;
         target: "spin";
         target: "spin2";
         after: "spin4";
      }
      // 'spin4' resets the state of the busy parts to their default (non-rotated) state.
      program { name: "spin4";
         action: STATE_SET "default" 0.0;
         target: "busy1";
         target: "busy2";
         target: "busy3";
         target: "busy4";
      }

      // These programs respond to signals from the packagekit C module to update the gadget's UI.
      // 'packagekit,state,none' means there are no ongoing operations and no updates.
      program {
         signal: "packagekit,state,none"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "status";
         after: "busy-off";
      }
      // 'packagekit,state,working' indicates an operation is in progress.
      // The two programs below are triggered by this signal. One starts the spinning animation ('spin')
      // and the other makes it visible ('busy-on'). Both also set the 'status' part's state to 'running'.
      program {
         signal: "packagekit,state,working"; source: "e";
         action: STATE_SET "running" 0.0;
         target: "status";
         after: "spin";
      }
      program {
         signal: "packagekit,state,working"; source: "e";
         action: STATE_SET "running" 0.0;
         target: "status";
         after: "busy-on";
      }
      // 'packagekit,state,updates' means updates are available, but nothing is happening.
      // The number of updates would be set on the 'num_updates' text part from C code.
      program {
         signal: "packagekit,state,updates"; source: "e";
         action: STATE_SET "updates" 0.0;
         target: "status";
         after: "busy-off";
      }
      // 'packagekit,state,updated' means an operation finished successfully.
      // It shows the 'updated' state (checkmark icon) and stops any busy animation.
      program {
         signal: "packagekit,state,updated"; source: "e";
         action: STATE_SET "updated" 0.0;
         target: "status";
         after: "busy-off";
      }
      // 'packagekit,state,error' indicates an operation failed.
      // It shows the 'error' state (error icon) and stops any busy animation.
      program {
         signal: "packagekit,state,error"; source: "e";
         action: STATE_SET "error" 0.0;
         target: "status";
         after: "busy-off";
      }
   }
}
