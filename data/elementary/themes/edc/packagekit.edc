// Defines the icon for bugfix updates. This group is a simple container for a single image.
group { name: "e/modules/packagekit/icon/bugfix";
   images.image: "pkg-bug.png" COMP;
   parts {
      // The 'image' part displays the bug icon.
      // 'mouse_events: 0' prevents it from capturing mouse interactions, making it purely decorative.
      part { name: "image";  mouse_events: 0;
         description { state: "default" 0.0;
            image.normal: "pkg-bug.png";
            // 'aspect' and 'aspect_preference' ensure the icon maintains its proportions.
            aspect: 1.0 1.0; aspect_preference: BOTH;
            // 'color_class' allows the icon's color to be themed.
            color_class: "/fg/normal/gadgets/packagekit/pkg/bug";
         }
      }
   }
}

