// This group defines the appearance of a scrollable entry.
// It builds upon the base scroller style and adds entry-specific features like
// validation feedback and focus highlighting.
group { name: "elm/scroller/entry/default";
   inherit: "elm/scroller/base/default";
   parts {
      // The 'bg' part is the main background of the entry.
      // It uses a color class, allowing theming to change its color.
      part { name: "bg";
         description { state: "default" 0.0;
            color_class: "/bg/normal/entry";
         }
      }
      // 'validation_glow' is a rectangle used to visually indicate the validation status of the entry's content.
      // It's normally transparent and placed after 'elm.swallow.background'.
      // It changes color based on 'pass' or 'fail' states. 'mouse_events: 0' ensures it doesn't block interactions.
      part { name: "validation_glow"; type: RECT; mouse_events: 0;
         insert_after: "elm.swallow.background";
         description { state: "default" 0.0;
            color: 0 0 0 0; // #00000000, Transparent
         }
         description { state: "pass" 0.0;
            // Uses a color class for a 'pass' visual state.
            color_class: "/bg/selected/entry/validate-pass";
         }
         description { state: "fail" 0.0;
            // Uses a color class for a 'fail' visual state.
            color_class: "/bg/selected/entry/validate-fail";
         }
      }
      // This program is triggered by the 'validation,default,fail' signal from the 'elm' source.
      // It sets the 'validation_glow' part to the 'fail' state.
      program { name: "validation_fail";
         signal: "validation,default,fail";
         source: "elm";
         action: STATE_SET "fail" 0.0;
         target: "validation_glow";
      }
      // Triggered by 'validation,default,pass' signal, it sets 'validation_glow' to the 'pass' state.
      program { name: "validation_pass";
         signal: "validation,default,pass";
         source: "elm";
         action: STATE_SET "pass" 0.0;
         target: "validation_glow";
      }
      // This program resets the validation glow to its default (transparent) state.
      program { name: "validation_off";
         signal: "validation,default";
         source: "elm";
         action: STATE_SET "default" 0.0;
         target: "validation_glow";
      }
      // 'glow' is another rectangle, used for providing a focus highlight effect.
      // It is inserted before the content, so it appears behind it.
      // 'scale: 1' enables smooth scaling animations.
      part { name: "glow"; type: RECT; mouse_events: 0;
         insert_before: "elm.swallow.content";
         scale: 1;
         // Default state: invisible and positioned relative to the bottom of the 'bg' part.
         // 'offscale' ensures it's scaled down to zero, preparing for a scaling animation.
         description { state: "default" 0.0;
            rel.to: "bg";
            rel1.relative: 0.0 1.0;
            rel1.offset: 0 0;
            color_class: "/bg/selected/entry/focus";
            color: 255 255 255 0; // #FFFFFF00, Transparent white
            visible: 0;
            offscale;
         }
         // Focused state: becomes visible, fully opaque white, and slightly offset for a visual effect.
         description { state: "focused" 0.0;
            inherit: "default" 0.0;
            rel1.offset: 0 -3;
            color: 255 255 255 255; // #FFFFFFFF, Opaque white
            visible: 1;
         }
      }
      // This program shows the focus highlight.
      // On 'elm,action,focus_highlight,show' signal, it transitions 'glow' to the 'focused' state.
      // The transition is a 0.3-second deceleration curve, creating a smooth animation.
      program { signal: "elm,action,focus_highlight,show"; source: "elm";
         action: STATE_SET "focused" 0.0;
         transition: DECELERATE 0.3;
         target: "glow";
      }
      // This program hides the focus highlight with the same smooth transition.
      program { signal: "elm,action,focus_highlight,hide"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.3;
         target: "glow";
      }
      // This is the main content area of the entry, where the actual text widget will be placed.
      // It's a SWALLOW part, meaning it can host external Evas objects.
      // Its position is relative to the icon and end parts, so it resizes to fill the available space between them.
      part { name: "elm.swallow.content";
         scale: 1;
         clip_to: "clipper";
         description { state: "default" 0.0;
            rel1.to_x: "elm.swallow.icon";
            rel1.relative: 1.0 0.0;
            rel1.offset: 2 2;
            rel2.to_x: "elm.swallow.end";
            rel2.relative: 0.0 1.0;
            rel2.offset: -3 -3;
            offscale;
         }
      }
      // 'elm.swallow.icon' is a container for an optional icon at the start of the entry.
      // It is invisible by default.
      part { name: "elm.swallow.icon"; type: SWALLOW;
         clip_to: "clipper";
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "bg";
            rel1.offset: -1 2;
            rel2.offset: -1 -3;
            rel2.relative: 0.0 1.0;
            visible: 0;
            align: 0.0 0.5;
            offscale;
         }
         // When in the 'visible' state, it appears and is given a minimum size.
         // 'aspect_preference' and 'aspect' help maintain the icon's proportions.
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
            rel1.offset: 2 2;
            rel2.offset: 2 -3;
            min: 16 16;
            aspect_preference: VERTICAL;
            aspect: 1.0 1.0;
         }
      }
      // Programs to control the visibility of the icon.
      program { signal: "elm,action,show,icon"; source: "elm";
         action: STATE_SET "visible" 0.0;
         target: "elm.swallow.icon";
      }
      program { signal: "elm,action,hide,icon"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "elm.swallow.icon";
      }
      // 'elm.swallow.end' is a container for an optional widget at the end of the entry (e.g., a clear button).
      // Similar to the icon part, it's invisible by default.
      part { name: "elm.swallow.end"; type: SWALLOW;
         clip_to: "clipper";
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "bg";
            rel1.offset: 0 2;
            rel1.relative: 1.0 0.0;
            rel2.offset: 0 -3;
            visible: 0;
            align: 1.0 0.5;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
            rel1.offset: -3 2;
            rel2.offset: -3 -3;
            min: 16 16;
            aspect_preference: VERTICAL;
            aspect: 1.0 1.0;
         }
      }
      // Programs to control the visibility of the end widget.
      program { signal: "elm,action,show,end"; source: "elm";
         action: STATE_SET "visible" 0.0;
         target: "elm.swallow.end";
      }
      program { signal: "elm,action,hide,end"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "elm.swallow.end";
      }
   }
}

// This group defines a single-line entry, often used in widgets like combo boxes.
// It includes a circular vertical shadow image and enables focus highlighting by default.
group { name: "elm/scroller/entry_single/default";
   alias: "elm/scroller/entry_single/combobox_vertical/default";
   images.image: "shadow_circle_vert.png" COMP;

   // This data item enables the focus highlight feature for this widget.
   data.item: "focus_highlight" "on";
   parts {
      // 'clipper' is a rectangle used to clip the content of the entry, ensuring nothing is drawn outside its bounds.
      part { name: "clipper"; type: RECT;
         description { state: "default" 0.0;
         }
      }
      // These parts define the components for a vertical scrollbar.
      // Even though this is a single-line entry, these parts might be included for structural consistency
      // with multi-line entries, but are set to 'visible: 0' so they don't appear.
      part { name: "sb_vbar_base"; type: RECT;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel2.relative: 1.0 0.0;
            visible: 0;
         }
      }
      part { name: "elm.dragable.vbar"; type: RECT;
         dragable.x: 0 0 0;
         dragable.y: 1 1 0;
         dragable.confine: "sb_vbar_base";
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1.relative: 0.5  0.5;
            rel1.to: "sb_vbar_base";
            rel2.relative: 0.5  0.5;
            rel2.to: "sb_vbar_base";
            visible: 0;
         }
      }
      // Similarly, these parts are for a horizontal scrollbar, also hidden.
      part { name: "sb_hbar_base"; type: RECT;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1.relative: 1.0 0.0;
            visible: 0;
         }
      }
      part { name: "elm.dragable.hbar"; type: RECT;
         dragable.x: 1 1 0;
         dragable.y: 0 0 0;
         dragable.confine: "sb_hbar_base";
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1.relative: 0.5  0.5;
            rel1.to: "sb_hbar_base";
            rel2.relative: 0.5  0.5;
            rel2.to: "sb_hbar_base";
            visible: 0;
         }

      }
      // The following parts ('bg', 'elm.swallow.background', 'validation_glow', 'glow', 'elm.swallow.content',
      // 'elm.swallow.icon', and 'elm.swallow.end') serve similar purposes as in the 'elm/scroller/entry/default'
      // group, defining the background, content areas, and visual feedback elements.
      part { name: "bg"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "elm.swallow.background";
            color_class: "/bg/normal/entry";
         }
      }
      part { name: "elm.swallow.background"; type: SWALLOW;
         clip_to: "clipper";
         description { state: "default" 0.0;
         }
      }
      part { name: "validation_glow"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            color: 0 0 0 0; // #00000000, Transparent
         }
         description { state: "pass" 0.0;
            color_class: "/bg/selected/entry/validate-pass";
         }
         description { state: "fail" 0.0;
            color_class: "/bg/selected/entry/validate-fail";
         }
      }
      part { name: "glow"; type: RECT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "bg";
            rel1.relative: 0.0 1.0;
            rel1.offset: 0 0;
            color_class: "/bg/selected/entry/focus";
            color: 255 255 255 0; // #FFFFFF00, Transparent white
            visible: 0;
            offscale;
         }
         description { state: "focused" 0.0;
            inherit: "default" 0.0;
            rel1.offset: 0 -3;
            color: 255 255 255 255; // #FFFFFFFF, Opaque white
            visible: 1;
         }
      }
      // The focus highlight animation is slightly faster here (0.2s vs 0.3s).
      program { signal: "elm,action,focus_highlight,show"; source: "elm";
         action: STATE_SET "focused" 0.0;
         transition: DECELERATE 0.2;
         target: "glow";
      }
      program { signal: "elm,action,focus_highlight,hide"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.2;
         target: "glow";
      }

      part { name: "elm.swallow.content"; type: SWALLOW;
         scale: 1;
         clip_to: "clipper";
         description { state: "default" 0.0;
            rel1.to_x: "elm.swallow.icon";
            rel1.relative: 1.0 0.0;
            rel1.offset: 2 2;
            rel2.to_x: "elm.swallow.end";
            rel2.relative: 0.0 1.0;
            rel2.offset: -3 -3;
            offscale;
         }
      }
      part { name: "elm.swallow.icon"; type: SWALLOW;
         scale: 1;
         clip_to: "clipper";
         description { state: "default" 0.0;
            fixed: 1 1;
            rel2.relative: 0.0 1.0;
            rel1.offset: -1 2;
            rel2.offset: -1 -3;
            visible: 0;
            align: 0.0 0.5;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            rel1.offset: 2 2;
            rel2.offset: 2 -3;
            visible: 1;
            min: 16 16;
            aspect_preference: VERTICAL;
            aspect: 1.0 1.0;
         }
      }
      program { signal: "elm,action,show,icon"; source: "elm";
         action: STATE_SET "visible" 0.0;
         target: "elm.swallow.icon";
      }
      program { signal: "elm,action,hide,icon"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "elm.swallow.icon";
      }

      part { name: "elm.swallow.end"; type: SWALLOW;
         scale: 1;
         clip_to: "clipper";
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1.relative: 1.0 0.0;
            rel1.offset: 0 2;
            rel2.offset: 0 -3;
            visible: 0;
            align: 1.0 0.5;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            rel1.offset: -3 2;
            rel2.offset: -3 -3;
            visible: 1;
            min: 16 16;
            aspect_preference: VERTICAL;
            aspect: 1.0 1.0;
         }
      }
      program { signal: "elm,action,show,end"; source: "elm";
         action: STATE_SET "visible" 0.0;
         target: "elm.swallow.end";
      }
      program { signal: "elm,action,hide,end"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "elm.swallow.end";
      }

      // 'elm.swallow.overlay' is a container that spans the entire area between the icon and end parts.
      // It can be used to display an overlay on top of the entry content, for example, a custom guide text or icon.
      part { name: "elm.swallow.overlay"; type: SWALLOW;
         clip_to: "clipper";
         description { state: "default" 0.0;
            rel1.to: "elm.swallow.icon";
            rel2.to: "elm.swallow.end";
         }
      }

      // 'sh_left' part creates a shadow effect on the left side of the entry.
      // It uses the 'shadow_circle_vert.png' image and is invisible by default.
      part { name: "sh_left"; mouse_events: 0;
         scale: 1;
         clip_to: "sh_clip";
         description { state: "default" 0.0;
            color: 255 255 255 0; // #FFFFFF00, Transparent white
            color_class: "/shadow/normal/entry";
            rel.to: "bg";
            rel1.offset: -1 0;
            rel2.offset: -1 -1;
            rel2.relative: 0.0 1.0;
            image.normal: "shadow_circle_vert.png";
            visible: 0;
            offscale;
         }
         // When visible, the shadow becomes opaque and is offset to appear correctly.
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // #FFFFFFFF, Opaque white
            rel1.offset: -16 0;
            rel2.offset: 15 -1;
            visible: 1;
         }
      }
      // Programs to animate the appearance and disappearance of the left shadow.
      program { signal: "elm,action,show,left"; source: "elm";
         action: STATE_SET "visible" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_left";
      }
      program { signal: "elm,action,hide,left"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_left";
      }
      // 'sh_right' provides a similar shadow effect for the right side of the entry.
      part { name: "sh_right"; mouse_events: 0;
         scale: 1;
         clip_to: "sh_clip";
         description { state: "default" 0.0;
            color: 255 255 255 0; // #FFFFFF00, Transparent white
            color_class: "/shadow/normal/entry";
            rel.to: "bg";
            rel1.relative: 1.0 0.0;
            rel1.offset: 0 0;
            rel2.offset: 0 -1;
            image.normal: "shadow_circle_vert.png";
            visible: 0;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // #FFFFFFFF, Opaque white
            rel1.offset: -16 0;
            rel2.offset: 15 -1;
            visible: 1;
         }
      }
      // Programs to animate the right shadow.
      program { signal: "elm,action,show,right"; source: "elm";
        action: STATE_SET "visible" 0.0;
        transition: DECELERATE 0.3;
        target: "sh_right";
      }
      program { signal: "elm,action,hide,right"; source: "elm";
        action: STATE_SET "default" 0.0;
        transition: DECELERATE 0.3;
        target: "sh_right";
      }

      // 'sh_clip' is a clipping rectangle for the shadows, ensuring they don't spill outside the widget's background area.
      part { name: "sh_clip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "elm.swallow.background";
         }
      }
   }
   // This block groups programs that apply to the whole group.
   // These programs handle validation signals, controlling the state of 'validation_glow'
   // to show 'pass' or 'fail' feedback, or reset it to the default state.
   programs {
      program { signal: "validation,default,fail"; source: "elm";
         action: STATE_SET "fail" 0.0;
         target: "validation_glow";
      }
      program { signal: "validation,default,pass"; source: "elm";
         action: STATE_SET "pass" 0.0;
         target: "validation_glow";
      }
      program { signal: "validation,default"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "validation_glow";
      }
   }
}

// This group defines the appearance and behavior of the text cursor in an entry field.
group { name: "elm/entry/cursor/default";
   min: 1 0;
   parts {
      // The 'cursor' part is the visual representation of the text cursor.
      // It's a rectangle with a minimum width of 1 and height of 10.
      part { name: "cursor"; type: RECT; mouse_events: 0;
         scale: 1;
         clip_to: "clipper";
         description { state: "default" 0.0;
            min: 1 10;
            color_class: "/fg/normal/entry/cursor";
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // 'clipper' is used to hide the cursor. When the text is selected,
      // the cursor should not be visible. This is achieved by making the clipper invisible.
      part { name: "clipper"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "cursor";
            fixed: 1 1;
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   programs {
      // When text selection changes, hide the cursor by setting the clipper to its 'hidden' state.
      program { signal: "selection,changed"; source: "elm.text";
         action: STATE_SET "hidden" 0.0;
         target: "clipper";
      }
      // When selection is cleared or reset, show the cursor again.
      program { signal: "selection,cleared"; source: "elm.text";
         action: STATE_SET "default" 0.0;
         target: "clipper";
      }
      program { signal: "selection,reset"; source: "elm.text";
         action: STATE_SET "default" 0.0;
         target: "clipper";
      }
      // When the entry gains focus, this program starts the cursor blinking animation.
      // 'ACTION_STOP' stops any ongoing cursor animations before starting a new one.
      // It targets all cursor-related programs and then calls 'cursor_show' to start the blinking.
      program { signal: "elm,action,focus"; source: "elm";
         action: ACTION_STOP;
         target: "cursor_show";
         target: "cursor_hide";
         target: "cursor_show_timer";
         target: "cursor_hide_timer";
         after: "cursor_show";
      }
      // When the entry loses focus, this program stops the blinking and hides the cursor.
      program { signal: "elm,action,unfocus"; source: "elm";
         action: ACTION_STOP;
         target: "cursor_show";
         target: "cursor_hide";
         target: "cursor_show_timer";
         target: "cursor_hide_timer";
         after: "cursor_hide_stop";
      }
      // Manually trigger the cursor to show.
      program { signal: "elm,action,show,cursor"; source: "elm";
         action: ACTION_STOP;
         target: "cursor_show";
         target: "cursor_hide";
         target: "cursor_show_timer";
         target: "cursor_hide_timer";
         after: "cursor_show";
      }
      // This set of programs creates the blinking effect for the cursor.
      // 'cursor_show' makes the cursor visible and starts a timer.
      // 'cursor_show_timer' waits for 0.5 seconds then calls 'cursor_hide'.
      // 'cursor_hide' makes the cursor invisible and starts another timer.
      // 'cursor_hide_timer' waits for 0.3 seconds then calls 'cursor_show', completing the loop.
      // 'cursor_hide_stop' is used to permanently hide the cursor when unfocused.
      program { name: "cursor_hide_stop";
         action: STATE_SET "default" 0.0;
         target: "cursor";
      }
      program { name: "cursor_show";
         action: STATE_SET "visible" 0.0;
         target: "cursor";
         after: "cursor_show_timer";
      }
      program { name: "cursor_hide";
         action: STATE_SET "default" 0.0;
         target: "cursor";
         after: "cursor_hide_timer";
      }
      program { name: "cursor_show_timer";
         in: 0.5 0.0;
         after: "cursor_hide";
      }
      program { name: "cursor_hide_timer";
         in: 0.3 0.0;
         after: "cursor_show";
      }
   }
}

// This group defines the appearance of the text selection highlight.
group { name: "elm/entry/selection/default";
   parts {
      // The 'base' part is a simple rectangle that uses a color class to style the selection area.
      part { name: "base"; type: RECT;
         description { state: "default" 0.0;
            color_class: "/bg/normal/entry/selection";
         }
      }
   }
}

// Defines the visual style for text anchors, which are typically used to mark hyperlink-like regions in text.
group { name: "elm/entry/anchor/default";
   parts {
      // The 'bar' part is a rectangle that appears under the anchor text.
      // It's positioned relative to the bottom of the anchor's geometry.
      part { name: "bar"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/fg/normal/entry/anchor";
            fixed: 0 1;
            rel1.relative: 0.0 1.0;
            rel1.offset: -1 -1;
            rel2.offset: 0 -1;
            offscale;
         }
      }
   }
}

// This is the base group for a standard, multi-line text entry.
group { name: "elm/entry/base/default";
   // The 'styles' block defines various text styles used within the entry.
   // These can be applied to the textblock parts.
   styles {
      // Default style for the entry text.
      // 'wrap=word' enables word wrapping. 'FN' is a macro for the default font name.
      // 'color=cc:' makes the color themeable via a color class.
      style { name: "entry_style";
         base: "font="FN" font_size=10 color=cc:/fg/normal/entry/text wrap=word text_class=entry_text left_margin=2 right_margin=2";
         // This macro includes a set of tags that can be used to format the text (e.g., bold, italic).
         ENABLED_TEXTBLOCK_TAGS
      }
      // A style for text that should not wrap.
      style { name: "entry_nowrap_style";
         base: "font="FN" font_size=10 color=cc:/fg/normal/entry/text text_class=entry_text left_margin=2 right_margin=2";
         ENABLED_TEXTBLOCK_TAGS
      }
      // Style for the entry when it is disabled.
      style { name: "entry_disabled_style";
         base: "font="FN" font_size=10 color=cc:/fg/disabled/entry/text wrap=word text_class=entry_text_disabled left_margin=2 right_margin=2";
         // In disabled state, formatting tags are usually turned off.
         DISABLED_TEXTBLOCK_TAGS
      }
      style { name: "entry_nowrap_disabled_style";
         base: "font="FN" font_size=10 color=cc:/fg/disabled/entry/text text_class=entry_text_disabled left_margin=2 right_margin=2";
         DISABLED_TEXTBLOCK_TAGS
      }
      // Style for the guide text (placeholder). It has a different color and no ellipsis.
      style { name: "entry_guide_style";
         base: "font="FN" font_size=10 color=cc:/fg/normal/entry/text/guide wrap=word text_class=entry_guide_text left_margin=2 right_margin=2 ellipsis=0.0";
         DISABLED_TEXTBLOCK_TAGS
      }
   }
//   data.item: "context_menu_orientation" "horizontal";
   parts {
      // A swallow part for the background, which can be provided by the user of the widget.
      part { name: "elm.swallow.background"; type: SWALLOW;
         description { state: "default" 0.0;
         }
      }
      // The 'elm.guide' part displays the placeholder text when the entry is empty.
      // It's a TEXTBLOCK and is positioned relative to the main text part.
      part { name: "elm.guide"; type: TEXTBLOCK; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "elm.text";
            text { style: "entry_guide_style";
               min: 0 1;
               align: 0.0 0.0;
            }
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // This is the main TEXTBLOCK part for the entry's text.
      part { name: "elm.text"; type: TEXTBLOCK;
         scale: 1;
         // 'entry_mode: EDITABLE' allows the user to modify the text.
         entry_mode: EDITABLE;
         // 'select_mode: DEFAULT' enables standard text selection behavior.
         select_mode: DEFAULT;
//         select_mode: EXPLICIT;
         // 'cursor_mode: BEFORE' places the cursor before the character it's at.
         cursor_mode: BEFORE;
         // 'multiline: 1' allows the entry to have multiple lines of text.
         multiline: 1;
         // These 'source' properties link to other EDC groups to style different aspects of the text.
         source: "elm/entry/selection/default"; // Style for text selection, rendered under the text.
//         source2: "X"; // selection over
//         source3: "X"; // cursor under
         source4: "elm/entry/cursor/default"; // Style for the cursor, rendered over the text.
//         source5: "elm/entry/anchor/default"; // anchor under
         source6: "elm/entry/anchor/default"; // Style for anchors, rendered over the text.
         description { state: "default" 0.0;
            /* we gotta use 0 0 here, because of scrolled entries */
            // 'fixed: 0 0' allows the textblock to resize freely. Important for scrolled entries.
            fixed: 0 0;
            rel1.offset: 2 2;
            rel2.offset: -3 -3;
            text { style: "entry_style";
               min: 0 1;
               align: 0.0 0.0; // Left-align text.
            }
            offscale;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            text.style: "entry_disabled_style";
         }
      }
   }
   programs {
      // On load, set the focus to the main text part.
      program { signal: "load"; source: "";
         action: FOCUS_SET;
         target: "elm.text";
      }
      // These programs switch the text part between 'default' and 'disabled' states based on signals from elm.
      program { signal: "elm,state,disabled"; source: "elm";
         action: STATE_SET "disabled" 0.0;
         target: "elm.text";
      }
      program { signal: "elm,state,enabled"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "elm.text";
      }
      // These programs control the visibility of the guide text.
      program { signal: "elm,guide,disabled"; source: "elm";
         action: STATE_SET "hidden" 0.0;
         target: "elm.guide";
      }
      program { signal: "elm,guide,enabled"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "elm.guide";
      }
      // This program demonstrates an inline script, a powerful feature of Edje.
      // It triggers on every keydown event in the text entry.
      program { signal: "entry,keydown"; source: "elm.text";
         // The script runs a small piece of Embryo code (a Pawn-like scripting language).
         script {
            // 'new buf[32];' declares a character buffer.
            new buf[32];
            // 'snprintf' creates a string like "key-down1", "key-down2", etc., by picking a random number from 1 to 5.
            snprintf(buf, 31, "key-down%i", (rand() % 5) + 1);
            // 'run_program(get_program_id(buf));' executes one of the 'key-down' programs defined below.
            // This is a clever way to add variety, playing a random sound for each key press.
            run_program(get_program_id(buf));
         }
      }
      // These programs are triggered by the script above. Each one plays a different 'key-tap' sound sample.
      // 'PLAY_SAMPLE' action plays a pre-loaded sound. The 'INPUT' flag indicates it's a UI feedback sound.
      program { name: "key-down1";
         action: PLAY_SAMPLE "key-tap1" 1.0 INPUT;
      }
      program { name: "key-down2";
         action: PLAY_SAMPLE "key-tap2" 1.0 INPUT;
      }
      program { name: "key-down3";
         action: PLAY_SAMPLE "key-tap3" 1.0 INPUT;
      }
      program { name: "key-down4";
         action: PLAY_SAMPLE "key-tap4" 1.0 INPUT;
      }
      program { name: "key-down5";
         action: PLAY_SAMPLE "key-tap5" 1.0 INPUT;
      }
   }
}

// An entry variant that uses 'mixed' word wrapping.
// This mode wraps text at word boundaries, but will break words if a single word is longer than the line.
group { name: "elm/entry/base-mixedwrap/default";
   inherit: "elm/entry/base/default";
   styles {
      style { name: "entry_style_mixedwrap";
         base: "font="FN" font_size=10 color=cc:/fg/normal/entry/text wrap=mixed text_class=entry_text left_margin=2 right_margin=2";
         ENABLED_TEXTBLOCK_TAGS
      }
      style { name: "entry_disabled_style_mixedwrap";
         base: "font="FN" font_size=10 color=cc:/fg/disabled/entry/text wrap=mixed text_class=entry_text_disabled left_margin=2 right_margin=2";
         DISABLED_TEXTBLOCK_TAGS
      }
      style { name: "entry_guide_style_mixedwrap";
         base: "font="FN" font_size=10 color=cc:/fg/disabled/entry/text/guide wrap=mixed text_class=entry_guide_text left_margin=2 right_margin=2 ellipsis=0.0";
         DISABLED_TEXTBLOCK_TAGS
      }
   }
   parts {
      part { name: "elm.guide"; type: TEXTBLOCK; mouse_events: 0;
         description { state: "default" 0.0;
            text.style: "entry_guide_style_mixedwrap";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      part { name: "elm.text";
         description { state: "default" 0.0;
            fixed: 1 0;
            text.style: "entry_style_mixedwrap";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            text { style: "entry_disabled_style_mixedwrap";
               min: 0 1;
            }
         }
      }
   }
}

// An entry variant that uses 'char' wrapping, breaking lines at any character.
group { name: "elm/entry/base-charwrap/default";
   inherit: "elm/entry/base/default";
   styles {
      style { name: "entry_style_charwrap";
         base: "font="FN" font_size=10 color=cc:/fg/normal/entry/text wrap=char text_class=entry_text left_margin=2 right_margin=2";
         ENABLED_TEXTBLOCK_TAGS
      }
      style { name: "entry_disabled_style_charwrap";
         base: "font="FN" font_size=10 color=cc:/fg/disabled/entry/text wrap=char text_class=entry_text_disabled left_margin=2 right_margin=2";
         DISABLED_TEXTBLOCK_TAGS
      }
      style { name: "entry_guide_style_charwrap";
         base: "font="FN" font_size=10 color=cc:/fg/disabled/entry/text/guide wrap=char text_class=entry_guide_text left_margin=2 right_margin=2 ellipsis=0.0";
         DISABLED_TEXTBLOCK_TAGS
      }
   }
   parts {
      part { name: "elm.guide"; type: TEXTBLOCK; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            text.style: "entry_guide_style_charwrap";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      part { name: "elm.text";
         description { state: "default" 0.0;
            fixed: 1 1;
            text.style: "entry_style_charwrap";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            text { style: "entry_disabled_style_charwrap";
               min: 0 1;
            }
         }
      }
   }
}

// An entry variant where text does not wrap.
group { name: "elm/entry/base-nowrap/default";
   inherit: "elm/entry/base/default";
   parts {
      part { name: "elm.guide"; type: TEXTBLOCK; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            text.style: "entry_guide_style";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      part { name: "elm.text";
         description { state: "default" 0.0;
            text { style: "entry_nowrap_style";
               min: 1 1;
               // 'ellipsis: -1' makes the text fade out at the end if it's too long to fit.
               ellipsis: -1;
            }
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            text { style: "entry_nowrap_disabled_style";
               min: 0 1;
            }
         }
      }
   }
}

// Defines a single-line entry.
group { name: "elm/entry/base-single/default";
   inherit: "elm/entry/base/default";
   alias: "elm/entry/base-single/combobox_vertical/default";
   alias: "elm/entry/base-single/combobox_vertical/entry";
   styles {
      style { name: "entry_single_style";
         base: "font="FN" font_size=10 color=cc:/fg/normal/entry/text wrap=none text_class=entry_text left_margin=2 right_margin=2";
         ENABLED_TEXTBLOCK_TAGS
      }
      style { name: "entry_single_disabled_style";
         base: "font="FN" font_size=10 color=cc:/fg/disabled/entry/text wrap=none text_class=entry_text_disabled left_margin=2 right_margin=2";
         DISABLED_TEXTBLOCK_TAGS
      }
      style { name: "entry_single_guide_style";
         base: "font="FN" font_size=10 color=cc:/fg/disabled/entry/text/guide wrap=none text_class=entry_guide_text left_margin=2 right_margin=2 ellipsis=0.0";
         DISABLED_TEXTBLOCK_TAGS
      }
   }
   parts {
      part { name: "elm.guide"; type: TEXTBLOCK; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            text { style: "entry_single_guide_style";
               align: 0.0 0.5;
            }
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      part { name: "elm.text";
         // 'multiline: 0' restricts the entry to a single line.
         multiline: 0;
         description { state: "default" 0.0;
            text { style: "entry_single_style";
               min: 1 1;
               ellipsis: -1;
               max: 0 0;
               align: 0.0 0.5;
            }
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            text.style: "entry_single_disabled_style";
         }
      }
   }
}

// A single-line entry variant for spinners, where the text is centered.
group { name: "elm/entry/base-single/spinner/default";
   alias: "elm/entry/base-single/spinner/vertical";
   inherit: "elm/entry/base-single/default";
   styles {
      style { name: "entry_single_spinner_style";
         base: "font="FN" font_size=10 color=cc:/fg/normal/entry/text align=center wrap=none text_class=entry_text left_margin=2 right_margin=2";
         ENABLED_TEXTBLOCK_TAGS
      }
   }
   parts {
      part { name: "elm.text";
         description { state: "default" 0.0;
            text.style: "entry_single_spinner_style";
         }
      }
   }
}

// A non-editable, single-line entry. Useful for displaying text that can be selected but not changed.
group { name: "elm/entry/base-single-noedit/default";
   inherit: "elm/entry/base/default";
   parts {
      part { name: "elm.text";
         // 'entry_mode: PLAIN' makes the text non-editable.
         entry_mode: PLAIN;
         multiline: 0;
         source: "elm/entry/selection/default"; // selection under
         // No cursor is needed since the text is not editable.
         source4: ""; // cursorover
         source6: "elm/entry/anchor/default"; // anchor over
         description { state: "default" 0.0;
            text { style: "entry_single_style";
               min: 1 1;
               ellipsis: -1;
               max: 0 0;
               align: 0.0 0.5;
            }
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            text.style: "entry_single_disabled_style";
         }
      }
   }
}

// A non-editable, multi-line entry.
group { name: "elm/entry/base-noedit/default";
   inherit: "elm/entry/base/default";
   parts {
      part { name: "elm.text";
         entry_mode: PLAIN;
         source: "elm/entry/selection/default"; // selection under
         source4: ""; // cursorover
         source6: "elm/entry/anchor/default"; // anchor over
         description { state: "default" 0.0;
            fixed: 1 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            text.style: "entry_disabled_style";
         }
      }
   }
}

// A non-editable entry with mixed wrapping.
group { name: "elm/entry/base-noedit-mixedwrap/default";
   inherit: "elm/entry/base/default";
   parts {
      part { name: "elm.text";
         entry_mode: PLAIN;
         source: "elm/entry/selection/default"; // selection under
         source4: ""; // cursorover
         source6: "elm/entry/anchor/default"; // anchor over
         description { state: "default" 0.0;
            fixed: 1 0;
            text.style: "entry_style_mixedwrap";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            text.style: "entry_disabled_style_mixedwrap";
         }
      }
   }
}

// A non-editable entry with character wrapping.
group { name: "elm/entry/base-noedit-charwrap/default";
   inherit: "elm/entry/base/default";
   parts {
      part { name: "elm.text";
         entry_mode: PLAIN;
         source: "elm/entry/selection/default"; // selection under
         source4: ""; // cursorover
         source6: "elm/entry/anchor/default"; // anchor under
         description { state: "default" 0.0;
            fixed: 1 0;
            text.style: "entry_style_charwrap";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            text.style: "entry_disabled_style_charwrap";
         }
      }
   }
