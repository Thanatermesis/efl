/* genlist widget item style information

   [SIGNAL]
      elm,state,focused: Emitted when an item is focused only when an item's "focus_highlight" is "on".
      elm,state,unfocused: Emitted when an item is unfocused only when an item's "focus_highlight" is "on".
*/

// Macro to create an odd-row variant of a genlist item style.
// It inherits from a source style and overrides the background color.
#define ODD(_NAME, _SRC) \
   group { _NAME; \
      inherit: _SRC; \
      parts { \
         rect { "base"; \
            desc { "default"; \
               color_class: "/bg-alt/normal/list/item"; \
            } \
         } \
      } \
   }
// Macro for a 'compress' style variant, where text properties are adjusted
// to minimize vertical space. text.min is set to 0 1, and ellipsis is disabled.
#define COMPRESS(_NAME, _SRC) \
   group { _NAME; \
      inherit: _SRC; \
      parts { \
         text { "elm.text"; \
            desc { "default"; \
               text.min: 0 1; \
               text.ellipsis: 0.0; \
            } \
            desc { "selected"; \
               text.min: 0 1; \
               text.ellipsis: 0.0; \
            } \
            desc { "disabled"; \
               text.min: 0 1; \
               text.ellipsis: 0.0; \
            } \
            desc { "flip_enabled"; \
               text.min: 0 1; \
               text.ellipsis: 0.0; \
            } \
         } \
      } \
   }
// Macro that combines the 'compress' and 'odd' styles.
#define COMPRESS_ODD(_NAME, _SRC) \
   group { name: _NAME; \
      inherit: _SRC; \
      parts { \
         text { "elm.text"; \
            desc { "default"; \
               text.min: 0 1; \
               text.ellipsis: 0.0; \
            } \
            desc { "selected"; \
               text.min: 0 1; \
               text.ellipsis: 0.0; \
            } \
            desc { "disabled"; \
               text.min: 0 1; \
               text.ellipsis: 0.0; \
            } \
            desc { "flip_enabled"; \
               text.min: 0 1; \
               text.ellipsis: 0.0; \
            } \
         } \
         rect { "base"; \
            desc { "default"; \
               color_class: "/bg-alt/normal/list/item"; \
            } \
         } \
      } \
   }

#define TREEPAD (ICMIN+4)

// This group defines the style for a group index item in a genlist.
// It's typically used as a header for a section of items.
group { "elm/genlist/item/group_index/default"; nomouse; program_source: "elm";
   // data.item properties provide metadata to the Elementary widget.
   // "texts" maps the "elm.text" part to the main text of the item.
   data.item: "texts" "elm.text";
   // "contents" maps swallow parts that can hold custom content.
   data.item: "contents" "elm.swallow.icon elm.swallow.end";
   // "treesize" defines the indentation width for tree styles.
   data.item: "treesize" TREEPAD;

   parts {
      // "base" is a rectangle that serves as the background for the group index.
      rect { "base";
         desc { "default";
            color_class: "/bg/normal/list/group";
         }
      }
      // "elm.text" is the text part for the group index's title.
      text { "elm.text";
         scale;
         desc { "default";
            offscale;
            min: 0 ICMIN;
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "elm.swallow.icon";
            rel2.offset: -5 -5;
            rel2.relative: 0.0 1.0;
            rel2.to_x: "elm.swallow.end";
            align: 0.0 0.5;
            color_class: "/fg/normal/list/group";
            text { font: FNBD; size: 10;
               min: 1 1;
               ellipsis: -1;
               align: 0.0 0.5;
               text_class: "list_group_item";
            }
            link.base: "elm,state,enabled";
            min: 0 ICMIN;
         }
         desc { "disabled";
            inherit: "default";
            color_class: "/fg/disabled/list/group";
            link.base: "elm,state,disabled";
         }
      }
      // "elm.swallow.pad" is a swallow part used for padding on the left side,
      // creating space for tree indentation if needed.
      swallow { "elm.swallow.pad"; mouse;
         scale;
         desc { "default";
            offscale;
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
         }
      }
      // "elm.swallow.icon" is a swallow part for an icon, positioned to the right of the padding.
      swallow { "elm.swallow.icon"; mouse;
         scale;
         desc { "default";
            offscale;
            min: ICMIN ICMIN;
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.to_x: "elm.swallow.pad";
            rel1.relative: 1.0 0.0;
            rel1.offset: 0 2;
            rel2.to_x: "elm.swallow.pad";
            rel2.relative: 1.0 1.0;
            rel2.offset: 0 -3;
         }
      }
      // "elm.swallow.end" is a swallow part for content at the end (right side) of the item.
      swallow { "elm.swallow.end"; mouse;
         scale;
         desc { "default";
            offscale;
            min: ICMIN ICMIN;
            fixed: 1 0;
            align: 1.0 0.5;
            rel1.offset: -5 4;
            rel1.relative: 1.0 0.0;
            rel2.offset: -5 -5;
         }
      }
   }
}
// This is a compressed version of the group index, inheriting from the default
// and modifying the text part to use less space.
group { "elm/genlist/item_compress/group_index/default"; nomouse;
   inherit: "elm/genlist/item/group_index/default";
   parts {
      text { "elm.text";
         desc { "default";
            text.min: 0 1;
         }
         desc { "selected";
            text.min: 0 1;
         }
         desc { "disabled";
            text.min: 0 1;
         }
         desc { "flip_enabled";
            text.min: 0 1;
         }
      }
   }
}

// "genlist_base" is a fundamental group that provides common parts for most genlist items.
// 'inherit_only: 1' means this group cannot be instantiated directly but must be inherited.
group { "genlist_base"; inherit_only: 1; nomouse; program_source: "elm";
   target_group: "default" "elm.text";
   parts {
       // "event" is a transparent rectangle that captures all mouse events over the item area.
       // This allows the entire item to be interactive.
       rect { "event"; mouse;
          desc { "default";
             // color 0 0 0 0 (#00000000) is fully transparent black.
             // The "no cc" comment indicates that this color is not tied to a color class,
             // so it will not change with the theme.
             color: 0 0 0 0; // no cc
             link.base: "elm,state,enabled";
          }
          desc { "disabled";
             inherit: "default";
             hid;
             link.base: "elm,state,disabled";
          }
       }
       // "base" is the background rectangle for the item. It has different color classes
       // for "even" and "odd" states, enabling alternating row colors.
       rect { "base";
          desc { "default";
             color_class: "/bg/normal/list/item";
             link.base: "elm,state,even";
          }
          desc { "odd";
             color_class: "/bg-alt/normal/list/item";
             link.base: "elm,state,odd";
          }
       }
       // "sel_base" is an image part (used as a colored rectangle here) to show the
       // selection highlight. It's hidden by default and becomes visible when selected.
       image { "sel_base"; type: RECT; mouse_events: 0;
          desc { "default";
             color_class: "/bg/selected/list/item";
             hid;
             link.base: "elm,state,unselected";
          }
          desc { "selected";
             inherit: "default";
             link.base: "elm,state,selected";
             vis;
          }
       }
   }
}

// Another inheritable group, providing a layer to block events.
group { "genlist_top"; inherit_only: 1; nomouse; program_source: "elm";
    parts {
       // "event_block" is a transparent rectangle that is visible only in the "disabled"
       // state. When visible, it sits on top and blocks mouse events from reaching
       // parts underneath, effectively disabling interaction with the item.
       rect { "event_block"; mouse;
          desc { "default";
             color: 0 0 0 0; // no cc
             hid;
             link.base: "elm,state,enabled";
          }
          desc { "disabled";
             inherit: "default";
             vis;
             link.base: "elm,state,disabled";
          }
       }
    }
}

// This inheritable group provides a placeholder for an arrow, used for alignment
// in non-tree items that should align with tree items (which have an arrow).
group { "genlist_noarrow"; inherit_only: 1; program_source: "elm";
   parts {
      // The "arrow" rectangle is a transparent spacer. It ensures that items inheriting
      // this group have the same indentation as items with a visible arrow,
      // maintaining a consistent layout in mixed lists.
      rect { "arrow"; mouse;
         scale;
         desc { "default";
            offscale;
            fixed: 1 0;
            min: 15 15;
            aspect: 1.0 1.0;
            align: 0.0 0.5;
            rel1.to_x: "elm.swallow.pad";
            rel1.relative: 1.0 0.0;
            rel1.offset: 0 4;
            rel2.to_x: "elm.swallow.pad";
            rel2.relative: 1.0 1.0;
            rel2.offset: 0 -5;
            // Transparent color, making it invisible.
            color: 0 0 0 0; // no cc
         }
      }
   }
}

// This is the default style for a standard genlist item.
group { "elm/genlist/item/default/default"; nomouse;
//   data.item: "selectraise" "on";
//   data.item: "focusraise" "on";
   data.item: "texts" "elm.text";
   data.item: "contents" "elm.swallow.icon elm.swallow.end";
   data.item: "treesize" TREEPAD;
   data.item: "flips" "elm.text.flip";
   inherit: "genlist_base";
   parts {
      //##//
      // "elm.text" is the main text part of the item.
      text { "elm.text";
         scale;
         desc { "default";
            offscale;
            min: 0 ICMIN;
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "elm.swallow.icon";
            rel2.offset: -5 -5;
            rel2.relative: 0.0 1.0;
            rel2.to_x: "elm.swallow.end";
            color_class: "/fg/normal/list/item";
            text { font: FN; size: 10;
               min: 1 1;
               ellipsis: -1;
               align: 0.0 0.5;
               text_class: "list_item";
            }
            min: 0 ICMIN;
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/selected/list/item";
         }
         desc { "disabled";
            inherit: "default";
            color_class: "/fg/disabled/list/item";
         }
         desc { "flip_enabled";
            inherit: "default";
            hid;
         }
      }
      // "elm.text.flip" is a swallow part used for the "flip" mode, where the default
      // content of the item can be replaced by custom content. It's hidden by default.
      swallow { "elm.text.flip"; mouse;
         scale;
         desc { "default";
            hid;
            rel1.to_y: "elm.text";
            rel2.to_y: "elm.text";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            offscale;
         }
         desc { "flip_enabled";
            inherit: "default";
            vis;
         }
      }
      // This program is triggered by the "elm,state,selected" signal from the C code.
      // It sets the state of parts in the "default" target_group (elm.text) to "selected".
      program {
         signal: "elm,state,selected";
         action: STATE_SET "selected";
         groups: "default";
      }
      // When "elm,state,unselected" is signaled, it reverts the state to "default".
      program {
         signal: "elm,state,unselected";
         action: STATE_SET "default";
         target_groups: "default";
      }
      // Handles the disabled state.
      program {
         signal: "elm,state,disabled";
         action: STATE_SET "disabled";
         groups: "default";
      }
      // Handles the enabled state.
      program {
         signal: "elm,state,enabled";
         action: STATE_SET "default";
         groups: "default";
      }
      // When flip mode is enabled, it sets the "flip_enabled" state on "elm.text"
      // (making it hidden) and the swallow part "elm.text.flip" (making it visible).
      program {
         signal: "elm,state,flip,enabled";
         action: STATE_SET "flip_enabled";
         groups: "default";
         target: "elm.text.flip";
      }
      // Disables flip mode, reverting to the default state.
      program {
         signal: "elm,state,flip,disabled";
         action: STATE_SET "default";
         groups: "default";
         target: "elm.text.flip";
      }
      //##//
      swallow { "elm.swallow.pad"; mouse;
         scale;
         desc { "default";
            offscale;
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
         }
      }
      swallow { "elm.swallow.icon"; mouse;
         scale;
         desc { "default";
            offscale;
            min: ICMIN ICMIN;
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.to_x: "elm.swallow.pad";
            rel1.relative: 1.0 0.0;
            rel1.offset: 0 4;
            rel2.to_x: "elm.swallow.pad";
            rel2.relative: 1.0 1.0;
            rel2.offset: 0 -5;
            // This part is linked to the "elm,state,flip,disabled" state, so it is
            // visible only when flip mode is off.
            link.base: "elm,state,flip,disabled";
         }
         desc { "flip_enabled";
            inherit: "default";
            // It is hidden when flip mode is on.
            hid;
            link.base: "elm,state,flip,enabled";
         }
      }
      swallow { "elm.swallow.end"; mouse;
         scale;
         desc { "default";
            offscale;
            min: ICMIN ICMIN;
            fixed: 1 0;
            align: 1.0 0.5;
            rel1.offset: -5 4;
            rel1.relative: 1.0 0.0;
            rel2.offset: -5 -5;
            link.base: "elm,state,flip,disabled";
         }
         desc { "flip_enabled";
            inherit: "default";
            hid;
            link.base: "elm,state,flip,enabled";
         }
      }
      //##//
   }
   inherit: "genlist_top";
}
ODD("elm/genlist/item_odd/default/default", "elm/genlist/item/default/default")
COMPRESS("elm/genlist/item_compress/default/default", "elm/genlist/item/default/default")
COMPRESS_ODD("elm/genlist/item_compress_odd/default/default", "elm/genlist/item/default/default")

// This style is similar to the default, but uses a TEXTBLOCK part instead of TEXT.
// This allows for rich text formatting using tags like "<b>" or "<hilight>".
group { "elm/genlist/item/default_style/default"; nomouse;
//   data.item: "selectraise" "on";
//   data.item: "focusraise" "on";
   data.item: "texts" "elm.text";
   data.item: "contents" "elm.swallow.icon elm.swallow.end";
   data.item: "treesize" TREEPAD;
   data.item: "flips" "elm.text.flip";
   // The 'styles' block defines text styles that can be applied to the textblock.
   // Each style has a base definition and can define formatting for various tags.
   styles.style { "genlist_style";
      base: "font="FN" font_size=10 align=left valign=0.5 color=cc:/fg/normal/list/item text_class=list_item";
      tag: "br" "\n";
      tag: "ps" "ps";
      tag: "hilight" "+ font_weight=Bold";
      tag: "b" "+ font_weight=Bold";
      tag: "tab" "\t";
   }
   // A separate style for the selected state, typically changing the text color.
   styles.style { "genlist_style_selected";
      base: "font="FN" font_size=10 align=left valign=0.5 color=cc:/fg/selected/list/item text_class=list_item_selected";
      tag: "br" "\n";
      tag: "ps" "ps";
      tag: "hilight" "+ font_weight=Bold";
      tag: "b" "+ font_weight=Bold";
      tag: "tab" "\t";
   }
   // A style for the disabled state.
   styles.style { "genlist_style_disabled";
      base: "font="FN" font_size=10 align=left valign=0.5 color=cc:/fg/disabled/list/item text_class=list_item";
      tag: "br" "\n";
      tag: "ps" "ps";
      tag: "hilight" "+ font_weight=Bold";
      tag: "b" "+ font_weight=Bold";
      tag: "tab" "\t";
   }

   inherit: "genlist_base";
   parts {

      //##//
      // "elm.text" is a textblock part that can render styled text.
      textblock { "elm.text";
         scale;
         desc { "default";
            offscale;
            min: 0 ICMIN;
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "elm.swallow.icon";
            rel2.offset: -5 -5;
            rel2.relative: 0.0 1.0;
            rel2.to_x: "elm.swallow.end";
            text { font: FN; size: 10;
               min: 1 1;
               ellipsis: -1;
               align: 0.0 0.5;
               text_class: "list_item";
               style: "genlist_style";
            }
            min: 0 ICMIN;
         }
         // In the "selected" state, it applies the "genlist_style_selected" style.
         desc { "selected";
            inherit: "default";
            text.style: "genlist_style_selected";
         }
         // In the "disabled" state, it applies the "genlist_style_disabled" style.
         desc { "disabled";
            inherit: "default";
            text.style: "genlist_style_disabled";
         }
         desc { "flip_enabled";
            inherit: "default";
            hid;
         }
      }
      swallow { "elm.text.flip"; mouse;
         scale;
         desc { "default";
            hid;
            rel1.to_y: "elm.text";
            rel2.to_y: "elm.text";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            offscale;
         }
         desc { "flip_enabled";
            inherit: "default";
            vis;
         }
      }
      program {
         signal: "elm,state,selected";
         action: STATE_SET "selected";
         groups: "default";
      }
      program {
         signal: "elm,state,unselected";
         action: STATE_SET "default";
         groups: "default";
      }
      program {
         signal: "elm,state,disabled";
         action: STATE_SET "disabled";
         groups: "default";
      }
      program {
         signal: "elm,state,enabled";
         action: STATE_SET "default";
         groups: "default";
      }
      program {
         signal: "elm,state,flip,enabled";
         action: STATE_SET "flip_enabled";
         groups: "default";
         target: "elm.text.flip";
      }
      program {
         signal: "elm,state,flip,disabled";
         action: STATE_SET "default";
         groups: "default";
         target: "elm.text.flip";
      }
      //##//
      swallow { "elm.swallow.pad"; mouse;
         scale;
         desc { "default";
            offscale;
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
         }
      }
      swallow { "elm.swallow.icon"; mouse;
         scale;
         desc { "default";
            offscale;
            min: ICMIN ICMIN;
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.to_x: "elm.swallow.pad";
            rel1.relative: 1.0 0.0;
            rel1.offset: 0 4;
            rel2.to_x: "elm.swallow.pad";
            rel2.relative: 1.0 1.0;
            rel2.offset: 0 -5;
            link.base: "elm,state,flip,disabled";
         }
         desc { "flip_enabled";
            inherit: "default";
            hid;
            link.base: "elm,state,flip,enabled";
         }
      }
      swallow { "elm.swallow.end"; mouse;
         scale;
         desc { "default";
            offscale;
            min: ICMIN ICMIN;
            fixed: 1 0;
            align: 1.0 0.5;
            rel1.offset: -5 4;
            rel1.relative: 1.0 0.0;
            rel2.offset: -5 -5;
            link.base: "elm,state,flip,disabled";
         }
         desc { "flip_enabled";
            inherit: "default";
            hid;
            link.base: "elm,state,flip,enabled";
         }
      }
      //##//

   }
   inherit: "genlist_top";
}
ODD("elm/genlist/item_odd/default_style/default", "elm/genlist/item/default_style/default")
COMPRESS("elm/genlist/item_compress/default_style/default", "elm/genlist/item/default_style/default")
COMPRESS_ODD("elm/genlist/item_compress_odd/default_style/default", "elm/genlist/item/default_style/default")

group { "elm/genlist/item/indent/default"; nomouse;
   inherit: "elm/genlist/item/default/default";
   parts {
      swallow { "elm.swallow.icon";
         scale;
         desc { "default";
            offscale;
            min: ICMIN ICMIN;
            rel1.to_x: "arrow";
            rel1.offset: 4 4;
            rel2.to_x: "arrow";
            rel2.offset: 4 -5;
         }
         desc { "flip_enabled";
            offscale;
            min: ICMIN ICMIN;
            rel1.to_x: "arrow";
            rel1.offset: 4 4;
            rel2.to_x: "arrow";
            rel2.offset: 4 -5;
         }
      }
   }
   inherit: "genlist_noarrow";
}

ODD("elm/genlist/item_odd/indent/default", "elm/genlist/item/indent/default")
COMPRESS("elm/genlist/item_compress/indent/default", "elm/genlist/item/indent/default")
COMPRESS_ODD("elm/genlist/item_compress_odd/indent/default", "elm/genlist/item/indent/default")

group { "elm/genlist/item/one_icon/default"; nomouse;
//   data.item: "selectraise" "on";
//   data.item: "focusraise" "on";
   data.item: "texts" "elm.text";
   data.item: "contents" "elm.swallow.icon";
   data.item: "treesize" TREEPAD;
   data.item: "flips" "elm.text.flip";
   inherit: "genlist_base";
   parts {

      //##//
      text { "elm.text";
         scale;
         desc { "default";
            offscale;
            min: 0 ICMIN;
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "elm.swallow.icon";
            rel2.offset: -5 -5;
            color_class: "/fg/normal/list/item";
            text { font: FN; size: 10;
               min: 0 1;
               align: 0.0 0.5;
               text_class: "list_item";
            }
            min: 0 ICMIN;
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/selected/list/item";
         }
         desc { "disabled";
            inherit: "default";
            color_class: "/fg/disabled/list/item";
         }
         desc { "flip_enabled";
            inherit: "default";
            hid;
         }
      }
      swallow { "elm.text.flip"; mouse;
         scale;
         desc { "default";
            hid;
            rel1.to_y: "elm.text";
            rel2.to_y: "elm.text";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            offscale;
         }
         desc { "flip_enabled";
            inherit: "default";
            vis;
         }
      }
      program {
         signal: "elm,state,selected";
         action: STATE_SET "selected";
         groups: "default";
      }
      program {
         signal: "elm,state,unselected";
         action: STATE_SET "default";
         target_groups: "default";
      }
      program {
         signal: "elm,state,disabled";
         action: STATE_SET "disabled";
         groups: "default";
      }
      program {
         signal: "elm,state,enabled";
         action: STATE_SET "default";
         target_groups: "default";
      }
      program {
         signal: "elm,state,flip,enabled";
         action: STATE_SET "flip_enabled";
         groups: "default";
         target: "elm.text.flip";
      }
      program {
         signal: "elm,state,flip,disabled";
         action: STATE_SET "default";
         target_groups: "default";
         target: "elm.text.flip";
      }
      //##//
      swallow { "elm.swallow.pad"; mouse;
         scale;
         desc { "default";
            offscale;
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
         }
      }
      swallow { "elm.swallow.icon"; mouse;
         scale;
         desc { "default";
            offscale;
            min: ICMIN ICMIN;
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.to_x: "elm.swallow.pad";
            rel1.relative: 1.0 0.0;
            rel1.offset: 0 4;
            rel2.to_x: "elm.swallow.pad";
            rel2.relative: 1.0 1.0;
            rel2.offset: 0 -5;
            link.base: "elm,state,flip,disabled";
         }
         desc { "flip_enabled";
            inherit: "default";
            hid;
            link.base: "elm,state,flip,enabled";
         }
      }
      //##//

   }
   inherit: "genlist_top";
}
ODD("elm/genlist/item_odd/one_icon/default", "elm/genlist/item/one_icon/default")
COMPRESS("elm/genlist/item_compress/one_icon/default", "elm/genlist/item/one_icon/default")
COMPRESS_ODD("elm/genlist/item_compress_odd/one_icon/default", "elm/genlist/item/one_icon/default")

group { "elm/genlist/item/end_icon/default"; nomouse;
//   data.item: "selectraise" "on";
//   data.item: "focusraise" "on";
   data.item: "texts" "elm.text";
   data.item: "contents" "elm.swallow.icon";
   data.item: "treesize" TREEPAD;
   data.item: "flips" "elm.text.flip";
   inherit: "genlist_base";
   parts {

      //##//
      text { "elm.text";
         scale;
         desc { "default";
            offscale;
            min: 0 ICMIN;
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "elm.swallow.pad";
            rel2.offset: -5 -5;
            rel2.relative: 0.0 1.0;
            rel2.to_x: "elm.swallow.icon";
            color_class: "/fg/normal/list/item";
            text { font: FN; size: 10;
               min: 1 1;
               ellipsis: -1;
               align: 0.0 0.5;
               text_class: "list_item";
            }
            min: 0 ICMIN;
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/selected/list/item";
         }
         desc { "disabled";
            inherit: "default";
            color_class: "/fg/disabled/list/item";
         }
         desc { "flip_enabled";
            inherit: "default";
            hid;
         }
      }
      swallow { "elm.text.flip"; mouse;
         scale;
         desc { "default";
            hid;
            rel1.to_y: "elm.text";
            rel2.to_y: "elm.text";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            offscale;
         }
         desc { "flip_enabled";
            inherit: "default";
            vis;
         }
      }
      program {
         signal: "elm,state,selected";
         action: STATE_SET "selected";
         groups: "default";
      }
      program {
         signal: "elm,state,unselected";
         action: STATE_SET "default";
         groups: "default";
      }
      program {
         signal: "elm,state,disabled";
         action: STATE_SET "disabled";
         groups: "default";
      }
      program {
         signal: "elm,state,enabled";
         action: STATE_SET "default";
         groups: "default";
      }
      program {
         signal: "elm,state,flip,enabled";
         action: STATE_SET "flip_enabled";
         groups: "default";
         target: "elm.text.flip";
      }
      program {
         signal: "elm,state,flip,disabled";
         action: STATE_SET "default";
         groups: "default";
         target: "elm.text.flip";
      }
      //##//
      swallow { "elm.swallow.pad"; mouse;
         scale;
         desc { "default";
            offscale;
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
         }
      }
      swallow { "elm.swallow.icon"; mouse;
         scale;
         desc { "default";
            offscale;
            min: ICMIN ICMIN;
            fixed: 1 0;
            align: 1.0 0.5;
            rel1.offset: -5 4;
            rel1.relative: 1.0 0.0;
            rel2.offset: -5 -5;
            link.base: "elm,state,flip,disabled";
         }
         desc { "flip_enabled";
            inherit: "default";
            hid;
            link.base: "elm,state,flip,enabled";
         }
      }
      //##//

   }
   inherit: "genlist_top";
}
