// This group defines the expandable arrow for tree items. It's designed to be
// inherited by tree item styles.
group { "genlist_arrow"; inherit_only: 1; program_source: "elm";
//   images.image: "big_arrow_left.png" COMP;
//   images.image: "big_arrow_right.png" COMP;
//   images.image: "big_arrow_down.png" COMP;

   parts {
      // "arrow_img_l" is the arrow image for LTR (Left-To-Right) locales.
      // It's clipped by "arrow_clip_l" to be shown only in LTR mode.
      image { "arrow_img_l";
         clip_to: "arrow_clip_l";
         scale;
         ignore_flags: ON_HOLD;
         desc { "default";
            fixed: 1 1;
            min: 15 15;
            max: 15 15;
            rel.to: "arrow";
            image.normal: "i-arrow-r";
            color_class: "/fg/normal/list/item";
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/selected/list/item";
         }
         desc { "disabled";
            inherit: "default";
            color_class: "/fg/disabled/list/item";
         }
         desc { "default" 1.0;
            inherit: "default";
            image.normal: "i-arrow-d";
            color_class: "/fg/normal/list/item";
         }
         desc { "selected" 1.0;
            inherit: "default";
            image.normal: "i-arrow-d";
            color_class: "/fg/selected/list/item";
         }
         desc { "disabled" 1.0;
            inherit: "default";
            image.normal: "i-arrow-d";
            color_class: "/fg/disabled/list/item";
         }
      }
      // "arrow_img_r" is the arrow image for RTL (Right-To-Left) locales.
      // It's clipped by "arrow_clip_r" to be shown only in RTL mode.
      image { "arrow_img_r";
         clip_to: "arrow_clip_r";
         scale;
         ignore_flags: ON_HOLD;
         desc { "default";
            fixed: 1 1;
            min: 15 15;
            max: 15 15;
            rel.to: "arrow";
            image.normal: "i-arrow-l";
            color_class: "/fg/normal/list/item";
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/selected/list/item";
         }
         desc { "disabled";
            inherit: "default";
            color_class: "/fg/disabled/list/item";
         }
         desc { "default" 1.0;
            inherit: "default";
            image.normal: "i-arrow-d";
            color_class: "/fg/normal/list/item";
         }
         desc { "selected" 1.0;
            inherit: "default";
            image.normal: "i-arrow-d";
            color_class: "/fg/selected/list/item";
         }
         desc { "disabled" 1.0;
            inherit: "default";
            image.normal: "i-arrow-d";
            color_class: "/fg/disabled/list/item";
         }
      }
      // "arrow" is a transparent rectangle that acts as the clickable area for the arrow.
      rect { "arrow"; mouse;
         scale;
         desc { "default";
            fixed: 1 0;
            min: 15 15;
            align: 0.0 0.5;
            rel1.to_x: "elm.swallow.pad";
            rel1.relative: 1.0 0.0;
            rel2.to_x: "elm.swallow.pad";
            rel2.relative: 1.0 1.0;
            color: 0 0 0 0; // no cc
         }
      }
      // "arrow_clip_l" is a clipper for the LTR arrow image. It's visible only when
      // the global Edje state is "ltr".
      rect { "arrow_clip_l";
         desc { "default";
            rel1.to: "arrow_img_l";
            rel2.to: "arrow_img_l";
            vis;
            link.base: "edje,state,ltr" "edje";
         }
         desc { "rtl";
            hid;
            link.base: "edje,state,rtl" "edje";
         }
      }
      // "arrow_clip_r" is a clipper for the RTL arrow image, visible in "rtl" state.
      rect { "arrow_clip_r";
         desc { "default";
            rel1.to: "arrow_img_r";
            rel2.to: "arrow_img_r";
            hid;
            link.base: "edje,state,ltr" "edje";
         }
         desc { "rtl";
            vis;
            link.base: "edje,state,rtl" "edje";
         }
      }
      // When the arrow area is clicked, it emits a signal to the C code
      // to toggle the expanded/contracted state of the item.
      program {
         signal: "mouse,up,1"; source: "arrow";
         action: SIGNAL_EMIT "elm,action,expand,toggle" "elm";
      }
      // This program runs when the item is expanded.
      program { "arr1";
         signal: "elm,state,expanded";
         // The script rotates the arrow image to point down.
         // It reads the current state description (e.g. "default", "selected")
         // and reapplies it with a new state value (1.0 for expanded).
         // This preserves the color state while changing the rotation state.
         script {
            new st[31], Float:vl;
            get_state(PART:"arrow_img_l", st, 30, vl);
            set_state(PART:"arrow_img_l", st, 1.0);
            set_state(PART:"arrow_img_r", st, 1.0);
         }
      }
      // This program runs when the item is contracted.
      program { "arr2";
         signal: "elm,state,contracted";
         // The script rotates the arrow image back to its default (right-pointing) position.
         // It uses the same technique as "arr1" to preserve the color state.
         script {
            new st[31], Float:vl;
            get_state(PART:"arrow_img_l", st, 30, vl);
            set_state(PART:"arrow_img_l", st, 0.0);
            set_state(PART:"arrow_img_r", st, 0.0);
         }
      }
      // The following programs handle state changes (selected, unselected, enabled, disabled)
      // for the arrow images, ensuring their color matches the item's state.
      // They use scripts to change only the state description string (e.g., "default" to "selected")
      // while keeping the state value (rotation) unchanged.
      program { "arr3";
         signal: "elm,state,selected";
         script {
            new st[31], Float:vl;
            get_state(PART:"arrow_img_l", st, 30, vl);
            set_state(PART:"arrow_img_l", "selected", vl);
            set_state(PART:"arrow_img_r", "selected", vl);
         }
      }
      program { "arr4";
         signal: "elm,state,unselected";
         script {
            new st[31], Float:vl;
            get_state(PART:"arrow_img_l", st, 30, vl);
            set_state(PART:"arrow_img_l", "default", vl);
            set_state(PART:"arrow_img_r", "default", vl);
         }
      }
      program { "arr5";
         signal: "elm,state,enabled";
         script {
            new st[31], Float:vl;
            get_state(PART:"arrow_img_l", st, 30, vl);
            set_state(PART:"arrow_img_l", "default", vl);
            set_state(PART:"arrow_img_r", "default", vl);
         }
      }
      program { "arr6";
         signal: "elm,state,disabled";
         script {
            new st[31], Float:vl;
            get_state(PART:"arrow_img_l", st, 30, vl);
            set_state(PART:"arrow_img_l", "disabled", vl);
            set_state(PART:"arrow_img_r", "disabled", vl);
         }
      }
   }
}

