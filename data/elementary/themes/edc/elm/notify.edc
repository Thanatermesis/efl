// This group provides a background that blocks mouse events, which can be
// used to create a modal-like notification that prevents interaction with
// other elements.
group { name: "elm/notify/block_events/default";
   // This data item informs the C code that this theme will emit
   // "elm,action,hide,finished" when the hide animation is complete.
   data.item: "hide_finished_signal" "on";
   parts {
      // This part is a rectangle that covers the entire area.
      // Initially, it is transparent and non-interactive. When shown,
      // it becomes visible and blocks mouse events.
      part { name: "block_events"; type: RECT;
         desc { state: "default";
            // Uses a color class for dimming, but is transparent by default.
            color_class: "/dim/normal/notify";
            color: 255 255 255 0; // #FFFFFF00, transparent white
         }
         desc { "visible";
            inherit: "default" 0.0;
            // Becomes opaque to block events.
            color: 255 255 255 255; // #FFFFFFFF, opaque white
         }
      }
      // When the background is clicked, it emits a signal to indicate
      // a click action, typically used to dismiss the notification.
      program { signal: "mouse,clicked,1"; source: "block_events";
         action: SIGNAL_EMIT "elm,action,click" "elm";
      }
      // When a "show" signal is received, this program transitions the
      // 'block_events' part to the "visible" state with a decelerating
      // animation, making it appear smoothly.
      program { signal: "show"; source: "*";
         action: STATE_SET "visible";
         targets: "block_events";
         transition: DECELERATE 0.2;
      }
      // On a "hide" signal, it immediately sets the state to "default"
      // without an animation.
      program { signal: "hide"; source: "";
         action: STATE_SET "default" 0.0;
         target: "block_events";
      }
      // The "elm,state,hide" signal provides a more graceful hide animation.
      // It transitions to the "default" state over 0.5 seconds and then
      // triggers the "hide_finish" program, which signals completion.
      program { signal: "elm,state,hide"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "block_events";
         transition: DECELERATE 0.5;
         after: "hide_finish";
      }
      program { name: "hide_finish";
         action: SIGNAL_EMIT "elm,action,hide,finished" "elm";
      }
   }
}

// This group defines the style for notifications appearing at the top of the
// screen. It serves as the base for other notification positions, which inherit
// its properties and only modify the entry animation direction.
group { name: "elm/notify/top/default";
   data.item: "hide_finished_signal" "on";
   parts {
      // The 'clip' part is a rectangle that contains all other parts.
      // It is used to mask the notification as it animates into view.
      // Initially, it's positioned far off-screen to hide the contents.
      part { name: "clip"; type: RECT;
         description { state: "default" 0.0;
            rel1.offset: -500 -500;
            rel2.offset: 499 499;
            color: 255 255 255 0; // #FFFFFF00, transparent white
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // #FFFFFFFF, opaque white
         }
      }
      // The 'shadow' part adds a drop shadow effect to the notification.
      // It does not receive mouse events and is clipped by the 'clip' part.
      part { name: "shadow"; mouse_events: 0;
         clip_to: "clip";
         description { state: "default" 0.0;
            rel.to: "base";
            // This macro applies a standard window shadow style.
            WIN_SHADOW;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
         }
      }
      // The 'base' part is the main background of the notification.
      // It is also clipped by the 'clip' part and scales during animations.
      part { name: "base"; type: RECT;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/bg/normal/popup/base";
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            // In the default state, it's positioned above the visible area,
            // creating a slide-in-from-top animation.
            rel1.relative: 0.0 -1.0;
            rel2.relative: 1.0 0.0;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            // In the "visible" state, it moves into its final position.
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 1.0;
         }
      }
      // This is a SWALLOW part, which acts as a container for the notification's
      // content. Its position is relative to the 'base' part.
      part { name: "elm.swallow.content"; type: SWALLOW;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "base";
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            offscale;
         }
      }
   }
   programs {
      // On "show", all parts transition to the "visible" state with a
      // decelerating animation, making the notification slide in.
      program { signal: "show"; source: "";
         action: STATE_SET "visible" 0.0;
         target: "clip";
         target: "base";
         target: "shadow";
         transition: DECELERATE 0.2;
      }
      // On "hide", all parts are immediately set to their default states.
      program { signal: "hide"; source: "";
         action: STATE_SET "default" 0.0;
         target: "clip";
         target: "base";
         target: "shadow";
      }
      // On "elm,state,hide", an animated transition to the default state
      // is performed, followed by the "hide_finish" program to signal completion.
      program { signal: "elm,state,hide"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "clip";
         target: "base";
         target: "shadow";
         transition: DECELERATE 0.5;
         after: "hide_finish";
      }
      program { name: "hide_finish";
         action: SIGNAL_EMIT "elm,action,hide,finished" "elm";
      }
   }
}

// Notification appearing at the bottom. It inherits from "top/default" and
// redefines the initial position of the 'base' part to animate in from the bottom.
group { name: "elm/notify/bottom/default";
   inherit: "elm/notify/top/default";
   parts {
      part { name: "base";
         description { state: "default" 0.0;
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            rel1.relative: 0.0 1.0;
            rel2.relative: 1.0 2.0;
         }
      }
   }
}

// Notification appearing on the left. It inherits from "top/default" and
// redefines the initial position of the 'base' part to animate in from the left.
group { name: "elm/notify/left/default";
   inherit: "elm/notify/top/default";
   parts {
      part { name: "base";
         description { state: "default" 0.0;
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            rel1.relative: -1.0 0.0;
            rel2.relative: 0.0 1.0;
         }
      }
   }
}

// Notification appearing on the right. It inherits from "top/default" and
// redefines the initial position of the 'base' part to animate in from the right.
group { name: "elm/notify/right/default";
   inherit: "elm/notify/top/default";
   parts {
      part { name: "base";
         description { state: "default" 0.0;
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            rel1.relative: 1.0 0.0;
            rel2.relative: 2.0 1.0;
         }
      }
   }
}

// A top-left aligned notification. This style is identical to the top-aligned
// notification but provides a distinct name for alignment purposes.
group { name: "elm/notify/top_left/default";
   inherit: "elm/notify/top/default";
   parts {
      part { name: "base";
         description { state: "default" 0.0;
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            rel1.relative: 0.0 -1.0;
            rel2.relative: 1.0 0.0;
         }
      }
   }
}

// A top-right aligned notification, identical in behavior to top-aligned.
group { name: "elm/notify/top_right/default";
   inherit: "elm/notify/top/default";
   parts {
      part { name: "base";
         description { state: "default" 0.0;
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            rel1.relative: 0.0 -1.0;
            rel2.relative: 1.0 0.0;
         }
      }
   }
}

// A bottom-left aligned notification, animating from the bottom.
group { name: "elm/notify/bottom_left/default";
   inherit: "elm/notify/top/default";
   parts {
      part { name: "base";
         description { state: "default" 0.0;
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            rel1.relative: 0.0 1.0;
            rel2.relative: 1.0 2.0;
         }
      }
   }
}

// A bottom-right aligned notification, animating from the bottom.
group { name: "elm/notify/bottom_right/default";
   inherit: "elm/notify/top/default";
   parts {
      part { name: "base";
         description { state: "default" 0.0;
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            rel1.relative: 0.0 1.0;
            rel2.relative: 1.0 2.0;
         }
      }
   }
}

// Notification appearing at the center. It inherits from "top/default" but
// redefines the 'base' part's initial state to be in the center, so it
// scales in place instead of sliding.
group { name: "elm/notify/center/default";
   inherit: "elm/notify/top/default";
   parts {
      part { name: "base";
         description { state: "default" 0.0;
            rel1.offset: 10 10;
            rel2.offset: -11 -11;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 1.0;
         }
      }
   }
}

