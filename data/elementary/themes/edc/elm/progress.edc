// The default horizontal progressbar.
// This is the main style for a horizontal progress bar, which can include an icon and a label,
// and supports disabled and pulse states. It's designed to be flexible and themeable.
group { name: "elm/progressbar/horizontal/default";
// Bitmasks for managing different states of the progressbar.
#define ICON    1 // Indicates that an icon is present.
#define LABEL   2 // Indicates that a label is present.
#define DISABLE 4 // Indicates that the widget is disabled.
   // This script handles the dynamic changes of the progressbar's appearance based on its state.
   script {
      // A public integer used as a bitmask to store the current state (icon, label, disabled).
      public slmode;
      // This function evaluates the state mode and applies the corresponding visual states to the parts.
      // 'm' is the bitmask containing the current state.
      public eval_mode(m) {
         new ic = m & ICON; // Check if icon is visible.
         new l = m & LABEL; // Check if label is visible.
         new d = m & DISABLE; // Check if disabled.
         // Show or hide the label, with a different state for disabled.
         if (l) {
            if (!d) {
               set_state(PART:"elm.text", "visible", 0.0);
            } else {
               set_state(PART:"elm.text", "disabled_visible", 0.0);
            }
         } else {
            set_state(PART:"elm.text", "default", 0.0);
         }
         // Show or hide the icon. The background part 'bg' is also adjusted
         // to make space for the icon and label.
         if (ic) {
            set_state(PART:"elm.swallow.content", "visible", 0.0);
            set_state(PART:"bg", "iclabel", 0.0);
         } else {
            set_state(PART:"elm.swallow.content", "default", 0.0);
            if (l) {
              set_state(PART:"bg", "iclabel", 0.0);
            }
            else {
              set_state(PART:"bg", "default", 0.0);
            }
         }
         // Apply a disabled effect over the icon.
         if (!d) {
            set_state(PART:"dis_clip", "default", 0.0);
         } else {
            set_state(PART:"dis_clip", "disabled", 0.0);
         }
      }
   }
   parts {
      // A clipping rectangle that is used to apply a disabled effect on the icon.
      part { name: "dis_clip"; type: RECT;
         description { state: "default" 0.0;
            // It is positioned relative to the icon container.
            rel.to: "elm.swallow.content";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            // A semi-transparent white color (#FFFFFF40) to indicate the disabled state.
            color: 255 255 255 64; // no cc
         }
      }
      // A clipping rectangle for the pulse animation. It is normally hidden and becomes
      // visible only when the progressbar is in pulse mode. The negative relative
      // positioning makes it larger than its parent, which is necessary for the pulse
      // effect to render correctly without being clipped by the main part boundaries.
      part { name: "pulse_clip"; type: RECT;
         description { state: "default" 0.0;
            rel1.relative: -2.0 -2.0;
            rel2.relative: 3.0 3.0;
            visible: 0;
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // A clipping rectangle for the main progress bar. It is hidden during pulse mode
      // to avoid interfering with the pulse animation.
      part { name: "fract_clip"; type: RECT;
         description { state: "default" 0.0;
            rel1.relative: -2.0 -2.0;
            rel2.relative: 3.0 3.0;
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // This is a SWALLOW part, which acts as a container for an external Evas object, typically an icon.
      part { name: "elm.swallow.content"; type: SWALLOW;
         scale: 1;
         // The content is clipped by 'dis_clip' to apply the disabled effect.
         clip_to: "dis_clip";
         description { state: "default" 0.0;
            visible: 0;
            align: 0.0 0.5;
            fixed: 1 0;
            rel1.offset: -1 4;
            rel2.offset: -1 -5;
            rel2.relative: 0.0 1.0;
            // 'offscale' is a performance optimization that hides parts that are scaled to zero or outside the viewport.
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
//            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            rel1.offset: 4 4;
            rel2.offset: 4 -5;
            min: ICMIN ICMIN;
         }
      }
      // The TEXT part used to display a label next to the progress bar.
      part { name: "elm.text"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            align: 0.0 0.5;
            // It is positioned to the right of the icon.
            rel1.to_x: "elm.swallow.content";
            rel1.relative: 1.0 0.0;
            rel1.offset: -1 4;
            rel2.to_x: "elm.swallow.content";
            rel2.relative: 1.0 1.0;
            rel2.offset: -1 -5;
            // The 'color_class' is used for theming, allowing the color to be changed from a central theme file.
            color_class: "/fg/normal/progress/text";
            text { font: FN; size: 10;
               text_class: "progressbar";
               min: 0 0;
               align: 0.0 0.5;
            }
            visible: 0;
            offscale;
            min: 0 ICMIN;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            fixed: 1 0;
            visible: 1;
            rel1.offset: 4 4;
            rel2.offset: 4 -5;
            text.min: 1 1;
            text.ellipsis: -1;
         }
         description { state: "disabled_visible" 0.0;
            inherit: "visible" 0.0;
            color_class: "/fg/disabled/progress/text";
         }
      }
      // The background of the progress bar.
      part { name: "bg"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            min: 16 16;
            max: -1 16;
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            color_class: "/bg/normal/progress/base";
            offscale;
         }
         // This state is used when there's an icon or a label, making space for them.
         description { state: "iclabel" 0.0;
            inherit: "default" 0.0;
            rel1.to_x: "elm.text";
            rel1.relative: 1.0 0.0;
         }
      }
      // A SWALLOW part that holds the draggable spacer controlling the progress.
      part { name: "elm.swallow.bar"; type: SWALLOW; mouse_events: 0;
         description { state: "default" 0.0;
            rel.to: "bg";
         }
      }
      // A SPACER part that is programmatically moved to represent the current progress value.
      // It's not visible itself but is used as a reference for the 'bar' part's size.
      part { name: "elm.cur.progressbar"; mouse_events: 0; type: SPACER;
         dragable.confine: "elm.swallow.bar";
         dragable.x: 1 1 1;
         dragable.y: 0 0 0;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 1 1;
            max: 1 9999;
            rel.to: "elm.swallow.bar";
         }
      }
      // A SPACER that marks the end of the progress bar fill.
      part { name: "barend"; type: SPACER;
         description { state: "default" 0.0;
            fixed: 1 0;
            max: 1 9999;
            // It is positioned at the same x-coordinate as the progress indicator.
            rel1.to_x: "elm.cur.progressbar";
            rel2.to_x: "elm.cur.progressbar";
            align: 1.0 0.5;
         }
         // In inverted mode, the alignment is flipped.
         description { state: "inv" 0.0;
            inherit: "default" 0.0;
            align: 0.0 0.5;
         }
      }
      // The visual representation of the progress, as a colored rectangle.
      part { name: "bar"; type: RECT;
         scale: 1;
         clip_to: "fract_clip";
         description { state: "default" 0.0;
            // Its width is determined by the 'barend' spacer.
            rel1.to: "bg";
            rel2.to_x: "barend";
            rel2.to_y: "bg";
            color_class: "/fg/normal/progress/bar";
            offscale;
         }
         // In inverted mode, the bar fills from right to left.
         description { state: "inv" 0.0;
            inherit: "default" 0.0;
            rel1.to_x: "barend";
            rel2.to_x: "bg";
         }
      }
      // The rectangle used for the pulse animation. It moves back and forth.
      part { name: "pulse"; type: RECT;
         clip_to: "pulse_clip";
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 16 8;
            max: 16 9999;
            rel.to: "elm.swallow.bar";
            align: 0.0 0.5;
            color_class: "/fg/normal/progress/pulse";
         }
         description { state: "end" 0.0;
            inherit: "default" 0.0;
            align: 1.0 0.5;
         }
      }
      // A text part to display the status, for example the percentage of completion.
      part { name: "elm.text.status"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "elm.swallow.bar";
            rel1.offset: 4 0;
            rel2.offset: -5 -1;
            align: 1.0 0.5;
            text { font: FN; size: 10;
               min: 0 1;
               text_class: "progress_status";
               align: 1.0 0.5;
            }
            color_class: "/fg/normal/progress/text/status";
            offscale;
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   programs {
      // Triggered by the "elm,state,inverted,on" signal, it sets the bar and barend parts to the "inv" state
      // for a right-to-left progress indication.
      program { name: "inverted-on";
         signal: "elm,state,inverted,on"; source: "elm";
         action:  STATE_SET "inv" 0.0;
         target: "bar";
         target: "barend";
      }
      // Reverts to the default left-to-right progress indication.
      program { name: "inverted-off";
         signal: "elm,state,inverted,off"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "bar";
         target: "barend";
      }
      // When pulsing is enabled, this program hides the status text.
      program { name: "pulse-mode0";
         signal: "elm,state,pulse"; source: "elm";
         action:  STATE_SET "hidden" 0.0;
         target: "elm.text.status";
         after: "pulse-mode1";
      }
      // This program hides the main progress bar ('fract_clip') to show the pulse animation instead.
      program { name: "pulse-mode1";
         signal: "elm,state,pulse,start"; source: "elm";
         action:  STATE_SET "pulse" 0.0;
         target: "fract_clip";
      }
      // This program starts the pulse animation. It makes the pulse clipper visible and hides the fraction clipper.
      program { name: "pulse-start";
         signal: "elm,state,pulse,start"; source: "elm";
         action:  STATE_SET "pulse" 0.0;
         target: "pulse_clip";
         target: "fract_clip";
         after: "pulse0";
      }
      // Defines the back-and-forth movement of the pulse animation.
      // 'pulse0' moves the pulse to the end.
      program { name: "pulse0";
         action:  STATE_SET "end" 0.0;
         transition: SINUSOIDAL 0.8;
         target: "pulse";
         after: "pulse1";
      }
      // 'pulse1' moves it back to the start, creating a loop with 'pulse0'.
      program { name: "pulse1";
         action:  STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.8;
         target: "pulse";
         after: "pulse0";
      }
      // Triggered when switching from pulse to fraction mode. It shows the status text
      // and then chains to 'pulse-stop' to clean up the pulse animation.
      program { name: "fraction";
         signal: "elm,state,fraction"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "elm.text.status";
         after: "pulse-stop";
      }
      // Stops the pulse animation programs.
      program { name: "elmpulse-stop";
         signal: "elm,state,pulse,stop"; source: "elm";
         action: ACTION_STOP;
         target: "pulse0";
         target: "pulse1";
         after: "pulse-stop";
      }
      // Hides the pulse clipper, effectively ending the pulse animation visibility.
      program { name: "pulse-stop";
         action:  STATE_SET "default" 0.0;
         target: "pulse_clip";
      }
      // Makes the unit/status text visible.
      program { name: "units-visible";
         signal: "elm,state,units,visible"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "elm.text.status";
      }
      // Hides the unit/status text.
      program { name: "units-hidden";
         signal: "elm,state,units,hidden"; source: "elm";
         action:  STATE_SET "hidden" 0.0;
         target: "elm.text.status";
      }
      // The following programs ('text-visible', 'text-hidden', 'icon-visible', 'icon-hidden',
      // 'state-disabled', 'state-enabled') are the main interface for controlling the
      // progressbar's appearance from the C code. They update the 'slmode' bitmask and
      // call 'eval_mode' to apply the changes.

      // Shows the label.
      program { name: "text-visible";
         signal: "elm,state,text,visible"; source: "elm";
         script {
            new m = get_int(slmode);
            m |= LABEL; set_int(slmode, m);
            eval_mode(m);
         }
      }
      // Hides the label.
      program { name: "text-hidden";
         signal: "elm,state,text,hidden"; source: "elm";
         script {
            new m = get_int(slmode);
            m &= ~LABEL; set_int(slmode, m);
            eval_mode(m);
         }
      }
      // Shows the icon.
      program { name: "icon-visible";
         signal: "elm,state,icon,visible"; source: "elm";
         script {
            new m = get_int(slmode);
            m |= ICON; set_int(slmode, m);
            eval_mode(m);
         }
      }
      // Hides the icon.
      program { name: "icon-hidden";
         signal: "elm,state,icon,hidden"; source: "elm";
         script {
            new m = get_int(slmode);
            m &= ~ICON; set_int(slmode, m);
            eval_mode(m);
         }
      }
      // Sets the progressbar to its disabled state.
      program { name: "state-disabled";
         signal: "elm,state,disabled"; source: "elm";
         script {
            new m = get_int(slmode);
            m |= DISABLE; set_int(slmode, m);
            eval_mode(m);
         }
      }
      // Sets the progressbar to its enabled state.
      program { name: "state-enabled";
         signal: "elm,state,enabled"; source: "elm";
         script {
            new m = get_int(slmode);
            m &= ~DISABLE; set_int(slmode, m);
            eval_mode(m);
         }
      }
   }
// Undefine the macros to keep them local to this group.
#undef ICON
#undef LABEL
#undef DISABLE
}

// The default vertical progressbar.
// This is the vertical counterpart of the default horizontal progressbar.
// Most of its logic and parts are similar, but adapted for a vertical orientation.
group { name: "elm/progressbar/vertical/default";
#define ICON    1
#define LABEL   2
#define DISABLE 4
   script {
      public slmode;
      public eval_mode(m) {
         new ic = m & ICON;
         new l = m & LABEL;
         new d = m & DISABLE;
         if (l) {
            if (!d) {
               set_state(PART:"elm.text", "visible", 0.0);
            } else {
               set_state(PART:"elm.text", "disabled_visible", 0.0);
            }
         } else {
            set_state(PART:"elm.text", "default", 0.0);
         }
         if (ic) {
            set_state(PART:"elm.swallow.content", "visible", 0.0);
            set_state(PART:"bg", "iclabel", 0.0);
         } else {
            set_state(PART:"elm.swallow.content", "default", 0.0);
            if (l) {
               set_state(PART:"bg", "iclabel", 0.0);
            }
            else {
               set_state(PART:"bg", "default", 0.0);
            }
         }
         if (!d) {
            set_state(PART:"dis_clip", "default", 0.0);
         } else {
            set_state(PART:"dis_clip", "disabled", 0.0);
         }
      }
   }
   parts {
      part { name: "dis_clip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "elm.swallow.content";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 64; // no cc
         }
      }
      part { name: "pulse_clip"; type: RECT;
         description { state: "default" 0.0;
            rel1.relative: -2.0 -2.0;
            rel2.relative: 3.0 3.0;
            visible: 0;
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "fract_clip"; type: RECT;
         description { state: "default" 0.0;
            rel1.relative: -2.0 -2.0;
            rel2.relative: 3.0 3.0;
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      part { name: "elm.swallow.content"; type: SWALLOW;
         scale: 1;
         clip_to: "dis_clip";
         description { state: "default" 0.0;
            visible: 0;
            align: 0.5 0.0;
            fixed: 1 1;
            rel1.offset: 4 0;
            rel2.offset: -5 -1;
            rel2.relative: 1.0 0.0;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
//            aspect: 1.0 1.0; aspect_preference: HORIZONTAL;
            rel1.offset: 4 4;
            rel2.offset: -5 4;
            min: ICMIN ICMIN;
         }
      }
      part { name: "elm.text"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            align: 0.5 0.0;
            rel1.to_y: "elm.swallow.content";
            rel1.relative: 0.0 1.0;
            rel1.offset: 4 -1;
            rel2.to_y: "elm.swallow.content";
            rel2.relative: 1.0 1.0;
            rel2.offset: -5 -1;
            color_class: "/fg/normal/progress/text";
            text { font: FN; size: 10;
               text_class: "progressbar";
               min: 0 0;
               align: 0.5 0.0;
            }
            visible: 0;
            offscale;
            min: 0 ICMIN;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
            rel1.offset: 4 4;
            rel2.offset: -5 4;
            text.min: 1 1;
            text.ellipsis: -1;
         }
         description { state: "disabled_visible" 0.0;
            inherit: "visible" 0.0;
            color_class: "/fg/disabled/progress/text";
         }
      }
      part { name: "bg"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            min: 16 16;
            max: 16 -1;
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            color_class: "/bg/normal/progress/base";
            offscale;
         }
         description { state: "iclabel" 0.0;
            inherit: "default" 0.0;
            rel1.to_y: "elm.text";
            rel1.relative: 0.0 1.0;
         }
      }
      part { name: "elm.swallow.bar"; type: SWALLOW; mouse_events: 0;
         description { state: "default" 0.0;
            rel.to: "bg";
         }
      }
      part { name: "elm.cur.progressbar"; mouse_events: 0; type: SPACER;
         dragable.confine: "elm.swallow.bar";
         dragable.x: 0 0 0;
         dragable.y: 1 1 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 1 1;
            max: 9999 1;
            rel.to: "elm.swallow.bar";
         }
      }
      part { name: "barend"; type: SPACER;
         description { state: "default" 0.0;
            fixed: 0 1;
            max: 9999 1;
            rel1.to_y: "elm.cur.progressbar";
            rel2.to_y: "elm.cur.progressbar";
            align: 0.5 1.0;
         }
         description { state: "inv" 0.0;
            inherit: "default" 0.0;
            align: 0.5 0.0;
         }
      }
      part { name: "bar"; type: RECT;
         scale: 1;
         clip_to: "fract_clip";
         description { state: "default" 0.0;
            rel1.to: "bg";
            rel2.to_y: "barend";
            rel2.to_x: "bg";
            color_class: "/fg/normal/progress/bar";
            offscale;
         }
         description { state: "inv" 0.0;
            inherit: "default" 0.0;
            rel1.to_y: "barend";
            rel2.to_y: "bg";
         }
      }
      part { name: "pulse"; type: RECT;
         clip_to: "pulse_clip";
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 8 16;
            max: 9999 16;
            rel.to: "elm.swallow.bar";
            align: 0.5 0.0;
            color_class: "/fg/normal/progress/pulse";
         }
         description { state: "end" 0.0;
            inherit: "default" 0.0;
            align: 0.5 1.0;
         }
      }
      // A spacer to help with the positioning of the rotated status text.
      part { name: "statbox"; type: SPACER;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "bg";
            aspect: 1.0 1.0; aspect_preference: NONE;
         }
      }
      part { name: "elm.text.status"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "statbox";
            rel1.offset: 4 0;
            rel2.offset: -5 -1;
            align: 1.0 0.5;
            text { font: FN; size: 10;
               min: 0 1;
               text_class: "progress_status";
               align: 1.0 0.5;
            }
            // Maps are used for transformations like rotation.
            map.on: 1;
            map.smooth: 0;
            // The text is rotated 90 degrees to be displayed vertically.
            map.rotation.center: "elm.swallow.bar";
            map.rotation.z: 90;
            color_class: "/fg/normal/progress/text/status";
            offscale;
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   programs {
      program { name: "inverted-on";
         signal: "elm,state,inverted,on"; source: "elm";
         action:  STATE_SET "inv" 0.0;
         target: "bar";
         target: "barend";
      }
      program { name: "inverted-off";
         signal: "elm,state,inverted,off"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "bar";
         target: "barend";
      }
      program { name: "pulse-mode0";
         signal: "elm,state,pulse"; source: "elm";
         action:  STATE_SET "hidden" 0.0;
         target: "elm.text.status";
         after: "pulse-mode1";
      }
      program { name: "pulse-mode1";
         signal: "elm,state,pulse,start"; source: "elm";
         action:  STATE_SET "pulse" 0.0;
         target: "fract_clip";
      }
      program { name: "pulse-start";
         signal: "elm,state,pulse,start"; source: "elm";
         action:  STATE_SET "pulse" 0.0;
         target: "pulse_clip";
         target: "fract_clip";
         after: "pulse0";
      }
      program { name: "pulse0";
         action:  STATE_SET "end" 0.0;
         transition: SINUSOIDAL 0.8;
         target: "pulse";
         after: "pulse1";
      }
      program { name: "pulse1";
         action:  STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.8;
         target: "pulse";
         after: "pulse0";
      }
      program { name: "fraction";
         signal: "elm,state,fraction"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "elm.text.status";
         after: "pulse-stop";
      }
      program { name: "elmpulse-stop";
         signal: "elm,state,pulse,stop"; source: "elm";
         action: ACTION_STOP;
         target: "pulse0";
         target: "pulse1";
         after: "pulse-stop";
      }
      program { name: "pulse-stop";
         action:  STATE_SET "default" 0.0;
         target: "pulse_clip";
      }
      program { name: "units-visible";
         signal: "elm,state,units,visible"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "elm.text.status";
      }
      program { name: "units-hidden";
         signal: "elm,state,units,hidden"; source: "elm";
         action:  STATE_SET "hidden" 0.0;
         target: "elm.text.status";
      }
      program { name: "text-visible";
         signal: "elm,state,text,visible"; source: "elm";
         script {
            new m = get_int(slmode);
            m |= LABEL; set_int(slmode, m);
            eval_mode(m);
         }
      }
      program { name: "text-hidden";
         signal: "elm,state,text,hidden"; source: "elm";
         script {
            new m = get_int(slmode);
            m &= ~LABEL; set_int(slmode, m);
            eval_mode(m);
         }
      }
      program { name: "icon-visible";
         signal: "elm,state,icon,visible"; source: "elm";
         script {
            new m = get_int(slmode);
            m |= ICON; set_int(slmode, m);
            eval_mode(m);
         }
      }
      program { name: "icon-hidden";
         signal: "elm,state,icon,hidden"; source: "elm";
         script {
            new m = get_int(slmode);
            m &= ~ICON; set_int(slmode, m);
            eval_mode(m);
         }
      }
      program { name: "state-disabled";
         signal: "elm,state,disabled"; source: "elm";
         script {
            new m = get_int(slmode);
            m |= DISABLE; set_int(slmode, m);
            eval_mode(m);
         }
      }
      program { name: "state-enabled";
         signal: "elm,state,enabled"; source: "elm";
         script {
            new m = get_int(slmode);
            m &= ~DISABLE; set_int(slmode, m);
            eval_mode(m);
         }
      }
   }
#undef ICON
#undef LABEL
#undef DISABLE
}

// A 'bare' style for the horizontal progressbar. It's a simpler version without an icon or label.
group { name: "elm/progressbar/horizontal/bare";
   parts {
      // The icon container is included but made invisible and zero-sized.
      // This is often done for consistency in the API, so the part still exists.
      part { name: "elm.swallow.content"; type: SWALLOW;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 0 0;
            max: 0 0;
            visible: 0;
         }
      }
      part { name: "pulse_clip"; type: RECT;
         description { state: "default" 0.0;
            rel1.relative: -2.0 -2.0;
            rel2.relative: 3.0 3.0;
            visible: 0;
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "fract_clip"; type: RECT;
         description { state: "default" 0.0;
            rel1.relative: -2.0 -2.0;
            rel2.relative: 3.0 3.0;
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // The background of the progress bar.
      part { name: "bg"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            // It has a fixed height of 5 pixels.
            min: 10 5;
            max: -1 5;
            color_class: "/bg/normal/progress/base";
         }
      }
      part { name: "elm.swallow.bar"; type: SWALLOW; mouse_events: 0;
         description { state: "default" 0.0;
            rel.to: "bg";
         }
      }
      part { name: "elm.cur.progressbar"; mouse_events: 0; type: SPACER;
         dragable.confine: "elm.swallow.bar";
         dragable.x: 1 1 1;
         dragable.y: 0 0 0;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 1 1;
            max: 1 9999;
            rel.to: "elm.swallow.bar";
         }
      }
      part { name: "barend"; type: SPACER;
         description { state: "default" 0.0;
            fixed: 1 0;
            max: 1 9999;
            rel1.to_x: "elm.cur.progressbar";
            rel2.to_x: "elm.cur.progressbar";
            align: 1.0 0.5;
         }
         description { state: "inv" 0.0;
            inherit: "default" 0.0;
            align: 0.0 0.5;
         }
      }
      part { name: "bar"; type: RECT;
         clip_to: "fract_clip";
         description { state: "default" 0.0;
            rel1.to: "bg";
            rel2.to_x: "barend";
            rel2.to_y: "bg";
            color_class: "/fg/normal/progress/bar";
         }
         description { state: "inv" 0.0;
            inherit: "default" 0.0;
            rel1.to_x: "barend";
            rel2.to_x: "bg";
         }
      }
      part { name: "pulse"; type: RECT;
         clip_to: "pulse_clip";
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 5 5;
            max: 5 9999;
            rel.to: "elm.swallow.bar";
            align: 0.0 0.5;
            color_class: "/fg/normal/progress/pulse";
         }
         description { state: "end" 0.0;
            inherit: "default" 0.0;
            align: 1.0 0.5;
         }
      }
   }
   programs {
      program { name: "inverted-on";
         signal: "elm,state,inverted,on"; source: "elm";
         action:  STATE_SET "inv" 0.0;
         target: "bar";
         target: "barend";
      }
      program { name: "inverted-off";
         signal: "elm,state,inverted,off"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "bar";
         target: "barend";
      }
      program { name: "pulse-mode1";
         signal: "elm,state,pulse,start"; source: "elm";
         action:  STATE_SET "pulse" 0.0;
         target: "fract_clip";
      }
      program { name: "pulse-start";
         signal: "elm,state,pulse,start"; source: "elm";
         action:  STATE_SET "pulse" 0.0;
         target: "pulse_clip";
         target: "fract_clip";
         after: "pulse0";
      }
      program { name: "pulse0";
         action:  STATE_SET "end" 0.0;
         transition: SINUSOIDAL 0.8;
         target: "pulse";
         after: "pulse1";
      }
      program { name: "pulse1";
         action:  STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.8;
         target: "pulse";
         after: "pulse0";
      }
      program { name: "elmpulse-stop";
         signal: "elm,state,pulse,stop"; source: "elm";
         action: ACTION_STOP;
         target: "pulse0";
         target: "pulse1";
         after: "pulse-stop";
      }
      program { name: "pulse-stop";
         action:  STATE_SET "default" 0.0;
         target: "pulse_clip";
      }
   }
}

// A 'hidden_bare' style, which is a 'bare' progressbar with a transparent background.
group { name: "elm/progressbar/horizontal/hidden_bare";
   inherit: "elm/progressbar/horizontal/bare";
   parts {
      part { name: "bg";
         description { state: "default" 0.0;
            // The background is made fully transparent (#00000000).
            color: 0 0 0 0; // no cc
         }
      }
   }
}

// A 'bare' style for the vertical progressbar.
group { name: "elm/progressbar/vertical/bare";
   parts {
      // The icon container is included but made invisible and zero-sized for API consistency.
      part { name: "elm.swallow.content"; type: SWALLOW;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 0 0;
            max: 0 0;
            visible: 0;
         }
      }
      part { name: "pulse_clip"; type: RECT;
         description { state: "default" 0.0;
            rel1.relative: -2.0 -2.0;
            rel2.relative: 3.0 3.0;
            visible: 0;
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "fract_clip"; type: RECT;
         description { state: "default" 0.0;
            rel1.relative: -2.0 -2.0;
            rel2.relative: 3.0 3.0;
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      part { name: "bg"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            min: 5 10;
            max: 5 -1;
            color_class: "/bg/normal/progress/base";
         }
      }
      part { name: "elm.swallow.bar"; type: SWALLOW; mouse_events: 0;
         description { state: "default" 0.0;
            rel.to: "bg";
         }
      }
      part { name: "elm.cur.progressbar"; mouse_events: 0; type: SPACER;
         dragable.confine: "elm.swallow.bar";
         dragable.x: 0 0 0;
         dragable.y: 1 1 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 1 1;
            max: 9999 1;
            rel.to: "elm.swallow.bar";
         }
      }
      part { name: "barend"; type: SPACER;
         description { state: "default" 0.0;
            fixed: 0 1;
            max: 9999 1;
            rel1.to_y: "elm.cur.progressbar";
            rel2.to_y: "elm.cur.progressbar";
            align: 0.5 1.0;
         }
         description { state: "inv" 0.0;
            inherit: "default" 0.0;
            align: 0.5 0.0;
