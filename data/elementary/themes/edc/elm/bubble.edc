      part { name: "base"; mouse_events:  0;
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/bg/normal/bubble";
            rel1.offset: 4 4;
            rel2 {
               to_y: "elm.swallow.icon";
               relative: 1.0 0.0;
               offset: -5 -5;
