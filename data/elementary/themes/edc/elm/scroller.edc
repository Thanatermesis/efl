// This is the main group for the scroller widget. It defines the basic
// structure, including background, content area, and scrollbars.
// It's aliased by other widgets like lists and grids, making it a
// fundamental component for scrollable views in Elementary.
group { name: "elm/scroller/base/default";
   alias: "elm/list/base/default";
   alias: "elm/genlist/base/default";
   alias: "elm/gengrid/base/default";
   alias: "elm/scroller/base/map_bubble";
   alias: "elm/genscroller/base/default";
   alias: "elm/scroller/base/popup/default";
   alias: "elm/scroller/base/popup/transparent";

   // Pre-loads images used for edge shadows to ensure they are ready for rendering.
   images.image: "shadow_circle_horiz.png" COMP;
   images.image: "shadow_circle_vert.png" COMP;

   // Enables the default focus highlight behavior for this widget.
   data.item: "focus_highlight" "on";

   parts {
      // This script runs once when the group is loaded. It emits a "reload"
      // signal, which can be used by the C code to perform any necessary
      // post-initialization tasks for the scroller widget.
      program { signal: "load"; source: "";
         script {
            emit("reload", "elm");
         }
      }

      //////////////////////////////////////////////////////////////////////
      // A background rectangle, sized to the swallow background area.
      // It uses a color class to allow for theme-wide color changes.
      part { name: "bg"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "elm.swallow.background";
            color_class: "/bg/normal/scroller/base";
         }
      }
      // This part acts as a clipping mask for all content, background, and
      // overlay swallows. Anything outside this rectangle will not be visible.
      part { name: "clipper"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "elm.swallow.content";
         }
      }
      // A swallow part for custom background content, provided from the C side.
      part { name: "elm.swallow.background"; type: SWALLOW;
         clip_to: "clipper";
         description { state: "default" 0.0;
         }
      }
      // The main content area where the scrollable content is placed.
      part { name: "elm.swallow.content"; type: SWALLOW;
         clip_to: "clipper";
         description { state: "default" 0.0;
            rel.to: "elm.swallow.background";
         }
      }
      // A swallow part for overlay content, which appears on top of the main content.
      part { name: "elm.swallow.overlay"; type: SWALLOW;
         clip_to: "clipper";
         description { state: "default" 0.0;
            rel.to: "elm.swallow.content";
         }
      }

      // This part creates the shadow at the top edge, visible when content can be scrolled up.
      // It's initially hidden ('offscale' and transparent) and fades in when scrolling is possible.
      // Mouse events are disabled as it's purely decorative.
      part { name: "sh_top"; mouse_events: 0;
         scale: 1;
         clip_to: "sh_clip";
         description { state: "default" 0.0;
            color_class: "/shadow/normal/scroller";
            // Color is transparent white (#FFFFFF00), making the shadow texture invisible by default.
            color: 255 255 255 0; // no cc
            rel.to: "elm.swallow.content";
            rel1.offset: 0 -1;
            rel2.offset: -1 -1;
            rel2.relative: 1.0 0.0;
            image.normal: "shadow_circle_horiz.png";
            visible: 0;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            // Opaque white (#FFFFFFFF), making the shadow texture visible.
            color: 255 255 255 255; // no cc
            rel1.offset: 0 -16;
            rel2.offset: -1 15;
            visible: 1;
         }
      }
      // When "elm,action,show,up" is signaled from the C code, this program animates
      // the shadow into the "visible" state with a deceleration effect.
      program { signal: "elm,action,show,up"; source: "elm";
         action: STATE_SET "visible" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_top";
      }
      // Hides the top shadow when scrolling up is no longer possible.
      program { signal: "elm,action,hide,up"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_top";
      }

      // Bottom edge shadow, using the same mechanism as the top shadow.
      part { name: "sh_bottom"; mouse_events: 0;
         scale: 1;
         clip_to: "sh_clip";
         description { state: "default" 0.0;
            color_class: "/shadow/normal/scroller";
            color: 255 255 255 0; // no cc
            rel.to: "elm.swallow.content";
            rel1.relative: 0.0 1.0;
            rel1.offset: 0 0;
            rel2.offset: -1 0;
            image.normal: "shadow_circle_horiz.png";
            visible: 0;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // no cc
            rel1.offset: 0 -16;
            rel2.offset: -1 15;
            visible: 1;
         }
      }
      // These programs control the visibility of the bottom shadow, triggering on
      // "show,down" and "hide,down" signals respectively.
      program { signal: "elm,action,show,down"; source: "elm";
         action: STATE_SET "visible" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_bottom";
      }
      program { signal: "elm,action,hide,down"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_bottom";
      }

      // Left edge shadow, using a vertical shadow image.
      part { name: "sh_left"; mouse_events: 0;
         scale: 1;
         clip_to: "sh_clip";
         description { state: "default" 0.0;
            color_class: "/shadow/normal/scroller";
            color: 255 255 255 0; // no cc
            rel.to: "elm.swallow.content";
            rel1.offset: -1 0;
            rel2.offset: -1 -1;
            rel2.relative: 0.0 1.0;
            image.normal: "shadow_circle_vert.png";
            visible: 0;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // no cc
            rel1.offset: -16 0;
            rel2.offset: 15 -1;
            visible: 1;
         }
      }
      // These programs control the visibility of the left shadow.
      program { signal: "elm,action,show,left"; source: "elm";
         action: STATE_SET "visible" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_left";
      }
      program { signal: "elm,action,hide,left"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_left";
      }

      // Right edge shadow, using a vertical shadow image.
      part { name: "sh_right"; mouse_events: 0;
         scale: 1;
         clip_to: "sh_clip";
         description { state: "default" 0.0;
            color_class: "/shadow/normal/scroller";
            color: 255 255 255 0; // no cc
            rel.to: "elm.swallow.content";
            rel1.relative: 1.0 0.0;
            rel1.offset: 0 0;
            rel2.offset: 0 -1;
            image.normal: "shadow_circle_vert.png";
            visible: 0;
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // no cc
            rel1.offset: -16 0;
            rel2.offset: 15 -1;
            visible: 1;
         }
      }
      // These programs control the visibility of the right shadow.
      program { signal: "elm,action,show,right"; source: "elm";
         action: STATE_SET "visible" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_right";
      }
      program { signal: "elm,action,hide,right"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.3;
         target: "sh_right";
      }

      // This is a clipper for all the shadow parts. By default it is the same
      // as the main clipper.
      part { name: "sh_clip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "clipper";
         }
      }
      //////////////////////////////////////////////////////////////////////

// vert bar ////////////////////////////////////////////////////////////////
      // The vertical scrollbar is composed of several parts:
      // - sb_vbar: The track area for the scrollbar.
      // - elm.dragable.vbar: The draggable thumb.
      // - sb_vbar_p1/p2: Invisible rectangles for page-up/page-down clicks.
      // - sb_vbar_over: A larger, invisible area to make mouse interaction easier.
      // - base_vbar/color_vbar: The visual representation of the thumb.

      // This part acts as a container to show or hide the vertical scrollbar area.
      part { name: "sb_vbar_show"; type: RECT;
         description { state: "default" 0.0;
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Defines the track for the vertical scrollbar. It's positioned on the right
      // side of the scroller and avoids the horizontal scrollbar area.
      part { name: "sb_vbar"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 15 1;
            align: 1.0 0.0;
            rel1.relative: 1.0 0.0;
            rel1.offset: -1 0;
            rel2.relative: 1.0 0.0;
            rel2.to_y: "sb_hbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 0 999999;
         }
      }
      // Invisible area above the scrollbar thumb. Clicking here scrolls up by one page.
      part { name: "sb_vbar_p1"; type: RECT;
         clip_to: "sb_vbar";
         description { state: "default" 0.0;
            // Transparent (#00000000).
            color: 0 0 0 0; // no cc
            rel1.to: "sb_vbar";
            rel2.relative: 1.0 0.0;
            rel2.to: "elm.dragable.vbar";
            fixed: 1 1;
         }
      }
      // Invisible area below the scrollbar thumb for page-down scrolling.
      part { name: "sb_vbar_p2"; type: RECT;
         clip_to: "sb_vbar";
         description { state: "default" 0.0;
            // Transparent (#00000000).
            color: 0 0 0 0; // no cc
            rel1.relative: 0.0 1.0;
            rel1.to: "elm.dragable.vbar";
            rel2.to: "sb_vbar";
            fixed: 1 1;
         }
      }
      // The draggable thumb of the vertical scrollbar. It is confined to the sb_vbar track.
      // The `dragable` properties make this part interactive, responding to user drags
      // to scroll the content vertically.
      part { name: "elm.dragable.vbar"; type: RECT;
         clip_to: "sb_vbar";
         scale: 1;
         dragable.x: 0 0 0;
         dragable.y: 1 1 0;
         dragable.confine: "sb_vbar";
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 15 15;
            rel1.relative: 0.5  0.5;
            rel1.to: "sb_vbar";
            rel2.relative: 0.5  0.5;
            rel2.to: "sb_vbar";
            color: 0 0 0 0; // no cc
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
         }
      }
      // This is an invisible, larger "hotspot" area around the vertical scrollbar.
      // It's wider than the visible bar to make it easier for the mouse to trigger
      // the "over" state, which provides visual feedback by enlarging the scrollbar thumb.
      part { name: "sb_vbar_over"; type: RECT;
         repeat_events: 1;
         scale: 1;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            rel1.to: "sb_vbar";
            rel1.offset: -45 0;
            rel2.to: "sb_vbar";
            fixed: 1 1;
            offscale;
         }
      }
      program { signal: "mouse,in"; source: "sb_vbar_over";
         action: STATE_SET "over" 0.0;
         transition: DECELERATE 0.2;
         target: "base_vbar";
      }
      program { signal: "mouse,out"; source: "sb_vbar_over";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.2;
         target: "base_vbar";
      }
      // These SPACER parts are likely used for layout calculations or as anchors
      // for other elements, but they are not visible. Their exact purpose might be
      // tied to specific C code logic that interacts with them.
      part { name: "y_vbar_up_mapper"; type: SPACER;
         scale: 1;
         repeat_events: 1;
         description { state: "default" 0.0;
            min: 4 2;
            max: 4 2;
            fixed: 1 1;
            align: 0.0 0.0;
            rel1.to: "sb_vbar";
            rel2.to: "sb_vbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 0 0;
         }
      }
      part { name: "y_vbar_up"; type: SPACER;
         scale: 1;
         repeat_events: 1;
         description { state: "default" 0.0;
            min: 4 2;
            max: 4 2;
            fixed: 1 1;
            align: 0.0 0.0;
            rel1.to: "elm.dragable.vbar";
            rel2.to: "elm.dragable.vbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 0 0;
         }
      }
      part { name: "y_vbar_down_mapper"; type: SPACER;
         scale: 1;
         repeat_events: 1;
         description { state: "default" 0.0;
            min: 4 2;
            max: 4 2;
            fixed: 1 1;
            align: 0.0 1.0;
            rel1.to: "sb_vbar";
            rel2.to: "sb_vbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 0 0;
         }
      }
      part { name: "y_vbar_down"; type: SPACER;
         scale: 1;
         repeat_events: 1;
         description { state: "default" 0.0;
            min: 4 2;
            max: 4 2;
            fixed: 1 1;
            align: 0.0 1.0;
            rel1.to: "elm.dragable.vbar";
            rel2.to: "elm.dragable.vbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 0 0;
         }
      }
      // This program is triggered by the "elm,action,show,vbar" signal to make
      // all parts of the vertical scrollbar visible.
      program { signal: "elm,action,show,vbar"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "sb_vbar";
         target: "sb_vbar_show";
         target: "elm.dragable.vbar";
         target: "y_vbar_up_mapper";
         target: "y_vbar_up";
         target: "y_vbar_down_mapper";
         target: "y_vbar_down";
      }
      // Hides all parts of the vertical scrollbar when it's not needed.
      program { signal: "elm,action,hide,vbar"; source: "elm";
         action: STATE_SET "hidden" 0.0;
         target: "sb_vbar";
         target: "sb_vbar_show";
         target: "elm.dragable.vbar";
         target: "y_vbar_up_mapper";
         target: "y_vbar_up";
         target: "y_vbar_down_mapper";
         target: "y_vbar_down";
      }
      // Triggered on mouse down on the page-up area. It scrolls the content
      // up by one page length by manipulating the draggable part.
      program { signal: "mouse,down,1*"; source: "sb_vbar_p1";
         action: DRAG_VAL_PAGE 0.0 -1.0;
         target: "elm.dragable.vbar";
      }
      // Triggers a page-down scroll.
      program { signal: "mouse,down,1*"; source: "sb_vbar_p2";
         action: DRAG_VAL_PAGE  0.0 1.0;
         target: "elm.dragable.vbar";
      }
//      program { signal: "elm,action,show,up"; source: "elm";
//      }
//      program { signal: "elm,action,show,down"; source: "elm";
//      }
//      program { signal: "elm,action,hide,up"; source: "elm";
//      }
//      program { signal: "elm,action,hide,down"; source: "elm";
//      }
//      program { signal: "elm,action,scroll"; source: "elm";
//      }
//      program { signal: "elm,loop_y,set"; source: "elm";
//      }
//      program { signal: "elm,loop_y,unset"; source: "elm";
//      }

// horiz bar /////////////////////////////////////////////////////////////
      // The horizontal scrollbar implementation is analogous to the vertical one,
      // but operates on the X-axis.
      part { name: "sb_hbar_show"; type: RECT;
         description { state: "default" 0.0;
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      part { name: "sb_hbar"; type: RECT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 1 15;
            align: 0.0 1.0;
            rel1.relative: 0.0 1.0;
            rel1.offset: 0 -1;
            rel2.relative: 0.0 1.0;
            rel2.to_x: "sb_vbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 999999 0;
         }
      }
      part { name: "sb_hbar_p1"; type: RECT;
         clip_to: "sb_hbar";
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            rel1.to: "sb_hbar";
            rel2.relative: 0.0 1.0;
            rel2.to: "elm.dragable.hbar";
            fixed: 1 1;
         }
      }
      part { name: "sb_hbar_p2"; type: RECT;
         clip_to: "sb_hbar";
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            rel1.relative: 1.0 0.0;
            rel1.to: "elm.dragable.hbar";
            rel2.to: "sb_hbar";
            fixed: 1 1;
         }
      }
      // The draggable thumb of the horizontal scrollbar.
      part { name: "elm.dragable.hbar"; type: RECT;
         scale: 1;
         clip_to: "sb_hbar";
         dragable.x: 1 1 0;
         dragable.y: 0 0 0;
         dragable.confine: "sb_hbar";
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 15 15;
            rel1.relative: 0.5  0.5;
            rel1.to: "sb_hbar";
            rel2.relative: 0.5  0.5;
            rel2.to: "sb_hbar";
            color: 0 0 0 0; // no cc
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
         }
      }
      part { name: "sb_hbar_over"; type: RECT;
         repeat_events: 1;
         scale: 1;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            rel1.to: "sb_hbar";
            rel1.offset: 0 -45;
            rel2.to: "sb_hbar";
            fixed: 1 1;
            offscale;
         }
      }
      program { signal: "mouse,in"; source: "sb_hbar_over";
         action: STATE_SET "over" 0.0;
         transition: DECELERATE 0.2;
         target: "base_hbar";
      }
      program { signal: "mouse,out"; source: "sb_hbar_over";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.2;
         target: "base_hbar";
      }
      part { name: "x_hbar_left_mapper"; type: SPACER;
         scale: 1;
         repeat_events: 1;
         description { state: "default" 0.0;
            min: 2 4;
            max: 2 4;
            fixed: 1 1;
            align: 0.0 1.0;
            rel1.to: "sb_hbar";
            rel2.to: "sb_hbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 0 0;
         }
      }
      part { name: "x_hbar_left"; type: SPACER;
         scale: 1;
         repeat_events: 1;
         description { state: "default" 0.0;
            min: 2 4;
            max: 2 4;
            fixed: 1 1;
            align: 0.0 1.0;
            rel1.to: "elm.dragable.hbar";
            rel2.to: "elm.dragable.hbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 0 0;
         }
      }
      part { name: "x_hbar_right_mapper"; type: SPACER;
         scale: 1;
         repeat_events: 1;
         description { state: "default" 0.0;
            min: 2 4;
            max: 2 4;
            fixed: 1 1;
            align: 1.0 1.0;
            rel1.to: "sb_hbar";
            rel2.to: "sb_hbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 0 0;
         }
      }
      part { name: "x_hbar_right"; type: SPACER;
         scale: 1;
         repeat_events: 1;
         description { state: "default" 0.0;
            min: 2 4;
            max: 2 4;
            fixed: 1 1;
            align: 1.0 1.0;
            rel1.to: "elm.dragable.hbar";
            rel2.to: "elm.dragable.hbar";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            min: 0 0;
            max: 0 0;
         }
      }
      // This program shows all parts of the horizontal scrollbar.
      program { signal: "elm,action,show,hbar"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "sb_hbar";
         target: "sb_hbar_show";
         target: "elm.dragable.hbar";
         target: "x_hbar_left_mapper";
         target: "x_hbar_left";
         target: "x_hbar_right_mapper";
         target: "x_hbar_right";
      }
      // This program hides all parts of the horizontal scrollbar.
      program { signal: "elm,action,hide,hbar"; source: "elm";
         action: STATE_SET "hidden" 0.0;
         target: "sb_hbar";
         target: "sb_hbar_show";
         target: "elm.dragable.hbar";
         target: "x_hbar_left_mapper";
         target: "x_hbar_left";
         target: "x_hbar_right_mapper";
         target: "x_hbar_right";
      }
      // These programs handle page-left and page-right scrolling on mouse clicks.
      program { signal: "mouse,down,1*"; source: "sb_hbar_p1";
         action: DRAG_VAL_PAGE -1.0 0.0;
         target: "elm.dragable.hbar";
      }
      program { signal: "mouse,down,1*"; source: "sb_hbar_p2";
         action: DRAG_VAL_PAGE  1.0 0.0;
         target: "elm.dragable.hbar";
      }
//      program { signal: "elm,action,show,left"; source: "elm";
//      }
//      program { signal: "elm,action,show,right"; source: "elm";
//      }
//      program { signal: "elm,action,hide,left"; source: "elm";
//      }
//      program { signal: "elm,action,hide,right"; source: "elm";
//      }
//      program { signal: "elm,action,scroll"; source: "elm";
//      }
//      program { signal: "elm,loop_x,set"; source: "elm";
//      }
//      program { signal: "elm,loop_x,unset"; source: "elm";
//      }

      //////////////////////////////////////////////////////////////////////
      // This part provides the themed color for the vertical scrollbar track.
      // It changes color based on state (default, disabled, clicked).
      part { name: "color_vbar"; type: RECT; mouse_events: 0;
         clip_to: "sb_vbar_show";
         description { state: "default" 0.0;
            fixed: 1 1;
            color_class: "/fg/normal/scroller/bar/vertical";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/scroller/bar/vertical";
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/scroller/bar/vertical";
         }
      }

      // This is the visible thumb of the vertical scrollbar, layered on top of
      // the colored track. It's related to the draggable part for its position.
      part { name: "base_vbar"; type: RECT; mouse_events: 0;
         scale: 1;
         clip_to: "color_vbar";
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "elm.dragable.vbar";
            min: 5 15;
            max: 5 999999;
            align: 1.0 0.5;
         }
         description { state: "over" 0.0;
            inherit: "default" 0.0;
            // The thumb widens on mouseover for better visual feedback.
            min: 15 15;
            max: 15 999999;
         }
      }

      //////////////////////////////////////////////////////////////////////
      // This part provides the themed color for the horizontal scrollbar track.
      part { name: "color_hbar"; type: RECT; mouse_events: 0;
         clip_to: "sb_hbar_show";
         description { state: "default" 0.0;
            fixed: 1 1;
            color_class: "/fg/normal/scroller/bar/horizontal";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/scroller/bar/horizontal";
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/scroller/bar/horizontal";
         }
      }

      // This is the visible thumb of the horizontal scrollbar.
      part { name: "base_hbar"; type: RECT; mouse_events: 0;
         scale: 1;
         clip_to: "color_hbar";
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "elm.dragable.hbar";
            min: 15 5;
            max: 999999 5;
            align: 0.5 1.0;
         }
         description { state: "over" 0.0;
            inherit: "default" 0.0;
            // The thumb becomes thicker on mouseover.
            min: 15 15;
            max: 999999 15;
         }
      }

      //////////////////////////////////////////////////////////////////////

      // This part creates a dimming effect over the content, used for visual
      // feedback during "looping" animations (e.g., bounce-back at scroll ends).
      part { name: "dim_effect"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            // Transparent dark gray (#20202000).
            color: 32 32 32 0; // no cc
            visible: 0;
         }
         description { state: "effect" 0.0;
            // Opaque dark gray (#202020FF).
            color: 32 32 32 255; // no cc
         }
      }
   }
   programs {
      // Handles the disabled state for both scrollbars, applying the "disabled"
      // state which typically alters their appearance (e.g., grays them out).
      program { signal: "elm,state,disabled"; source: "elm";
         action: STATE_SET "disabled" 0.0;
         target: "color_hbar";
         target: "color_vbar";
      }
      // Restores the default appearance of the scrollbars when enabled.
      program { signal: "elm,state,enabled"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "color_hbar";
         target: "color_vbar";
      }
      // When the vertical scrollbar thumb is pressed, this program changes its
      // state to "clicked" for visual feedback.
      program { signal: "mouse,down,1*"; source: "elm.dragable.vbar";
         action: STATE_SET "clicked" 0.0;
         target: "elm.dragable.vbar";
         target: "color_vbar";
      }
      // Emits a signal to the C code that the vertical bar has been pressed.
      program { signal: "mouse,down,*"; source: "elm.dragable.vbar";
         action: SIGNAL_EMIT "elm,vbar,press" "elm";
      }
      program { signal: "mouse,up,1"; source: "elm.dragable.vbar";
         action: STATE_SET "default" 0.0;
         target: "elm.dragable.vbar";
         target: "color_vbar";
      }
      program { signal: "mouse,up,*"; source: "elm.dragable.vbar";
         action: SIGNAL_EMIT "elm,vbar,unpress" "elm";
      }

      program { signal: "mouse,down,1*"; source: "elm.dragable.hbar";
         action: STATE_SET "clicked" 0.0;
         target: "elm.dragable.hbar";
         target: "color_hbar";
      }
      program { signal: "mouse,down,*"; source: "elm.dragable.hbar";
         action: SIGNAL_EMIT "elm,hbar,press" "elm";
      }
      program { signal: "mouse,up,1"; source: "elm.dragable.hbar";
         action: STATE_SET "default" 0.0;
         target: "elm.dragable.hbar";
         target: "color_hbar";
      }
      program { signal: "mouse,up,*"; source: "elm.dragable.hbar";
         action: SIGNAL_EMIT "elm,hbar,unpress" "elm";
      }
      // This program and the following one create the looping (bounce) effect.
      // When triggered, it animates the "dim_effect" part to become visible.
      // The `after` keyword specifies a program to run after this one completes.
      program { signal: "elm,action,looping,left"; source: "elm";
         action: STATE_SET "effect" 0.0;
         transition: LINEAR 0.3;
         target: "dim_effect";
         after: "looping,left,done";
      }
      // After the dim animation, this program signals back to the C code
      // that the animation has finished.
      program { name: "looping,left,done";
         action: SIGNAL_EMIT "elm,looping,left,done" "elm";
      }
      // This program fades out the dim effect when the looping action ends.
      program { signal: "elm,action,looping,left,end"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: LINEAR 0.3;
         target: "dim_effect";
      }
      // The following programs implement the same looping/dimming effect for the
      // right, up, and down directions.
      program { signal: "elm,action,looping,right"; source: "elm";
         action: STATE_SET "effect" 0.0;
         transition: LINEAR 0.3;
         target: "dim_effect";
         after: "looping,right,done";
      }
      program { name: "looping,right,done";
         action: SIGNAL_EMIT "elm,looping,right,done" "elm";
      }
      program { signal: "elm,action,looping,right,end"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: LINEAR 0.3;
         target: "dim_effect";
      }
      program { signal: "elm,action,looping,up"; source: "elm";
         action: STATE_SET "effect" 0.0;
         transition: LINEAR 0.3;
         target: "dim_effect";
         after: "looping,up,done";
      }
      program { name: "looping,up,done";
         action: SIGNAL_EMIT "elm,looping,up,done" "elm";
      }
      program { signal: "elm,action,looping,up,end"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: LINEAR 0.3;
         target: "dim_effect";
      }
      program { signal: "elm,action,looping,down"; source: "elm";
         action: STATE_SET "effect" 0.0;
         transition: LINEAR 0.3;
         target: "dim_effect";
         after: "looping,down,done";
      }
      program { name: "looping,down,done";
         action: SIGNAL_EMIT "elm,looping,down,done" "elm";
      }
      program { signal: "elm,action,looping,down,end"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: LINEAR 0.3;
         target: "dim_effect";
      }
   }
}

// This group inherits from the default scroller but disables content clipping.
// It achieves this by making the "clipper" part extremely large, so it
// never actually clips the content within the window.
group { name: "elm/scroller/base/noclip";
   inherit: "elm/scroller/base/default";
   parts {
      part { name: "clipper";
         description { state: "default" 0.0;
            rel1.offset: -999999 -999999;
            rel2.offset: 999999 999999;
         }
      }
      part { name: "elm.swallow.background";
         description { state: "default" 0.0;
            rel1.offset: 0 0;
            rel2.offset: -1 -1;
         }
      }
      part { name: "elm.swallow.content";
         description { state: "default" 0.0;
            rel1.offset: 0 1;
            rel2.offset: -1 -1;
         }
      }
      part { name: "sh_clip"; type: RECT;
         description { state: "default" 0.0;
            visible: 0;
         }
      }
   }
}

// This group defines the content swallows required for looping (infinite) scroll.
// It provides four swallow parts: the main one, and three others for content
// to the right, bottom, and bottom-right. The C code can populate these
// swallows with copies of the content to create a seamless wrapping effect.
group { name: "elm/scroller/contents/default";
   parts {
      part { name: "elm.swallow.content"; type: SWALLOW;
         description { state: "default" 0.0;
         }
      }
      part { name: "elm.swallow.content_r";
         type: SWALLOW;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1 {
                relative: 1.0 0.0;
                to: "elm.swallow.content";
            }
            rel2 {
                relative: 2.0 1.0;
                to: "elm.swallow.content";
            }
         }
      }
      part { name: "elm.swallow.content_b";
         type: SWALLOW;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1 {
                relative: 0.0 1.0;
                to: "elm.swallow.content";
            }
            rel2 {
                relative: 1.0 2.0;
                to: "elm.swallow.content";
            }
         }
      }
      part { name: "elm.swallow.content_rb";
         type: SWALLOW;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1 {
                relative: 1.0 1.0;
                to: "elm.swallow.content";
            }
            rel2 {
                relative: 2.0 2.0;
                to: "elm.swallow.content";
            }
         }
      }
   }
}

// This variant of the scroller is used in contexts like popups where the
// default inset shadow is not desired. It inherits from the base and
// overrides the content swallow's offsets to remove the inset.
group { name: "elm/scroller/base/popup/no_inset_shadow";
   inherit: "elm/scroller/base/default";
   alias: "elm/scroller/base/no_inset_shadow";
   alias: "elm/gengrid/base/no_inset_shadow";
   parts {
      part { name: "elm.swallow.content"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1.offset: 0 0;
            rel2.offset: 0 0;
         }
      }
   }
}
