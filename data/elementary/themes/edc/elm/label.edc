// Group: elm/label/base/slide_long
// This group implements a label with a "long slide" animation for text that
// doesn't fit. When activated, the text slides from right to left until it
// disappears, then reappears at the starting point. This is useful for displaying
// long strings of text (like song titles) in a constrained space.
group { name: "elm/label/base/slide_long";
   inherit: "elm/label/base/default";
   script {
      LABEL_SCRIPT
      public g_duration, g_stopslide, g_timer_id, g_anim_id;

      // The message handler allows the C code to configure the animation's
      // duration dynamically by sending a MSG_FLOAT_SET message.
      public message(Msg_Type:type, id, ...) {
         if ((type == MSG_FLOAT_SET) && (id == 0)) {
            new Float:duration;
            duration = getfarg(2);
            set_float(g_duration, duration);
         }
      }
      // This function is the callback for the animation timer. It tweens the
      // state of the 'elm.text' part between "slide_begin" and "slide_end"
      // to create the sliding motion.
      public slide_to_end_anim(val, Float:pos) {
         new stopflag;
         new id;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         set_tween_state(PART:"elm.text", pos, "slide_begin", 0.0, "slide_end", 0.0);
         if (pos >= 1.0) {
            // After the slide completes, wait for 0.5s then restart it.
            id = timer(0.5, "slide_to_begin", 1);
            set_int(g_timer_id, id);
            emit("elm,state,slide,end","elm");
         }
      }
      // Starts the animation from beginning to end.
      public slide_to_end() {
         new stopflag;
         new id;
         new Float:duration;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         duration = get_float(g_duration);
         id = anim(duration, "slide_to_end_anim", 1);
         set_int(g_anim_id, id);
      }
      // Resets the text position and restarts the slide animation.
      public slide_to_begin() {
         new stopflag;
         new id;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         set_state(PART:"elm.text", "slide_begin", 0.0);
         id = timer(0.5, "slide_to_end", 1);
         set_int(g_timer_id, id);
      }
      // Public API to start the whole sliding process.
      public start_slide() {
         set_int(g_stopslide, 0);
         set_state(PART:"elm.text", "slide_begin", 0.0);
         slide_to_end();
      }
      // Public API to stop the sliding animation and reset the label.
      public stop_slide() {
         new id;
         set_int(g_stopslide, 1);
         id = get_int(g_anim_id);
         cancel_anim(id);
         id = get_int(g_timer_id);
         cancel_timer(id);
         set_state(PART:"elm.text", "default", 0.0);
      }
   }
   parts {
      part { name: "label.text.clip"; type: RECT;
         description { state: "default" 0.0;
         }
      }
      // The part descriptions are identical to 'slide_short', defining the
      // start and end points for the slide. The script uses these for both
      // the forward and backward animations.
      part { name: "elm.text"; type: TEXTBLOCK;
         scale: 1;
         // The text is clipped to prevent it from appearing outside the
         // designated slide area.
         clip_to: "label.text.clip";
         description { state: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 1.0;
            align: 0.0 0.0;
            text {
               style: "label_style";
               min: 0 1;
            }
         }
         description { state: "slide_end" 0.0;
            inherit: "default" 0.0;
            // 'slide_end' state: The text part is positioned entirely to the left of the container
            // (rel1.relative and rel2.relative x are 0.0), and its content is aligned to the right (align 1.0).
            // This makes the text slide from view to the left.
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 1.0;
            align: 1.0 0.0;
            text {
               style: "label_style";
               min: 1 1;
               // ellipsis is disabled (-1) to ensure the full text slides, rather than being truncated.
               ellipsis: -1;
            }
            fixed: 1 0;
         }
         description { state: "slide_begin" 0.0;
            inherit: "default" 0.0;
            // 'slide_begin' state: The text part is positioned to the right of the container
            // (rel1.relative and rel2.relative x are 1.0), with content aligned to the left.
            // This is the starting point of the animation, where the text begins to slide in from the right.
            rel1.relative: 1.0 0.0;
            rel2.relative: 1.0 1.0;
            align: 0.0 0.0;
            text {
               style: "label_style";
               min: 1 1;
               ellipsis: -1;
            }
            fixed: 1 0;
         }
      }
   }
   programs {
      // The 'start_slide' program is triggered by the "elm,state,slide,start" signal,
      // initiating the sliding animation.
      program { name: "start_slide";
         signal: "elm,state,slide,start"; source: "elm";
         script {
            start_slide();
         }
      }
      // The 'stop_slide' program, triggered by "elm,state,slide,stop",
      // halts the animation.
      program { name: "stop_slide";
         signal: "elm,state,slide,stop"; source: "elm";
         script {
            stop_slide();
         }
      }
   }
}


// Group: elm/label/base/slide_short
// This is a "short slide" animation. Unlike "slide_long", the text in this
// version slides from left to right. The script logic is the same, but the
// positioning of the "slide_begin" and "slide_end" states is reversed to
// change the slide direction.
group { name: "elm/label/base/slide_short";
   inherit: "elm/label/base/default";
   script {
      LABEL_SCRIPT
      public g_duration, g_stopslide, g_timer_id, g_anim_id;

      public message(Msg_Type:type, id, ...) {
         if ((type == MSG_FLOAT_SET) && (id == 0)) {
            new Float:duration;
            duration = getfarg(2);
            set_float(g_duration, duration);
         }
      }
      public slide_to_end_anim(val, Float:pos) {
         new stopflag;
         new id;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         set_tween_state(PART:"elm.text", pos, "slide_begin", 0.0, "slide_end", 0.0);
         if (pos >= 1.0) {
            id = timer(0.5, "slide_to_begin", 1);
            set_int(g_timer_id, id);
            emit("elm,state,slide,end","elm");
         }
      }
      public slide_to_end() {
         new stopflag;
         new id;
         new Float:duration;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         duration = get_float(g_duration);
         id = anim(duration, "slide_to_end_anim", 1);
         set_int(g_anim_id, id);
      }
      public slide_to_begin() {
         new stopflag;
         new id;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         set_state(PART:"elm.text", "slide_begin", 0.0);
         id = timer(0.5, "slide_to_end", 1);
         set_int(g_timer_id, id);
      }
      public start_slide() {
         set_int(g_stopslide, 0);
         set_state(PART:"elm.text", "slide_begin", 0.0);
         slide_to_end();
      }
      public stop_slide() {
         new id;
         set_int(g_stopslide, 1);
         id = get_int(g_anim_id);
         cancel_anim(id);
         id = get_int(g_timer_id);
         cancel_timer(id);
         set_state(PART:"elm.text", "default", 0.0);
      }
   }
   parts {
      part { name: "label.text.clip"; type: RECT;
         description { state: "default" 0.0;
         }
      }
      part { name: "elm.text"; type: TEXTBLOCK;
         scale: 1;
         clip_to: "label.text.clip";
         description { state: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 1.0;
            align: 0.0 0.0;
            text { style: "label_style";
               min: 0 1;
            }
         }
         description { state: "slide_end" 0.0;
            inherit: "default" 0.0;
            // 'slide_end' state: The text is positioned to the right of the container.
            // This is the destination of the slide animation.
            rel1.relative: 1.0 0.0;
            rel2.relative: 1.0 1.0;
            align: 1.0 0.0;
            text { style: "label_style";
               min: 1 1;
               ellipsis: -1;
            }
            fixed: 1 0;
         }
         description { state: "slide_begin" 0.0;
            inherit: "default" 0.0;
            // 'slide_begin' state: The text is positioned to the left of the container,
            // serving as the starting point for the slide from left to right.
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 1.0;
            align: 0.0 0.0;
            text { style: "label_style";
               min: 1 1;
               ellipsis: -1;
            }
            fixed: 1 0;
         }
      }
   }
   programs {
      program { name: "start_slide";
         signal: "elm,state,slide,start"; source: "elm";
         script {
            start_slide();
         }
      }
      program { name: "stop_slide";
         signal: "elm,state,slide,stop"; source: "elm";
         script {
            stop_slide();
         }
      }
   }
}

// Group: elm/label/base/slide_bounce
// This label style features a "bounce" animation, where the text slides to one
// end, pauses, and then slides back to the beginning, repeating in a loop.
// This is achieved by having two separate animation functions, one for each direction.
group { name: "elm/label/base/slide_bounce";
   inherit: "elm/label/base/default";
   script {
      LABEL_SCRIPT
      public g_duration, g_stopslide, g_timer_id, g_anim_id;

      public message(Msg_Type:type, id, ...) {
         if ((type == MSG_FLOAT_SET) && (id == 0)) {
            new Float:duration;
            duration = getfarg(2);
            set_float(g_duration, duration);
         }
      }
      // Animates the slide from start to end (e.g., left to right).
      public slide_to_end_anim(val, Float:pos) {
         new stopflag;
         new id;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         set_tween_state(PART:"elm.text", pos, "slide_begin", 0.0, "slide_end", 0.0);
         if (pos >= 1.0) {
            // When the slide reaches the end, a timer is set to start the return slide.
            id = timer(0.5, "slide_to_begin", 1);
            set_int(g_timer_id, id);
         }
      }
      // Triggers the slide-to-end animation.
      public slide_to_end() {
         new stopflag;
         new id;
         new Float:duration;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         duration = get_float(g_duration);
         id = anim(duration, "slide_to_end_anim", 1);
         set_int(g_anim_id, id);
      }
      // Animates the slide from end back to start (e.g., right to left),
      // creating the "bounce" effect.
      public slide_to_begin_anim(val, Float:pos) {
         new stopflag;
         new id;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         set_tween_state(PART:"elm.text", pos, "slide_end", 0.0, "slide_begin", 0.0);
         if (pos >= 1.0) {
            // When the slide returns to the beginning, it triggers the slide
            // to the end again, creating a continuous loop.
            id = timer(0.5, "slide_to_end", 1);
            set_int(g_timer_id, id);
            emit("elm,state,slide,end","elm");
         }
      }
      // Triggers the slide-to-begin (return) animation.
      public slide_to_begin() {
         new stopflag;
         new id;
         new Float:duration;
         stopflag = get_int(g_stopslide);
         if (stopflag == 1) return;
         duration = get_float(g_duration);
         id = anim(duration, "slide_to_begin_anim", 1);
         set_int(g_anim_id, id);
      }
      public start_slide() {
         set_int(g_stopslide, 0);
         set_state(PART:"elm.text", "slide_begin", 0.0);
         slide_to_end();
      }
      public stop_slide() {
         new id;
         set_int(g_stopslide, 1);
         id = get_int(g_anim_id);
         cancel_anim(id);
         id = get_int(g_timer_id);
         cancel_timer(id);
         set_state(PART:"elm.text", "default", 0.0);
      }
   }
   parts {
      part { name: "label.text.clip"; type: RECT;
         description { state: "default" 0.0;
         }
      }
      part { name: "elm.text"; type: TEXTBLOCK;
         scale: 1;
         clip_to: "label.text.clip";
         description { state: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 1.0;
            align: 0.0 0.0;
            text { style: "label_style";
               min: 0 1;
            }
         }
         description { state: "slide_end" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 1.0 0.0;
            rel2.relative: 1.0 1.0;
            align: 1.0 0.0;
            text { style: "label_style";
               min: 1 1;
               ellipsis: -1;
            }
            fixed: 1 0;
         }
         description { state: "slide_begin" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 1.0;
            align: 0.0 0.0;
            text { style: "label_style";
               min: 1 1;
               ellipsis: -1;
            }
            fixed: 1 0;
         }
      }
   }
   programs {
      program { name: "start_slide";
         signal: "elm,state,slide,start"; source: "elm";
         script {
            start_slide();
         }
      }
      program { name: "stop_slide";
         signal: "elm,state,slide,stop"; source: "elm";
         script {
            stop_slide();
         }
      }
   }
}
#undef FIXED
