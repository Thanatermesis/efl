#define FIXED 1

// LABEL_SCRIPT: A reusable script for managing label states.
// This macro defines a script that handles the visual state of a label based on
// its properties, such as being enabled/disabled or having a fixed size.
// It uses a bitmask 'btmode' to store the state flags (e.g., FIXED, DISABLE)
// and updates the text part's state accordingly. This is a common EDC technique
// to avoid code duplication across multiple groups that share similar logic.
#define LABEL_SCRIPT \
      public btmode; \
      public eval_mode(m) { \
         new f = m & FIXED; \
         new d = m & DISABLE; \
         if (d) { \
            if (f) set_state(PART:"elm.text", "disabled_horizontal_fixed", 0.0); \
            else set_state(PART:"elm.text", "disabled", 0.0); \
         } else { \
            if (f) set_state(PART:"elm.text", "horizontal_fixed", 0.0); \
            else set_state(PART:"elm.text", "default", 0.0); \
         } \
      } \
      public flag_set(flag) { \
         new m = get_int(btmode) | flag; \
         set_int(btmode, m); eval_mode(m); \
      } \
      public flag_unset(flag) { \
         new m = get_int(btmode) & ~flag; \
         set_int(btmode, m); eval_mode(m); \
      }

// Group: elm/label/base/default
// This is the base theme for a standard label widget. It defines the fundamental
// appearance and behavior for labels, including styles for different states and
// basic layout properties. It is designed to be inherited and extended by other
// label variants (e.g., left-aligned, right-aligned).
group { name: "elm/label/base/default";
   script {
      LABEL_SCRIPT
   }
   styles {
      style { name: "label_style";
         // Defines the default text style.
         // 'color_class' is used to link to a color defined in the theme's color palette.
         // It allows for consistent coloring across the UI.
         base: "font="FN" font_size=10 text_class=tb_plain align=center color_class=/fg/normal/text";
         tag: "br" "\n";
         tag: "b" "+ font="FNBD" text_class=tb_light";
         ENABLED_TEXTBLOCK_TAGS
      }
      style { name: "label_style_disabled";
         // Defines the text style for the disabled state.
         // It uses a different color class to visually indicate that the label is inactive.
         base: "font="FN" font_size=10 text_class=tb_plain align=center color_class=/fg/disabled/text";
         tag: "br" "\n";
         tag: "b" "+ font="FNBD" text_class=tb_light";
         DISABLED_TEXTBLOCK_TAGS
      }
   }
   parts {
      part { name: "label.text.clip"; type: RECT;
         // A clipping rectangle that ensures the text and background do not
         // render outside the label's boundaries. It's an invisible part
         // that acts as a container.
         description { state: "default" 0.0;
         }
      }
      part { name: "elm.swallow.background"; type: SWALLOW;
         // A SWALLOW part allows external Evas objects (like a background widget)
         // to be "swallowed" into this part of the layout.
         clip_to: "label.text.clip";
         description { state: "default" 0.0;
         }
      }
      part { name: "elm.text"; type: TEXTBLOCK;
         // The core TEXTBLOCK part that displays the label's text.
         // It is clipped by "label.text.clip" to prevent overflow.
         clip_to: "label.text.clip";
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 1.0;
            text {
               // The 'min' property (1 1) ensures the text part requests at least
               // a minimum size, preventing it from becoming invisible if the text is empty.
               style: "label_style";
               min: 1 1;
            }
         }
         description { state: "horizontal_fixed" 0.0;
            inherit: "default" 0.0;
            fixed: 1 0;
            // 'fixed: 1 0' makes the part's width fixed and height scalable.
            // 'text.min: 0 1' changes minimum size request, allowing it to shrink horizontally.
            // This is useful for layouts where the label should not expand to fill space.
            text.min: 0 1;
         }
         description { state: "disabled" 0.0;
            // In the "disabled" state, the label uses the 'label_style_disabled'
            // to appear greyed out.
            inherit: "default" 0.0;
            text.style: "label_style_disabled";
         }
         description { state: "disabled_horizontal_fixed" 0.0;
            // This state combines the "disabled" and "horizontal_fixed" properties.
            inherit: "horizontal_fixed" 0.0;
            text.style: "label_style_disabled";
         }
      }
   }
   programs {
      // These programs listen for signals from the application logic (e.g., "elm")
      // and execute scripts to change the label's state. This decouples the
      // theme's visual logic from the C code.
      program { signal: "elm,state,horizontal,expandable"; source: "elm";
         script { flag_unset(FIXED); }
      }
      program { signal: "elm,state,horizontal,fixed"; source: "elm";
         script { flag_set(FIXED); }
      }
      program { signal: "elm,state,disabled"; source: "elm";
         // When "elm,state,disabled" is received, it sets the DISABLE flag,
         // triggering the 'eval_mode' function in LABEL_SCRIPT to apply the
         // "disabled" state.
         script { flag_set(DISABLE); }
      }
      program { signal: "elm,state,enabled"; source: "elm";
         // When "elm,state,enabled" is received, it unsets the DISABLE flag,
         // returning the label to its default enabled appearance.
         script { flag_unset(DISABLE); }
      }
   }
}

// Group: elm/label/base/default/left
// This group inherits from the default label and overrides the text alignment to be 'left'.
// This is an efficient way to create variations of a base widget without duplicating
// all the part and program definitions.
group { name: "elm/label/base/default/left";
   inherit: "elm/label/base/default";
   script {
      LABEL_SCRIPT
   }
   styles {
      style { name: "label_style_left";
         // The 'align' property is set to 'left'. All other style properties are the same as the base.
         base: "font="FN" font_size=10 text_class=tb_plain align=left color_class=/fg/normal/text";
         tag: "br" "\n";
         tag: "b" "+ font="FNBD" text_class=tb_light";
         ENABLED_TEXTBLOCK_TAGS
      }
      style { name: "label_style_left_disabled";
         // The disabled style for the left-aligned label.
         base: "font="FN" font_size=10 text_class=tb_plain align=left color_class=/fg/disabled/text";
         tag: "br" "\n";
         tag: "b" "+ font="FNBD" text_class=tb_light";
         DISABLED_TEXTBLOCK_TAGS
      }
   }
   parts {
      textblock { "elm.text";
         // This shorthand syntax updates the description of the 'elm.text' part inherited from the base group.
         // It assigns the new left-aligned styles to the different states.
         desc { "default"; text.style: "label_style_left"; }
         desc { "horizontal_fixed"; text.style: "label_style_left"; }
         desc { "disabled"; text.style: "label_style_left_disabled"; }
         desc { "disabled_horizontal_fixed"; text.style: "label_style_left_disabled"; }
      }
   }
}

// Group: elm/label/base/default/right
// Similar to the 'left' variant, this group provides a right-aligned version of the label
// by inheriting from the base and overriding the text alignment style.
group { name: "elm/label/base/default/right";
   inherit: "elm/label/base/default";
   script {
      LABEL_SCRIPT
   }
   styles {
      style { name: "label_style_right";
         // Sets text alignment to 'right'.
         base: "font="FN" font_size=10 text_class=tb_plain align=right color_class=/fg/normal/text";
         tag: "br" "\n";
         tag: "b" "+ font="FNBD" text_class=tb_light";
         ENABLED_TEXTBLOCK_TAGS
      }
      style { name: "label_style_right_disabled";
         base: "font="FN" font_size=10 text_class=tb_plain align=right color_class=/fg/disabled/text";
         tag: "br" "\n";
         tag: "b" "+ font="FNBD" text_class=tb_light";
         DISABLED_TEXTBLOCK_TAGS
      }
   }
   parts {
      textblock { "elm.text";
         desc { "default"; text.style: "label_style_right"; }
         desc { "horizontal_fixed"; text.style: "label_style_right"; }
         desc { "disabled"; text.style: "label_style_right_disabled"; }
         desc { "disabled_horizontal_fixed"; text.style: "label_style_right_disabled"; }
      }
   }
}

// Group: elm/label/base/marker
// A 'marker' style label, which likely serves as a more prominent label,
// for instance, in tooltips or as markers on a map. It uses a bold font by default
// and defines a 'hilight' tag for special text styling.
group { name: "elm/label/base/marker";
   inherit: "elm/label/base/default";
   script {
      LABEL_SCRIPT
   }
   styles {
      style { name: "label_style2";
         base: "font="FNBD" font_size=10 text_class=tb_plain align=center color_class=/fg/normal/text";
         // The 'hilight' tag allows parts of the label's text to be styled differently,
         // for example, to draw attention to a specific word. It uses a standout text color.
         // Usage in code: "This is a <hilight>highlighted</hilight> text."
         tag: "br" "\n";
         tag: "hilight" "+ font="FNBD" color_class=/fg/normal/text-standout text_class=tb_light";
         tag: "b" "+ font="FNBD" color_class=/fg/normal/text-standout text_class=tb_light";
      }
      style { name: "label_style2_disabled";
         base: "font="FNBD" font_size=10 text_class=tb_plain align=center color_class=/fg/disabled/text";
         tag: "br" "\n";
         tag: "hilight" "+ font="FNBD" color_class=/fg/disabled/text-standout text_class=tb_light";
         tag: "b" "+ font="FNBD" color_class=/fg/disabled/text-standout text_class=tb_light";
      }
   }
   parts {
      textblock { "elm.text";
         desc { "default"; text.style: "label_style2"; }
         desc { "horizontal_fixed"; text.style: "label_style2"; }
         desc { "disabled"; text.style: "label_style2_disabled"; }
         desc { "disabled_horizontal_fixed"; text.style: "label_style2_disabled"; }
      }
   }
}

