// Defines the "hand1" cursor, a pointer hand shape.
// This is commonly used to indicate interactive elements that can be clicked.
group { name: "elm/cursor/hand1/default";
   images.image: "pointer_hand1.png" COMP;
   parts {
      // The 'base' part is the visual representation of the cursor.
      // It uses "pointer_hand1.png" and is set to a fixed size of 32x32 pixels.
      // 'mouse_events: 0' ensures it doesn't interfere with underlying UI elements.
      part { name: "base"; mouse_events: 0; scale: 1;
         scale: 1;
         description { state: "default" 0.0;
            FIXED_SIZE(32, 32)
            image.normal: "pointer_hand1.png";
         }
      }
      // This part defines the cursor's hotspot, which is the exact point
      // that interacts with the screen (e.g., for clicking).
      // It's an invisible 'SWALLOW' part, positioned relative to the 'base' part.
      // The hotspot for this hand cursor is at coordinates (21, 7) within the
      // 32x32 pixel image, corresponding to the tip of the pointing finger.
      part { name: "elm.swallow.hotspot"; type: SWALLOW;
         description { state: "default" 0.0;
            fixed: 1 1;
            visible: 0;
            rel1.relative: (21/32) (7/32);
            rel1.to: "base";
            rel2.to: "base";
            rel2.relative: (21/32) (7/32);
            rel2.offset: 0 0;
         }
      }
      // 'elm.content.hotspot' is an alias for 'elm.swallow.hotspot',
      // ensuring backward compatibility with older EFL versions.
      alias: "elm.content.hotspot" "elm.swallow.hotspot";
   }
}

// Defines a blank (invisible) cursor. This is useful in situations
// where the mouse pointer should be hidden, for example in fullscreen
// media playback or kiosk applications.
group { name: "elm/cursor/blank/default";
   parts {
      // The cursor is made invisible by having no visual parts and only a minimal,
      // non-visible hotspot area. It does not load any images.
      part { name: "elm.swallow.hotspot"; type: SWALLOW;
         description { state: "default" 0.0;
            visible: 0;
            max: 1 1;
         }
      }
      // Alias for backward compatibility.
      alias: "elm.content.hotspot" "elm.swallow.hotspot";
   }
}

// This group defines the "xterm" cursor, which is an I-beam shape.
// It is typically used in text entry fields to indicate where text will be inserted.
group { name: "elm/cursor/xterm/default";
   images.image: "pointer_entry.png" COMP;
   parts {
      // The visual part of the cursor, using the "pointer_entry.png" image.
      // It has a fixed size of 16x32 pixels.
      part { name: "base"; mouse_events: 0; scale: 1;
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "pointer_entry.png";
            FIXED_SIZE(16, 32)
         }
      }
      // The hotspot for the I-beam cursor is positioned exactly in the center
      // of the 'base' part (0.5, 0.5 relative coordinates). This ensures that
      // the cursor's visual center aligns with the text insertion point.
      part { name: "elm.swallow.hotspot"; type: SWALLOW;
         description { state: "default" 0.0;
            visible: 0;
            fixed: 1 1;
            rel.to: "base";
            rel1.relative: 0.5 0.5;
            rel2.relative: 0.5 0.5;
            rel2.offset: 0 0;
         }
      }
      // Alias for backward compatibility.
      alias: "elm.content.hotspot" "elm.swallow.hotspot";
   }
}
