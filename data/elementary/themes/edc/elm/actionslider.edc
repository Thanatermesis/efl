// The main group for the actionslider widget. It defines the layout and behavior
// of the slider, including its background, draggable button, and text labels.
// This group serves as the base for other actionslider styles.
group { name: "elm/actionslider/base/default";
   parts {
      // The background of the actionslider. It serves as the main container for other parts.
      // `mouse_events: 0` means it doesn't react to mouse input directly.
      part { name: "bg"; type: RECT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            min: 120 20;
            color_class: "/bg/normal/actionslider/base";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            // The color when the widget is disabled.
            color_class: "/bg/disabled/actionslider/base";
         }
      }
      // An invisible spacer that defines the confinement area for the draggable button.
      // This ensures the button cannot be dragged outside the widget's boundaries.
      part { name: "icon_dragable_area"; type: SPACER;
         description { state: "default" 0.0;
            rel.to: "bg";
         }
      }
      // These three text parts ("left", "center", "right") display the labels
      // for the actionslider's positions. They are initially positioned off-screen
      // using `offscale` and are made visible by the application logic based
      // on the slider's state.
      part { name: "elm.text.left"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/fg/normal/actionslider/left";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            text { font: FN; size: 10;
               align: 0.0 0.5;
               min: 1 1;
               ellipsis: -1;
               text_class: "button";
            }
            offscale;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            // The text color when the widget is disabled.
            color_class: "/fg/disabled/actionslider/left";
         }
      }
      part { name: "elm.text.center"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/fg/normal/actionslider/center";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            text { font: FN; size: 10;
               align: 0.5 0.5;
               min: 1 1;
               ellipsis: -1;
               text_class: "button";
            }
            offscale;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/actionslider/center";
         }
      }
      part { name: "elm.text.right"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/fg/normal/actionslider/right";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            text { font: FN; size: 10;
               align: 1.0 0.5;
               min: 1 1;
               ellipsis: -1;
               text_class: "button";
            }
            offscale;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/actionslider/right";
         }
      }
      // A SWALLOW part that acts as the container for the draggable button's content
      // (e.g., an icon). This part is dragged, but events are handled by `elm.drag_button`.
      part { name: "elm.drag_button_base"; type: SWALLOW; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 40 20;
            align: 0.5 0.5;
            rel1.to: "icon_dragable_area";
            rel2 {
               relative: 0.0 1.0;
               to: "icon_dragable_area";
            }
         }
         dragable {
            // Confines movement to the `icon_dragable_area`.
            confine: "icon_dragable_area";
            // `x: 1 1 0` enables horizontal dragging. `y: 0 0 0` disables vertical.
            x: 1 1 0;
            y: 0 0 0;
         }
      }
      // An invisible rectangle used as a hit area for the drag button.
      // It forwards drag events to `elm.drag_button_base`. This separation allows for
      // a larger, simpler hit area than the potentially complex visual part.
      part { name: "elm.drag_button"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            min: 40 20;
            color: 0 0 0 0; // Transparent (RGBA: #00000000).
            rel1.to_x: "elm.drag_button_base";
            rel1.to_y: "icon_dragable_area";
            rel2.to_x: "elm.drag_button_base";
            rel2.to_y: "icon_dragable_area";
         }
         dragable {
            events: "elm.drag_button_base";
         }
      }
      // The visible representation of the draggable button. It changes color based on
      // its state ("default", "disabled", "clicked"). Its geometry is tied to
      // `elm.drag_button`, so it moves along with it.
      part { name: "drag_button"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            rel.to: "elm.drag_button";
            color_class: "/bg/normal/actionslider/button";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/disabled/actionslider/button";
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/pressed/actionslider/button";
         }
      }
      // Text displayed on top of the draggable button, often showing its current value
      // or state. It is positioned relative to `drag_button` and follows its states.
      part { name: "elm.text.indicator"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "drag_button";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            color_class: "/fg/normal/actionslider/button";
            text {
               font: FN; size: 10;
               align: 0.5 0.5;
               min: 0 1;
               text_class: "check_off_text";
            }
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/actionslider/button";
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/actionslider/button";
         }
      }
      // An invisible rectangle that covers the entire widget when it's disabled.
      // By becoming visible in the "disabled" state, it intercepts all mouse
      // events, effectively disabling interaction with other parts.
      part { name: "disabler"; type: RECT;
         description { state: "default" 0.0;
            color: 0 0 0 0; // Transparent (RGBA: #00000000).
            visible: 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
   }
   // The programs section defines the dynamic behavior of the widget.
   // These programs react to signals (like mouse clicks or state changes)
   // and execute actions, such as changing part states or emitting signals
   // to the application code.
   programs {
      // When the left mouse button is released on the drag button:
      // 1. Emits the "elm,action,up,drag_button" signal to notify the application.
      // 2. Triggers the "button_unclick_anim" program to revert the button's appearance.
      program { signal: "mouse,up,1"; source: "elm.drag_button";
         action: SIGNAL_EMIT "elm,action,up,drag_button" "elm";
         after: "button_unclick_anim";
      }
      program { name: "button_unclick_anim";
         // Resets the visual state of the button and its text to "default".
         action: STATE_SET "default" 0.0;
         target: "drag_button";
         target: "elm.text.indicator";
      }
      // When the left mouse button is pressed on the drag button:
      // 1. Emits the "elm,action,down,drag_button" signal.
      // 2. Triggers the "button_click_anim" program.
      // The "*" in "mouse,down,1*" allows other programs to also handle this event.
      program { signal: "mouse,down,1*"; source: "elm.drag_button";
         action: SIGNAL_EMIT "elm,action,down,drag_button" "elm";
         after: "button_click_anim";
      }
      program { name: "button_click_anim";
         // Sets the visual state of the button and its text to "clicked".
         action: STATE_SET "clicked" 0.0;
         target: "drag_button";
         target: "elm.text.indicator";
      }
      // As the button is dragged, this program continuously emits the
      // "elm,action,move,drag_button" signal, allowing the application
      // to track the slider's position in real-time.
      program { signal: "mouse,move"; source: "elm.drag_button_base";
         action: SIGNAL_EMIT "elm,action,move,drag_button" "elm";
      }
      // These programs allow the side labels to be clickable. When clicked,
      // they emit a corresponding signal (e.g., "elm,action,down,right")
      // which the application can use to snap the slider to a position.
      program { signal: "mouse,down,1*"; source: "elm.text.right";
         action: SIGNAL_EMIT "elm,action,down,right" "elm";
      }
     program { signal: "mouse,down,1*"; source: "elm.text.left";
         action: SIGNAL_EMIT "elm,action,down,left" "elm";
      }
     program { signal: "mouse,down,1*"; source: "elm.text.center";
         action: SIGNAL_EMIT "elm,action,down,center" "elm";
      }
      // When the widget receives the "elm,state,disabled" signal from the application,
      // this program transitions all relevant parts to their "disabled" state.
      program { signal: "elm,state,disabled"; source: "elm";
         action: STATE_SET "disabled" 0.0;
         target: "bg";
         target: "drag_button";
         target: "disabler";
         target: "elm.text.left";
         target: "elm.text.center";
         target: "elm.text.right";
         target: "elm.text.indicator";
      }
      // Reverses the "disabled" state, setting all parts back to "default"
      // when the "elm,state,enabled" signal is received.
      program { signal: "elm,state,enabled"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "bg";
         target: "drag_button";
         target: "disabler";
         target: "elm.text.left";
         target: "elm.text.center";
         target: "elm.text.right";
         target: "elm.text.indicator";
      }
   }
}

// This group inherits from the default actionslider and adds a "bar" part.
// The bar visually represents the slider's track or progress.
group { name: "elm/actionslider/base/bar";
   inherit: "elm/actionslider/base/default";
   parts {
      // The "bar" part is a rectangle that fills the space from the left edge of
      // the widget to the current position of the drag button. This creates a
      // "progress" effect as the slider is moved.
      part { name: "bar"; type: RECT; mouse_events: 0;
         insert_before: "elm.drag_button_base";
         description { state: "default" 0.0;
            color_class: "/bg/normal/actionslider/bar";
            rel1.to: "bg";
            // The right edge of the bar is tied to the X position of the drag button.
            rel2 {
               relative: 0.0 1.0;
               to_x: "elm.drag_button_base";
               to_y: "bg";
            }
         }
      }
   }
}
