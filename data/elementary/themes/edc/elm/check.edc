// This group defines the standard check widget, which can be toggled on or off.
// It includes a checkbox, an optional icon, and a text label.
group { name: "elm/check/base/default";
   script {
      // Inherits a standard script for handling button-like behaviors and states,
      // such as pressed, disabled, and icon/label visibility.
      BUTTONMODE_SCRIPT
   }
   parts {
      // A spacer part that can be used to provide a shadow effect for depth.
      // Its properties are defined in different states to create the visual effect.
      part { name: "shadow"; type: SPACER;
         description { state: "default";
         }
         desc { "pressed"; inherit;
         }
         desc { "disabled"; inherit;
         }
      }
      // A container for a custom background object. It is initially hidden and does not
      // interact with mouse events due to the 'nomouse' property.
      swallow { "elm.swallow.background"; nomouse;
         desc { "default";
            visible: 0;
         }
         desc { "visible"; inherit;
            visible: 1;
         }
      }
      // A clipping rectangle that defines the visible area for the icon. This ensures
      // that the icon does not draw outside its designated space.
      rect { "icon_clip";
         desc { "default";
            color: 255 255 255 255; // no cc // Solid white (#FFFFFFFF)
         }
         desc { "pressed"; inherit;
            color: 255 255 255 255; // no cc
         }
         desc { "disabled"; inherit;
            color: 255 255 255 64; // no cc // Semi-transparent white (#FFFFFF40)
         }
      }
      swallow { "elm.swallow.content"; nomouse;
         clip_to: "icon_clip";
         scale: 1;
         desc { "default";
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.to_x: "base";
            rel2.to_x: "base";
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
            visible: 0;
            offscale;
         }
         desc { "visible"; inherit;
            fixed: 1 0;
            aspect: 1.0 1.0;
            visible: 1;
            min: ICMIN ICMIN;
         }
         desc { "icononly"; inherit;
            fixed: 0 0;
            align: 0.5 0.5;
            rel2.relative: 1.0 1.0;
            rel2.offset: -5 -5;
            visible: 1;
            min: ICMIN ICMIN;
         }
      }
      // This rectangle forms the main body of the checkbox. Its appearance is determined by
      // color classes, making it easily themeable. It maintains a fixed size of 13x13 pixels.
      part { name: "base"; type: RECT;
         scale: 1;
         description { state: "default";
            color_class: "/bg/normal/check/base";
            align: 0.0 0.5;
            min: 13 13;
            max: 13 13;
            rel1.offset: 4 4;
            rel2.offset: 4 -5;
            rel2.relative: 0.0 1.0;
            offscale;
            fixed: 1 1;
         }
         desc { "pressed"; inherit;
            color_class: "/bg/pressed/check/base";
         }
         desc { "disabled"; inherit;
            color_class: "/bg/disabled/check/base";
         }
      }
      // A rectangle that indicates the selected state of the checkbox. It's positioned relative
      // to the "base" part and becomes semi-transparent when the widget is disabled.
      part { name: "ck_selected"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "base";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 153; // no cc // Semi-transparent white (#FFFFFF99)
         }
      }
      // This part displays the checkmark icon ("i-check") when the box is checked. It is
      // clipped by "ck_selected" to ensure it fits within the selection indicator. The
      // icon's visibility and color are controlled by its state.
      part { name: "ck_check";
         clip_to: "ck_selected";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "base";
            image.normal: "i-check";
            min: 15 15;
            max: 15 15;
            visible: 0;
            color_class: "/fg/normal/check/check";
            fixed: 1 1;
         }
         description { state: "pressed" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/check/check";
            visible: 1;
         }
         description { state: "selected" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/selected/check/check";
            visible: 1;
         }
      }
      // The text label for the check widget. It has multiple states to handle layout
      // changes when an icon is present ("visible") versus when it's not ("textonly"),
      // and also adjusts for pressed and disabled states.
      text { "elm.text"; nomouse;
         scale: 1;
         desc { "default";
            fixed: 0 1;
            color_class: "/fg/normal/check/text";
            rel1.offset: 0 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "elm.swallow.content";
            rel2.offset: -5 -5;
            text { font: FN; size: 10;
               align: 0.0 0.5;
               min: 0 0;
            }
            visible: 0;
            offscale;
            min: 0 ICMIN;
         }
         desc { "visible"; inherit;
            fixed: 0 0;
            rel1.offset: 4 4;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "pressed_visible"; inherit;
            fixed: 0 0;
            color_class: "/fg/pressed/check/text";
            rel1.offset: 4 4;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "textonly"; inherit;
            fixed: 0 0;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "pressed_textonly"; inherit;
            fixed: 0 0;
            color_class: "/fg/pressed/check/text";
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "disabled_visible"; inherit;
            fixed: 0 0;
            color_class: "/fg/disabled/check/text";
            rel1.offset: 4 4;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "disabled_textonly"; inherit;
            fixed: 0 0;
            color_class: "/fg/disabled/check/text";
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
      }
      // An invisible rectangle that captures all mouse events for the widget. This makes
      // the entire check widget area, including the label, clickable.
      rect { "event";
         ignore_flags: ON_HOLD;
         desc { "default";
            color: 0 0 0 0; // no cc // Fully transparent
         }
         desc { "disabled"; inherit;
            visible: 0;
         }
      }
   }
   // The 'programs' section defines the interactive behavior of the widget.
   // These programs respond to signals (like mouse clicks) and change the widget's state.
   programs {
      // When clicked, this program sends a signal to toggle the check state.
      program { signal: "mouse,clicked,1"; source: "event";
         action: SIGNAL_EMIT "elm,action,check,toggle" "elm";
      }
      // When the mouse button is pressed down, this script checks the current state
      // and plays a corresponding sound effect for immediate auditory feedback.
      program { signal: "mouse,down,1"; source: "event";
         script {
            new buf[32]; new Float:val;
            get_state(PART:"ck_check", buf, 32, val);
            if (!strcmp(buf, "default")) { run_program(PROGRAM:"snd-check-on"); }
            else { run_program(PROGRAM:"snd-check-off"); }
         }
      }
      // Changes the state of the "ck_check" part to "selected" when the widget is checked on.
      program { signal: "elm,state,check,on"; source: "elm";
         action:  STATE_SET "selected" 0.0;
         target: "ck_check";
      }
      // Resets the "ck_check" part to its default state when the widget is unchecked.
      program { signal: "elm,state,check,off"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "ck_check";
      }
      // Program to play a sound when the check is turned on.
      program { name: "snd-check-on";
         action: PLAY_SAMPLE "wood-tap1" 1.0 INPUT;
      }
      // Program to play a sound when the check is turned off.
      program { name: "snd-check-off";
         action: PLAY_SAMPLE "wood-tap2" 1.0 INPUT;
      }
      // The following programs handle the visual feedback for the pressed state.
      // On "mouse,down,1", a "press" signal is emitted and the "ck_check" part's state
      // is set to "pressed". The 'PRESSED' flag is also set via a script.
      program { signal: "mouse,down,1"; source: "event";
         action: SIGNAL_EMIT "elm,action,press" "elm";
         after: "button_click_anim";
      }
      program { signal: "mouse,down,1"; source: "event";
         action: STATE_SET "pressed" 0.0;
         target: "ck_check";
      }
      program { name: "button_click_anim";
         script { flag_set(PRESSED); }
      }
      // On "mouse,up,1", an "unpress" signal is emitted, the "ck_check" part is reset
      // to its default state, and the 'PRESSED' flag is unset.
      program { name: "button_unclick";
         signal: "mouse,up,1"; source: "event";
         action: SIGNAL_EMIT "elm,action,unpress" "elm";
         after: "button_unclick_anim";
      }
      program { signal: "mouse,up,1"; source: "event";
         // This ensures that after a click, the checkmark's state is reset,
         // preparing it for the new state determined by the toggle action.
         action: STATE_SET "default" 0.0;
         target: "ck_check";
      }
      program { name: "button_unclick_anim";
         script { flag_unset(PRESSED); }
      }
      // This set of programs allows for programmatic activation of the check widget,
      // simulating a click with a brief "pressed" animation.
      program { name: "buttonactivate";
         signal: "elm,anim,activate"; source: "elm";
         action: STATE_SET "pressed" 0.0;
         target: "ck_check";
         after: "button_unpressed_anim";
      }
      program { name: "button_unpressed_anim";
         in: 0.5 0.0;
         action: STATE_SET "default" 0.0;
         target: "ck_check";
      }
      // Emits a generic "click" signal, allowing other components to react to the action.
      program { signal: "mouse,clicked,1"; source: "event";
         action: SIGNAL_EMIT "elm,action,click" "elm";
      }
      // The following programs manage flags based on the visibility of text, icon, and background.
      // These flags are used by the BUTTONMODE_SCRIPT to adjust the widget's layout dynamically.
      program { name: "button_text_visible";
         signal: "elm,state,text,visible"; source: "elm";
         script { flag_set(LABEL); }
      }
      program { name: "button_text_hidden";
         signal: "elm,state,text,hidden"; source: "elm";
         script { flag_unset(LABEL); }
      }
      program { name: "button_icon_visible";
         signal: "elm,state,icon,visible"; source: "elm";
         script { flag_set(ICON); }
      }
      program { name: "button_icon_hidden";
         signal: "elm,state,icon,hidden"; source: "elm";
         script { flag_unset(ICON); }
      }
      program { name: "button_background_visible";
         signal: "elm,state,background,visible"; source: "elm";
         script { flag_set(BACKGROUND); }
      }
      program { name: "button_background_hidden";
         signal: "elm,state,background,hidden"; source: "elm";
         script { flag_unset(BACKGROUND); }
      }
      // These programs manage the 'DISABLE' flag and set the state of various parts
      // to "disabled" or "enabled" accordingly, controlling the widget's interactive state.
      program { name: "button_state_disabled";
         signal: "elm,state,disabled"; source: "elm";
         script { flag_set(DISABLE); }
      }
      program { name: "button_state_enabled";
         signal: "elm,state,enabled"; source: "elm";
         script { flag_unset(DISABLE); }
      }
      // When the widget is disabled, this program visually updates the "ck_selected" part.
      program { signal: "elm,state,disabled"; source: "elm";
         action:  STATE_SET "disabled" 0.0;
         target: "ck_selected";
      }
      // When enabled, it reverts "ck_selected" to its default appearance.
      program { signal: "elm,state,enabled"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "ck_selected";
      }
   }
}

// This group defines a toggle switch widget, a variant of the check widget that
// visually slides between "ON" and "OFF" states. It supports dragging and
// click-to-toggle interactions.
group { name: "elm/check/base/toggle";
   script {
      // 'is_drag' and 'was_drag' manage the dragging state of the toggle.
      // 'is_rtl' is used to support right-to-left layout direction.
      public is_drag;
      public was_drag;
      public is_rtl;

      BUTTONMODE_SCRIPT
   }
   parts {
      part { name: "shadow"; type: SPACER;
         description { state: "default";
         }
         desc { "pressed"; inherit;
         }
         desc { "disabled"; inherit;
         }
      }
      swallow { "elm.swallow.background"; nomouse;
         desc { "default";
            visible: 0;
         }
         desc { "visible"; inherit;
            visible: 1;
         }
      }
      rect { "icon_clip";
         desc { "default";
            color: 255 255 255 255; // no cc
         }
         desc { "pressed"; inherit;
            color: 255 255 255 255; // no cc
         }
         desc { "disabled"; inherit;
            color: 255 255 255 64; // no cc // Semi-transparent white (#FFFFFF40)
         }
      }
      // This part is a container for the check widget's icon, and is clipped by "icon_clip".
      // Its layout is adaptive, changing based on whether a text label is also present,
      // as seen in the "visible" and "icononly" states.
      swallow { "elm.swallow.content"; nomouse;
         clip_to: "icon_clip";
         scale: 1;
         desc { "default";
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
            visible: 0;
            offscale;
         }
         desc { "visible"; inherit;
            fixed: 1 0;
            aspect: 1.0 1.0;
            visible: 1;
            min: ICMIN ICMIN;
         }
         desc { "icononly"; inherit;
            fixed: 0 0;
            align: 0.5 0.5;
            rel2.relative: 1.0 1.0;
            rel2.offset: -5 -5;
            rel2.to_x: "tog";
            rel2.relative: 0.0 1.0;
            visible: 1;
            min: ICMIN ICMIN;
         }
      }
      // This spacer defines the main area for the toggle switch mechanism, including the
      // track and the sliding button. It has a fixed size.
      spacer { name: "tog"; scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1.relative: 1.0 0.0;
            rel1.offset: -5 4;
            rel2.offset: -5 -5;
            align: 1.0 0.5;
            min: 88 15;
            max: 88 15;
            offscale;
         }
      }
      // The background track of the toggle switch.
      rect { name: "base";
         description { state: "default";
            fixed: 1 1;
            color_class: "/bg/normal/toggle/base";
            rel.to: "tog";
         }
         desc { "pressed"; inherit;
            color_class: "/bg/pressed/toggle/base";
         }
         desc { "disabled"; inherit;
            color_class: "/bg/disabled/toggle/base";
         }
      }
      // Spacers used to define the areas for the "ON" and "OFF" text labels,
      // positioning them on either side of the sliding "button".
      spacer { name: "onrect";
         description { state: "default" 0.0;
            rel.to: "button";
            rel1.relative: -5.0 0.0;
            rel2.relative: 0.5 1.0;
         }
      }
      spacer { name: "offrect";
         description { state: "default" 0.0;
            rel.to: "button";
            rel1.relative: 0.5 0.0;
            rel2.relative: 6.0 1.0;
         }
      }
      // The "OFF" text label. Its position is relative to the "button" and "offrect" parts.
      // It displays the text "OFF" and has states for disabled and clicked appearances.
      text { name: "elm.offtext"; nomouse; scale: 1;
         clip_to: "tog_clip";
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1.to: "button";
            rel1.relative: 1.0 0.0;
            rel1.offset: 4 0;
            rel2.to: "offrect";
            rel2.offset: -5 -1;
            offscale;
            color_class: "/fg/normal/toggle/text/off";
            text { font: FN; size: 10;
               min: 0 1;
               align: 0.5 0.5;
               text_class: "check_off_text";
               text: "OFF";
            }
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/toggle/text/off";
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/toggle/text/off";
         }
      }
      // The "ON" text label, similar in function to "elm.offtext" but for the "ON" state.
      // It is positioned relative to "onrect" and "button".
      text { name: "elm.ontext"; nomouse; scale: 1;
         clip_to: "tog_clip";
         description { state: "default" 0.0;
            fixed: 1 1;
            rel1.to: "onrect";
            rel1.offset: 4 0;
            rel2.to: "button";
            rel2.relative: 0.0 1.0;
            rel2.offset: -5 -1;
            offscale;
            color_class: "/fg/normal/toggle/text/on";
            text { font: FN; size: 10;
               min: 0 1;
               align: 0.5 0.5;
               text_class: "check_on_text";
               text: "ON";
            }
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/toggle/text/on";
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/toggle/text/on";
         }
      }
      // A clipping rectangle that constrains the toggle switch components, ensuring they do
      // not draw outside the bounds of the "tog" part.
      part { name: "tog_clip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "tog";
         }
      }
      // This part represents the draggable button of the toggle switch. It is confined to
      // horizontal movement within the "tog" area.
      part { name: "button"; type: RECT; scale: 1;
         clip_to: "tog_clip";
         dragable {
            x: 1 1 0;
            y: 0 0 0;
            confine: "tog";
         }
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "tog";
            min: 15 15;
            max: 15 99999;
            color: 0 0 0 0; // no cc
         }
      }
      // The visible rectangle of the sliding button. It doesn't handle mouse events directly.
      rect { name: "base_but"; nomouse;
         description { state: "default" 0.0;
            rel.to: "button";
            color_class: "/fg/normal/toggle/button";
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/toggle/button";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/toggle/button";
         }
      }
      // An invisible rectangle that forwards drag events to the "button" part, allowing the
      // button to be dragged without the visual element needing to handle events.
      rect { name: "button_events";
         dragable.events: "button";
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
         }
      }
      // The main text label for the toggle widget, positioned to the left of the switch.
      // Similar to the checkbox, it adapts its layout based on various states.
      text { "elm.text"; nomouse;
         scale: 1;
         desc { "default";
            fixed: 0 1;
            color_class: "/fg/normal/toggle/text";
            rel1.offset: 0 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "elm.swallow.content";
            rel2.offset: -5 -5;
            rel2.relative: 0.0 1.0;
            rel2.to_x: "tog";
            text { font: FN; size: 10;
               align: 0.5 0.5;
               min: 0 0;
            }
            visible: 0;
            offscale;
            min: 0 ICMIN;
         }
         desc { "visible"; inherit;
            fixed: 0 0;
            rel1.offset: 4 4;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "pressed_visible"; inherit;
            fixed: 0 0;
            color_class: "/fg/pressed/toggle/text";
            rel1.offset: 4 4;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "textonly"; inherit;
            fixed: 0 0;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "pressed_textonly"; inherit;
            fixed: 0 0;
            color_class: "/fg/pressed/toggle/text";
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "disabled_visible"; inherit;
            fixed: 0 0;
            color_class: "/fg/disabled/toggle/text";
            rel1.offset: 4 4;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "disabled_textonly"; inherit;
            fixed: 0 0;
            color_class: "/fg/disabled/toggle/text";
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
      }
      // An event-blocking rectangle that becomes visible only when the widget is disabled,
      // preventing any interaction.
      rect { "event2";
         desc { "default";
            color: 0 0 0 0; // no cc
            visible: 0;
         }
         desc { "disabled"; inherit;
            visible: 1;
         }
      }
      // The main clickable area of the widget (excluding the sliding button), used for
      // toggling the state with a simple click instead of dragging.
      rect { "event"; repeat;
         ignore_flags: ON_HOLD;
         desc { "default";
            color: 0 0 0 0; // no cc
         }
         desc { "disabled"; inherit;
            visible: 0;
         }
      }
   }
   // The programs for the toggle switch handle its complex interactive logic, including
   // sliding animations, drag-and-drop, and state changes.
   programs {
      // When the state changes to "on" or "off", these programs animate the sliding "button"
      // to the correct position, taking into account the layout direction (LTR or RTL).
      program { signal: "elm,state,check,on"; source: "elm";
         script {
            new Float:drag;
            if (get_int(is_rtl) == 0) { drag = 100.0; }
            else                      { drag = 0.0; }
            set_drag(PART:"button", drag, 0.0);
         }
      }
      program { signal: "elm,state,check,off"; source: "elm";
         script {
            new Float:drag;
            if (get_int(is_rtl) == 0) { drag = 0.0; }
            else                      { drag = 100.0; }
            set_drag(PART:"button", drag, 0.0);
         }
      }
      // Handles a click on the sliding button. If it wasn't a drag action ('was_drag' is false),
      // it toggles the switch's state by moving the button to the opposite side and
      // emitting the appropriate "check,on" or "check,off" signal.
      program { signal: "mouse,clicked,1"; source: "button";
         script {
            new Float:dx, Float:dy;
            get_drag(PART:"button", dx, dy);
            if (!get_int(was_drag)) {
               if (dx > 0.5) {
                  set_drag(PART:"button", 0.0, 0.0);
               } else {
                  set_drag(PART:"button", 1.0, 0.0);
               }
               if (((get_int(is_rtl) == 1) && (dx <= 0.5)) ||
                   (get_int(is_rtl) == 0) && (dx > 0.5)) {
                  emit("elm,action,check,off", "elm");
               } else {
                  emit("elm,action,check,on", "elm");
               }
            }
         }
      }
      // Sets the 'is_drag' flag to true when a drag operation begins on the button.
      program { signal: "drag"; source: "button";
         script {
            set_int(is_drag, 1);
         }
      }
      // Initializes drag-related flags when the mouse button is pressed down on the slider.
      program { signal: "mouse,down,1"; source: "button";
         script {
            set_int(was_drag, 0);
            set_int(is_drag, 0);
         }
      }
      // When the mouse is released after dragging, this program determines the final state.
      // It snaps the button to the nearest end (on or off) and emits the corresponding
      // signal. It also sets 'was_drag' to true to prevent the click handler from firing.
      program { signal: "mouse,up,1"; source: "button";
         script {
            new Float:dx, Float:dy;
            get_drag(PART:"button", dx, dy);
            if (get_int(is_drag)) {
               if (dx > 0.5) {
                 set_drag(PART:"button", 1.0, 0.0);
               } else {
                 set_drag(PART:"button", 0.0, 0.0);
               }
               if (((get_int(is_rtl) == 1) && (dx <= 0.5)) ||
                   (get_int(is_rtl) == 0) && (dx > 0.5)) {
                 emit("elm,action,check,on", "elm");
               } else {
                 emit("elm,action,check,off", "elm");
               }
               set_int(was_drag, 1);
               set_int(is_drag, 0);
            }
         }
      }
      // These programs provide visual feedback when the slider button is pressed and released.
      // They change the state of the button and the "ON"/"OFF" text labels to "clicked"
      // on mouse down and back to "default" on mouse up.
      program { signal: "mouse,down,1"; source: "button";
         action: STATE_SET "clicked" 0.0;
         target: "base_but";
         target: "elm.ontext";
         target: "elm.offtext";
      }
      program { signal: "mouse,up,1"; source: "button";
         action: STATE_SET "default" 0.0;
         target: "base_but";
         target: "elm.ontext";
         target: "elm.offtext";
      }
      // Toggles the state when the area next to the switch is clicked.
      program { signal: "mouse,clicked,1"; source: "event";
         action: SIGNAL_EMIT "elm,action,check,toggle" "elm";
      }
      // The following programs manage button-like behaviors such as press/unpress animations,
      // programmatic activation, and dynamic layout adjustments based on the visibility of
      // text, icon, and background elements.
      program { signal: "mouse,down,1"; source: "event";
         action: SIGNAL_EMIT "elm,action,press" "elm";
         after: "button_click_anim";
      }
      program { name: "button_click_anim";
         script { flag_set(PRESSED); }
      }
      program { name: "button_unclick";
         signal: "mouse,up,1"; source: "event";
         action: SIGNAL_EMIT "elm,action,unpress" "elm";
         after: "button_unclick_anim";
      }
      program { name: "button_unclick_anim";
         script { flag_unset(PRESSED); }
      }
      program { signal: "elm,anim,activate"; source: "elm";
         script {
            new Float:drag;
            if (get_int(is_rtl) == 0) { drag = 100.0; }
            else                      { drag = 0.0; }
            set_drag(PART:"button", drag, 0.0);
         }
         after: "button_unpressed_anim";
      }
      program { name: "button_unpressed_anim";
         in: 0.5 0.0;
         script {
            new Float:drag;
            if (get_int(is_rtl) == 0) { drag = 0.0; }
            else                      { drag = 100.0; }
            set_drag(PART:"button", drag, 0.0);
         }
      }
      program { signal: "mouse,clicked,1"; source: "event";
         action: SIGNAL_EMIT "elm,action,click" "elm";
      }
      program { signal: "elm,state,text,visible"; source: "elm";
         script { flag_set(LABEL); }
      }
      program { signal: "elm,state,text,hidden"; source: "elm";
         script { flag_unset(LABEL); }
      }
      program { signal: "elm,state,icon,visible"; source: "elm";
         script { flag_set(ICON); }
      }
      program { signal: "elm,state,icon,hidden"; source: "elm";
         script { flag_unset(ICON); }
      }
      program { signal: "elm,state,background,visible"; source: "elm";
         script { flag_set(BACKGROUND); }
      }
      program { signal: "elm,state,background,hidden"; source: "elm";
         script { flag_unset(BACKGROUND); }
      }
      // These programs handle the enabled and disabled states of the widget, updating the
      // appearance and interactivity of various parts accordingly.
      program { signal: "elm,state,disabled"; source: "elm";
         script { flag_set(DISABLE); }
      }
      program { signal: "elm,state,enabled"; source: "elm";
         script { flag_unset(DISABLE); }
      }
      program { signal: "elm,state,disabled"; source: "elm";
         action:  STATE_SET "disabled" 0.0;
         target: "base_but";
         target: "event2";
         target: "elm.offtext";
         target: "elm.ontext";
      }
      program { signal: "elm,state,enabled"; source: "elm";
         action:  STATE_SET "default" 0.0;
         target: "base_but";
         target: "event2";
         target: "elm.offtext";
         target: "elm.ontext";
      }
     // These programs listen for layout direction changes (RTL/LTR) from the Edje engine
     // and update the 'is_rtl' flag, which is used to correctly position the toggle button.
     program { signal: "edje,state,rtl"; source: "edje";
        script {
           set_int(is_rtl, 1);
        }
     }
      program { signal: "edje,state,ltr"; source: "edje";
         script {
            set_int(is_rtl, 0);
         }
      }
   }
}
