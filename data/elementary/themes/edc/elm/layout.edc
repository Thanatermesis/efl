/* application with a main content area with a back button and title area */
// This group defines a layout with a main content area, a back button, and a title.
// It is commonly used in applications for navigation.
group { name: "elm/layout/application/content-back";
   parts {
      // The main content area, positioned below the title bar.
      part { name: "elm.swallow.content"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1 {
               to_y: "title_clipper";
               relative: 0.0 1.0;
            }
         }
      }
      // A clipper for the title area, allows hiding/showing the entire title bar.
      part { name: "title_clipper"; type: RECT;
         description { state: "default" 0.0;
            visible: 1;
            rel1.to_y: "back";
            rel2.to_y: "back";
         }
         // When hidden, it collapses to zero height.
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
            rel2.relative: 1.0 0.0;
         }
      }
      // A clipper for the back button, allowing it to be hidden independently of the title.
      // It is clipped by title_clipper, so hiding the title also hides the back button.
      part { name: "back_clipper"; type: RECT;
         clip_to: "title_clipper";
         description { state: "default" 0.0;
            visible: 1;
         }
         description { state: "hidden" 0.0;
            visible: 0;
         }
      }
      // The back button, implemented as an external part from the elm/button theme.
      part { name: "back"; type: EXTERNAL;
         source: "elm/button";
         clip_to: "back_clipper";
         scale;
         description { state: "default" 0.0;
            align: 0.0 0.0;
            fixed: 1 1;
            rel1 {
               relative: 0.0 0.0;
               offset: 0 0;
            }
            rel2 {
               relative: 0.0 0.0;
               offset: 50 32;
            }
            // Sets the label of the button.
            params.string: "label" "Back";
            offscale;
         }
      }
      programs {
         // When the back button is clicked, emit a signal to notify the application.
         program { signal: "clicked"; source: "back";
            action: SIGNAL_EMIT "elm,action,back" "elm";
         }
         // Show/hide the back button by changing the state of its clipper.
         program { signal: "elm,back,hide"; source: "elm";
            action: STATE_SET "hidden" 0.0;
            target: "back_clipper";
         }
         program { signal: "elm,back,show"; source: "elm";
            action: STATE_SET "default" 0.0;
            target: "back_clipper";
         }
         // Show/hide the title bar with a brief animation.
         program { signal: "elm,title,hide"; source: "elm";
            action: STATE_SET "hidden" 0.0;
            transition: LINEAR 0.1;
            target: "title_clipper";
         }
         program { signal: "elm,title,show"; source: "elm";
            action: STATE_SET "default" 0.0;
            target: "title_clipper";
         }
      }
      // A swallow part on the right side of the title bar for additional controls.
      part { name: "elm.swallow.end"; type: SWALLOW;
         description { state: "default" 0.0;
            align: 1.0 0.0;
            fixed: 1 1;
            rel1 {
               relative: 1.0 0.0;
               offset: -2 1;
            }
            rel2 {
               relative: 1.0 0.0;
               offset: -1 32;
            }
         }
      }
      // The title text, positioned between the back button and the end swallow area.
      part { name: "elm.text.title"; type: TEXT;
         scale: 1;
         clip_to: "title_clipper";
         description { state: "default" 0.0;
            offscale;
            rel1 {
               to_x: "back";
               relative: 1.0 0.0;
               offset: 2 1;
            }
            rel2 {
               to_y: "back";
               to_x: "elm.swallow.end";
               relative: 0.0 1.0;
               offset: -3 -1;
            }
            // Defines the text color using a color class.
            // For example, if the theme defines this as #FFFFFF (white).
            color_class: "/fg/normal/layout/content-back/title";
            text { font: FNBD; size: 10;
            }
         }
      }
   }
}

/* application with a main content area with a back and next buttons and title area */
// This layout extends 'content-back' by adding a 'Next' button on the right side of the title bar.
group { name: "elm/layout/application/content-back-next";
   parts {
      part { name: "elm.swallow.content"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1 {
               to_y: "title_clipper";
               relative: 0.0 1.0;
               offset: -1 1;
            }
         }
      }
      part { name: "title_clipper"; type: RECT;
         description { state: "default" 0.0;
            visible: 1;
            rel1.to_y: "back";
            rel2.to_y: "back";
         }
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
            rel2.relative: 1.0 0.0;
         }
      }
      part { name: "back"; type: EXTERNAL;
         source: "elm/button";
         clip_to: "back_clipper";
         scale;
         description { state: "default" 0.0;
            align: 0.0 0.0;
            fixed: 1 1;
            rel1 {
               relative: 0.0 0.0;
               offset: 0 1;
            }
            rel2 {
               relative: 0.0 0.0;
               offset: 50 32;
            }
            params.string: "label" "Back";
            offscale;
         }
      }
      part { name: "back_clipper"; type: RECT;
         clip_to: "title_clipper";
         description { state: "default" 0.0;
            visible: 1;
         }
         description { state: "hidden" 0.0;
            visible: 0;
         }
      }
      // The 'Next' button, similar to the 'Back' button but aligned to the right.
      part { name: "next"; type: EXTERNAL;
         source: "elm/button";
         clip_to: "next_clipper";
         scale;
         description { state: "default" 0.0;
            align: 1.0 0.0;
            fixed: 1 1;
            rel1 {
               relative: 1.0 0.0;
               offset: -2 1;
            }
            rel2 {
               relative: 1.0 0.0;
               offset: -1 32;
            }
            params.string: "label" "Next";
            offscale;
         }
      }
      // A clipper for the 'Next' button, for independent hide/show control.
      part { name: "next_clipper"; type: RECT;
         clip_to: "title_clipper";
         description { state: "default" 0.0;
            visible: 1;
         }
         description { state: "hidden" 0.0;
            visible: 0;
         }
      }
      programs {
         program { signal: "clicked"; source: "back";
            action: SIGNAL_EMIT "elm,action,back" "elm";
         }
         program { signal: "elm,title,hide"; source: "elm";
            action: STATE_SET "hidden" 0.0;
            transition: LINEAR 0.1;
            target: "title_clipper";
         }
         program { signal: "elm,title,show"; source: "elm";
            action: STATE_SET "default" 0.0;
            target: "title_clipper";
         }
         program { signal: "elm,back,hide"; source: "elm";
            action: STATE_SET "hidden" 0.0;
            target: "back_clipper";
         }
         program { signal: "elm,back,show"; source: "elm";
            action: STATE_SET "default" 0.0;
            target: "back_clipper";
         }
         // When the next button is clicked, emit a signal to the application.
         program { signal: "clicked"; source: "next";
            action: SIGNAL_EMIT "elm,action,next" "elm";
         }
         // Programs to show/hide the next button.
         program { signal: "elm,next,hide"; source: "elm";
            action: STATE_SET "hidden" 0.0;
            target: "next_clipper";
         }
         program { signal: "elm,next,show"; source: "elm";
            action: STATE_SET "default" 0.0;
            target: "next_clipper";
         }
      }
      part { name: "elm.text.title"; type: TEXT;
         scale: 1;
         clip_to: "title_clipper";
         description { state: "default" 0.0;
            rel1 {
               to_x: "back";
               relative: 1.0 0.0;
               offset: 2 1;
            }
            // The title is now constrained between the 'back' and 'next' buttons.
            rel2 {
               to_y: "back";
               to_x: "next";
               relative: 0.0 1.0;
               offset: -3 -1;
            }
            color_class: "/fg/normal/layout/content-back/title";
            text { font: FNBD; size: 10;
            }
         }
      }
   }
}

/* application with toolbar and main content area */
// A layout with a toolbar at the top and a main content area below it.
group { name: "elm/layout/application/toolbar-content";
   parts {
      // The main content area, positioned below the toolbar.
      part { name: "elm.swallow.content"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.external.toolbar";
               relative: 0.0 1.0;
               offset: -1 1;
            }
         }
      }
      // The toolbar, using an external 'elm/toolbar' theme.
      // It's placed at the top of the layout.
      part { name: "elm.external.toolbar"; type: EXTERNAL;
         source: "elm/toolbar";
         description { state: "default" 0.0;
            align: 0.5 0.0;
            fixed: 0 1;
            rel2 {
               relative: 1.0 0.0;
               offset: -1 0;
            }
         }
      }
   }
}

/* application with toolbar and main content area with a back button and title area */
// This layout inherits from 'content-back' and adds a toolbar at the top.
// The parts from the parent group are repositioned to accommodate the toolbar.
group { name: "elm/layout/application/toolbar-content-back";
   inherit: "elm/layout/application/content-back";
   parts {
      // Adds a toolbar at the top of the layout.
      part { name: "elm.external.toolbar"; type: EXTERNAL;
         insert_after: "elm.swallow.content";
         source: "elm/toolbar";
         description { state: "default" 0.0;
            fixed: 0 1;
            align: 0.5 0.0;
            rel2 {
               relative: 1.0 0.0;
               offset: -1 0;
            }
         }
      }
      // Repositions the 'back' button to be below the toolbar.
      part { name: "back";
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.external.toolbar";
               relative: 0.0 1.0;
            }
            rel2 {
               to_y: "elm.external.toolbar";
               relative: 0.0 1.0;
            }
         }
      }
      // Repositions the 'end' swallow area below the toolbar.
      part { name: "elm.swallow.end";
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.external.toolbar";
               relative: 1.0 1.0;
            }
            rel2 {
               to_y: "elm.external.toolbar";
               relative: 1.0 1.0;
            }
         }
      }
      // Repositions the title text below the toolbar.
      part { name: "elm.text.title";
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.external.toolbar";
               relative: 1.0 1.0;
            }
         }
      }
   }
}

/* application with toolbar and main content area with a back and next buttons and title area */
// Inherits from 'content-back-next' and adds a toolbar.
// This is useful for wizards or multi-step processes that also have global actions in a toolbar.
group { name: "elm/layout/application/toolbar-content-back-next";
   inherit: "elm/layout/application/content-back-next";
   parts {
      // The toolbar is added at the top.
      part { name: "elm.external.toolbar"; type: EXTERNAL;
         source: "elm/toolbar";
         description { state: "default" 0.0;
            fixed: 0 1;
            align: 0.5 0.0;
            rel2 {
               relative: 1.0 0.0;
               offset: -1 0;
            }
         }
      }
      part { name: "back";
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.external.toolbar";
               relative: 0.0 1.0;
            }
            rel2 {
               to_y: "elm.external.toolbar";
               relative: 0.0 1.0;
            }
         }
      }
      // Repositions the 'next' button below the toolbar.
      part { name: "next";
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.external.toolbar";
               relative: 1.0 1.0;
            }
            rel2 {
               to_y: "elm.external.toolbar";
               relative: 1.0 1.0;
            }
         }
      }
      part { name: "elm.text.title";
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.external.toolbar";
               relative: 1.0 1.0;
            }
         }
      }
   }
}

/* application with toolbar and main content area as a vertical box */
// Provides a layout with a toolbar and a vertical box for content.
group { name: "elm/layout/application/toolbar-vbox";
   parts {
      // A BOX part for vertically arranging child elements.
      // This is useful for lists of items or stacked controls.
      part { name: "elm.box.content"; type: BOX;
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.external.toolbar";
               relative: 0.0 1.0;
               offset: -1 0;
            }
            box.layout: "vertical";
         }
      }
      part { name: "elm.external.toolbar"; type: EXTERNAL;
         source: "elm/toolbar";
         description { state: "default" 0.0;
            align: 0.5 0.0;
            fixed: 0 1;
            rel2 {
               relative: 1.0 0.0;
               offset: -1 0;
            }
         }
      }
   }
}

/* application with toolbar and main content area as a table */
// Provides a layout with a toolbar and a table for content.
group { name: "elm/layout/application/toolbar-table";
   parts {
      // A TABLE part for arranging child elements in a grid.
      // This is ideal for forms or grid-based layouts.
      part { name: "elm.table.content"; type: TABLE;
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.external.toolbar";
               relative: 0.0 1.0;
               offset: -1 0;
            }
         }
      }
      part { name: "elm.external.toolbar"; type: EXTERNAL;
         source: "elm/toolbar";
         description { state: "default" 0.0;
            align: 0.5 0.0;
            fixed: 0 1;
            rel2 {
               relative: 1.0 0.0;
               offset: -1 0;
            }
         }
      }
   }
}

/* a simple title layout, with a label and two icons */
// A flexible title bar layout with optional icons on the left and right.
// The icons are hidden by default and can be shown via signals.
group { name: "elm/layout/application/titlebar";
   parts {
      // Main content area below the title bar elements.
      part { name: "elm.swallow.content"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1 {
               to_y: "elm.swallow.icon";
               relative: 0.0 1.0;
               offset: -1 0;
            }
         }
      }
      // A swallow part for an icon on the left of the title.
      // Initially hidden, it becomes visible when its state is set to 'visible'.
      part { name: "elm.swallow.icon"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            visible: 0;
            fixed: 1 1;
            align: 0.0 0.0;
            min: 24 24;
            rel1 {
               relative: 0.0 0.0;
               offset: 2 2;
            }
            rel2 {
               relative: 0.0 0.0;
               offset: 2 2;
            }
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // A swallow part for an icon or control on the right of the title.
      // Also hidden by default.
      part { name: "elm.swallow.end"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            visible: 0;
            fixed: 1 1;
            align: 1.0 0.0;
            min: 24 24;
            rel1 {
               relative: 1.0 0.0;
               offset: -3 2;
            }
            rel2 {
               relative: 1.0 0.0;
               offset: -3 2;
            }
            offscale;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      programs {
         // These programs control the visibility of the icon and end swallow parts
         // by switching their states in response to external signals.
         program { signal: "elm,state,icon,visible"; source: "elm";
            action: STATE_SET "visible" 0.0;
            target: "elm.swallow.icon";
         }
         program { signal: "elm,state,icon,hidden"; source: "elm";
            action: STATE_SET "default" 0.0;
            target: "elm.swallow.icon";
         }
         program { signal: "elm,state,end,visible"; source: "elm";
            action: STATE_SET "visible" 0.0;
            target: "elm.swallow.end";
         }
         program { signal: "elm,state,end,hidden"; source: "elm";
            action: STATE_SET "default" 0.0;
            target: "elm.swallow.end";
         }
      }
      // The title text, positioned between the left icon and the right end part.
      part { name: "elm.text"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            rel1 {
               to: "elm.swallow.icon";
               relative: 1.0 0.0;
            }
            rel2 {
               to: "elm.swallow.end";
               relative: 0.0 1.0;
            }
            color_class: "/fg/normal/layout/content-back/title";
            text { font: FNBD; size: 10;
            }
         }
      }
   }
}

