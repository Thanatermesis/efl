/* panes widget style information

   [SIGNAL]
      elm,panes,fixed: Used for elm_panes_fixed_set()
      elm,panes,unfixed: Used for elm_panes_fixed_set()

   [SIGNAL EMIT]
      elm,action,click: Used for "clicked" smart callback.
      elm,action,click,double: Used for "clicked,double" smart callback.
      elm,action,press: Used for "press" smart callback.
      elm,action,unpress: Used for "unpress" smart callback.
*/

// Minimum size for the pane handle.
#define PANEMIN  8
// A secondary minimum size, likely for a different dimension of the handle.
#define PANEMIN2 24
// Width of the pane handle.
#define PANEWID  24

// This group defines the style for a default vertical pane.
// It consists of two content areas separated by a draggable vertical bar.
group { name: "elm/panes/vertical/default";
   // Defines the image used for the vertical pane handle, with compression.
   images.image: "pane_handle_v.png" COMP;
   parts {
      // "whole" serves as the main container for the entire panes widget.
      part { name: "whole"; type: SPACER;
         description { state: "default" 0.0;
         }
      }
      // "right_constraint" is a draggable SPACER used to define the right
      // boundary for the pane. It's confined to "whole" and can only be dragged
      // horizontally. Its max size is 0, making it an invisible constraint.
      part { name: "right_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 1 1 1;
            y: 0 0 0;
         }
         description { state: "default" 0.0;
            max: 0 0;
         }
      }
      // "left_constraint" is similar to "right_constraint", defining the left boundary.
      part { name: "left_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 1 1 1;
            y: 0 0 0;
         }
         description { state: "default" 0.0;
            max: 0 0;
         }
      }
      // "sub_whole" defines the draggable area for the separator, positioned
      // between "left_constraint" and "right_constraint".
      part { name: "sub_whole"; type: SPACER;
         description { state: "default" 0.0;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "left_constraint";
            rel2.relative: 0.0 1.0;
            rel2.to_x: "right_constraint";
         }
      }
      // "whole_left" is a RECT part that represents the left content area.
      // Its right edge is attached to the left side of "elm.bar".
      part { name: "whole_left"; type: RECT;
         description { state: "default" 0.0;
            rel2.to_x: "elm.bar";
            rel2.relative: 0.0 1.0;
         }
      }
      // "whole_right" is the right content area. Its left edge is attached
      // to the right side of "elm.bar".
      part { name: "whole_right"; type: RECT;
         description { state: "default" 0.0;
            rel1.to_x: "elm.bar";
            rel1.relative: 1.0 0.0;
         }
      }
      // "elm.swallow.left" is where the user's content for the left pane is placed.
      // It's clipped by "whole_left" to ensure content doesn't overflow.
      part { name: "elm.swallow.left"; type: SWALLOW;
         clip_to: "whole_left";
         description { state: "default" 0.0;
            rel2.to_x: "elm.bar";
            rel2.relative: 0.0 1.0;
         }
      }
      // "elm.swallow.right" is the SWALLOW part for the right pane's content,
      // clipped by "whole_right".
      part { name: "elm.swallow.right"; type: SWALLOW;
         clip_to: "whole_right";
         description { state: "default" 0.0;
            rel1.to_x: "elm.bar";
            rel1.relative: 1.0 0.0;
         }
      }
      // "elm.bar" is the draggable separator. It is confined within "sub_whole"
      // and can be moved horizontally. The `scale: 1` property makes it
      // scale with the rest of the UI.
      part { name: "elm.bar"; type: SPACER;
         scale: 1;
         dragable { confine: "sub_whole";
            x: 1 1 1;
            y: 0 0 0;
         }
         description { state: "default" 0.0;
            max: 8 99999;
            min: 8 24;
            fixed: 1 1;
            rel1.relative: 0.0 0.5;
            rel2.relative: 1.0 0.5;
         }
      }
      // The "dots" part is the visual representation of the handle on the bar.
      // `mouse_events: 0` means it won't react to mouse events directly;
      // these are handled by the "bar" part. It changes color when pressed.
      part { name: "dots"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            FIXED_SIZE(8, 24)
            image.normal: "pane_handle_v.png";
            rel.to: "elm.bar";
            color_class: "/fg/normal/panes/handle";
         }
         description { state: "pressed" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/panes/handle";
         }
      }
      // "elm.swallow.event" is an invisible SWALLOW part centered on "elm.bar".
      // It's used to define a larger, more user-friendly event area around the
      // thin separator bar, making it easier to click and drag.
      part { name: "elm.swallow.event"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            visible: 0;
            min: PANEMIN PANEMIN2;
            fixed: 1 1;
            rel.to: "elm.bar";
         }
      }
      // The "bar" part is a transparent RECT that captures mouse events for
      // dragging. `dragable.events: "elm.bar"` forwards these events to "elm.bar".
      // Its size is defined by "elm.swallow.event", making the clickable area larger.
      // The color is transparent (#00000000). It becomes invisible when disabled.
      // The event-capturing "bar" is sized relative to "elm.swallow.event"
      // but vertically centered and smaller, creating two hover areas ("bar1" and "bar2").
      part { name: "bar"; type: RECT;
         scale: 1;
         dragable.events: "elm.bar";
         description { state: "default" 0.0;
            min: PANEMIN PANEWID;
            max: 99999 99999;
            fixed: 1 1;
            rel1.to_x: "elm.swallow.event";
            rel2.to_x: "elm.swallow.event";
            color: 0 0 0 0; // no cc
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   programs {
      // When the left mouse button is pressed on the "bar", it emits the
      // "elm,action,press" signal, used for the "press" smart callback.
      program { signal: "mouse,down,1"; source: "bar";
         action: SIGNAL_EMIT "elm,action,press" "elm";
      }
      // Emits "elm,action,unpress" when the mouse button is released.
      program { signal: "mouse,up,1"; source: "bar";
         action: SIGNAL_EMIT "elm,action,unpress" "elm";
      }
      // Changes the state of "dots" to "pressed" when the bar is pressed.
      program { name: "bar_down";
         signal: "mouse,down,1"; source: "bar";
         action: STATE_SET "pressed" 0.0;
         target: "dots";
      }
      // Reverts "dots" to its "default" state on mouse release.
      program { name: "bar_up";
         signal: "mouse,up,1"; source: "bar";
         action: STATE_SET "default" 0.0;
         target: "dots";
      }
      // Emits "elm,action,click" for a single click.
      program { signal: "mouse,clicked,1"; source: "bar";
         action: SIGNAL_EMIT "elm,action,click" "elm";
      }
      // Emits "elm,action,click,double" for a double click.
      program { signal: "mouse,down,1,double"; source: "bar";
         action: SIGNAL_EMIT "elm,action,click,double" "elm";
      }
      // When the "elm,panes,fixed" signal is received, the "bar" is disabled,
      // preventing it from being dragged. This is for elm_panes_fixed_set().
      program {
         signal: "elm,panes,fixed"; source: "elm";
         action: STATE_SET "disabled" 0.0;
         target: "bar";
      }
      // Re-enables the "bar" when the "elm,panes,unfixed" signal is received.
      program {
         signal: "elm,panes,unfixed"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "bar";
      }
   }
}

// This group defines the style for a default horizontal pane, which is
// similar to the vertical version but with a horizontal separator bar.
group { name: "elm/panes/horizontal/default";
   images.image: "pane_handle_h.png" COMP;
   parts {
      part { name: "whole"; type: SPACER;
         description { state: "default" 0.0;
         }
      }
      part { name: "right_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 0 0 0;
            y: 1 1 1;
         }
         description { state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "left_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 0 0 0;
            y: 1 1 1;
         }
         description { state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "sub_whole"; type: SPACER;
         description { state: "default" 0.0;
            rel1.relative: 0.0 1.0;
            rel1.to_y: "left_constraint";
            rel2.relative: 1.0 0.0;
            rel2.to_y: "right_constraint";
         }
      }
      part { name: "whole_left"; type: RECT;
         description { state: "default" 0.0;
            rel2.to_y: "elm.bar";
            rel2.relative: 1.0 0.0;
         }
      }
      part { name: "whole_right"; type: RECT;
         description { state: "default" 0.0;
            rel1.to_y: "elm.bar";
            rel1.relative: 0.0 1.0;
         }
      }
      part { name: "elm.swallow.left"; type: SWALLOW;
         clip_to: "whole_left";
         description { state: "default" 0.0;
            rel2.to_y: "elm.bar";
            rel2.relative: 1.0 0.0;
         }
      }
      part { name: "elm.swallow.right"; type: SWALLOW;
         clip_to: "whole_right";
         description { state: "default" 0.0;
            rel1.to_y: "elm.bar";
            rel1.relative: 0.0 1.0;
         }
      }
      part { name: "elm.bar"; type: SPACER;
         scale: 1;
         dragable { confine: "sub_whole";
            x: 0 0 0;
            y: 1 1 1;
         }
         description { state: "default" 0.0;
            max: 99999 8;
            min: 24 8;
            fixed: 1 1;
            rel1.relative: 0.5 0.0;
            rel2.relative: 0.5 1.0;
         }
      }
      part { name: "dots"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            FIXED_SIZE(24, 8)
            image.normal: "pane_handle_h.png";
            // `fill.smooth: 0` disables smooth scaling for the image,
            // preserving pixel art clarity.
            fill.smooth: 0;
            rel.to: "elm.bar";
            color_class: "/fg/normal/panes/handle";
         }
         description { state: "pressed" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/panes/handle";
         }
      }
      part { name: "elm.swallow.event"; type: SWALLOW;
         description { state: "default" 0.0;
            visible: 0;
            min: PANEMIN2 PANEMIN;
            fixed: 1 1;
            rel.to: "elm.bar";
         }
      }
      part { name: "bar"; type: RECT;
         scale: 1;
         dragable.events: "elm.bar";
         description { state: "default" 0.0;
            min: PANEWID PANEMIN;
            max: 99999 99999;
            fixed: 1 1;
            rel1.to_y: "elm.swallow.event";
            rel2.to_y: "elm.swallow.event";
            color: 0 0 0 0; // no cc
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   programs {
      program {signal: "mouse,down,1"; source: "bar"; // for "press" smart callback
         action: SIGNAL_EMIT "elm,action,press" "elm";
      }
      program { signal: "mouse,up,1"; source: "bar"; // for "unpress" smart callback
         action: SIGNAL_EMIT "elm,action,unpress" "elm";
      }
      program { name: "bar_down";
         signal: "mouse,down,1"; source: "bar";
         action: STATE_SET "pressed" 0.0;
         target: "dots";
      }
      program { name: "bar_up";
         signal: "mouse,up,1"; source: "bar";
         action: STATE_SET "default" 0.0;
         target: "dots";
      }
      program { signal: "mouse,clicked,1"; source: "bar"; // for "clicked" smart callback
         action: SIGNAL_EMIT "elm,action,click" "elm";
      }
      program { signal: "mouse,down,1,double"; source: "bar"; // for "clicked,double" smart callback
         action: SIGNAL_EMIT "elm,action,click,double" "elm";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,fixed"; source: "elm";
         action: STATE_SET "disabled" 0.0;
         target: "bar";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,unfixed"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "bar";
      }
   }
}

////////////////////////////////////////////////////////////////////////////

// This group defines a "flush" style for the vertical pane, where the
// separator bar has no visible width, and a glow effect appears on hover.
group { name: "elm/panes/vertical/flush";
   images.image: "shadow_circle_vert.png" COMP;
   parts {
      part { name: "whole"; type: SPACER;
         description { state: "default" 0.0;
         }
      }
      part { name: "right_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 1 1 1;
            y: 0 0 0;
         }
         description { state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "left_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 1 1 1;
            y: 0 0 0;
         }
         description { state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "sub_whole"; type: SPACER;
         description { state: "default" 0.0;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "left_constraint";
            rel2.relative: 0.0 1.0;
            rel2.to_x: "right_constraint";
         }
      }
      // The content areas are defined to meet at the center of the bar,
      // creating a seamless, "flush" appearance. "whole_left" extends
      // to the right side of "elm.bar".
      part { name: "whole_left"; type: RECT;
         description { state: "default" 0.0;
            rel2.to_x: "elm.bar";
            rel2.relative: 1.0 1.0;
         }
      }
      // "whole_right" starts from the left side of "elm.bar".
      part { name: "whole_right"; type: RECT;
         description { state: "default" 0.0;
            rel1.to_x: "elm.bar";
            rel1.relative: 0.0 0.0;
         }
      }
      // The swallow parts for content are aligned like "whole_left" and "whole_right"
      // and are clipped by them. `fixed: 1 0` makes their width scalable but height fixed.
      part { name: "elm.swallow.left"; type: SWALLOW;
         clip_to: "whole_left";
         description { state: "default" 0.0;
            rel2.to_x: "elm.bar";
            rel2.relative: 1.0 1.0;
            fixed: 1 0;
         }
      }
      part { name: "elm.swallow.right"; type: SWALLOW;
         clip_to: "whole_right";
         description { state: "default" 0.0;
            rel1.to_x: "elm.bar";
            rel1.relative: 0.0 0.0;
            fixed: 1 0;
         }
      }
      // In the flush style, "elm.bar" has a max width of 0, making it invisible.
      // This is key to the "flush" look.
      part { name: "elm.bar"; type: SPACER;
         scale: 1;
         dragable { confine: "sub_whole";
            x: 1 1 1;
            y: 0 0 0;
         }
         description { state: "default" 0.0;
            max: 0 99999;
            min: 0 14;
            fixed: 1 1;
            rel1.relative: 0.0 0.5;
            rel2.relative: 1.0 0.5;
         }
      }
      part { name: "elm.swallow.event"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            visible: 0;
            min: PANEMIN PANEMIN2;
            fixed: 1 1;
            rel.to: "elm.bar";
         }
      }
      part { name: "bar"; type: RECT;
         scale: 1;
         dragable.events: "elm.bar";
         description { state: "default" 0.0;
            min: PANEMIN PANEWID;
            max: 99999 99999;
            fixed: 1 1;
            rel1.to_x: "elm.swallow.event";
            rel1.relative: 0.0 0.25;
            rel2.to_x: "elm.swallow.event";
            rel2.relative: 1.0 0.75;
            color: 0 0 0 0; // no cc
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // "glow1a" is a glow effect for the right pane, clipped by "whole_right".
      // It's invisible by default (transparent white, #FFFFFF00) and becomes
      // visible and opaque white (#FFFFFFFF) in the "active" state (on hover).
      // `offscale` means it's not affected by `elm_scale_set()`.
      part { name: "glow1a"; mouse_events: 0;
         clip_to: "whole_right";
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "shadow_circle_vert.png";
            rel1.to_x: "elm.bar";
            rel2.to_x: "elm.bar";
            color_class: "/shadow/normal/panes/flush";
            color: 255 255 255 0; // no cc
            offscale;
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // no cc
            rel1.offset: -16 0;
            rel2.offset: 15 -1;
            visible: 1;
         }
      }
      // "glow2a", "glowbar1a", and "glowbar2a" provide similar glow effects
      // for the different sides of the separator.
      part { name: "glow2a"; mouse_events: 0;
         clip_to: "whole_left";
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "shadow_circle_vert.png";
            rel1.to_x: "elm.bar";
            rel2.to_x: "elm.bar";
            color_class: "/shadow/normal/panes/flush";
            color: 255 255 255 0; // no cc
            offscale;
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // no cc
            rel1.offset: -16 0;
            rel2.offset: 15 -1;
            visible: 1;
         }
      }
      part { name: "glowbar1a"; type: RECT; mouse_events: 0;
         clip_to: "whole_left";
         scale: 1;
         description { state: "default" 0.0;
            rel1.to_x: "elm.bar";
            rel2.to_x: "elm.bar";
            color_class: "/fg/normal/panes/flush";
            offscale;
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            rel1.offset: -5 0;
            rel2.offset: 4 -1;
            visible: 1;
         }
      }
      part { name: "glowbar2a"; type: RECT; mouse_events: 0;
         clip_to: "whole_right";
         scale: 1;
         description { state: "default" 0.0;
            rel1.to_x: "elm.bar";
            rel2.to_x: "elm.bar";
            color_class: "/fg/normal/panes/flush";
            offscale;
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            rel1.offset: -5 0;
            rel2.offset: 4 -1;
            visible: 1;
         }
      }
      // "bar1" and "bar2" are two transparent RECTs that split the main "bar"
      // into two hover-sensitive areas (left and right). `repeat_events: 1`
      // allows events to be passed to other parts below.
      part { name: "bar1"; type: RECT; repeat_events: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "bar";
            rel2.relative: 0.5 1.0;
            color: 0 0 0 0; // no cc
         }
      }
      part { name: "bar2"; type: RECT; repeat_events: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "bar";
            rel1.relative: 0.5 0.0;
            color: 0 0 0 0; // no cc
         }
      }
   }
   programs {
      program {signal: "mouse,down,1"; source: "bar"; // for "press" smart callback
         action: SIGNAL_EMIT "elm,action,press" "elm";
      }
      program { signal: "mouse,up,1"; source: "bar"; // for "unpress" smart callback
         action: SIGNAL_EMIT "elm,action,unpress" "elm";
      }
      program { signal: "mouse,clicked,1"; source: "bar"; // for "clicked" smart callback
         action: SIGNAL_EMIT "elm,action,click" "elm";
      }
      program { signal: "mouse,down,1,double"; source: "bar"; // for "clicked,double" smart callback
         action: SIGNAL_EMIT "elm,action,click,double" "elm";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,fixed"; source: "elm";
         action: STATE_SET "disabled" 0.0;
         target: "bar";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,unfixed"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "bar";
      }
      // When the mouse enters "bar1", the corresponding glow parts transition
      // to the "active" state with a deceleration effect.
      program { signal: "mouse,in"; source: "bar1";
         action: STATE_SET "active" 0.0;
         transition: DECELERATE 0.2;
         target: "glow1a";
         target: "glowbar1a";
      }
      // The glow fades out when the mouse leaves.
      program { signal: "mouse,out"; source: "bar1";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.5;
         target: "glow1a";
         target: "glowbar1a";
      }
      program { signal: "mouse,in"; source: "bar2";
         action: STATE_SET "active" 0.0;
         transition: DECELERATE 0.2;
         target: "glow2a";
         target: "glowbar2a";
      }
      program { signal: "mouse,out"; source: "bar2";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.5;
         target: "glow2a";
         target: "glowbar2a";
      }
   }
}

// Horizontal version of the "flush" style.
group { name: "elm/panes/horizontal/flush";
   images.image: "shadow_circle_horiz.png" COMP;
   parts {
      part { name: "whole"; type: SPACER;
         description { state: "default" 0.0;
         }
      }
      part { name: "right_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 0 0 0;
            y: 1 1 1;
         }
         description { state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "left_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 0 0 0;
            y: 1 1 1;
         }
         description { state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "sub_whole"; type: SPACER;
         description { state: "default" 0.0;
            rel1.relative: 0.0 1.0;
            rel1.to_y: "left_constraint";
            rel2.relative: 1.0 0.0;
            rel2.to_y: "right_constraint";
         }
      }
      part { name: "whole_left"; type: RECT;
         description { state: "default" 0.0;
            rel2.to_y: "elm.bar";
            rel2.relative: 1.0 1.0;
         }
      }
      part { name: "whole_right"; type: RECT;
         description { state: "default" 0.0;
            rel1.to_y: "elm.bar";
            rel1.relative: 0.0 0.0;
         }
      }
      part { name: "elm.swallow.left"; type: SWALLOW;
         clip_to: "whole_left";
         description { state: "default" 0.0;
            rel2.to_y: "elm.bar";
            rel2.relative: 1.0 1.0;
            fixed: 0 1;
         }
      }
      part { name: "elm.swallow.right"; type: SWALLOW;
         clip_to: "whole_right";
         description { state: "default" 0.0;
            rel1.to_y: "elm.bar";
            rel1.relative: 0.0 0.0;
            fixed: 0 1;
         }
      }
      part { name: "elm.bar"; type: SPACER;
         scale: 1;
         dragable { confine: "sub_whole";
            x: 0 0 0;
            y: 1 1 1;
         }
         description { state: "default" 0.0;
            max: 99999 0;
            min: 14 0;
            fixed: 1 1;
            rel1.relative: 0.5 0.0;
            rel2.relative: 0.5 1.0;
         }
      }
      part { name: "elm.swallow.event"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            visible: 0;
            min: PANEMIN2 PANEMIN;
            fixed: 1 1;
            rel.to: "elm.bar";
         }
      }
      part { name: "bar"; type: RECT;
         scale: 1;
         dragable.events: "elm.bar";
         description { state: "default" 0.0;
            min: PANEWID PANEMIN;
            max: 99999 99999;
            fixed: 1 1;
            rel1.to_y: "elm.swallow.event";
            rel1.relative: 0.25 0.0;
            rel2.to_y: "elm.swallow.event";
            rel2.relative: 0.75 1.0;
            color: 0 0 0 0; // no cc
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      part { name: "glow1a"; mouse_events: 0;
         clip_to: "whole_right";
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "shadow_circle_horiz.png";
            rel1.to_y: "elm.bar";
            rel2.to_y: "elm.bar";
            color_class: "/shadow/normal/panes/flush";
            color: 255 255 255 0; // no cc
            offscale;
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // no cc
            rel1.offset: 0 -16;
            rel2.offset: -1 15;
            visible: 1;
         }
      }
      part { name: "glow2a"; mouse_events: 0;
         clip_to: "whole_left";
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "shadow_circle_horiz.png";
            rel1.to_y: "elm.bar";
            rel2.to_y: "elm.bar";
            color_class: "/shadow/normal/panes/flush";
            color: 255 255 255 0; // no cc
            offscale;
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // no cc
            rel1.offset: 0 -16;
            rel2.offset: -1 15;
            visible: 1;
         }
      }
      part { name: "glowbar1a"; type: RECT; mouse_events: 0;
         clip_to: "whole_left";
         scale: 1;
         description { state: "default" 0.0;
            rel1.to_y: "elm.bar";
            rel2.to_y: "elm.bar";
            color_class: "/fg/normal/panes/flush";
            offscale;
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            rel1.offset: 0 -5;
            rel2.offset: -1 4;
            visible: 1;
         }
      }
      part { name: "glowbar2a"; type: RECT; mouse_events: 0;
         clip_to: "whole_right";
         scale: 1;
         description { state: "default" 0.0;
            rel1.to_y: "elm.bar";
            rel2.to_y: "elm.bar";
            color_class: "/fg/normal/panes/flush";
            offscale;
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            rel1.offset: 0 -5;
            rel2.offset: -1 4;
            visible: 1;
         }
      }
      part { name: "bar1"; type: RECT; repeat_events: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "bar";
            rel2.relative: 1.0 0.5;
            color: 0 0 0 0; // no cc
         }
      }
      part { name: "bar2"; type: RECT; repeat_events: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "bar";
            rel1.relative: 0.0 0.5;
            color: 0 0 0 0; // no cc
         }
      }
   }
   programs {
      program {signal: "mouse,down,1"; source: "bar"; // for "press" smart callback
         action: SIGNAL_EMIT "elm,action,press" "elm";
      }
      program { signal: "mouse,up,1"; source: "bar"; // for "unpress" smart callback
         action: SIGNAL_EMIT "elm,action,unpress" "elm";
      }
      program { signal: "mouse,clicked,1"; source: "bar"; // for "clicked" smart callback
         action: SIGNAL_EMIT "elm,action,click" "elm";
      }
      program { signal: "mouse,down,1,double"; source: "bar"; // for "clicked,double" smart callback
         action: SIGNAL_EMIT "elm,action,click,double" "elm";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,fixed"; source: "elm";
         action: STATE_SET "disabled" 0.0;
         target: "bar";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,unfixed"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "bar";
      }
      program { signal: "mouse,in"; source: "bar1";
         action: STATE_SET "active" 0.0;
         transition: DECELERATE 0.2;
         target: "glow1a";
         target: "glowbar1a";
      }
      program { signal: "mouse,out"; source: "bar1";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.5;
         target: "glow1a";
         target: "glowbar1a";
      }
      program { signal: "mouse,in"; source: "bar2";
         action: STATE_SET "active" 0.0;
         transition: DECELERATE 0.2;
         target: "glow2a";
         target: "glowbar2a";
      }
      program { signal: "mouse,out"; source: "bar2";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.5;
         target: "glow2a";
         target: "glowbar2a";
      }
   }
}

// This group defines a "foldable" vertical pane, where the left pane can be
// collapsed. It inherits from the default style and adds scripting logic.
group { name: "elm/panes/vertical/left-fold";
   inherit: "elm/panes/vertical/default";
   // The script manages the open/closed state of the pane.
   // `public` variables can be accessed from the C code.
   // - open: Tracks if the pane is open (1) or closed (0).
   // - drag_x, drag_y: Store the separator's position before folding.
   script {
      public open;
      public drag_x;
      public drag_y;
   }
   parts {
      // Redefines the "dots" part as a clickable arrow icon to control folding.
      // It has different states for open, closed, and pressed.
      image { "dots";
         desc { "default";
            image.normal: "i-arrow-l";
            FIXED_SIZE(15, 15)
            color_class: "/fg/normal/panes/fold/arrow";
         }
         desc { "pressed";
            image.normal: "i-arrow-l";
            FIXED_SIZE(15, 15)
            color_class: "/fg/pressed/panes/fold/arrow";
         }
         desc { "closed";
            inherit: "default" 0.0;
            image.normal: "i-arrow-r";
         }
         desc { "closed-pressed";
            inherit: "pressed" 0.0;
            image.normal: "i-arrow-r";
            color_class: "/fg/pressed/panes/fold/arrow";
         }
      }
      // An invisible "event" rectangle on top of "dots" to capture clicks.
      rect { "event";
         repeat;
         desc { "default";
            rel.to: "dots";
            color: 0 0 0 0; // no cc
         }
      }
   }
   programs {
      // On load, initialize the pane as open.
      program { signal: "load"; source: "";
         script {
            set_int(open, 1);
         }
      }
      // Overrides the "bar_down" program to set the correct "pressed" state
      // for the arrow icon depending on whether the pane is open or closed.
      program { name: "bar_down";
         script {
            if (get_int(open) == 1) {
               set_state(PART:"dots", "pressed", 0.0);
            } else if (get_int(open) == 0) {
               set_state(PART:"dots", "closed-pressed", 0.0);
            }
         }
      }
      program { name: "bar_up";
         script {
            if (get_int(open) == 1) {
               set_state(PART:"dots", "default", 0.0);
            } else if (get_int(open) == 0) {
               set_state(PART:"dots", "closed", 0.0);
            }
         }
      }
      // Handles clicks on the folding arrow.
      program { signal: "mouse,clicked,1"; source: "event";
         script {
            // If the pane is open, close it.
            if (get_int(open) == 1) {
               new Float: dx;
               new Float: dy;
               // Set state to closed.
               set_int(open, 0);
               // Save the current drag position.
               get_drag(PART:"elm.bar", dx, dy);
               set_float(drag_x, dx);
               // Move the bar to the far left to collapse the pane.
               set_drag(PART:"elm.bar", 0.0, 0.5);
               set_state(PART:"dots", "closed", 0.0);
            // If closed, open it.
            } else if (get_int(open) == 0) {
               // Set state to open.
               set_int(open, 1);
               // Restore the drag position from before it was closed.
               set_drag(PART:"elm.bar", get_float(drag_x), 0.5);
               set_state(PART:"dots", "default", 0.0);
            }
         }
      }
   }
}

// Similar to left-fold, but for collapsing the right pane.
group { name: "elm/panes/vertical/right-fold";
   inherit: "elm/panes/vertical/default";
   script {
      public open;
      public drag_x;
      public drag_y;
   }
   parts {
      image { "dots";
         scale;
         desc { "default";
            image.normal: "i-arrow-r";
            FIXED_SIZE(15, 15)
            color_class: "/fg/normal/panes/fold/arrow";
         }
         desc { "pressed";
            image.normal: "i-arrow-r";
            FIXED_SIZE(15, 15)
            color_class: "/fg/pressed/panes/fold/arrow";
         }
         desc { "closed";
            inherit: "default" 0.0;
            image.normal: "i-arrow-l";
         }
         desc { "closed-pressed";
            inherit: "pressed" 0.0;
            image.normal: "i-arrow-r";
            color_class: "/fg/pressed/panes/fold/arrow";
         }
      }
      rect { "event";
         repeat;
         desc { "default";
            rel.to: "dots";
            color: 0 0 0 0; // no cc
         }
      }
   }
   programs {
      program { signal: "load"; source: "";
         script {
            set_int(open, 1);
         }
      }
      program { name: "bar_down";
         script {
            if (get_int(open) == 1) {
               set_state(PART:"dots", "pressed", 0.0);
            } else if (get_int(open) == 0) {
               set_state(PART:"dots", "closed-pressed", 0.0);
            }
         }
      }
      program { name: "bar_up";
         script {
            if (get_int(open) == 1) {
               set_state(PART:"dots", "default", 0.0);
            } else if (get_int(open) == 0) {
               set_state(PART:"dots", "closed", 0.0);
            }
         }
      }
      program { signal: "mouse,clicked,1"; source: "event";
         script {
            if (get_int(open) == 1) {
               new Float: dx;
               new Float: dy;
               set_int(open, 0);
               get_drag(PART:"elm.bar", dx, dy);
               set_float(drag_x, dx);
               set_drag(PART:"elm.bar", 1.0, 0.5);
               set_state(PART:"dots", "closed", 0.0);
            } else if (get_int(open) == 0) {
               set_int(open, 1);
               set_drag(PART:"elm.bar", get_float(drag_x), 0.5);
               set_state(PART:"dots", "default", 0.0);
            }
         }
      }
   }
}

