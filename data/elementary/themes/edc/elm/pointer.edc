// This group defines the default mouse cursor.
// It consists of a base image and an invisible hotspot part
// that determines the precise point of interaction.
group { name: "elm/pointer/base/default";
   images {
      image: "pointer.png" COMP;
   }
   parts {
      // The "base" part displays the cursor's image.
      part { name: "base";
         // This part does not react to mouse events, so it doesn't interfere with widgets underneath.
         mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            aspect: 1.0 1.0;
            min: 32 32;
            /* force a specific aspect ratio so
             * when it gets scaled it wont squash
             * or stretch */
            aspect_preference: BOTH;
            /* both axes control aspect - thus it
             * will be WITHIN the bounds the axes
             * of thre part describe */
            image.normal: "pointer.png";
            // Uses a color class for theming, allowing the color to be changed globally.
            color_class: "/fg/normal/pointer/base";
         }
      }
      // This "SWALLOW" part is a special, non-visible element used to define the pointer's hotspot.
      // The hotspot is the exact coordinate within the cursor image that corresponds to the mouse position.
      // For a standard arrow cursor, this is the tip of the arrow.
      part { name: "elm.swallow.hotspot"; type: SWALLOW;
         description { state: "default" 0.0;
            visible: 0;
            fixed: 1 1;
            rel1 { to: "base";
               /* the hotspot will scale with the cursor here */
               // The top-left corner of the hotspot is positioned at 18.75% from the top and left of the "base" part.
               relative: 0.1875 0.1875;
               offset: 0 0;
            }
            rel2 { to: "base";
               // The bottom-right corner is at the same position, creating a 1x1 pixel hotspot.
               relative: 0.1875 0.1875;
               offset: 0 0;
            }
         }
      }
   }
}

// Defines the cursor for resizing from the bottom-right corner.
// It inherits the default cursor and adds an animated box to indicate the resize direction.
group { name: "elm/pointer/base/bottom_right_corner";
   inherit: "elm/pointer/base/default";
   parts {
      // This part is a rectangle layered on top of the base cursor.
      // It animates to indicate the direction of resizing.
      part { name: "box"; type: RECT;
         insert_after: "base";
         description { state: "default" 0.0;
            color_class: "/fg/normal/pointer/manipulator";
            // Initially, the box is a smaller square in the middle.
            rel1.relative: 0.3 0.3;
            rel2.relative: 0.7 0.7;
         }
         description { state: "p1" 0.0;
            inherit: "default" 0.0;
            // In the "p1" state, the box expands to the bottom-right corner.
            rel1.relative: 0.3 0.3;
            rel2.relative: 1.0 1.0;
         }
      }
   }
   // The programs create a pulsating animation for the "box" part.
   programs {
      // On load, transition the box to state "p1" (expanded).
      program { name: "box1";
         signal: "load"; source: "";
         action: STATE_SET "p1" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         // After completing, trigger the "box2" program.
         after: "box2";
      }
      // Transition the box back to the "default" state (centered).
      program { name: "box2";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         // After completing, trigger "box1" to create an infinite loop.
         after: "box1";
      }
   }
}

// Defines the cursor for resizing from the top-right corner.
// It inherits from bottom_right_corner and redefines the "p1" state of the "box" part
// to change the animation's direction towards the top-right.
group { name: "elm/pointer/base/top_right_corner";
   inherit: "elm/pointer/base/bottom_right_corner";
   parts {
      part { name: "box";
         description { state: "default" 0.0;
            rel1.relative: 0.3 0.3;
            rel2.relative: 0.7 0.7;
         }
         description { state: "p1" 0.0;
            // In state "p1", the box expands to the top-right.
            rel1.relative: 0.3 0.0;
            rel2.relative: 1.0 0.7;
         }
      }
   }
}

// Defines the cursor for resizing from the top-left corner by redefining the animation states.
group { name: "elm/pointer/base/top_left_corner";
   inherit: "elm/pointer/base/bottom_right_corner";
   parts {
      part { name: "box";
         description { state: "default" 0.0;
            rel1.relative: 0.6 0.6;
            rel2.relative: 1.0 1.0;
         }
         description { state: "p1" 0.0;
            rel1.relative: 0.3 0.3;
            rel2.relative: 1.0 1.0;
         }
      }
   }
}

// Defines the cursor for resizing from the bottom-left corner by redefining the animation states.
group { name: "elm/pointer/base/bottom_left_corner";
   inherit: "elm/pointer/base/bottom_right_corner";
   parts {
      part { name: "box";
         description { state: "default" 0.0;
            rel1.relative: 0.7 0.3;
            rel2.relative: 1.0 0.7;
         }
         description { state: "p1" 0.0;
            rel1.relative: 0.3 0.3;
            rel2.relative: 1.0 1.0;
         }
      }
   }
}

// Defines the cursor for resizing from the bottom side by redefining the animation states.
group { name: "elm/pointer/base/bottom_side";
