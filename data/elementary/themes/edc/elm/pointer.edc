// Defines a "hand" cursor, typically used for clickable or draggable items.
// It features a more complex, multi-stage animation to create a "grabbing" or "waving" effect.
group { name: "elm/pointer/base/hand1";
   inherit: "elm/pointer/base/default";
   parts {
      // The "box" part animates through five different states to create the effect.
      part { name: "box"; type: RECT;
         insert_after: "base";
         description { state: "default" 0.0;
            color_class: "/fg/normal/pointer/manipulator";
            rel1.relative: 0.5 0.5;
            rel2.relative: 1.0 1.0;
         }
         // Each "p" state defines a step in the animation sequence,
         // moving and resizing the box to different positions.
         description { state: "p1" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.5 0.2;
            rel2.relative: 1.0 0.7;
         }
         description { state: "p2" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.0 0.5;
            rel2.relative: 0.5 1.0;
         }
         description { state: "p3" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.2 0.2;
            rel2.relative: 0.7 0.7;
         }
         description { state: "p4" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.3 0.5;
            rel2.relative: 0.8 1.0;
         }
      }
   }
   // The programs chain together to create a five-step animation loop.
   programs {
      // On load, the animation starts by transitioning to "p1".
      program { name: "box1";
         signal: "load"; source: "";
         action: STATE_SET "p1" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         // Each program triggers the next in the sequence.
         after: "box2";
      }
      program { name: "box2";
         action: STATE_SET "p2" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         after: "box3";
      }
      program { name: "box3";
         action: STATE_SET "p3" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         after: "box4";
      }
      program { name: "box4";
         action: STATE_SET "p4" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         after: "box5";
      }
      // The final program transitions back to the "default" state
      // and then restarts the cycle by calling "box1".
      program { name: "box5";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         after: "box1";
      }
   }
}

// Defines the "move" cursor, which is a static version of the "hand1" cursor.
group { name: "elm/pointer/base/move";
   inherit: "elm/pointer/base/hand1";
   // By overriding the programs block and leaving it empty,
   // the animation inherited from "hand1" is disabled.
   programs {
   }
}

// Defines the "rotate" cursor. It features a rectangle that rotates back and forth
// to indicate that a rotation action is possible.
group { name: "elm/pointer/base/rotate";
   inherit: "elm/pointer/base/default";
   parts {
      part { name: "box"; type: RECT;
         insert_after: "base";
         description { state: "default" 0.0;
            color_class: "/fg/normal/pointer/manipulator";
            rel1.relative: 0.3 0.3;
            rel2.relative: 0.8 0.8;
            // Enables 3D-like transformations (mapping) on this part.
            map.on: 1;
            map.smooth: 1;
            // The rotation will occur around the center of the "box" itself.
            map.rotation.center: "box";
         }
         description { state: "p1" 0.0;
            inherit: "default" 0.0;
            // In state "p1", the box is rotated 30 degrees around the Z-axis.
            map.rotation.z: 30;
         }
         description { state: "p2" 0.0;
            inherit: "default" 0.0;
            // In state "p2", it's rotated -60 degrees.
            map.rotation.z: -60;
         }
      }
   }
   // The programs create a continuous back-and-forth rotation animation.
   programs {
      // On load, start rotating to state "p1".
      program { name: "box1";
         signal: "load"; source: "";
         action: STATE_SET "p1" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         after: "box2";
      }
      // Then rotate to state "p2".
      program { name: "box2";
         action: STATE_SET "p2" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         after: "box3";
      }
      // Then rotate back to "p1" and loop by calling "box2" again.
      program { name: "box3";
         action: STATE_SET "p1" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "box";
         after: "box2";
      }
   }
}

// Defines the "plus" cursor, used for actions like "add" or "copy".
// It adds a pulsating plus icon to the default cursor.
group { name: "elm/pointer/base/plus";
   inherit: "elm/pointer/base/default";
   images.image: "pointer_plus.png" COMP;
   parts {
      // This part displays the "plus" icon.
      part { name: "add";
         insert_after: "base";
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "pointer_plus.png";
            color_class: "/fg/normal/pointer/manipulator";
            aspect: 1.0 1.0; aspect_preference: BOTH;
            // Positions the icon towards the bottom-right of the main cursor.
            rel1.relative: 0.3 0.3;
            rel2.relative: 1.0 1.0;
            align: 1.0 1.0;
            max: 21 21;
         }
         description { state: "faded" 0.0;
            inherit: "default" 0.0;
            // The "faded" state is semi-transparent white (#FFFFFF80).
            // The "// no cc" indicates this color is fixed and not affected by the color class.
            color: 255 255 255 128; // no cc
         }
      }
   }
   // The programs create a simple fade in/out animation loop for the "add" icon.
   programs {
      // On load, transition to the "faded" state.
      program { name: "fade1";
         signal: "load"; source: "";
         action: STATE_SET "faded" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "add";
         after: "fade2";
      }
      // Then transition back to the "default" (fully opaque) state.
      program { name: "fade2";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.5;
         target: "add";
         after: "fade1";
      }
   }
}

// Defines the "xterm" or "I-beam" cursor, used for text entry fields.
// Unlike other cursors, this one does not inherit from the default pointer, as its shape is fundamentally different.
group { name: "elm/pointer/base/xterm";
   images.image: "pointer_entry.png" COMP;
   parts {
      // The base part for the I-beam cursor image.
      part { name: "base";
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/fg/normal/pointer/base";
            image.normal: "pointer_entry.png";
            // Sets a 0.5 aspect ratio, making the cursor taller than it is wide.
            // aspect_preference: VERTICAL ensures it scales vertically while maintaining the ratio.
            aspect: (44/88) (44/88); aspect_preference: VERTICAL;
            // This is a preprocessor macro that likely expands to `min: 32 32; max: 32 32;`,
            // fixing the cursor's size to 32x32 pixels.
            FIXED_SIZE(32, 32)
         }
      }
      // The hotspot for the text cursor is positioned exactly in the center of the image.
      part { name: "elm.swallow.hotspot"; type: SWALLOW;
         description { state: "default" 0.0;
            fixed: 1 1;
            visible: 0;
            rel.to: "base";
            rel1.relative: 0.5 0.5;
            rel2.relative: 0.5 0.5;
            rel2.offset: 0 0;
        }
      }
   }
}
