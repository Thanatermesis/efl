// This group defines the basic theme for the Elm_Video widget.
// It handles the visual representation of the video player area,
// including state changes like play, pause, and load.
group { name: "elm/video/base/default";
   parts {
      // A clipper part of type RECT, which serves as a background and a clipping mask.
      // It has two visual states: 'default' (fully opaque white) and 'darker' (gray),
      // used to give visual feedback on the video's state.
      part { name: "clipper"; type: RECT;
         description { state: "default" 0.0;
            color: 255 255 255 255; // #FFFFFFFF
         }
         description { state: "darker" 0.0;
            color: 128 128 128 255; // #808080FF
         }
      }
      // This SWALLOW part is the container where the actual video object from the C code is placed.
      // It is clipped by the "clipper" part, meaning any part of the video outside
      // the clipper's area will not be visible.
      part { name: "elm.swallow.video"; type: SWALLOW;
         clip_to: "clipper";
         description { state: "default" 0.0;
            // Ensures the video maintains its aspect ratio, fitting within the available space.
            aspect: 1.0 1.0; aspect_preference: BOTH;
         }
      }
   }
   // The programs section defines reactions to signals sent from the widget's C code.
   // These programs control the state of the "clipper" part, changing its appearance
   // based on the video's playback status.
   programs {
      // When the video starts loading, set the background to the 'darker' state.
      // This indicates that content is being prepared but is not yet visible.
      program { signal: "elm,video,load"; source: "elm";
         action: STATE_SET "darker" 0.0;
         target: "clipper";
      }
      // When the video begins playing, transition the background to the 'default' (white) state.
      // The SINUSOIDAL transition over 0.1 seconds provides a quick, smooth fade-in effect.
      program { signal: "elm,video,play"; source: "elm";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.1 CURRENT;
         target: "clipper";
      }
      // When the video is paused or ends, transition the background back to the 'darker' state.
      // The 0.5-second transition provides a slower, more noticeable fade to indicate the change in state.
      program { signal: "elm,video,pause"; source: "elm";
         action: STATE_SET "darker" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT;
         target: "clipper";
      }
      program { signal: "elm,video,end"; source: "elm";
         action: STATE_SET "darker" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT;
         target: "clipper";
      }
   }
}
