// The main group for the wizard interface, providing the basic layout,
// background, and navigation controls. It inherits from "e/desktop/background"
// to reuse a common desktop background style.
group { name: "e/wizard/main";
   inherit: "e/desktop/background";
   // These macros define rotating ring images used for a subtle animated background effect.
   // Each IMAGE_RING creates a part with an image that is animated to rotate.
   IMAGE_RING("ringa", 160)
   IMAGE_RING("ringb", 160)
   IMAGE_RING("ringc", 160)
   // A shadow image for the main window, loaded with compression enabled.
   images.image: "win_shadow.png" COMP;
   parts {
      // A SWALLOW part that serves as a container for the wizard page content.
      // External UI components will be "swallowed" into this part.
      // It is positioned between the title and the bottom label, providing a
      // flexible area for different wizard pages.
      part { name: "e.swallow.content"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: 0.2 1.0;
            rel1.offset: 16 16;
            rel1.to_y: "e.text.title";
            rel2.relative: 0.8 0.0;
            rel2.offset: -17 -21;
            rel2.to_y: "e.text.label";
            // Sets a maximum width of 400px.
            max: 400 99999;
            // offscale avoids rendering this part if it's not visible, which is an optimization.
            offscale;
         }
      }

      // Defines a fixed-size area in the bottom-right corner for the busy indicator.
      part { name: "busy_area"; type: SPACER;
         scale: 1;
         description { state: "default" 0.0;
            min: 40 40;
            max: 40 40;
            rel1.relative: 1.0 1.0;
            rel1.offset: -17 -17;
            rel2.relative: 1.0 1.0;
            rel2.offset: -17 -17;
            align: 1.0 1.0;
            fixed: 1 1;
            offscale;
         }
      }
      // This macro creates a busy animation part that is shown when the "next"
      // button is disabled and hidden when it's enabled. It uses the "busy_area" part as its container.
      BUSY("busy_area", "e,state,next,disable", "e", "e,state,next,enable", "e")

      // A decorative shadow for the "next" button, positioned relative to the "base" part.
      part { name: "shadow"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "base";
            WIN_SHADOW_SMALL;
            color_class: "/shadow/normal/wizard";
         }
         // When clicked, the shadow slightly grows and moves, giving a pressed-down effect.
         description { state: "clicked" 0.0;
            inherit;
            image.border_scale_by: 0.25;
            rel1.offset: -5 -3;
            rel2.offset: 4 6;
         }
      }
      // The clickable base of the "next" button. It's a rectangle sized relative
      // to the button's text label.
      part { name: "base"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "e.text.label";
            rel1.offset: -4 -4;
            rel2.offset: 3 3;
            color_class: "/bg/normal/button";
            offscale;
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/pressed/button";
         }
      }
      // An invisible rectangle used to block mouse events on the "next" button.
      // It is made visible in the "disabled" state, effectively overlaying the button
      // and preventing clicks. The color is transparent (0,0,0,0 or #00000000).
      part { name: "block"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "base";
            color: 0 0 0 0; // no cc
            visible: 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // The text label for the "next" button. It's not interactive itself
      // (mouse_events: 0) as the "base" part handles clicks.
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            min: 96 32;
            align: 0.5 1.0;
            rel1.relative: 0.5  0.99;
            rel1.offset: 16 -17;
            rel2.relative: 0.5  0.99;
            rel2.offset: -17 -17;
            color_class: "/fg/normal/button";
            text { font: FN; size: 10;
               min: 1 1;
               ellipsis: -1;
            }
            offscale;
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/button";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/button";
         }
      }

      // The main title text at the top of the wizard.
      part { name: "e.text.title"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: 0.05 0.01;
            rel1.offset: 16 16;
            rel2.relative: 0.95 0.01;
            rel2.offset: -17 16;
            align: 0.5 0.0;
            color_class: "/fg/normal/wizard/text/title";
            text { font: FNBD; size: 20;
               min: 0 1;
               text_class: "init_title";
            }
            fixed: 0 1;
            offscale;
         }
      }

      // A full-window rectangle used to create a fade-in effect when the wizard appears.
      // It starts as fully opaque black (0,0,0,255 or #000000FF) and transitions
      // to transparent (0,0,0,0 or #00000000).
      part { name: "blanker"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            color: 0 0 0 255; // no cc
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color: 0 0 0 0; // no cc
            visible: 0;
         }
      }
   }
   programs {
      // When the wizard is shown ("show" signal), this program starts a transition
      // on the "blanker" part to the "visible" state, creating a fade-in effect.
      program { signal: "show"; source: "";
         action: STATE_SET "visible" 0.0;
         transition: DECELERATE 1.0 USE_DURATION_FACTOR 1;
         target: "blanker";
      }
      // The following programs manage the "next" button's click behavior.
      // They use an Embryo script to check if the button is enabled by inspecting
      // the state of the "block" part before reacting to mouse events.

      // On mouse down, change appearance to "clicked" if not disabled.
      program { signal: "mouse,down,1"; source: "base";
         script {
            new st[31];
            new Float:vl;
            get_state(PART:"block", st, 30, vl);
            if (!strcmp(st, "default")) {
              set_state(PART:"base", "clicked", 0.0);
              set_state(PART:"shadow", "clicked", 0.0);
              set_state(PART:"e.text.label", "clicked", 0.0);
            }
         }
      }
      // On mouse up, revert appearance to "default" if not disabled.
      program { signal: "mouse,up,1"; source: "base";
         script {
            new st[31];
            new Float:vl;
            get_state(PART:"block", st, 30, vl);
            if (!strcmp(st, "default")) {
              set_state(PART:"base", "default", 0.0);
              set_state(PART:"shadow", "default", 0.0);
              set_state(PART:"e.text.label", "default", 0.0);
            }
         }
      }
      // On a full click, emit a signal to the application code to proceed to the next step.
      program { signal: "mouse,clicked,1"; source: "base";
         script {
            new st[31];
            new Float:vl;
            get_state(PART:"block", st, 30, vl);
            if (!strcmp(st, "default"))
              emit("e,action,next", "");
         }
      }
      // These programs are controlled by signals from the application logic
      // to enable or disable the "next" button.

      // Enables the "next" button by making the "block" part invisible and
      // setting the label to its default state.
      program { signal: "e,state,next,enable"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "block";
         target: "e.text.label";
      }
      // Disables the "next" button by making the "block" part visible
      // and setting the label to its disabled state.
      program { signal: "e,state,next,disable"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "block";
         target: "e.text.label";
      }
   }
}

// This group defines the content for the first page of the wizard, which
// prominently features a pulsing logo.
group { name: "e/wizard/firstpage";
   // Defines a scalable image set for the logo. Edje will automatically
   // select the best-sized image from this set based on the display resolution
   // and the part's size, optimizing for quality and performance.
   set { name: "logo_mono";
      image { image: "logo.png" COMP;  size: 601 601 99999 99999; }
      image { image: "logo2.png" COMP; size: 301 301   600   600; }
      image { image: "logo3.png" COMP; size: 151 151   300   300; }
      image { image: "logo4.png" COMP; size:  76  76   150   150; }
      image { image: "logo5.png" COMP; size:  0    0    75    75; }
   }
   parts {
      // The logo part, centered on the page. It has two states, "default" and "active",
      // which are used by the programs below to create a pulsing animation.
      part { name: "logo";
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "logo_mono";
            rel1.relative: 0.5 0.5;
            rel2.relative: 0.5 0.5;
            FIXED_SIZE(150, 150)
            color_class: "/fg/selected-pressed";
         }
         description { state: "active";
            inherit: "default" 0.0;
            color_class: "/fg/selected";
         }
      }
   }
  programs {
     // These two programs create a continuous pulsing animation for the logo.
     // "logo_pulse" is triggered on "show", and then the two programs call
     // each other in a loop using the "after" property. The SINUSOIDAL transition
     // creates a smooth, breathing-like effect.
     program { name: "logo_pulse";
        signal: "show"; source: "";
        action: STATE_SET "active" 0.0;
        target: "logo";
        transition: SINUSOIDAL 1.0;
        after: "logo_pulse2";
     }
     program { name: "logo_pulse2";
        action: STATE_SET "default" 0.0;
        target: "logo";
        transition: SINUSOIDAL 1.0;
        after: "logo_pulse";
     }
  }
}

// A minimal group that inherits the desktop background and provides a simple
// fade-in effect. This could be used for simple pages or transitions that
// don't need the full wizard chrome.
group { name: "e/wizard/extra";
   inherit: "e/desktop/background";
   parts {
      // A full-window rectangle for the fade-in effect, similar to the one
      // in "e/wizard/main". It starts as opaque black (#000000FF) and fades
      // to transparent (#00000000).
      part { name: "blanker"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            color: 0 0 0 255; // no cc
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            color: 0 0 0 0; // no cc
            visible: 0;
         }
      }
   }
   programs {
      // Triggers the fade-in animation when the group is shown.
      program { signal: "show"; source: "";
         action: STATE_SET "visible" 0.0;
         transition: DECELERATE 1.0;
         target: "blanker";
      }
   }
}
