// This group defines the base appearance and behavior of the default shelf.
// It is set to `nomouse` to prevent it from directly interacting with mouse events,
// delegating this responsibility to its child parts.
group { name: "e/shelf/default/base"; nomouse;
   data {
      /* this tells e the shelf is shaped, not rectangular */
//      item: "shaped" "1";
      /* this tells e the number of pixels of the shelf to leave "exposed"
       * when auto-hiding the shelf */
      item: "hidden_state_size" "2";
      /* This makes the border hide instantly after the given amount of
       * seconds - in this case 3 seconds. This means there will be no
       * visible part of the shelf after this time at all as it will be
       * totally hidden */
//      item: "instant_delay" "3.0";
   }
   parts {
      // This rectangle is a transparent mouse event catcher for the entire group.
      rect { "mouse"; mouse;
         desc {
            color: 0 0 0 0; // no cc // Transparent color #00000000
         }
      }
      // The `bg` part serves as the visual background of the shelf.
      part { name: "bg"; type: RECT;
         description { state: "default" 0.0;
            // It uses a color class to allow theming.
            color_class: "/bg/normal/shelf/default";
         }
         description { state: "vert" 0.0;
            inherit: "default" 0.0;
         }
      }
      // The `sizer` spacer defines the content area's padding. It's invisible
      // but constrains the content part. It adapts to orientation changes.
      spacer { "sizer";
         scale: 1;
         description { state: "default" 0.0;
            // Padding for horizontal shelf layout.
            rel1.offset: 4 0;
            rel2.offset: -5 -1;
            // `offscale` ensures the part is pushed out of view instead of being
            // scaled down if the container is smaller than its minimum size.
            offscale;
         }
         description { state: "vert" 0.0;
            // Padding for vertical shelf layout.
            rel1.offset: 0 4;
            rel2.offset: -1 -5;
            offscale;
         }
      }
      // This is the container for the shelf's content (e.g., icons, widgets).
      part { name: "e.swallow.content"; type: SWALLOW; mouse;
         desc {
            // It is positioned relative to the `sizer` part.
            rel.to: "sizer";
            // `link.base` connects the part's visibility to Enlightenment's
            // state signals, enabling autohide functionality.
            link.base: "e,state,visible" "e";
         }
         desc { "hidden"; hid;
            rel.to: "sizer";
            link.base: "e,state,hidden" "e";
         }
      }
      // This rectangle ensures that mouse events are passed to elements below it.
      rect { "events"; repeat; mouse;
         desc {
            color: 0 0 0 0; // no cc // Transparent color #00000000
         }
      }
      programs  {
// The `ORIENT_SATE` macro simplifies creating programs that respond to
// orientation changes. It sets the state of the `sizer` part based on the
// shelf's orientation signal from Enlightenment.
#define ORIENT_SATE(_ORIENT, _STATE) \
         program { signal: "e,state,orientation,"_ORIENT; source: "e"; \
            action: STATE_SET _STATE 0.0; \
            target: "sizer"; \
         }
      }
      // These programs handle orientation changes for horizontal shelves.
      ORIENT_SATE("top", "default")
      ORIENT_SATE("top_left", "default")
      ORIENT_SATE("top_right", "default")
      ORIENT_SATE("bottom", "default")
      ORIENT_SATE("bottom_left", "default")
      ORIENT_SATE("bottom_right", "default")
      // These programs handle orientation changes for vertical shelves.
      ORIENT_SATE("left", "vert")
      ORIENT_SATE("left_top", "vert")
      ORIENT_SATE("left_bottom", "vert")
      ORIENT_SATE("right", "vert")
      ORIENT_SATE("right_top", "vert")
      ORIENT_SATE("right_bottom", "vert")
#undef ORIENT_SATE
   }
}

// This group defines an "inset" style for the shelf, which is aliased for
// various themes. It features a shadow effect that indicates scrolling activity.
group { name: "e/shelf/default/inset"; nomouse;
   alias: "e/shelf/alternate/inset";
   alias: "e/shelf/invisible/inset";
   alias: "e/shelf/translucent/inset";
   // Pre-loads images used for shadows to improve performance.
   images.image: "shadow_circle_horiz.png" COMP;
   images.image: "shadow_circle_vert.png" COMP;
   parts {
      rect { "mouse"; mouse;
         desc {
            color: 0 0 0 0; // no cc // Transparent color #00000000
         }
      }
      // A transparent base layer for the shelf.
      part { name: "base"; type: RECT;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc // Transparent color #00000000
         }
      }
      // This part acts as a clipper for the content, creating the inset look.
      // Its dimensions change based on the shelf's orientation.
      part { name: "clip"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 3 0;
            rel2.offset: -4 -1;
            offscale;
         }
         description { state: "vert" 0.0;
            rel1.offset: 0 3;
            rel2.offset: -1 -4;
            offscale;
         }
      }
      // This spacer defines padding for the content area using `SHELFPAD`,
      // which is a pre-processor macro.
      spacer { "sizer";
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: (3 + SHELFPAD) SHELFPAD;
            rel2.offset: (-4 - SHELFPAD) (-1 - SHELFPAD);
            offscale;
         }
         description { state: "vert" 0.0;
            rel1.offset: SHELFPAD (3 + SHELFPAD);
            rel2.offset: (-1 - SHELFPAD) (-4 - SHELFPAD);
            offscale;
         }
      }
      // The content area, which is clipped by the "clip" part.
      part { name: "e.swallow.content"; type: SWALLOW; mouse;
         clip_to: "clip";
         desc {
            rel.to: "sizer";
            link.base: "e,state,visible" "e";
         }
         desc { "hidden"; hid;
            rel.to: "sizer";
            link.base: "e,state,hidden" "e";
         }
      }
      // This part clips the horizontal shadows, and its visibility is
      // toggled based on the shelf's orientation.
      part { name: "sh_horiz_clip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "clip";
            visible: 1;
         }
         description { state: "vert" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Left shadow part, which is only visible during horizontal scrolling.
      part { name: "sh_l"; nomouse;
         clip_to: "sh_horiz_clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "clip";
            rel2.relative: 0.0 1.0;
            image.normal: "shadow_circle_vert.png";
            min: 0 0;
            // The shadow is initially transparent.
            color: 255 255 255 0; // no cc // Transparent white #FFFFFF00
            // The color class allows theming of the shadow color.
            color_class: "/shadow/normal/shelf/inset";
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            min: 16 0;
            // The shadow becomes opaque in the active state.
            color: 255 255 255 255; // no cc // Opaque white #FFFFFFFF
         }
      }
      // Right shadow part, similar to the left shadow.
      part { name: "sh_r"; nomouse;
         clip_to: "sh_horiz_clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "clip";
            rel1.relative: 1.0 0.0;
            image.normal: "shadow_circle_vert.png";
            min: 0 0;
            color: 255 255 255 0; // no cc // Transparent white #FFFFFF00
            color_class: "/shadow/normal/shelf/inset";
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            min: 16 0;
            color: 255 255 255 255; // no cc // Opaque white #FFFFFFFF
         }
      }
      // This part clips the vertical shadows, and its visibility is
      // toggled based on the shelf's orientation.
      part { name: "sh_vert_clip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "clip";
            visible: 0;
         }
         description { state: "vert" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // Top shadow part, visible during vertical scrolling.
      part { name: "sh_t"; nomouse;
         clip_to: "sh_vert_clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "clip";
            rel2.relative: 1.0 0.0;
            image.normal: "shadow_circle_horiz.png";
            min: 0 0;
            color: 255 255 255 0; // no cc // Transparent white #FFFFFF00
            color_class: "/shadow/normal/shelf/inset";
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            min: 0 16;
            color: 255 255 255 255; // no cc // Opaque white #FFFFFFFF
         }
      }
      // Bottom shadow part, similar to the top shadow.
      part { name: "sh_b"; nomouse;
         clip_to: "sh_vert_clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "clip";
            rel1.relative: 0.0 1.0;
            image.normal: "shadow_circle_horiz.png";
            min: 0 0;
            color: 255 255 255 0; // no cc // Transparent white #FFFFFF00
            color_class: "/shadow/normal/shelf/inset";
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            min: 0 16;
            color: 255 255 255 255; // no cc // Opaque white #FFFFFFFF
         }
      }
      rect { "events"; repeat; mouse;
         desc {
            color: 0 0 0 0; // no cc // Transparent color #00000000
         }
      }
   }
   programs {
// This macro now also targets the clipper parts to adjust them on
// orientation change.
#define ORIENT_SATE(_ORIENT, _STATE) \
   program { signal: "e,state,orientation,"_ORIENT; source: "e"; \
     action: STATE_SET _STATE 0.0; \
     target: "sizer"; \
     target: "clip"; \
     target: "sh_horiz_clip"; \
     target: "sh_vert_clip"; \
   }
      ORIENT_SATE("top", "default")
      ORIENT_SATE("top_left", "default")
      ORIENT_SATE("top_right", "default")
      ORIENT_SATE("bottom", "default")
      ORIENT_SATE("bottom_left", "default")
      ORIENT_SATE("bottom_right", "default")
      ORIENT_SATE("left", "vert")
      ORIENT_SATE("left_top", "vert")
      ORIENT_SATE("left_bottom", "vert")
      ORIENT_SATE("right", "vert")
      ORIENT_SATE("right_top", "vert")
      ORIENT_SATE("right_bottom", "vert")
#undef ORIENT_SATE
      // When scrolling begins, the left/top shadows fade out (if visible)
      // and the right/bottom shadows fade in, indicating scroll start.
      program { signal: "e,state,scroll,begin"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT USE_DURATION_FACTOR 1;
         target: "sh_l";
         target: "sh_t";
      }
      program { signal: "e,state,scroll,begin"; source: "e";
         action: STATE_SET "active" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT USE_DURATION_FACTOR 1;
         target: "sh_r";
         target: "sh_b";
      }
      // When scrolling in the middle, all shadows are active, indicating that
      // there is content to scroll to in both directions.
      program { signal: "e,state,scroll,middle"; source: "e";
         action: STATE_SET "active" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT USE_DURATION_FACTOR 1;
         target: "sh_l";
         target: "sh_t";
      }
      program { signal: "e,state,scroll,middle"; source: "e";
         action: STATE_SET "active" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT USE_DURATION_FACTOR 1;
         target: "sh_r";
         target: "sh_b";
      }
      // When scrolling reaches the end, the left/top shadows are active
      // and the right/bottom shadows are inactive, showing you can scroll back.
      program { signal: "e,state,scroll,end"; source: "e";
         action: STATE_SET "active" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT USE_DURATION_FACTOR 1;
         target: "sh_l";
         target: "sh_t";
      }
      program { signal: "e,state,scroll,end"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT USE_DURATION_FACTOR 1;
         target: "sh_r";
         target: "sh_b";
      }
      // When there is no scrolling (e.g., not enough content),
      // all shadows are set to their default (transparent) state.
      program { signal: "e,state,scroll,none"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT USE_DURATION_FACTOR 1;
         target: "sh_l";
         target: "sh_t";
      }
      program { signal: "e,state,scroll,none"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.5 CURRENT USE_DURATION_FACTOR 1;
         target: "sh_r";
         target: "sh_b";
      }
   }
}

// Defines a simple, "plain" shelf style without complex effects like shadows.
// It is aliased for different themes to provide a minimalist appearance.
group { name: "e/shelf/default/plain"; nomouse;
   alias: "e/shelf/alternate/plain";
   alias: "e/shelf/invisible/plain";
   alias: "e/shelf/translucent/plain";
   parts {
      rect { "mouse"; mouse;
         desc {
            color: 0 0 0 0; // no cc // Transparent color #00000000
         }
      }
      part { name: "base"; type: RECT;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc // Transparent color #00000000
         }
      }
      // A simple clipper for the content area.
      part { name: "clip"; type: RECT;
         description { state: "default" 0.0;
         }
      }
      // Defines uniform padding around the content area.
      spacer { "sizer";
         scale: 1;
         desc {
            rel1.offset: SHELFPAD SHELFPAD;
            rel2.offset: (-1 - SHELFPAD) (-1 - SHELFPAD);
            offscale;
         }
      }
      // The content area is clipped and positioned within the sizer's padding.
      part { name: "e.swallow.content"; type: SWALLOW; mouse;
         clip_to: "clip";
         desc {
            rel.to: "sizer";
            link.base: "e,state,visible" "e";
         }
         desc { "hidden"; hid;
            rel.to: "sizer";
            link.base: "e,state,hidden" "e";
         }
      }
      rect { "events"; repeat; mouse;
         desc {
            color: 0 0 0 0; // no cc // Transparent color #00000000
         }
      }
   }
}

// This group provides an alternate background color for the default shelf
// by inheriting from "e/shelf/default/base" and overriding the `color_class`.
group { name: "e/shelf/alternate/base"; nomouse;
   inherit: "e/shelf/default/base";
   parts {
      part { name: "bg"; type: RECT;
         description { state: "default" 0.0;
            color_class: "/bg/normal/shelf/alt";
         }
         description { state: "vert" 0.0;
            color_class: "/bg/normal/shelf/alt";
         }
      }
   }
}

// This group creates an invisible shelf by hiding the background and setting
// data properties to indicate it's shaped and has no shadow.
group { name: "e/shelf/invisible/base"; nomouse;
   inherit: "e/shelf/default/base";
   data {
      item: "shaped" "1";
      item: "noshadow" "1";
   }
   parts {
      part { name: "bg";
         description { state: "default" 0.0;
            visible: 0;
         }
         description { state: "vert" 0.0;
            visible: 0;
         }
      }
   }
}

// This group defines a translucent shelf by using a specific color class for
// transparency and setting data properties for a shaped, no-shadow look.
group { name: "e/shelf/translucent/base"; nomouse;
   inherit: "e/shelf/default/base";
   data {
      item: "shaped" "1";
      item: "noshadow" "1";
   }
   parts {
      part { name: "bg";
         description { state: "default" 0.0;
            color_class: "/bg/normal/shelf/translucent";
         }
         description { state: "vert" 0.0;
            color_class: "/bg/normal/shelf/translucent";
         }
      }
   }
}
