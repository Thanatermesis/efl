// This group defines the main background and container for the RandR configuration dialog.
// It sets up a dark background with a diagonal stripe pattern.
group { name: "e/conf/randr/main";
   images.image: "diagonal_stripes.png" COMP;
   parts {
      // "bg" is a rectangle that serves as the main dark background of the dialog.
      // It has a small margin (2px on left/top, 3px on right/bottom) from the group's edges.
      // The "color_class" is used for theming, applying a standard dark background color.
      part { name: "bg"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 2 2;
            rel2.offset: -3 -3;
            color_class: "/bg-dark/normal";
            min: 18 18;
            offscale;
         }
      }
      // "pat" is a part that overlays a tiled pattern on top of the "bg" part.
      // It uses "diagonal_stripes.png" and is slightly smaller than "bg" to create a border effect.
      // The color_class "/bg-dark-alt/normal" provides a slightly different shade for the pattern.
      part { name: "pat";
         scale: 1;
         description
           { state: "default" 0.0;
              rel.to: "bg";
              rel1.offset: 2 2;
              rel2.offset: -3 -3;
              image.normal: "diagonal_stripes.png";
              color_class: "/bg-dark-alt/normal";
              // This macro tiles the image "diagonal_stripes.png" within the part's area,
              // with each tile being 240x240 pixels. This is an efficient way to create a patterned background.
              TILED_PATTERN(240, 240)
              offscale;
           }
      }
      // "clipper" is an invisible rectangle used to clip the content. Its geometry is tied to "pat",
      // ensuring that anything drawn inside it doesn't spill outside the patterned area.
      part { name: "clipper"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "pat";
         }
      }
      // "e.swallow.content" is the main content area of the dialog.
      // External UI elements (like the monitor representations) will be placed here.
      // It is clipped by "clipper" to stay within the designated frame.
      part { name: "e.swallow.content"; type: SWALLOW;
         clip_to: "clipper";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "pat";
            rel1.offset: 2 2;
            rel2.offset: -3 -3;
            offscale;
         }
      }
   }
}

// This group acts as a container for a single monitor representation,
// separating the stand from the frame for flexible arrangement.
group { name: "e/conf/randr/main/monitor";
   parts {
      // Swallows the visual representation of the monitor stand.
      // It's aligned to the bottom-center of the available space.
      part { name: "e.swallow.stand"; type: SWALLOW;
         description { state: "default" 0.0;
            align: 0.5 1.0;
            rel1.relative: 0.0 0.5;
            rel2.offset: -1 30;
         }
      }
      // Swallows the main monitor frame, which contains the screen preview and controls.
      part { name: "e.swallow.frame"; type: SWALLOW;
         description { state: "default" 0.0;
         }
      }
   }
}

// This group defines the appearance and behavior of an individual monitor frame.
// It includes text styles for displaying monitor information, parts for visual elements
// like the preview and status indicators, and programs to handle user interactions.
group { name: "e/conf/randr/main/frame";
   // Defines reusable text styles used by TEXTBLOCK parts within this group.
   styles {
      // Style for the monitor's name (e.g., "HDMI-1").
      style { name: "randr_name_style";
         base: "font="FNBD" font_size=10 text_class=randr_monitor align=center color=cc:/fg/normal/text wrap=word";
         tag: "br" "\n";
         tag: "hilight" "+ font="FNBD"";
      }
      // Style for the monitor's resolution (e.g., "1920x1080").
      style { name: "randr_resolution_style";
         base: "font="FN" font_size=10 text_class=randr_resolution align=center color=cc:/fg/normal/tex wrap=mixed align=center";
         tag: "br" "\n";
         tag: "hilight" "+ font="FNBD"";
      }
      // Style for the monitor's position (e.g., "@ 0,0").
      style { name: "randr_position_style";
         base: "font="FN" font_size=10 text_class=randr_position align=center color=cc:/fg/normal/tex wrap=mixed align=center";
         tag: "br" "\n";
         tag: "hilight" "+ font="FNBD"";
      }
   }
   // EDC scripts allow for simple state management within the theme.
   // This is more efficient than calling back to the C code for simple UI logic.
   script {
      // A public integer used as a flag to track whether the refresh rate
      // selection UI is currently open (1) or closed (0).
      public refresh_open;
   }
   parts {
      // A rectangle that acts as a border to indicate the primary display.
      // It's normally invisible and becomes visible when the monitor is set as primary.
      part { name: "primary"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/bg-alt/normal";
            rel1.offset: -4 -4;
            rel2.offset: 3 3;
            offscale;
            visible: 0;
         }
         description { state: "on" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // This is the main swallow part where the actual scaled-down preview of the
      // monitor's content will be displayed.
      part { name: "e.swallow.preview"; type: SWALLOW;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 5 5;
            rel2.offset: -6 -6;
            offscale;
         }
      }
      // A clipper for "e.swallow.preview". When the monitor is disabled ("off" state),
      // it overlays a semi-transparent white color (RGBA: 255, 255, 255, 16 or #FFFFFF10)
      // to give a dimmed visual effect.
      part { name: "clip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "e.swallow.preview";
         }
         description { state: "off" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 16; // no cc
         }
      }
      // A horizontal box used to display miniature previews of monitors
      // that are cloned from this one.
      part { name: "e.box.clone"; type: BOX;
         clip_to: "clone_clip";
         description { state: "default" 0.0;
            rel1.to: "e.swallow.preview";
            rel1.relative: 0.0 1.0;
            rel1.offset: 0 -27;
            rel2.relative: 1.0 0.0;
            rel2.to_x: "e.swallow.preview";
            rel2.to_y: "e.event.indicator";
            box {
               layout: "horizontal";
               padding: 2 0;
               align: 0.0 0.5;
               min: 1 1;
            }
         }
      }
      // Clips the content of "e.box.clone".
      part { name: "clone_clip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "e.box.clone";
         }
      }
      // An invisible rectangle that becomes visible during a drag-and-drop operation
      // to indicate that this monitor is a valid drop target (e.g., for cloning).
      // mouse_events: 0; ensures it doesn't interfere with other interactions.
      part { name: "drop_zone"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            rel.to: "e.swallow.preview";
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/selected";
            // Uses a semi-transparent white (RGBA: 255, 255, 255, 128 or #FFFFFF80) to highlight the drop zone.
            color: 255 255 255 128; // no cc
            visible: 1;
         }
      }
      // This part represents the physical hole for the power LED on a monitor.
      // It's placed at the bottom-left of the frame.
      part { name: "hole"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 4 -5;
            rel1.relative: 0.0 1.0;
            rel2.offset: 4 -5;
            rel2.relative: 0.0 1.0;
            align: 0.0 1.0;
            min: 12 12;
            max: 12 12;
            image.normal: "i-radio";
            color_class: "/bg-dark/normal";
            offscale;
            fixed: 1 1;
         }
      }
      // The LED part, placed inside the "hole". It's used to indicate the monitor's
      // power status. It can be "on" (default), "off", or "pulse".
      part { name: "led"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "hole";
            min: 10 10;
            max: 10 10;
            image.normal: "i-radio";
            color_class: "/fg/normal";
            fixed: 1 1;
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            // The pulsing state uses a semi-transparent white color (RGBA: 255, 255, 255, 128 or #FFFFFF80).
            color: 255 255 255 128; // no cc
         }
         description { state: "off" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Displays the monitor's name (e.g., "DP-1") centered in the preview area.
      // It's placed above the resolution text.
      part { name: "e.text.name"; type: TEXTBLOCK; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: 0.5 0.5;
            rel1.to: "e.swallow.preview";
            rel2.relative: 0.5 0.5;
            rel2.to: "e.swallow.preview";
            align: 0.5 1.0;
            text { style: "randr_name_style";
               min: 1 1;
               ellipsis: -1;
            }
         }
      }
      // Displays the monitor's resolution (e.g., "1920x1080"), centered in the preview.
      part { name: "e.text.resolution"; type: TEXTBLOCK; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: 0.5 0.5;
            rel1.to: "e.swallow.preview";
            rel2.relative: 0.5 0.5;
            rel2.to: "e.swallow.preview";
            align: 0.5 0.0;
            text { style: "randr_resolution_style";
               min: 1 1;
               ellipsis: -1;
            }
         }
         description { state: "off" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Displays the monitor's top-left corner position in the virtual screen space.
      part { name: "e.text.position"; type: TEXTBLOCK; mouse_events: 0;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: 0.5 1.0;
            rel1.to_x: "e.swallow.preview";
            rel1.to_y: "e.text.resolution";
            rel2.relative: 0.5 0.5;
            rel2.to: "e.swallow.preview";
            align: 0.5 0.0;
            text { style: "randr_position_style";
               min: 1 1;
               ellipsis: -1;
            }
         }
         description { state: "off" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // A small upward-pointing arrow to hint that the LED area is interactive (for power).
      part { name: "pwrhint"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "hole";
            rel1.relative: 0.0 1.0;
            rel1.offset: 0 3;
            rel2.offset: -1 3;
            align: 0.5 0.0;
            FIXED_SIZE(15, 15)
            image.normal: "i-arrow-u";
            fixed: 1 1;
            color_class: "/fg-alt/selected";
            offscale;
         }
      }
      // A power/shutdown icon next to the "pwrhint" arrow, further clarifying the action.
      part { name: "pwrhint2"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel1.to: "pwrhint";
            rel1.relative: 1.0 0.0;
            rel2.to: "pwrhint";
            align: 0.0 0.0;
            FIXED_SIZE(20, 20)
            image.normal: "i-system-shutdown";
            fixed: 1 1;
            color_class: "/fg-alt/selected";
         }
      }
      // Visual indicator (top-left arrow) for resizing, attached to the "e.event.resize" part.
      // These indicators ("rsz1", "rsz2", "rot1", "rot2") pulse to draw user attention.
      part { name: "rsz1"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            align: 0.0 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 0.0;
            rel.to: "e.event.resize";
            image.normal: "i-arrow-lu";
            FIXED_SIZE(5, 5)
            color_class: "/fg-alt/selected";
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            rel1.relative: -1.0 -1.0;
            rel2.relative: -1.0 -1.0;
            // The pulse animation moves the part and fades it out (Alpha=0, #FFFFFF00).
            color: 255 255 255 0; // no cc
         }
      }
      // Visual indicator (bottom-right arrow) for resizing.
      part { name: "rsz2"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            align: 1.0 1.0;
            rel1.relative: 1.0 1.0;
            rel2.relative: 1.0 1.0;
            rel.to: "e.event.resize";
            image.normal: "i-arrow-rd";
            FIXED_SIZE(5, 5)
            color_class: "/fg-alt/selected";
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 2.0 2.0;
            rel2.relative: 2.0 2.0;
            color: 255 255 255 0; // no cc
         }
      }
      // An invisible rectangle that serves as the rotation center for the rotation hint icons.
      // This is a common technique to define a pivot point for map animations.
      part { name: "rotc"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            rel1.offset: 16 16;
            rel2.offset: -17 -17;
            max: 1 1;
            align: 0.9 0.1;
            offscale;
         }
      }
      // Visual indicator (right-curved arrow) for rotation, attached to "e.event.rotate".
      // It uses mapping to apply rotation, pivoting around the "rotc" part.
      part { name: "rot1"; mouse_events: 0;
         description { state: "default" 0.0;
            align: 0.0 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 0.0;
            rel.to: "e.event.rotate";
            image.normal: "i-arrow-r";
            FIXED_SIZE(5, 5)
            map.on: 1;
            map.smooth: 1;
            map.rotation.center: "rotc";
            color_class: "/fg-alt/selected";
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            map.rotation.z: -60;
            // The pulse animation rotates the part and fades it out.
            color: 255 255 255 0; // no cc
         }
      }
      // Visual indicator (left-curved arrow) for rotation.
      part { name: "rot2"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            align: 1.0 1.0;
            rel1.relative: 1.0 1.0;
            rel2.relative: 1.0 1.0;
            rel.to: "e.event.rotate";
            image.normal: "i-arrow-l";
            FIXED_SIZE(5, 5)
            map.on: 1;
            map.smooth: 1;
            map.rotation.center: "rotc";
            color_class: "/fg-alt/selected";
         }
         description { state: "pulse" 0.0;
            inherit: "default" 0.0;
            map.rotation.z: 60;
            color: 255 255 255 0; // no cc
         }
      }
      // This swallow part is for holding the refresh rate selection UI.
      // It animates into view when the user clicks the arrow.
      part { name: "e.swallow.refresh"; type: SWALLOW;
         clip_to: "clip";
         description { state: "default" 0.0;
            rel1.to_y: "e.swallow.preview";
            rel1.to_x: "e.event.arrow.show";
            rel1.relative: 1.0 0.0;
            rel2.to: "e.swallow.preview";
            rel2.relative: 0.0 0.0;
            align: 0.0 1.0;
         }
         description { state: "expanded" 0.0;
            inherit: "default" 0.0;
            align: 0.0 0.0;
         }
      }
      // The following parts ("arrowclip", "arrow1clip", "arrow2clip") work together
      // to create a clipping effect that shows either a down arrow or an up arrow,
      // but not both at the same time. This is a common technique for state-based icon swapping.
      part { name: "arrowclip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "e.event.arrow.show";
            visible: 1;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Clips "arrow1" (down arrow), visible when the refresh list is collapsed.
      part { name: "arrow1clip"; type: RECT;
         clip_to: "arrowclip";
         description { state: "default" 0.0;
            rel.to: "e.event.arrow.show";
         }
         description { state: "expanded" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Clips "arrow2" (up arrow), visible when the refresh list is expanded.
      part { name: "arrow2clip"; type: RECT;
         clip_to: "arrowclip";
         description { state: "default" 0.0;
            rel.to: "e.event.arrow.show";
            visible: 0;
         }
         description { state: "expanded" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // The down arrow icon, indicating the refresh list can be expanded.
      part { name: "arrow1"; mouse_events: 0;
         clip_to: "arrow1clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "e.event.arrow.show";
            image.normal: "i-arrow-d";
            FIXED_SIZE(15, 15)
            color_class: "/fg/normal";
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed";
         }
      }
      // The up arrow icon, indicating the refresh list can be collapsed.
      part { name: "arrow2"; mouse_events: 0;
         clip_to: "arrow2clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "e.event.arrow.show";
            image.normal: "i-arrow-u";
            FIXED_SIZE(15, 15)
            color_class: "/fg/normal";
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed";
         }
      }
      // This is an invisible rectangle that captures mouse clicks to show/hide
      // the refresh rate list. Using an event rectangle separates the clickable
      // area from the visual elements.
      part { name: "e.event.arrow.show"; type: RECT;
         clip_to: "arrowclip";
         scale: 1;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            max: 21 21;
            align: 0.0 0.0;
         }
      }
      // Invisible event rectangle for rotation interaction. It's placed in the top-right corner.
      part { name: "e.event.rotate"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            max: 21 21;
            align: 1.0 0.0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // A spacer used for layout, to help position "e.event.indicator".
      part { name: "ind"; type: SPACER;
         scale: 1;
         description { state: "default" 0.0;
            max: 21 21;
            align: 0.0 1.0;
         }
      }
      // Invisible event rectangle for the power/indicator toggle.
      // It's positioned over the LED area.
      part { name: "e.event.indicator"; type: RECT;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            align: 0.0 1.0;
            rel2.to_y: "pwrhint2";
            rel2.to_x: "pwrhint2";
            rel1.relative: 0.0 0.0;
            rel1.to_y: "ind";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Invisible event rectangle for resize interaction. It's placed in the bottom-right corner.
      part { name: "e.event.resize"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            max: 21 21;
            align: 1.0 1.0;
         }
      }
   }
   programs {
      // When the show/hide arrow is pressed, set the arrow icons to a "clicked" state
      // for visual feedback.
      program { signal: "mouse,down,1"; source: "e.event.arrow.show";
         action: STATE_SET "clicked" 0.0;
         target: "arrow1";
         target: "arrow2";
      }
      // When the mouse button is released, revert the arrow icons to their default state.
      program { signal: "mouse,up,1"; source: "e.event.arrow.show";
         action: STATE_SET "default" 0.0;
         target: "arrow1";
         target: "arrow2";
      }
      // This program handles the main logic for toggling the refresh rate list.
      // It is triggered by a click on the arrow's event rectangle.
      program { signal: "mouse,clicked,1"; source: "e.event.arrow.show";
         // The script reads the 'refresh_open' variable, toggles its state,
         // and runs the appropriate show/hide program.
         script {
            new shown;

            shown = get_int(refresh_open);
            if (shown) {
               run_program(PROGRAM:"refresh_hide");
               set_state(PART:"arrow1clip", "default", 0.0);
               set_state(PART:"arrow2clip", "default", 0.0);
            } else {
               run_program(PROGRAM:"refresh_show");
               set_state(PART:"arrow1clip", "expanded", 0.0);
               set_state(PART:"arrow2clip", "expanded", 0.0);
            }
            set_int(refresh_open, 1 - shown);
         }
      }
      // Animates the "e.swallow.refresh" part to its "expanded" state, making it visible.
      program { name: "refresh_show";
         action: STATE_SET "expanded" 0.0;
         transition: DECELERATE 0.5;
         target: "e.swallow.refresh";
      }
      // Animates the "e.swallow.refresh" part to its "default" state, hiding it.
      program { name: "refresh_hide";
         action: STATE_SET "default" 0.0;
         transition: ACCELERATE 0.5;
         target: "e.swallow.refresh";
      }
      // The 'e' source refers to signals coming from the application's C code.
      // These programs enable or disable the refresh rate arrow based on application logic
      // (e.g., if there's only one refresh rate available).
      program { signal: "e,state,refresh,enabled"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "arrowclip";
      }
      program { signal: "e,state,refresh,disabled"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "arrowclip";
      }
      // This program and "rrpulse2" create a looping animation for the resize and rotate
      // hint icons. "rrpulse1" starts the "pulse" state.
      program { name: "rrpulse1";
         signal: "show"; source: "";
         action: STATE_SET "pulse" 0.0;
         transition: DECELERATE 1.0;
         target: "rsz1";
         target: "rsz2";
         target: "rot1";
         target: "rot2";
         after: "rrpulse2";
      }
      // After "rrpulse1" completes, this program reverts the icons to their default state
      // and then chains back to "rrpulse1", creating a continuous pulse effect.
      program { name: "rrpulse2";
         action: STATE_SET "default" 0.0;
         target: "rsz1";
         target: "rsz2";
         target: "rot1";
         target: "rot2";
         after: "rrpulse1";
      }
      // Similar to the resize/rotate pulse, this creates a pulsing effect for the power LED.
      program { name: "pulse1";
         signal: "show"; source: "";
         action: STATE_SET "pulse" 0.0;
         transition: SINUSOIDAL 0.3;
         target: "led";
         after: "pulse2";
      }
      // The second half of the LED pulse animation.
      program { name: "pulse2";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 0.3;
         target: "led";
         after: "pulse1";
      }
      // When the monitor is enabled (signal from C code), this program sets various
      // parts to their default/visible state and starts the LED pulse animation.
      program { signal: "e,state,enabled"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "clip";
         target: "e.text.resolution";
         target: "e.text.position";
         target: "led";
         after: "pulse1";
      }
      // When the monitor is disabled, this stops the LED pulse animation and then
      // runs the "off" program to set parts to their "off" state.
      program { signal: "e,state,disabled"; source: "e";
         action: ACTION_STOP;
         target: "pulse1";
         target: "pulse2";
         after: "off";
      }
      // Sets parts to the "off" state, which typically makes them invisible or dimmed.
      program { name: "off";
         signal: "e,state,disabled"; source: "e";
         action: STATE_SET "off" 0.0;
         target: "led";
         target: "clip";
         target: "e.text.resolution";
         target: "e.text.position";
      }
      // When a drag operation enters the monitor area, show the drop zone highlight.
      program { signal: "e,state,drop,on"; source: "e";
         action: STATE_SET "active" 0.0;
         target: "drop_zone";
      }
      // When the drag operation leaves, hide the drop zone highlight.
      program { signal: "e,state,drop,off"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "drop_zone";
      }
      // These programs react to state signals from the C code to enable or disable
      // various interactive elements like rotation, the power indicator, and the primary marker.
      program { signal: "e,state,rotate_disabled"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "e.event.rotate";
      }
      program { signal: "e,state,indicator,enabled"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "e.event.indicator";
      }
      program { signal: "e,state,indicator,disabled"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "e.event.indicator";
      }
      program { signal: "e,state,primary,off"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "primary";
      }
      program { signal: "e,state,primary,on"; source: "e";
         action: STATE_SET "on" 0.0;
         target: "primary";
      }
      // The following programs capture mouse events on the invisible event rectangles
      // and emit them as new signals with a source of "e". This is a delegation pattern
      // that allows the C code to listen for high-level actions (e.g., "e,action,resize,start")
      // without needing to know about the specific EDC part that triggered it.
      program { signal: "mouse,in"; source: "e.event.resize";
         action: SIGNAL_EMIT "e,action,resize,in" "e";
      }
      program { signal: "mouse,out"; source: "e.event.resize";
         action: SIGNAL_EMIT "e,action,resize,out" "e";
      }
      program { signal: "mouse,down,1"; source: "e.event.resize";
         action: SIGNAL_EMIT "e,action,resize,start" "e";
      }
      program { signal: "mouse,up,1"; source: "e.event.resize";
         action: SIGNAL_EMIT "e,action,resize,stop" "e";
      }
      program { signal: "mouse,in"; source: "e.event.rotate";
         action: SIGNAL_EMIT "e,action,rotate,in" "e";
      }
      program { signal: "mouse,out"; source: "e.event.rotate";
         action: SIGNAL_EMIT "e,action,rotate,out" "e";
      }
      program { signal: "mouse,down,1"; source: "e.event.rotate";
         action: SIGNAL_EMIT "e,action,rotate,start" "e";
      }
      program { signal: "mouse,up,1"; source: "e.event.rotate";
         action: SIGNAL_EMIT "e,action,rotate,stop" "e";
      }
      program { signal: "mouse,in"; source: "e.event.indicator";
         action: SIGNAL_EMIT "e,action,indicator,in" "e";
      }
      program { signal: "mouse,out"; source: "e.event.indicator";
         action: SIGNAL_EMIT "e,action,indicator,out" "e";
      }
      program { signal: "mouse,clicked,1"; source: "e.event.indicator";
         action: SIGNAL_EMIT "e,action,indicator,toggle" "e";
      }
   }
}

// This group defines a stand for the monitor. It is currently empty but can be
// themed to provide different stand styles.
group { name: "e/conf/randr/main/stand";
   parts {
   }
}

// Defines a miniature version of the monitor preview, likely used to represent
// cloned displays in the "e.box.clone" part of the main frame.
group { name: "e/conf/randr/main/mini";
   parts {
      // The background of the mini preview.
      part { name: "base"; type: RECT;
         description { state: "default" 0.0;
            color_class: "/bg-dark/normal";
         }
      }
      // The swallow part for the actual mini preview content.
      part { name: "e.swallow.preview"; type: SWALLOW;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 5 5;
            rel2.offset: -6 -6;
            offscale;
         }
      }
      // A clipper for the mini preview.
      part { name: "clip"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "e.swallow.preview";
         }
      }
   }
}
