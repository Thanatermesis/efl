/**
Group: efl/radio (@since 1.23)
	 Part Text: efl.text (required)
	 Part Swallow: efl.content (required)
	 Signal: efl,content,set
	 Signal: efl,content,unset
	 Signal: efl,state,disabled
	 Signal: efl,state,enabled
	 Signal: efl,state,selected
	 Signal: efl,state,unselected
	 Signal: efl,text,set
	 Signal: efl,text,unset
*/
// The "efl/radio" group defines the appearance and behavior of a radio button widget.
// It consists of a clickable area, an icon, and a label, which can be in various states
// like default, pressed, disabled, and selected. The script section handles the logic
// for state transitions, ensuring that visual changes reflect the widget's current state.
group { name: "efl/radio";
   data.item: "version" "123";
// These defines are used as bitmasks to track the state of the radio button's components.
// For example, they determine whether an icon or label is present, or if the widget is
// disabled or selected. This allows for efficient state management within the script.
#define ICON     1
#define LABEL    2
#define MASK     3
#define DISABLE  4
#define SELECTED 8
   script {
      // This macro provides common button behavior logic, which is included here to handle
      // standard interactions without duplicating code.
      BUTTONMODE_SCRIPT2
      // 'sel' is a public integer used to store the combined state of the radio button using the bitmasks defined above.
      public sel;
      // 'eval_sel' is a function that visually updates the checkmark of the radio button.
      // It sets the state of the 'ck_check' part to "selected" if the 'm' parameter
      // (representing the button's state) has the SELECTED bit set, and "default" otherwise.
      public eval_sel(m) {
         if (m) {
            set_state(PART:"ck_check", "selected", 0.0);
         } else {
            set_state(PART:"ck_check", "default", 0.0);
         }
      }
   }
   parts {
      // The "shadow" part is a SPACER, which is often used for layout purposes or to create visual effects like shadows.
      // In this case, it doesn't have any visible properties but participates in state changes ("pressed", "disabled"),
      // which could be a hook for custom styles or future extensions.
      part { name: "shadow"; type: SPACER;
         description { state: "default";
         }
         desc { "pressed"; inherit;
         }
         desc { "disabled"; inherit;
         }
      }
      // "efl.background" is a swallow part that allows external content to be used as a background for the widget.
      // It is initially hidden and becomes visible when the "visible" state is applied.
      // 'nomouse' ensures it doesn't interact with mouse events, letting them pass through to parts below.
      swallow { "efl.background"; nomouse;
         desc { "default";
            visible: 0;
         }
         desc { "visible"; inherit;
            visible: 1;
         }
      }
      // "icon_clip" is a RECT part that acts as a clipping mask for the icon in "efl.content".
      // This ensures that the icon does not draw outside its designated area.
      // Its color is opaque white (255 255 255 255, #FFFFFFFF) in the default and pressed states,
      // becoming semi-transparent (255 255 255 64, #FFFFFF40) when disabled, which affects the clipped content.
      rect { "icon_clip";
         desc { "default";
            color: 255 255 255 255; // no cc
         }
         desc { "pressed"; inherit;
            color: 255 255 255 255; // no cc
         }
         desc { "disabled"; inherit;
            color: 255 255 255 64; // no cc
         }
      }
      // "efl.content" is a required swallow part for the radio button's icon.
      // 'required' means that the host application must provide content for this part.
      // It is clipped by "icon_clip" to maintain the boundaries of the icon area.
      // Its position is relative to the "base" part, and it's initially invisible and scaled off-screen ('offscale').
      // Different states ("visible", "icononly") control its visibility and alignment,
      // accommodating layouts with or without a text label.
      swallow { "efl.content"; nomouse;
         required;
         clip_to: "icon_clip";
         scale: 1;
         desc { "default";
            fixed: 1 0;
            align: 0.0 0.5;
            rel1.to_x: "base";
            rel2.to_x: "base";
            rel1.offset: 4 4;
            rel1.relative: 1.0 0.0;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
            visible: 0;
            offscale;
         }
         desc { "visible"; inherit;
            fixed: 1 0;
            aspect: 1.0 1.0;
            visible: 1;
            min: ICMIN ICMIN;
         }
         desc { "icononly"; inherit;
            fixed: 0 0;
            align: 0.5 0.5;
            rel2.relative: 1.0 1.0;
            rel2.offset: -5 -5;
            rel2.to_x: "";
            visible: 1;
            min: ICMIN ICMIN;
         }
      }
      // The "base" part is a RECT that serves as an anchor for positioning the radio button's visual elements,
      // such as the checkmark background and the check itself.
      // It has a fixed size (13x13) and is invisible ('visible: 0', 'offscale'),
      // purely for layout control. Its aspect ratio is maintained vertically.
      part { name: "base"; type: RECT;
         scale: 1;
         description { state: "default";
            align: 0.0 0.5;
            min: 13 13;
            max: 13 13;
            rel1.offset: 4 4;
            rel2.relative: 0.0 1.0;
            rel2.offset: 4 -5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            offscale;
            visible: 0;
            offscale;
         }
         desc { "pressed"; inherit;
         }
         desc { "disabled"; inherit;
         }
      }
      // "ck_bg" is the visual background of the radio button circle.
      // It's positioned relative to the "base" anchor and uses the "i-radio" image.
      // The 'color_class' allows theming, changing color in the "disabled" state.
      part { name: "ck_bg";
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            rel.to: "base";
            image.normal: "i-radio";
            min: 15 15;
            max: 15 15;
            color_class: "/bg/normal/radio/base";
         }
         desc { "disabled"; inherit;
            color_class: "/bg/disabled/radio/base";
         }
      }
      // "ck_check" represents the checkmark (or dot) that appears inside the radio button when selected.
      // It's also positioned relative to the "base" part and uses the same "i-radio" image as the background,
      // likely a different part of the image or layered on top.
      // It is invisible by default and becomes visible when its state is set to "selected".
      part { name: "ck_check";
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/fg/selected/radio/radio";
            fixed: 1 1;
            rel.to: "base";
            image.normal: "i-radio";
            min: 15 15;
            max: 15 15;
            visible: 0;
         }
         description { state: "selected" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
         desc { "disabled"; inherit;
            visible: 0;
         }
      }
      // "ck_press" provides visual feedback when the radio button is being pressed.
      // It's an overlay that is normally invisible and becomes visible only during a "mouse,down,1" event,
      // as defined in the 'programs' section. It uses a "pressed" color_class for theming.
      part { name: "ck_press";
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/fg/pressed/radio/radio";
            fixed: 1 1;
            rel.to: "base";
            image.normal: "i-radio";
            min: 15 15;
            max: 15 15;
            visible: 0;
         }
         description { state: "pressed" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // "efl.text" is a required text part for the radio button's label. It is placed to the right
      // of the icon ("efl.content").
      // 'nomouse' prevents it from capturing mouse events. It has various states to handle
      // different combinations of visibility, pressed, and disabled states, each with its own
      // text color and layout adjustments. For example, "pressed_visible" applies a pressed
      // text color, while "disabled_visible" applies a disabled color.
      text { "efl.text"; nomouse;
         required;
         scale: 1;
         desc { "default";
            fixed: 0 1;
            color_class: "/fg/normal/radio/text";
            rel1.offset: 0 4;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "efl.content";
            rel2.offset: -5 -5;
            text { font: FN; size: 10;
               align: 0.0 0.5;
               min: 0 0;
            }
            visible: 0;
            offscale;
            min: 0 ICMIN;
         }
         desc { "visible"; inherit;
            fixed: 0 0;
            rel1.offset: 4 4;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "pressed_visible"; inherit;
            fixed: 0 0;
            color_class: "/fg/pressed/radio/text";
            rel1.offset: 4 4;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "textonly"; inherit;
            fixed: 0 0;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "pressed_textonly"; inherit;
            fixed: 0 0;
            color_class: "/fg/pressed/radio/text";
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "disabled_visible"; inherit;
            fixed: 0 0;
            color_class: "/fg/disabled/radio/text";
            rel1.offset: 4 4;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
         desc { "disabled_textonly"; inherit;
            fixed: 0 0;
            color_class: "/fg/disabled/radio/text";
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
         }
      }
      // The "event" part is a transparent rectangle covering the entire widget area.
      // Its purpose is to capture all mouse input events for the radio button.
      // 'ignore_flags: ON_HOLD' prevents it from generating "hold" signals, which are not needed for a radio button.
      // It is hidden in the "disabled" state, effectively preventing any user interaction.
      rect { "event";
         ignore_flags: ON_HOLD;
         desc { "default";
            color: 0 0 0 0; // no cc
         }
         desc { "disabled"; inherit;
            visible: 0;
         }
      }
   }
   programs {
      // Binds standard clickable behavior (like emitting "clicked" signals) to the "event" part.
      // This is a common macro for widgets that need click handling.
      EFL_UI_CLICKABLE_PART_BIND(event)
      // When the "efl,state,selected" signal is received, this program updates the 'sel' variable
      // by setting the SELECTED bit. It then calls 'eval_sel' to update the visual state of the checkmark.
      program { signal: "efl,state,selected"; source: "efl";
         script {
            new m = get_int(sel) | SELECTED;
            set_int(sel, m);
            eval_sel(m);
         }
      }
      // When the "efl,state,unselected" signal is received, it clears the SELECTED bit from 'sel'
      // and calls 'eval_sel' to hide the checkmark.
      program { signal: "efl,state,unselected"; source: "efl";
         script {
            new m = get_int(sel) & ~SELECTED;
            set_int(sel, m);
            eval_sel(m);
         }
      }
      // These programs react to signals indicating changes in content (text and icon) and state (disabled/enabled).
      // They use the 'flag_set' and 'flag_unset' macros (from BUTTONMODE_SCRIPT2) to update the state
      // bits (LABEL, ICON, DISABLE) in a shared state variable. This mechanism allows the widget
      // to correctly adjust its layout and appearance based on whether it has a label, an icon, or is disabled.
      program { signal: "efl,text,set"; source: "efl";
         script { flag_set(LABEL); }
      }
      program { signal: "efl,text,unset"; source: "efl";
         script { flag_unset(LABEL); }
      }
      program { signal: "efl,content,set"; source: "efl";
         script { flag_set(ICON); }
      }
      program { signal: "efl,content,unset"; source: "efl";
         script { flag_unset(ICON); }
      }
      program { signal: "efl,state,disabled"; source: "efl";
         script { flag_set(DISABLE); }
      }
      program { signal: "efl,state,enabled"; source: "efl";
         script { flag_unset(DISABLE); }
      }
      // In addition to setting the script flag, the "efl,state,disabled" signal also directly
      // sets the state of the "ck_check" and "ck_bg" parts to "disabled",
      // which triggers their corresponding visual changes (e.g., color changes via color_class).
      program { signal: "efl,state,disabled"; source: "efl";
         action:  STATE_SET "disabled" 0.0;
         target: "ck_check";
         target: "ck_bg";
      }
      // Similarly, the "efl,state,enabled" signal reverts "ck_check" and "ck_bg" to their "default" state.
      program { signal: "efl,state,enabled"; source: "efl";
         action:  STATE_SET "default" 0.0;
         target: "ck_check";
         target: "ck_bg";
      }
      // These programs handle the visual feedback for mouse clicks on the "event" part.
      // On "mouse,down,1", the "ck_press" part is set to the "pressed" state, making the press effect visible.
      // On "mouse,up,1", it returns to the "default" state, hiding the effect.
      program { signal: "mouse,down,1"; source: "event";
         action: STATE_SET "pressed" 0.0;
         target: "ck_press";
      }
      program { signal: "mouse,up,1"; source: "event";
         action: STATE_SET "default" 0.0;
         target: "ck_press";
      }
   }
}
