/* Window client-side decorations and extra slots
 * Includes swallows for:
 *  - app content
 *  - main menu
 *  - indicator
 *  - soft key
 *  - virtual keyboard
 */

// This group defines the standard appearance and behavior of a window border.
// It includes elements like the title bar, buttons for minimize, maximize, and close,
// resize handles, and shadows. It's the base for other window types like dialogs.
group { "efl/border"; data.item: "version" "123";
   // Pre-loads the shadow image, with compression for efficiency.
   images.image: "win_shad_flat.png" COMP;
   // Custom data item, indicating that this theme part provides a shadow.
   data.item: "shadow" "1";

// Defines bitmask flags for different window states.
// This allows combining states (e.g., a window can be maximized AND borderless).
#define BORDERLESS  1
#define MAXIMIZED   2
#define UNRESIZABLE 4

// Macros to manipulate the 'border_mode' integer variable in the script.
// They use bitwise operations to set or unset flags, then call 'eval_mode'
// to apply the visual changes.
#define SET_MODE(a) script { new m = get_int(border_mode); m |= (a); set_int(border_mode, m); eval_mode(m); }
#define UNSET_MODE(a) script { new m = get_int(border_mode); m &= ~(a); set_int(border_mode, m); eval_mode(m); }

// Defines constants for the indicator's background style.
#define INDICATOR_TYPE_UNKNOWN 0
#define INDICATOR_TYPE_BG_OPAQUE 1
#define INDICATOR_TYPE_BG_TRANSPARENT 2
#define INDICATOR_TYPE_HIDDEN 3
   // Embryo script for handling complex logic that cannot be expressed
   // easily with standard state transitions. This script manages visibility
   // of shadows and menus, and evaluates different border modes.
   script {
      // Public variables accessible from programs.
      public hide_shadow;
      public show_menu;
      // This function evaluates the state of the shadow and menu.
      public eval_shadow_menu() {
         new m_show = get_int(show_menu);
         new s_hide = get_int(hide_shadow);

         // Hides or shows the shadow based on the 'hide_shadow' variable.
         if (s_hide) {
            set_state(PART:"shadow_clip", "hidden", 0.0);
            set_state(PART:"shadow_base", "hidden", 0.0);
         } else {
            set_state(PART:"shadow_clip", "default", 0.0);
            set_state(PART:"shadow_base", "default", 0.0);
         }
         // Shows or hides the main menu based on the 'show_menu' variable.
         if ((m_show)/* && (s_hide)*/) {
            set_state(PART:"efl.menu", "visible", 0.0);
         } else {
            set_state(PART:"efl.menu", "default", 0.0);
         }
      }

      // 'border_mode' holds the bitmask of window states.
      public border_mode;
      // Variables to control the indicator's state.
      public indicator_type = 0;
      public indicator_enabled = 0;
      // Evaluates the current border mode and applies necessary state changes.
      public eval_mode(m) {
         // If the window is borderless, maximized, or not resizable,
         // the bottom border and top resize handles are hidden.
         if (m & (BORDERLESS | MAXIMIZED | UNRESIZABLE)) {
            set_state(PART:"bottom_clip", "hidden", 0.0);
            set_state(PART:"top_resize_clip", "hidden", 0.0);
         } else {
            set_state(PART:"bottom_clip", "default", 0.0);
            set_state(PART:"top_resize_clip", "default", 0.0);
         }
      }
   }
   parts {
      // This SPACER part defines the opaque region of the window.
      // Compositors can use this information for optimization, avoiding rendering
      // what's behind this area. It spans from the top bar to the bottom bar.
      spacer { "efl.spacer.opaque";
         desc {
            rel1.to: "top_clip";
            rel2.to: "bottom_clip";
         }
         desc { "max"; inherit: "default"; }
      }
      // This SPACER defines the main content area for the application,
      // positioned between the main menu (if visible) and the keyboard.
      spacer { "efl.spacer.content";
         required; // since 1.19
         desc {
            rel1.to: "efl.menu";
            rel1.relative: 0.0 1.0;
            rel2.to: "efl.keyboard";
            rel2.relative: 1.0 0.0;
         }
      }
      // A clipping rectangle for the shadow. Its color class can change
      // on focus. It is toggled visible/hidden by the script.
      part { name: "shadow_clip"; type: RECT; mouse_events: 0;
         description { state: "default";
            rel.to: "_sh1";
            color_class: "/shadow/normal/border";
         }
         description { state: "hidden";
            visible: 0;
         }
         description { state: "focused";
            inherit: "default";
            color_class: "/shadow/selected/border";
         }
      }
      // A spacer that defines the base geometry for the shadow.
      // The WIN_SHAD macro will use this to correctly place shadow images.
      part { name: "shadow_base"; type: SPACER;
         scale: 1;
         description { state: "default" 0.0;
            WIN_SHADOW_SPACER;
         }
         desc { "hidden";
            rel1.offset: 0 0;
            rel2.offset: -1 -1;
         }
      }
      // This macro generates the actual image parts for the window shadow.
      WIN_SHAD("shadow_base", "shadow_clip", "win_shad_flat.png", 21, 21, 14, 28, 0.5)
      // A clipper for the background, ensuring it doesn't draw over the border.
      rect { "bg_clip"; nomouse;
         desc { "default";
            rel1.to: "top_clip";
            rel1.relative: 0.0 1.0;
            rel2.to: "bottom_clip";
         }
      }
      // A solid color background for the window. This is optional and can be
      // toggled on/off. It is clipped by "bg_clip".
      rect { "efl.rect.background";
         required; // @since 1.19
         clip: "bg_clip";
         desc { "default";
            color_class: "/bg/normal/background";
            rel.to: "efl.spacer.content";
            visible: 0;
         }
         desc { "visible";
            inherit: "default";
            visible: 1;
         }
      }
      // A swallow part for an image-based background. An application can
      // provide its own Evas_Object here for custom backgrounds (e.g., gradients, images).
      swallow { "efl.background";
         required; // @since 1.19
         clip: "client_clip";
         desc { "default";
            rel.to: "efl.spacer.content";
         }
      }
      // A spacer that controls the vertical position of the indicator area.
      // When the indicator is hidden, this spacer collapses, allowing content
      // below it to move up.
      spacer { "indicator_spacer";
         desc { "default";
            rel.to: "efl.indicator";
         }
         desc { "hidden";
            rel.to: "top_clip";
            rel1.relative: 0.0 1.0;
            align: 0.5 0.0;
            fixed: 1 1;
         }
      }

      // The main menu area, composed of a background rectangle and a swallow part.
      // The background for the menu bar. It is normally not visible.
      rect { "menu_bg";
         desc { "default";
            color_class: "/bg/normal/menu/bar";
            align: 0.5 0.0;
            rel.to: "efl.menu";
            fixed: 1 1;
            visible: 0;
         }
      }
      // A swallow part for the application's main menu content.
      swallow { "efl.menu";
         required: 1; // since 1.19
         desc { "default";
            rel.to: "top_clip";
            visible: 0;
            align: 0.5 1.0;
            fixed: 1 1;
            rel2.relative: 1.0 1.0;
            rel1.offset: 0 -1;
// debug...
//min:  0 40;
         }
         desc { "visible"; inherit: "default";
            // GGGG
            rel1.offset: 0 0;
            align: 0.5 0.0;
            visible: 1;
            fixed: 0 1;
         }
      }

      // Defines the main content area for the application.
      // This spacer defines the geometry of the client area, located between
      // the menu and the virtual keyboard.
      spacer { "client_spacer";
         desc { "default";
            rel1.to: "efl.menu";
            rel1.relative: 0.0 1.0;
            rel2.to: "efl.keyboard";
            rel2.relative: 1.0 0.0;
         }
      }
      // Clipping rectangle for the client area to prevent content from overflowing.
      rect { "client_clip";
         nomouse;
         desc { "default";
            rel.to: "client_spacer";
         }
      }

      // The primary swallow part where the application's main UI is placed.
      swallow { "efl.client"; required;
         clip: "client_clip";
         desc { "default";
            rel.to: "client_spacer";
            visible: 1;
         }
      }

      // A semi-transparent rectangle used to block interaction with the main
      // window when a modal dialog is active.
      rect { "rect.blocker";
         required;
         desc { "default";
            rel1.to: "top_clip";
            rel1.relative: 0.0 1.0;
            rel2.to: "bottom_clip";
            rel2.relative: 1.0 0.0;
            color_class: "/dim/normal/win/modal";
            // Starts fully transparent (alpha=0, #FFFFFF00).
            color: 255 255 255 0; // no cc
            hid;
         }
         desc { "visible";
            inherit: "default";
            // Becomes opaque when visible, using the color from the color class.
            // The explicit color here is a fallback if no color class is found. (#FFFFFFFF)
            color: 255 255 255 255; // no cc
            vis;
         }
      }

      // The top part of the window, containing the title bar and window controls.
      // This RECT acts as a clipper for all title bar elements.
      rect { "top_clip"; //nomouse;
         scale: 1;
         desc { "default";
            rel1.to: "shadow_base";
            rel2.to_x: "shadow_base";
            rel2.to_y: "efl.text.title";
            rel2.offset: -1 2;
            vis;
            offscale;
         }
         desc { "hidden";
            inherit: "default";
            rel.to: "";
            rel1.relative: 0.0 0.0;
            rel1.offset: 0 -1;
            rel2.to: "shadow_base";
            rel2.relative: 1.0 0.0;
            rel2.offset: -1 -1;
            max: -1 0;
            min: 0 0;
            fixed: 0 1;
            hid;
         }
      }
      // The background of the title bar. It changes color on focus.
      part { name: "top"; type: RECT;
         clip: "top_clip";
         description { state: "default" 0.0;
            rel.to: "top_clip";
            color_class: "/bg/normal/titlebar";
         }
         description { state: "focused" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/selected/titlebar";
         }
      }
      // The TEXT part for the window title. It is positioned between the
      // icon and the minimize button.
      part { name: "efl.text.title"; type: TEXT; mouse_events: 0;
         scale: 1;
         clip: "top_clip";
         description { state: "default" 0.0;
            rel1.relative: 1.0 0.0;
            rel1.offset: 1 4;
            rel1.to_x: "icon";
            rel1.to_y: "shadow_base";
            rel2.relative: 0.0 0.0;
            rel2.offset: -2 4;
            rel2.to_x: "event.minimize";
            rel2.to_y: "shadow_base";
            align: 0.5 0.0;
            color_class: "/fg/normal/titlebar";
            min: 0 16;
            text { font: FNBD; size: 10;
               text_class: "title_bar";
               align: 0.5 0.0;
               min: 0 1;
            }
            fixed: 0 1;
            offscale;
         }
         description { state: "focused" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/selected/titlebar";
         }
      }
      // This spacer is used to animate the window icon. The "bounce" states
      // create a pulsating effect when the window is in an "urgent" state.
      spacer {  "icon";
         desc { "default";
            rel.to: "event.icon";
         }
         desc { "bounce1";
            inherit: "default";
            rel1.relative: 0.5 0.5;
            rel2.relative: 0.5 0.5;
         }
         desc { "bounce2";
            inherit: "default";
            rel1.relative: -0.5 -0.5;
            rel2.relative: 1.2 1.2;
         }
      }
      // The swallow part for the window icon itself. It's positioned relative
      // to the "icon" spacer to allow for the bounce animation.
      swallow {  "efl.icon"; nomouse;
         clip_to: "top_clip";
         desc { "default";
            rel1.to: "icon";
            rel1.relative: 0.15 0.15;
            rel2.to: "icon";
            rel2.relative: 0.85 0.85;
            rel2.offset: 0 0;
         }
      }
      // These two RECTs are used as clippers to switch between two sets of
      // window control buttons: one for the normal state and one for the
      // focused state. This is a common technique to handle different
      // visual styles for focused windows without duplicating all button logic.
      // 'clip1' is visible by default, 'clip2' is visible when focused.
      rect {  "clip1"; nomouse;
         desc { "default";
            rel.to: "top_clip";
         }
         desc { "focused";
            inherit: "default";
            visible: 0;
         }
      }
      rect {  "clip2"; nomouse;
         desc { "default";
            rel.to: "top_clip";
            visible: 0;
         }
         desc { "focused";
            inherit: "default";
            visible: 1;
         }
      }
      // Window control buttons (Close, Maximize, Minimize).
      // There are two sets of images, one for unfocused state (clipped by "clip1")
      // and one for focused state (clipped by "clip2").
      image { "close1";  nomouse;
         clip: "clip1";
         scale: 1;
         desc { "default";
            image.normal: "i-close";
            rel.to: "event.close";
            min: 15 15; max: 15 15;
            fixed: 1 1;
            color_class: "/fg/normal/titlebar/close";
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/pressed/titlebar/close";
         }
      }
      image { "max1"; nomouse;
         clip: "clip1";
         scale: 1;
         desc { "default";
            image.normal: "i-arrow-u";
            rel.to: "event.maximize";
            min: 15 15; max: 15 15;
            fixed: 1 1;
            color_class: "/fg/normal/titlebar/maximize";
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/pressed/titlebar/maximize";
         }
      }
      image { "min1"; nomouse;
         clip: "clip1";
         scale: 1;
         desc { "default";
            image.normal: "i-arrow-d";
            rel.to: "event.minimize";
            min: 15 15; max: 15 15;
            fixed: 1 1;
            color_class: "/fg/normal/titlebar/minimize";
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/pressed/titlebar/minimize";
         }
      }
      image { "close2";  nomouse;
         clip: "clip2";
         scale: 1;
         desc { "default";
            image.normal: "i-close";
            rel.to: "event.close";
            min: 15 15; max: 15 15;
            fixed: 1 1;
            color_class: "/fg/selected/titlebar/close";
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/selected-pressed/titlebar/close";
         }
      }
      image { "max2"; nomouse;
         clip: "clip2";
         scale: 1;
         desc { "default";
            image.normal: "i-arrow-u";
            rel.to: "event.maximize";
            min: 15 15; max: 15 15;
            fixed: 1 1;
            color_class: "/fg/selected/titlebar/maximize";
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/selected-pressed/titlebar/maximize";
         }
      }
      image { "min2"; nomouse;
         clip: "clip2";
         scale: 1;
         desc { "default";
            image.normal: "i-arrow-d";
            rel.to: "event.minimize";
            min: 15 15; max: 15 15;
            fixed: 1 1;
            color_class: "/fg/selected/titlebar/minimize";
         }
         desc { "selected";
            inherit: "default";
            color_class: "/fg/selected-pressed/titlebar/minimize";
         }
      }
      // These are invisible rectangles used solely to capture mouse events for
      // different parts of the title bar. This separates the clickable area
      // from the visual representation, which simplifies layout and theming.
      // They are colored here for debugging purposes but are transparent (alpha=0).
      // Click area for the window icon.
      rect {  "event.icon";
         desc { "default";
            rel1.relative: 0.0 0.0;
            rel1.to: "top_clip";
            rel2.relative: 0.0 1.0;
            rel2.to: "top_clip";
            align: 0.0 0.5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            color: 0 0 0 0; // no cc
         }
      }
      // Click area for the title bar, used for dragging the window.
      rect {  "event.titlebar";
         desc { "default";
            rel1.relative: 1.0 0.0;
            rel1.to_x: "event.icon";
            rel1.to_y: "top_clip";
            rel2.relative: 0.0 1.0;
            rel2.offset: 0 -1;
            rel2.to_x: "event.minimize";
            rel2.to_y: "top_clip";
            color: 0 0 0 0; // no cc
         }
      }
      // Click area for the close button.
      rect {  "event.close";
         desc { "default";
            rel.to: "top_clip";
            rel1.relative: 1.0 0.0;
            rel2.relative: 1.0 1.0;
            align: 1.0 0.5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            color: 0 0 0 0; // no cc
         }
      }
      // Click area for the maximize button.
      rect {  "event.maximize";
         desc { "default";
            rel1.relative: -0.25 0.0;
            rel1.offset: -1 0;
            rel1.to_x: "event.close";
            rel1.to_y: "top_clip";
            rel2.relative: -0.25 1.0;
            rel2.to_x: "event.close";
            rel2.to_y: "top_clip";
            align: 1.0 0.5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            color: 0 0 0 0; // no cc
         }
      }
      // Click area for the minimize button.
      rect {  "event.minimize";
         desc { "default";
            rel1.relative: 0.0 0.0;
            rel1.offset: -1 0;
            rel1.to_x: "event.maximize";
            rel1.to_y: "top_clip";
            rel2.relative: 0.0 1.0;
            rel2.to_y: "top_clip";
            rel2.to_x: "event.maximize";
            align: 1.0 0.5;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            color: 0 0 0 0; // no cc
         }
      }
      // A clipper for the top resize handles. It's hidden when the window
      // is not resizable.
      rect { "top_resize_clip";
         clip: "top_clip";
         desc { "default";
            rel.to: "top_clip";
         }
         desc { "hidden";
            inherit: "default";
            hid;
         }
      }
      // Invisible rectangles for window resizing handles. These capture mouse
      // events and are typically placed at the edges and corners of the window.
      // RSZCOL and RSZCOL2 are likely macros for defining resize handle colors
      // for debugging, usually transparent.
      // Top-left resize handle.
      rect {  "efl.event.resize.tl";
         clip: "top_resize_clip";
         scale: 1;
         desc { "default";
            rel.to: "top_clip";
            rel2.relative: 0.0 0.0;
            rel2.offset: 31 3;
            min: RSZMINW RSZMINH;
            align: 1.0 1.0;
            color: RSZCOL; // no cc
            fixed: 1 1;
         }
         desc { "hidden"; inherit: "default"; hid; }
      }
      // Top resize handle.
      rect {  "efl.event.resize.t";
         clip: "top_resize_clip";
         scale: 1;
         desc { "default";
            rel1.to: "efl.event.resize.tl";
            rel1.relative: 1.0 0.0;
            rel2.to: "efl.event.resize.tr";
            rel2.relative: 0.0 1.0;
            min: 0 RSZMINH;
            align: 1.0 1.0;
            color: RSZCOL2; // no cc
            fixed: 1 1;
         }
         desc { "hidden"; inherit: "default"; hid; }
      }
      // Top-right resize handle.
      rect {  "efl.event.resize.tr";
         clip: "top_resize_clip";
         scale: 1;
         desc { "default";
            rel.to: "top_clip";
            rel1.relative: 1.0 0.0;
            rel1.offset: -32 0;
            rel2.relative: 1.0 0.0;
            rel2.offset: -1 3;
            min: RSZMINW RSZMINH;
            align: 0.0 1.0;
            color: RSZCOL; // no cc
            fixed: 1 1;
         }
         desc { "hidden"; inherit: "default"; hid; }
      }
      // The bottom part of the window, including resize handles and a potential
      // area for a virtual keyboard.
      // Swallow part for a virtual keyboard. It docks to the bottom of the window.
      swallow { "efl.keyboard";
         desc { "default";
           rel.to: "bottom_clip";
           rel2.relative: 1.0 0.0;
           align: 0.0 1.0;
           fixed: 0 1;
         }
      }
      // Clipper for the bottom border elements.
      rect { "bottom_clip";
         scale: 1;
         desc { "default";
            rel.to: "shadow_base";
            rel1 { relative: 0.0 1.0; offset: 0 -1; }
            align: 0.0 1.0;
            min: 0 5;
            fixed: 0 1;
         }
         desc { "hidden";
            inherit: "default";
            rel1 { relative: 0.0 1.0; offset: 0 0; }
            rel2 { relative: 1.0 1.0; offset: 0 0; }
            min: 0 0;
            hid;
         }
      }
      // The visible rectangle for the bottom border.
      part { name: "bottom"; type: RECT; mouse_events: 0;
         clip: "bottom_clip";
         description { state: "default" 0.0;
            color_class: "/bg/normal/border";
            rel.to: "bottom_clip";
         }
         description { state: "focused" 0.0;
            inherit: "default";
            color_class: "/bg/selected/border";
         }
      }

      // Bottom-left resize handle.
      rect {  "efl.event.resize.bl";
         clip: "bottom_clip";
         scale: 1;
         desc { "default";
            rel.to: "bottom_clip";
            rel2.relative: 0.0 1.0;
            rel2.offset: 31 -1;
            min: RSZMINW RSZMINH;
            align: 1.0 0.0;
            color: RSZCOL; // no cc
            fixed: 1 1;
            offscale;
         }
         desc { "hidden"; inherit: "default"; hid; }
      }
      // Bottom resize handle.
      rect {  "efl.event.resize.b";
         clip: "bottom_clip";
         scale: 1;
         desc { "default";
            rel1.to: "efl.event.resize.bl";
            rel1.relative: 1.0 0.0;
            rel2.to: "efl.event.resize.br";
            rel2.relative: 0.0 1.0;
            min: 0 RSZMINH;
            align: 0.5 0.0;
            color: RSZCOL2; // no cc
            fixed: 1 1;
            offscale;
         }
         desc { "hidden"; inherit: "default"; hid; }
      }
      // Bottom-right resize handle.
      rect {  "efl.event.resize.br";
         clip: "bottom_clip";
         scale: 1;
         desc { "default";
            rel.to: "bottom_clip";
            rel1.relative: 1.0 0.0;
            rel1.offset: -32 0;
            min: RSZMINW RSZMINH;
            align: 0.0 0.0;
            color: RSZCOL; // no cc
            fixed: 1 1;
            offscale;
         }
         desc { "hidden"; inherit: "default"; hid; }
      }
      // A background for the indicator area. This can be opaque or transparent.
      rect { "indicator_bg";
         clip: "bg_clip";
         desc { "default";
            // Color: #94172DFF
            color: 148 23 45 255; // no cc never see this...
            rel.to: "efl.indicator";
         }
         desc { "bg_transparent";
            inherit: "default";
            // Color: #00000000
            color: 0 0 0 0; // no cc never see this...
         }
      }
      // Swallow part for the indicator widget itself. An application can
      // place a status indicator here.
      swallow { "efl.indicator";
         clip: "bg_clip";
         desc { "default";
            rel.to: "top_clip";
            rel1.relative: 0.0 1.0;
            visible: 0;
            align: 0.5 0.0;
            fixed: 1 1;
         }
         desc { "visible"; inherit: "default";
            visible: 1;
            fixed: 0 1;
         }
         desc { "hidden"; inherit: "visible";
            align: 0.5 1.0;
         }
      }
   }

   programs {
      // Triggered by the application to make the window borderless.
      // It hides the top and bottom clips and then calls the script to update the mode.
      program { signal: "efl,state,borderless,on"; source: "efl";
         action: STATE_SET "hidden";
         targets: "top_clip" "bottom_clip";
         after: "borderless,on";
      }
      program { "borderless,on"; SET_MODE(BORDERLESS); }
      // Re-enables the border.
      program { signal: "efl,state,borderless,off"; source: "efl";
         action: STATE_SET "default";
         targets: "top_clip" "bottom_clip";
         after: "borderless,off";
      }
      program { "borderless,off"; UNSET_MODE(BORDERLESS); }
      // Triggered by the application to make the window unresizable.
      // This calls the script which will hide resize handles.
      program {
         signal: "efl,state,unresizable,on"; source: "efl";
         SET_MODE(UNRESIZABLE);
      }
      program { signal: "efl,state,unresizable,off"; source: "efl";
         UNSET_MODE(UNRESIZABLE);
      }
      // Toggles the window shadow visibility by calling the script function.
      program { signal: "efl,state,shadow,on"; source: "efl";
         script {
            set_int(hide_shadow, 0);
            eval_shadow_menu();
         }
//         action: STATE_SET "default";
//         target: "shadow_clip";
//         target: "shadow_base";
      }
      program { signal: "efl,state,shadow,off"; source: "efl";
         script {
            set_int(hide_shadow, 1);
            eval_shadow_menu();
         }
//         action: STATE_SET "hidden";
//         target: "shadow_clip";
//         target: "shadow_base";
      }
      // Shows the application's main menu area.
      program { signal: "efl,action,show_menu"; source: "efl";
         script {
            set_int(show_menu, 1);
            eval_shadow_menu();
         }
//         action: STATE_SET "visible";
//         target: "efl.menu";
      }
      // Hides the application's main menu area. 'hide' is an ambiguous signal name
      // and could conflict. Here it likely means hide menu.
      program { signal: "efl,action,hide"; source: "efl";
         script {
            set_int(show_menu, 0);
            eval_shadow_menu();
         }
//         action: STATE_SET "default";
//         target: "efl.menu";
      }
      // Toggles the visibility of the solid-color background rectangle.
      program { signal: "efl,state,background,solid,on"; source: "efl";
         action: STATE_SET "visible";
         target: "efl.rect.background";
      }
      program { signal: "efl,state,background,solid,off"; source: "efl";
         action: STATE_SET "default";
         target: "efl.rect.background";
      }
//      program { signal: "efl,state,background,standard,on"; source: "efl";
//         action: STATE_SET "visible";
//         target: "background_bevel";
//      }
//      program { signal: "efl,state,background,standard,off"; source: "efl";
//         action: STATE_SET "default";
//         target: "background_bevel";
//      }
      // When the window receives focus, it sets the state of various title bar
      // elements to "focused", which applies different color classes or visuals.
      program { signal: "efl,action,focus"; source: "efl";
         action: STATE_SET "focused";
         target: "top";
         target: "bottom";
         target: "efl.text.title";
         target: "clip1";
         target: "clip2";
         target: "shadow_clip";
      }
      // When the window loses focus, it reverts the elements to their "default" state.
      program { signal: "efl,action,unfocus"; source: "efl";
         action: STATE_SET "default";
         target: "top";
         target: "bottom";
         target: "efl.text.title";
         target: "clip1";
         target: "clip2";
         target: "shadow_clip";
      }
      // This program chain creates a bouncing animation for the window icon when
      // its state is set to "urgent".
      // It starts a loop: urg -> urg1 -> urg2 -> urg1 -> ...
      program { signal: "efl,state,urgent"; source: "efl";
         action: STATE_SET "bounce1";
         target: "icon";
         after: "urg1";
      }
      program { name: "urg1";
         action: STATE_SET "bounce2";
         transition: DECELERATE 0.4;
         target: "icon";
         after: "urg2";
      }
      program { name: "urg2";
         action: STATE_SET "bounce1";
         transition: ACCELERATE 0.3;
         target: "icon";
         after: "urg1";
      }
      // Stops the urgent animation and returns the icon to its default state.
      program { signal: "efl,state,not_urgent"; source: "efl";
         action: STATE_SET "default";
         target: "icon";
      }

      // Handlers for window maximization. The wildcard '*' in the signal matches
      // any suffix (e.g., "efl,state,maximize" or "efl,state,maximize,animatable").
      // This sets the opaque region to "max" state and updates the border mode.
      program { signal: "efl,state,maximize*"; source: "efl";
         action: STATE_SET "max";
         target: "efl.spacer.opaque";
      }
      program { signal: "efl,state,maximize*"; source: "efl";
         SET_MODE(MAXIMIZED);
      }
      // Reverts the window from a maximized state.
      program { signal: "efl,state,unmaximize*"; source: "efl";
         action: STATE_SET "default";
         target: "efl.spacer.opaque";
      }
      program { signal: "efl,state,unmaximize*"; source: "efl";
         UNSET_MODE(MAXIMIZED);
      }

      // Indicator-related programs. They set variables in the script and then
      // run the 'update_indicator' program to apply the changes.
      program { signal: "efl,action,show_indicator"; source: "efl";
         script {
            set_int(indicator_enabled, 1);
         }
         after: "update_indicator";
      }
      program { signal: "efl,action,hide_indicator"; source: "efl";
         script {
            set_int(indicator_enabled, 0);
         }
         after: "update_indicator";
      }
      program { signal: "efl,action,indicator,bg_opaque"; source: "efl";
         script {
            set_int(indicator_type, INDICATOR_TYPE_BG_OPAQUE);
         }
         after: "update_indicator";
      }
      program { signal: "efl,action,indicator,bg_transparent"; source: "efl";
         script {
            set_int(indicator_type, INDICATOR_TYPE_BG_TRANSPARENT);
         }
         after: "update_indicator";
      }
      program { signal: "efl,action,indicator,hidden"; source: "efl";
         script {
            set_int(indicator_type, INDICATOR_TYPE_HIDDEN);
         }
         after: "update_indicator";
      }
      program { signal: "efl,action,indicator,show_effect"; source: "efl";
         action: STATE_SET "visible";
         transition: DECELERATE 0.2;
         target: "efl.indicator";
      }
      program { signal: "efl,action,indicator,hide_effect"; source: "efl";
         action: STATE_SET "hidden";
         transition: DECELERATE 0.2;
         target: "efl.indicator";
      }
      // This is the main logic for the indicator. It is implemented in a script
      // because of the multiple conditions involved (enabled, type).
      program { name: "update_indicator";
         script {
            if (get_int(indicator_enabled)) {
              if ((get_int(indicator_type) == INDICATOR_TYPE_BG_OPAQUE) ||
                  (get_int(indicator_type) == INDICATOR_TYPE_UNKNOWN)) {
                set_state(PART:"efl.indicator", "visible", 0.0);
                set_state(PART:"indicator_spacer", "default", 0.0);
                set_state(PART:"indicator_bg", "default", 0.0);
              } else if (get_int(indicator_type) == INDICATOR_TYPE_BG_TRANSPARENT) {
                set_state(PART:"efl.indicator", "visible", 0.0);
                set_state(PART:"indicator_spacer", "default", 0.0);
                set_state(PART:"indicator_bg", "bg_transparent", 0.0);
              } else if (get_int(indicator_type) == INDICATOR_TYPE_HIDDEN) {
                set_state(PART:"efl.indicator", "hidden", 0.0);
                set_state(PART:"indicator_spacer", "hidden", 0.0);
                set_state(PART:"indicator_bg", "default", 0.0);
              }
            } else {
              set_state(PART:"efl.indicator", "default", 0.0);
              set_state(PART:"indicator_spacer", "default", 0.0);
            }
         }
      }

      // Hides the modal blocker with a fade-out transition.
      program { signal: "efl,action,hide_blocker"; source: "efl";
         action: STATE_SET "default" 0.0;
         target: "rect.blocker";
         transition: DECELERATE 0.2;
      }
      // Shows the modal blocker with a fade-in transition.
      program { signal: "efl,action,show_blocker"; source: "efl";
         action: STATE_SET "visible" 0.0;
         target: "rect.blocker";
         transition: DECELERATE 0.2;
      }

      // These programs handle mouse interactions with the window control buttons.
      // They change the state of the button images to "selected" on mouse down
      // to provide visual feedback.
      program { signal: "mouse,down,*"; source: "event.close";
         action: STATE_SET "selected";
         target: "close1";
         target: "close2";
      }
      program { signal: "mouse,up,*"; source: "event.close";
         action: STATE_SET "default";
         target: "close1";
         target: "close2";
      }
      program { signal: "mouse,down,*"; source: "event.maximize";
         action: STATE_SET "selected";
         target: "max1";
         target: "max2";
      }
      program { signal: "mouse,up,*"; source: "event.maximize";
         action: STATE_SET "default";
         target: "max1";
         target: "max2";
      }
      program { signal: "mouse,down,*"; source: "event.minimize";
         action: STATE_SET "selected";
         target: "min1";
         target: "min2";
      }
      program { signal: "mouse,up,*"; source: "event.minimize";
         action: STATE_SET "default";
         target: "min1";
         target: "min2";
      }
      // When the title bar is clicked, it emits a signal to the application
      // code to start moving the window.
      program { signal: "mouse,down,1"; source: "event.titlebar";
         action: SIGNAL_EMIT "efl,action,move,start" "efl";
      }
      program { signal: "mouse,up,1"; source: "event.titlebar";
         action: SIGNAL_EMIT "efl,action,move,stop" "efl";
      }
      // When the control buttons are clicked, they emit signals to the application
      // to perform the corresponding actions (minimize, maximize, close).
      program { signal: "mouse,clicked,1"; source: "event.minimize";
         action: SIGNAL_EMIT "efl,action,minimize" "efl";
      }
      program { signal: "mouse,clicked,1"; source: "event.maximize";
         action: SIGNAL_EMIT "efl,action,maximize" "efl";
      }
      program { signal: "mouse,clicked,1"; source: "event.close";
         action: SIGNAL_EMIT "efl,action,close" "efl";
      }
      // Programs for resize handles. They emit signals to show/hide the resize
      // cursor and to start the resize operation on mouse down. This pattern
      // is repeated for all resize handles.
      program { signal: "mouse,in"; source: "efl.event.resize.t";
         action: SIGNAL_EMIT "efl,action,resize,show" "efl.event.resize.t";
      }
      program { signal: "mouse,out"; source: "efl.event.resize.t";
         action: SIGNAL_EMIT "efl,action,resize,hide" "efl.event.resize.t";
      }
      program { signal: "mouse,down,1"; source: "efl.event.resize.t";
         action: SIGNAL_EMIT "efl,action,resize,start" "efl.event.resize.t";
      }
      program { signal: "mouse,in"; source: "efl.event.resize.b";
         action: SIGNAL_EMIT "efl,action,resize,show" "efl.event.resize.b";
      }
      program { signal: "mouse,out"; source: "efl.event.resize.b";
         action: SIGNAL_EMIT "efl,action,resize,hide" "efl.event.resize.b";
      }
      program { signal: "mouse,down,1"; source: "efl.event.resize.b";
         action: SIGNAL_EMIT "efl,action,resize,start" "efl.event.resize.b";
      }
      program { signal: "mouse,in"; source: "efl.event.resize.tl";
         action: SIGNAL_EMIT "efl,action,resize,show" "efl.event.resize.tl";
      }
      program { signal: "mouse,out"; source: "efl.event.resize.tl";
         action: SIGNAL_EMIT "efl,action,resize,hide" "efl.event.resize.tl";
      }
      program { signal: "mouse,down,1"; source: "efl.event.resize.tl";
         action: SIGNAL_EMIT "efl,action,resize,start" "efl.event.resize.tl";
      }
      program { signal: "mouse,in"; source: "efl.event.resize.tr";
         action: SIGNAL_EMIT "efl,action,resize,show" "efl.event.resize.tr";
      }
      program { signal: "mouse,out"; source: "efl.event.resize.tr";
         action: SIGNAL_EMIT "efl,action,resize,hide" "efl.event.resize.tr";
      }
      program { signal: "mouse,down,1"; source: "efl.event.resize.tr";
         action: SIGNAL_EMIT "efl,action,resize,start" "efl.event.resize.tr";
      }
      program { signal: "mouse,in"; source: "efl.event.resize.bl";
         action: SIGNAL_EMIT "efl,action,resize,show" "efl.event.resize.bl";
      }
      program { signal: "mouse,out"; source: "efl.event.resize.bl";
         action: SIGNAL_EMIT "efl,action,resize,hide" "efl.event.resize.bl";
      }
      program { signal: "mouse,down,1"; source: "efl.event.resize.bl";
         action: SIGNAL_EMIT "efl,action,resize,start" "efl.event.resize.bl";
      }
      program { signal: "mouse,in"; source: "efl.event.resize.br";
         action: SIGNAL_EMIT "efl,action,resize,show" "efl.event.resize.br";
      }
      program { signal: "mouse,out"; source: "efl.event.resize.br";
         action: SIGNAL_EMIT "efl,action,resize,hide" "efl.event.resize.br";
      }
      program { signal: "mouse,down,1"; source: "efl.event.resize.br";
         action: SIGNAL_EMIT "efl,action,resize,start" "efl.event.resize.br";
      }
      // A click on the window icon emits a signal to show the window menu.
      program { signal: "mouse,clicked,1"; source: "event.icon";
         action: SIGNAL_EMIT "efl,action,menu" "efl";
      }
   }
}

// This group defines a dialog window border. It inherits all properties from
// the base "efl/border" and then customizes it for dialog-specific behavior.
group { name: "efl/border/dialog";
   inherit: "efl/border";
   parts {
      // For dialogs, the title is positioned relative to the close button,
      // as other buttons are hidden.
      text {  "efl.text.title";
         clip: "top_clip";
         desc { "default";
            rel2.to_x: "event.close";
         }
         desc { "focused";
            inherit: "default";
            visible: 0;
         }
      }
      text {  "title2";
         desc { "default";
            rel2.to_x: "event.close";
         }
         desc { "focused";
            inherit: "default";
            visible: 1;
         }
      }
      // In a dialog, the maximize and minimize buttons are not needed,
      // so their visual parts and event areas are set to be permanently invisible.
      image { "max1";
         desc { "default";
            visible: 0;
         }
         desc { "selected";
            visible: 0;
         }
      }
      image { "min1";
         desc { "default";
            visible: 0;
         }
         desc { "selected";
            visible: 0;
         }
      }
      image { "max2";
         desc { "default";
            visible: 0;
         }
         desc { "selected";
            visible: 0;
         }
      }
      image { "min2";
         desc { "default";
            visible: 0;
         }
         desc { "selected";
            visible: 0;
         }
      }
      rect {  "efl.event.maximize";
         desc { "default";
            visible: 0;
         }
      }
      rect {  "efl.event.minimize";
         desc { "default";
            visible: 0;
         }
      }
   }
}

// This group defines a border for a "naviframe" (navigation frame), which is a
// common UI pattern for hierarchical navigation (like in a wizard or settings).
// It inherits from the dialog style.
group { name: "efl/border/naviframe";
   inherit:   "efl/border/dialog";
   parts {
      // The "close" button's icon is changed to a left arrow, which
      // typically signifies "back" in a navigation context.
      image { "close1";
         desc { "default";
            image.normal: "i-arrow-l";
         }
         desc { "selected";
            image.normal: "i-arrow-l";
         }
      }
      image { "close2"; nomouse;
         clip: "clip2";
         desc { "default";
            image.normal: "i-arrow-l";
         }
         desc { "selected";
            image.normal: "i-arrow-l";
         }
      }
   }
}

// It is good practice to undefine macros at the end of a file to prevent
// them from leaking into other files that might be processed by the same
// compiler invocation. This avoids macro name collisions.
#undef UNRESIZABLE
#undef BORDERLESS
#undef MAXIMIZED
#undef SET_MODE
#undef UNSET_MODE

