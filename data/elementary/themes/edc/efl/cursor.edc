// A group defining the "hand1" cursor, which includes its visual
// appearance and the interactive hotspot.
group { name: "efl/cursor/hand1";
   // Custom metadata, here indicating the version of this definition.
   data.item: "version" "123";
   // The image for the cursor, compressed to save space.
   images.image: "pointer_hand1.png" COMP;
   parts {
      // The "base" part displays the cursor's image. `mouse_events: 0` makes
      // it non-interactive, acting only as a visual element.
      part { name: "base"; mouse_events: 0; scale: 1;
         scale: 1;
         description { state: "default" 0.0;
            // A macro that sets a fixed size of 32x32 pixels.
            FIXED_SIZE(32, 32)
            image.normal: "pointer_hand1.png";
         }
      }
      // The "efl.hotspot" part is a special, non-visible element that defines
      // the exact pixel of the cursor's pointer.
      part { name: "efl.hotspot"; type: SWALLOW;
         description { state: "default" 0.0;
            visible: 0;
            fixed: 1 1;
            // Positions the hotspot at coordinates (21, 7) relative to the
            // "base" part's 32x32 dimensions. This is the tip of the finger.
            rel1.relative: (21/32) (7/32);
            rel1.to: "base";
            rel2.to: "base";
            rel2.relative: (21/32) (7/32);
            rel2.offset: 0 0;
         }
      }
      // Aliases the current hotspot name to an older one for compatibility.
      /* efl.content.hotspot is the old name for the above part */
      alias: "efl.content.hotspot" "efl.hotspot";
   }
}

// Defines a blank (invisible) cursor. This is useful for scenarios
// where the cursor should be hidden, for example in fullscreen applications.
group { name: "efl/cursor/blank";
   data.item: "version" "123";
   parts {
      // It contains only a minimal hotspot part, as a valid cursor group
      // requires one. There are no visual parts.
      part { name: "efl.hotspot"; type: SWALLOW;
         description { state: "default" 0.0;
            visible: 0;
            // Sets a maximum size of 1x1 pixels for this part.
            max: 1 1;
         }
      }
      /* efl.content.hotspot is the old name for the above part */
      alias: "efl.content.hotspot" "efl.hotspot";
   }
}

// This group defines the "xterm" cursor, typically used for text entry fields.
group { name: "efl/cursor/xterm";
   data.item: "version" "123";
   images.image: "pointer_entry.png" COMP;
   parts {
      part { name: "base"; mouse_events: 0; scale: 1;
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "pointer_entry.png";
            // The cursor image has a non-square size of 16x32 pixels.
            FIXED_SIZE(16, 32)
         }
      }
      part { name: "efl.hotspot"; type: SWALLOW;
         description { state: "default" 0.0;
            visible: 0;
            fixed: 1 1;
            // `rel.to` is a shorthand for setting both rel1.to and rel2.to.
            rel.to: "base";
            // By using 0.5 for both X and Y relative positions, the hotspot
            // is perfectly centered within the "base" part, regardless of its size.
            rel1.relative: 0.5 0.5;
            rel2.relative: 0.5 0.5;
            rel2.offset: 0 0;
         }
      }
      /* efl.content.hotspot is the old name for the above part */
      alias: "efl.content.hotspot" "efl.hotspot";
   }
}
