//Efl.Ui.Navigation_Layout Themes
// This group defines the main layout structure for a navigation widget. It consists
// of a top bar area and a main content area below it.
group { "efl/navigation_layout";
   data.item: "version" "123";
   parts {
      // A non-visible spacer part that serves as a reference for positioning
      // other parts, ensuring consistent alignment across the layout.
      spacer { "base";
         desc { "default";
         }
      }
      // This swallow part is designated for the navigation bar, typically at the top.
      swallow { "efl.bar";
         scale: 1;
         desc { "default";
            // The bar's height is fixed to its minimum vertical size, while its
            // width scales with the layout.
            fixed: 0 1;
            // Sets the minimum height of the bar to 40 pixels.
            min: 0 40;
            // Positions the bar at the top of the layout, spanning its full width.
            rel2.relative: 1.0 0.0;
            align: 0.5 0.0;
         }
      }
      // This swallow part is the main content area of the layout.
      swallow { "efl.content";
         desc { "default";
            // Positions the top of the content area just below the 'efl.bar' part.
            rel1 {
               to_x: "base";
               to_y: "efl.bar";
               relative: 0.0 1.0;
            }
            // Ensures the content area spans the full width relative to the 'base' spacer.
            rel2.to_x: "base";
            align: 0.5 0.0;
         }
      }
   }
}
