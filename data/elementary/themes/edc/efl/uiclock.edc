// DATETIME_FIELD: This macro generates a 'swallow' part that acts as a placeholder
// for individual date/time components (e.g., year, month, day).
// It's designed to be shown or hidden based on the date/time format.
#define DATETIME_FIELD(_pos) \
   swallow { "efl.field"#_pos; \
      scale; \
      clip_to: "clip"; \
      desc { "default"; \
         hid; \
         min: 0 0; \
         align: 0.0 0.5; \
         fixed: 1 1; \
         rel1.relative: 1.0 0.0; \
         rel1.to: "efl.separator"#_pos; \
         rel2.relative: 1.0 1.0; \
         rel2.to: "efl.separator"#_pos; \
      } \
      desc { "enable"; \
         inherit: "default"; \
         vis; \
         min: 8 10; \
      } \
   } \
   programs{ \
      program { "field_"#_pos"enabled"; \
         signal: "field"#_pos",enable"; \
         source: "efl"; \
         action: STATE_SET "enable"; \
         target: "efl.field"#_pos; \
      } \
      program { "field_"#_pos"disabled"; \
         signal: "field"#_pos",disable"; \
         source: "efl"; \
         action: STATE_SET "default"; \
         target: "efl.field"#_pos; \
      } \
   }
// DATETIME_SEPARATOR: This macro creates a text part that serves as a separator
// (e.g., '/', ':') between date/time fields. Its visibility is tied to the
// preceding field. The macro also creates a disabled-state version of the text.
#define DATETIME_SEPARATOR(_pos, _after) \
   text { "efl.separator"#_pos; \
      scale; \
      clip_to: "disclip"; \
      desc { "default"; \
         hid; \
         min: 0 0; \
         align: 0.0 0.5; \
         fixed: 1 0; \
         rel1 { \
            relative: 1.0 0.0; \
            to: "efl.field"#_after; \
         } \
         rel2 { \
            relative: 1.0 1.0; \
            to: "efl.field"#_after; \
         } \
         color_class: "/fg/normal/clock/separator"; \
         text { \
            font: FN; size: 10; \
            min: 1 0; \
            ellipsis: -1; \
            align: 0.5 0.5; \
            text_class: "datetime_separator_text"; \
         } \
      } \
      desc { "enable"; \
         inherit: "default"; \
         vis; \
         min: 8 10; \
      } \
   } \
   text { "efl.separator"#_pos"d"; \
      scale; \
      clip_to: "disclip2"; \
      desc { "default"; \
         hid; \
         rel1.to: "efl.separator"#_pos; \
         rel2.to: "efl.separator"#_pos; \
         color_class: "/fg/normal/clock/separator"; \
         text { \
            text_source: "efl.separator"#_pos; \
            font: FN; size: 10; \
            text_class: "datetime_separator_text_disabled"; \
         } \
      } \
      desc { "enable"; \
         inherit: "default"; \
         vis; \
      } \
   } \
   programs { \
      program { \
         signal: "field"#_after",enable"; \
         source: "efl"; \
         action: STATE_SET "enable"; \
         target: "efl.separator"#_pos; \
         target: "efl.separator"#_pos"d"; \
      } \
      program { \
         signal: "field"#_after",disable"; \
         source: "efl"; \
         action: STATE_SET "default"; \
         target: "efl.separator"#_pos; \
         target: "efl.separator"#_pos"d"; \
      } \
   }

// The main group for the uiclock widget. It defines the layout and behavior
// of the date and time display, assembling the fields and separators defined
// in the macros above.
group { "efl/uiclock";
   data.item: "version" "123";
   parts {
      // "bg": A simple rectangle that serves as the background for the entire widget.
      // It uses a color_class, so its color is determined by the theme.
      rect { "bg";
         desc { "default";
            color_class: "/bg/normal/clock";
         }
      }
      // "clip": This rectangle acts as a clipping mask for all the active
      // date/time fields. Its horizontal bounds are tied to the first and last
      // visible separators, ensuring that only the fields within this range are
      // rendered. This is crucial for creating a clean, contained layout.
      rect { "clip";
         desc { "default";
            rel1.to: "efl.separator0";
            rel2.to: "efl.separator7";
         }
      }
      // "disclip" and "disclip2": These are two clipping rectangles that manage the
      // visibility of separators based on the widget's enabled/disabled state.
      // "disclip" is visible by default and hides when disabled, taking the enabled
      // separators with it.
      rect { "disclip";
         clip_to: "clip";
         desc { "default";
            rel1.to: "efl.separator0";
            rel2.to: "efl.separator7";
         }
         desc { "disabled";
           inherit: "default";
           hid;
         }
      }
      // "disclip2" is hidden by default and becomes visible when disabled, revealing
      // the disabled-style separators. This two-clipper approach is a common EDC
      // technique for state-dependent visibility without complex logic.
      rect { "disclip2";;
         clip_to: "clip";
         desc { "default";
            rel1.to: "efl.separator0";
            rel2.to: "efl.separator7";
            hid;
         }
         desc { "disabled";
            inherit: "default";
            vis;
         }
      }
      // "efl.separator0": This is not a visible separator but a spacer that acts as
      // the starting anchor for the layout of the fields. It provides a reference
      // point for the 'clip' rectangle and the first field.
      spacer { "efl.separator0";;
         scale;
         desc { "default";
            min: 8 10;
            align: 0.0 0.5;
            fixed: 1 0;
            rel2.relative: 0.0 1.0;
         }
      }
      // The following lines instantiate the date/time fields and their separators
      // using the macros defined at the start of the file. The numeric arguments
      // create unique part names (e.g., "efl.field0", "efl.separator1") and link
      // separators to their preceding fields.
      DATETIME_FIELD(0)
      DATETIME_SEPARATOR(1,0)
      DATETIME_FIELD(1)
      DATETIME_SEPARATOR(2,1)
      DATETIME_FIELD(2)
      DATETIME_SEPARATOR(3,2)
      DATETIME_FIELD(3)
      DATETIME_SEPARATOR(4,3)
      DATETIME_FIELD(4)
      DATETIME_SEPARATOR(5,4)
      DATETIME_FIELD(5)
      DATETIME_SEPARATOR(6,5)
      DATETIME_FIELD(6)
      DATETIME_SEPARATOR(7,6)
      DATETIME_FIELD(7)
      DATETIME_SEPARATOR(8,7)
      // "efl.separator9": Another spacer that defines the rightmost boundary
      // of the content area.
      spacer { "efl.separator9";;
         desc { "default";
            rel1.to: "efl.separator7";
            rel1.relative: 1.0 0.0;
            min: 8 10;
         }
      }
      // "discover": A transparent rectangle that overlays the fields area. It's
      // hidden by default but becomes visible when the widget is disabled. Its
      // purpose is to intercept mouse events, effectively making the underlying
      // fields non-interactive. The color is set to fully transparent
      // black (#00000000).
      rect { "discover";;
         desc { "default";
            rel1.to: "efl.separator0";
            rel2.to: "efl.separator7";
            hid;
            color: 0 0 0 0; // no cc
         }
         desc { "disabled";
            inherit: "default";
            vis;
         }
      }
      // "efl.access": A part designated for accessibility features. The 'repeat'
      // property indicates that an instance of this part will be created for each
      // accessible child object, which is a standard way to handle accessibility
      // in EDC. It is transparent.
      rect { "efl.access";
         repeat;
         desc { "default";
            color: 0 0 0 0; // no cc
         }
      }
   }
   // These programs handle the overall enabled/disabled state of the uiclock widget.
   programs {
      // When the "efl,state,disabled" signal is received (typically from the C
      // code), this program transitions the clipping and overlay parts to their
      // "disabled" states. This visually indicates that the widget is inactive.
      program {
         signal: "efl,state,disabled";
         source: "efl";
         action: STATE_SET "disabled";
         target: "disclip";
         target: "disclip2";
         target: "discover";
      }
      // Conversely, the "efl,state,enabled" signal reverts the parts to their
      // "default" states, re-enabling interaction and restoring the normal
      // appearance.
      program {
         signal: "efl,state,enabled";
         source: "efl";
         action: STATE_SET "default";
         target: "disclip";
         target: "disclip2";
         target: "discover";
      }
   }
}
#undef DATETIME_SEPARATOR
#undef DATETIME_FIELD

// The "efl/uiclock/ampm" group defines the AM/PM selector button.
// It simply inherits from the standard "efl/button" group, meaning it will
// look and behave like a default button but can be specifically themed for
// the uiclock context.
group { "efl/uiclock/ampm"
   data.item: "version" "123";
   inherit: "efl/button";
}

// The following groups are for theming the text entry parts within the uiclock,
// such as the fields for year, month, etc. They inherit from standard EFL text
// and selection styles, allowing themers to provide uiclock-specific overrides.
group { "efl/uiclock/text"
   data.item: "version" "123";
   inherit: "efl/text";
   alias: "efl/uiclock/text/single";
   alias: "efl/uiclock/text/single-noedit";
}
// This group is for styling the text selection within the uiclock fields.
group { "efl/uiclock/text/selection"
   data.item: "version" "123";
   inherit: "efl/text/selection";
}
