/**
Group: efl/spin_button/vertical (@since 1.23)
	 Part Swallow: efl.dec_button (required)
	 Part Swallow: efl.entry (required)
	 Part Swallow: efl.inc_button (required)
	 Part Swallow: efl.text_button (required)
	 Signal: efl,button,visible,off
	 Signal: efl,button,visible,on
	 Signal: efl,entry,visible,off
	 Signal: efl,entry,visible,on
	 Signal: efl,state,access,active
	 Signal: efl,state,access,inactive
	 Signal: efl,state,disabled
	 Signal: efl,state,enabled
Group: efl/spin_button/horizontal/dec_button (@since 1.23)
	 Signal: efl,action,multi,down
	 Signal: efl,action,multi,up
	 Signal: efl,action,pressed
	 Signal: efl,action,unpressed
	 Signal: efl,state,animation,activated
	 Signal: efl,state,disabled
	 Signal: efl,state,enabled
Group: efl/spin_button/horizontal (@since 1.23)
	 Part Swallow: efl.dec_button (required)
	 Part Swallow: efl.entry (required)
	 Part Swallow: efl.inc_button (required)
	 Part Swallow: efl.text_button (required)
	 Signal: efl,button,visible,off
	 Signal: efl,button,visible,on
	 Signal: efl,entry,visible,off
	 Signal: efl,entry,visible,on
	 Signal: efl,state,access,active
	 Signal: efl,state,access,inactive
	 Signal: efl,state,disabled
	 Signal: efl,state,enabled
Group: efl/spin_button/vertical/text_button (@since 1.23)
	 Part Text: efl.text
	 Signal: efl,state,disabled
	 Signal: efl,state,enabled
Group: efl/spin (@since 1.23)
	 Part Text: efl.text
Group: efl/spin_button/horizontal/inc_button (@since 1.23)
	 Signal: efl,action,multi,down
	 Signal: efl,action,multi,up
	 Signal: efl,action,pressed
	 Signal: efl,action,unpressed
	 Signal: efl,state,animation,activated
	 Signal: efl,state,disabled
	 Signal: efl,state,enabled
Group: efl/spin_button/horizontal/text_button (@since 1.23)
	 Part Text: efl.text
	 Signal: efl,state,disabled
	 Signal: efl,state,enabled
Group: efl/spin_button/vertical/dec_button (@since 1.23)
	 Signal: efl,action,multi,down
	 Signal: efl,action,multi,up
	 Signal: efl,action,pressed
	 Signal: efl,action,unpressed
	 Signal: efl,state,animation,activated
	 Signal: efl,state,disabled
	 Signal: efl,state,enabled
Group: efl/spin_button/vertical/inc_button (@since 1.23)
	 Signal: efl,action,multi,down
	 Signal: efl,action,multi,up
	 Signal: efl,action,pressed
	 Signal: efl,action,unpressed
	 Signal: efl,state,animation,activated
	 Signal: efl,state,disabled
	 Signal: efl,state,enabled
*/
// This group defines the horizontal layout for a spin button.
// It consists of an entry for displaying values, increment and decrement
// buttons, and a text button. It manages visibility and state changes
// for these components based on incoming EFL signals.
group { "efl/spin_button/horizontal";
   data.item: "version" "123";
   parts {
      // The "clip" rectangle is used as a clipping mask for the "efl.entry".
      // This ensures that the entry part does not draw outside its designated area,
      // which is aligned with the "efl.text_button".
      rect { "clip";
         desc { "default";
            rel.to: "efl.text_button";
         }
      }
      // "bg" serves as the background for the entire widget.
      rect { "bg";
         desc { "default";
            color_class: "/bg/normal/spinner/base";
         }
      }
      // The "access" part is an invisible rectangle used for accessibility.
      // It becomes visible when the widget is in an 'active' accessibility state,
      // providing a focus highlight.
      rect { "access";
         repeat;
         desc { "default";
            fixed: 1 1;
            color: 0 0 0 0; // no cc // Transparent color (#00000000)
            rel.to: "bg";
            hid;
         }
         desc { "active";
            inherit: "default";
            vis;
         }
      }
      // "efl.entry" is a swallow part where the actual entry widget will be placed.
      // It's clipped by the "clip" rectangle. Its visibility is toggled
      // between 'default' (hidden) and 'active' (visible) states.
      swallow { "efl.entry"; required;
         clip: "clip";
         desc { "default";
            fixed: 1 1;
            rel.to: "efl.text_button";
            hid;
         }
         desc { "active";
            inherit: "default";
            vis;
         }
      }
      // The "efl.dec_button" is a swallow part for the decrement button.
      // It's positioned on the left side of the widget.
      swallow { "efl.dec_button"; required;
         scale;
         desc { "default";
            fixed: 1 1;
            align: 0.0 0.5;
            min: 23 23;
            max: 23 23;
         }
      }
      // The "efl.inc_button" is a swallow part for the increment button.
      // It's positioned on the right side of the widget.
      swallow { "efl.inc_button"; required;
         scale;
         desc { "default";
            fixed: 1 1;
            align: 1.0 0.5;
            min: 23 23;
            max: 23 23;
         }
      }
      // "efl.text_button" is a swallow part that displays the current value when not in entry mode.
      // It is positioned between the increment and decrement buttons.
      swallow { "efl.text_button"; required;
         scale;
         desc { "default";
            vis;
            rel1.to_y: "bg";
            rel1.to_x: "efl.dec_button";
            rel1.relative: 1.0 0.0;
            rel1.offset: 4 4;
            rel2.to_y: "bg";
            rel2.to_x: "efl.inc_button";
            rel2.relative: 0.0 1.0;
            rel2.offset: -5 -5;
            min: 23 0;
            max: -1 -1;
            offscale;
         }
         desc { "inactive";
            inherit: "default";
            hid;
         }
      }
      // "disabler" is a transparent rectangle that covers the widget when disabled.
      // This prevents mouse events from reaching other parts.
      rect { "disabler";
         norepeat;
         nomouse;
         desc { "default";
            color: 0 0 0 0; // no cc // Transparent color (#00000000)
            hid;
         }
         desc { "disabled";
            inherit: "default";
            vis;
         }
      }
   }
   programs {
      // This program makes the "efl.entry" part visible when the "efl,entry,visible,on"
      // signal is received, effectively switching to entry mode.
      program { "entry_active"; signal: "efl,entry,visible,on";
         source: "efl";
         action: STATE_SET "active";
         target: "efl.entry";
      }
      // This program hides the "efl.entry" part, returning to text display mode.
      program { "entry_inactive"; signal: "efl,entry,visible,off";
         source: "efl";
         action: STATE_SET "default";
         target: "efl.entry";
      }
      // Controls visibility of the text button. When "efl,button,visible,on" is signaled,
      // the "efl.text_button" part is set to its default (visible) state.
      program { signal: "efl,button,visible,on"; source: "efl";
         action: STATE_SET "default";
         target: "efl.text_button";
      }
      // When "efl,button,visible,off" is signaled, "efl.text_button" becomes inactive (hidden).
      program { signal: "efl,button,visible,off"; source: "efl";
         action: STATE_SET "inactive";
         target: "efl.text_button";
      }
      // When accessibility is active, the "access" rectangle is made visible.
      program { signal: "efl,state,access,active"; source: "efl";
         action:  STATE_SET "active";
         target: "access";
      }
      // Hides the "access" rectangle when accessibility is inactive.
      program { signal: "efl,state,access,inactive"; source: "efl";
         action:  STATE_SET "default";
         target: "access";
      }
      // Shows the "disabler" part when the widget is disabled.
      program { signal: "efl,state,disabled"; source: "efl";
         action: STATE_SET "disabled";
         target: "disabler";
      }
      // Hides the "disabler" part when the widget is enabled.
      program { signal: "efl,state,enabled"; source: "efl";
         action: STATE_SET "default";
         target: "disabler";
      }
   }
}

// This group defines the vertical layout for a spin button.
// It inherits the horizontal layout and overrides the positions of the
// increment/decrement buttons and the text button to arrange them vertically.
group { "efl/spin_button/vertical";
   inherit: "efl/spin_button/horizontal";
   data.item: "version" "123";
   parts {
      part { name: "bg";
         desc { "default";
            min: 40 69;
         }
      }
      // The increment button is placed at the top of the widget.
      swallow { "efl.inc_button"; required;
         scale;
         desc { "default";
            rel.to: "bg";
            align: 0.5 0.0;
         }
      }
      // The decrement button is placed at the bottom.
      swallow { "efl.dec_button"; required;
         scale;
         desc { "default";
            rel.to: "bg";
            align: 0.5 1.0;
         }
      }
      // The text button is placed between the increment and decrement buttons.
      swallow { "efl.text_button"; required;
         scale;
         desc { "default";
            rel.to_x: "bg";
            rel1 {
               to_x: "bg";
               to_y: "efl.inc_button";
               relative: 0.0 1.0;
            }
            rel2 {
               to_x: "bg";
               to_y: "efl.dec_button";
               relative: 1.0 0.0;
            }
            fixed: 0 1;
         }
         desc { "inactive";
            inherit: "default";
            hid;
         }
      }
   }
}

// This group defines the appearance and behavior of the horizontal increment button.
// It includes an arrow image, an overlay for mouse events, and logic to handle
// single clicks and multi-press (hold) events.
group { "efl/spin_button/horizontal/inc_button";
   data.item: "version" "123";
   // This script manages the button's state to distinguish between single clicks
   // and continuous presses (multi-down).
   // 'mouse_down' tracks if the mouse button is currently pressed.
   // 'multi_down' is a flag set externally to indicate a long press is active.
   script {
      public mouse_down = 0;
      public multi_down = 0;
   }
   parts {
      // The visual representation of the increment button, typically a right-facing arrow.
      // It changes color class based on its state (default, pressed, disabled).
      part { name: "arrow.image";
         scale: 1;
         description { state: "default" 0.0;
            min: 15 15;
            max: 15 15;
            image.normal: "i-arrow-r";
            color_class: "/fg/normal/spinner/arrow";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            offscale;
         }
         description { state: "pressed" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/spinner/arrow";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/spinner/arrow";
         }
      }
      // An invisible rectangle that captures mouse events for the entire button area.
      // 'repeat_events' allows it to continuously receive mouse events while pressed.
      part { name: "over"; type: RECT;
         repeat_events: 1;
         scale;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc // Transparent color (#00000000)
            min: 23 23;
         }
      }
      // Similar to the main disabler, this part covers the button when disabled.
      part { name: "disabler"; type: RECT;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc // Transparent color (#00000000)
            visible: 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
   }
   programs {
      // When the mouse button is pressed down, this program checks if it's a new press.
      // If it is (not a multi-down and not already down), it sets the 'mouse_down' flag
      // and triggers the "button_press2" program.
      program { signal: "mouse,down,1"; source: "over";
         script {
            if ((get_int(multi_down) == 0) &&
                (get_int(mouse_down) == 0)) {
                  set_int(mouse_down, 1);
                  run_program(PROGRAM:"button_press2");
            }
         }
      }
      // Emits the "efl,action,press" signal to notify the application code.
      // This is followed by an animation.
      program { name: "button_press2";
         action: SIGNAL_EMIT "efl,action,press" "";
         after: "button_press_anim";
      }
      // Animates the button to the "pressed" state.
      program { name: "button_press_anim";
         action: STATE_SET "pressed" 0.0;
         target: "arrow.image";
      }
      // On mouse up, if the button was considered pressed, it resets the 'mouse_down' flag
      // and triggers the unpress signal and animation.
      program { signal: "mouse,up,1"; source: "over";
         script {
            if (get_int(mouse_down) == 1) {
                  set_int(mouse_down, 0);
                  run_program(PROGRAM:"button_unpress2");
                  run_program(PROGRAM:"button_unpress_anim");
            }
         }
      }
      // Emits the "efl,action,unpress" signal.
      program { name: "button_unpress2";
         action: SIGNAL_EMIT "efl,action,unpress" "";
      }
      // Animates the button back to its default state.
      program { name: "button_unpress_anim";
         action: STATE_SET "default" 0.0;
         target: "arrow.image";
      }
      // On a full click, if not in multi-down mode, emits the "efl,action,click" signal.
      program { signal: "mouse,clicked,1"; source: "over";
         script {
            if (get_int(multi_down) == 0) {
              run_program(PROGRAM:"button_click2");
            }
         }
      }
      // The application can signal "efl,action,unpressed" to trigger the unpress animation.
      program { signal: "efl,action,unpressed"; source: "efl";
         after: "button_unpress_anim";
      }
      // The application can signal "efl,action,pressed" to trigger the press animation.
      program { signal: "efl,action,pressed"; source: "efl";
         after: "button_press_anim";
      }
      program { name: "button_click2";
         action: SIGNAL_EMIT "efl,action,click" "";
      }
      // Accessibility action to show a pressed state animation.
      program { signal: "efl,state,animation,activated"; source: "efl";
         action: STATE_SET "pressed" 0.0;
         target: "arrow.image";
         after: "access_pressed_anim";
      }
      // This program defines the animation back to the default state for the
      // accessibility "activated" signal. It uses a decelerate transition
      // to create a smooth visual effect.
      program { name: "access_pressed_anim";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.1;
         target: "arrow.image";
      }
      // These programs toggle the visual state between enabled and disabled.
      program { signal: "efl,state,disabled"; source: "efl";
         action: STATE_SET "disabled" 0.0;
         target: "arrow.image";
         target: "disabler";
      }
      program { signal: "efl,state,enabled"; source: "efl";
         action: STATE_SET "default" 0.0;
         target: "arrow.image";
         target: "disabler";
      }
      // These programs set and clear the 'multi_down' flag, which is used to
      // manage continuous press behavior.
      program { signal: "efl,action,multi,down"; source: "efl";
         script {
            set_int(multi_down, 1);
         }
      }
      program { signal: "efl,action,multi,up"; source: "efl";
         script {
            set_int(multi_down, 0);
         }
      }
   }
}

// This group defines the entry part of the spin button.
// It inherits from "efl/text" to provide standard text properties.
// The alias makes it available for the vertical layout as well.
group { "efl/spin_button/horizontal/entry";
   alias: "efl/spin_button/vertical/entry";
   inherit: "efl/text";
   data.item: "version" "123";
}

// This group defines the horizontal decrement button.
// It inherits all the behavior from the increment button and simply
// overrides the arrow image to point left.
group { "efl/spin_button/horizontal/dec_button";
   inherit: "efl/spin_button/horizontal/inc_button";
   data.item: "version" "123";
   parts {
      part { name: "arrow.image";
         description { state: "default" 0.0;
            image.normal: "i-arrow-l";
         }
         description { state: "pressed" 0.0;
            image.normal: "i-arrow-l";
         }
         description { state: "disabled" 0.0;
            image.normal: "i-arrow-l";
         }
      }
   }
}

// This group defines the text button part, which displays the spinner's
// value when not in entry mode. It provides a clickable area that can
// switch the spinner to entry mode. The alias makes it available for the
// vertical layout as well.
group { "efl/spin_button/horizontal/text_button";
   alias: "efl/spin_button/vertical/text_button";
   data.item: "version" "123";
   parts {
      // A spacer that serves as a background and defines the area of the text.
      part { name: "bg";
         type: SPACER;
         scale: 1;
         description { state: "default" 0.0;
         }
      }
      // The TEXT part that displays the value. It has properties for font,
      // size, class, and ellipsis handling.
      part { name: "efl.text"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            color_class: "/fg/normal/spinner/text";
            rel.to: "bg";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            offscale;
            text { font: FN; size: 10;
               min: 1 1;
               text_class: "spinner";
               ellipsis: -1;
            }
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0 ;
            color_class: "/fg/disabled/spinner/text";
         }
      }
      // An invisible overlay to capture mouse clicks over the text area.
      part { name: "over"; type: RECT;
         repeat_events: 1;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc // Transparent color (#00000000)
         }
      }
      part { name: "disabler"; type: RECT;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            visible: 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
   }
   programs {
      // When the "over" part is clicked, it emits an "efl,action,click" signal,
      // which is typically used to switch to entry mode.
      program { signal: "mouse,clicked,1"; source: "over";
         script {
            run_program(PROGRAM:"button_click2");
         }
      }
      program { name: "button_click2";
         action: SIGNAL_EMIT "efl,action,click" "";
      }
      // These programs toggle the state between enabled and disabled.
      program { signal: "efl,state,disabled"; source: "efl";
         action: STATE_SET "disabled" 0.0;
         target: "disabler";
         target: "efl.text";
      }
      program { signal: "efl,state,enabled"; source: "efl";
         action: STATE_SET "default" 0.0;
         target: "disabler";
         target: "efl.text";
      }
   }
}

// This group defines the vertical increment button. It inherits from the
// horizontal version and changes the arrow image to point up.
group { "efl/spin_button/vertical/inc_button";
   inherit: "efl/spin_button/horizontal/inc_button";
   data.item: "version" "123";
   parts {
      part { name: "arrow.image";
         description { state: "default" 0.0;
            image.normal: "i-arrow-u";
         }
         description { state: "pressed" 0.0;
            image.normal: "i-arrow-u";
         }
         description { state: "disabled" 0.0;
            image.normal: "i-arrow-u";
         }
      }
   }
}

// This group defines the vertical decrement button. It inherits from the
// horizontal version and changes the arrow image to point down.
group { "efl/spin_button/vertical/dec_button";
   inherit: "efl/spin_button/horizontal/dec_button";
   data.item: "version" "123";
   parts {
      part { name: "arrow.image";
         description { state: "default" 0.0;
            image.normal: "i-arrow-d";
         }
         description { state: "pressed" 0.0;
            image.normal: "i-arrow-d";
         }
         description { state: "disabled" 0.0;
            image.normal: "i-arrow-d";
         }
      }
   }
}
