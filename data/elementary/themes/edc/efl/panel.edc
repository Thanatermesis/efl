         target: "efl.content";
      }
      program { signal: "efl,state,content,hidden"; source: "efl";
         action: STATE_SET "default" 0.0;
         target: "efl.panel_area";
         target: "efl.event_area";
         target: "bg";
         target: "efl.content";
      }
   }
}

// This group defines a left-side panel that can be toggled.
// It includes features like animations, focus highlighting, and RTL support.
group { name: "efl/panel/left";
   data.item: "version" "123";
   data.item: "focus_highlight" "on"; // Enables focus highlight feature
   // Script block to define Embryo script variables and functions.
   // 'is_rtl' is used to track Right-To-Left language mode.
   script {
      public is_rtl = 0;
   }
   parts {
      // "shadow" part adds a drop shadow effect to the panel.
      // It follows the "base" part's geometry.
      part { name: "shadow"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "base";
            // WIN_SHADOW_SMALL is a macro that defines shadow properties.
            WIN_SHADOW_SMALL;
         }
      }
      // "glow" part is for the focus highlight effect. It's a rectangle
      // that becomes visible when the panel is focused.
      part { name: "glow"; type: RECT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "base";
            color_class: "/bg/selected/panel";
            visible: 0;
            offscale;
         }
         description { state: "focused" 0.0;
            inherit: "default" 0.0;
            rel1.offset: -5 -5;
            rel2.offset: 4 4;
            visible: 1;
         }
      }
      // "all" is a spacer that occupies the entire group area, used as a
      // reference for other parts.
      part { name: "all"; type: SPACER;
         description { state: "default" 0.0;
         }
      }
      // "base" is the main background rectangle of the panel.
      part { name: "base"; type: RECT;
         description { state: "default" 0.0;
            rel1.to_x: "all";
            rel2.to_x: "efl.swallow.event";
            rel2.relative: 0.0 1.0;
            color_class: "/bg/normal/panel";
         }
      }
      // "efl.content" is the SWALLOW part for the application content.
      // It's placed inside the "base" part with some padding.
      part { name: "efl.content"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "base";
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            offscale;
         }
      }
      // "efl.swallow.event" is a SWALLOW part that acts as the handle or
      // toggle button area for the panel.
      part { name: "efl.swallow.event"; type: SWALLOW;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 30 30; max: 30 999999;
            align: 1.0 0.5;
            rel1.relative: 1.0 0.0;
            rel2.relative: 1.0 1.0;
            color: 0 0 0 0; // no cc - Transparent color (#00000000)
         }
         // When hidden, the event area moves to the left edge to hide the panel.
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            align: 0.0 0.5;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 1.0;
         }
      }
      // "btn" is a transparent rectangle on top of the event area to capture
      // mouse clicks for toggling the panel.
      part { name: "btn"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "efl.swallow.event";
            color: 0 0 0 0; // no cc - Transparent color (#00000000)
         }
         description { state: "hidden" 0.0;
            rel.to: "efl.swallow.event";
         }
      }
      // "icn" is the icon part, displaying an arrow to indicate
      // the panel's toggle action. It's not interactive (mouse_events: 0).
      part { name: "icn"; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            fixed: 1 1;
            min: 30 30; max: 30 30;
            rel.to: "btn";
            image.normal: "i-arrow-l";
         }
         // The icon changes to a right arrow when the panel is hidden.
         description { state: "hidden" 0.0;
            inherit: "default" 0.0;
            image.normal: "i-arrow-r";
         }
      }
   }
   programs {
      // Clicking the "btn" part emits a signal to toggle the panel.
      program { signal: "mouse,clicked,1"; source: "btn";
         action: SIGNAL_EMIT "efl,action,panel,toggle" "efl";
      }
      // On "efl,action,show", animate the event area and base to their "default" state.
      program { signal: "efl,action,show"; source: "efl";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.2;
         target: "efl.swallow.event";
         target: "base";
      }
      // This script runs when showing the panel to set the correct icon based on RTL mode.
      program { signal: "efl,action,show"; source: "efl";
         script {
            if (get_int(is_rtl) == 0)
              set_state(PART:"icn", "default", 0.0);
            else
              set_state(PART:"icn", "hidden", 0.0);
         }
      }
      // When the UI switches to RTL mode, this script updates the icon and sets 'is_rtl'.
      program { signal: "edje,state,rtl"; source: "edje";
         script {
            new st[31];
            new Float:vl;
            get_state(PART:"efl.swallow.event", st, 30, vl);
            if (!strcmp(st, "default"))
              set_state(PART:"icn", "hidden", 0.0);
            else
              set_state(PART:"icn", "default", 0.0);
            set_int(is_rtl, 1);
         }
      }
      // When the UI switches to LTR mode, this script updates the icon and unsets 'is_rtl'.
      program { signal: "edje,state,ltr"; source: "edje";
         script {
            new st[31];
            new Float:vl;
            get_state(PART:"efl.swallow.event", st, 30, vl);
            if (!strcmp(st, "default"))
              set_state(PART:"icn", "default", 0.0);
            else
              set_state(PART:"icn", "hidden", 0.0);
            set_int(is_rtl, 0);
         }
      }
      // On "efl,action,hide", animate the event area to its "hidden" state.
      program { signal: "efl,action,hide"; source: "efl";
         action: STATE_SET "hidden" 0.0;
         transition: ACCELERATE 0.2;
         target: "efl.swallow.event";
      }
      // This script runs when hiding the panel to set the correct icon based on RTL mode.
      program { signal: "efl,action,hide"; source: "efl";
         script {
            if (get_int(is_rtl) == 0)
              set_state(PART:"icn", "hidden", 0.0);
            else
              set_state(PART:"icn", "default", 0.0);
         }
      }
      // The "hide1" and "hide2" programs work together to create a custom
      // slide-out animation for the panel.
      program { name: "hide1";
         signal: "efl,action,hide"; source: "efl";
         // This script calculates the position for the "base" part to slide off-screen.
         // It creates a custom state for the animation.
         script {
            new x, y, w, h;
            if (get_int(is_rtl) == 0) {
               custom_state(PART:"base", "default", 0.0);
               set_state_val(PART:"base", STATE_REL1, -1.0, 0.0);
               get_geometry(PART:"efl.swallow.event", x, y, w, h);
               set_state_val(PART:"base", STATE_REL1_OFFSET, w, 0);
            } else {
               custom_state(PART:"base", "default", 0.0);
               set_state_val(PART:"base", STATE_REL1, -1.0, 0.0);
               set_state_val(PART:"base", STATE_REL2, -2.0, 1.0);
               get_geometry(PART:"efl.swallow.event", x, y, w, h);
               set_state_val(PART:"base", STATE_REL2_OFFSET, -w, 0);
            }
         }
         after: "hide2";
      }
      // "hide2" applies the custom state created by "hide1" with a transition,
      // executing the animation.
      program { name: "hide2";
         action: STATE_SET "custom" 0.0;
         transition: ACCELERATE 0.3;
         target: "base";
      }
      // Shows the focus highlight effect.
      program { signal: "efl,action,focus_highlight,show"; source: "efl";
         action: STATE_SET "focused" 0.0;
         transition: ACCELERATE 0.2;
         target: "glow";
      }
      // Hides the focus highlight effect.
      program { signal: "efl,action,focus_highlight,hide"; source: "efl";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.5;
         target: "glow";
      }
   }
}

// This group defines a right-side panel, inheriting its base functionality
// from "efl/panel/left" and overriding parts for a right-aligned layout.
group { name: "efl/panel/right";
   data.item: "version" "123";
   inherit: "efl/panel/left";
   parts {
      // Overriding "base" to position it on the right side of the event area.
      part { name: "base";
         description { state: "default" 0.0;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "efl.swallow.event";
            rel1.offset: 3 0;
            rel2.relative: 1.0 1.0;
            rel2.to_x: "all";
            rel2.offset: -1 -1;
         }
      }
      // Overriding "efl.swallow.event" to place it on the left edge.
      part { name: "efl.swallow.event";
         description { state: "default" 0.0;
            align: 0.0 0.5;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 1.0;
         }
         description { state: "hidden" 0.0;
            align: 1.0 0.5;
            rel1.relative: 1.0 0.0;
            rel2.relative: 1.0 1.0;
         }
      }
      // Overriding icon images for a right-side panel.
      part { name: "icn";
         description { state: "default" 0.0;
            image.normal: "i-arrow-r";
         }
         description { state: "hidden" 0.0;
            image.normal: "i-arrow-l";
         }
      }
   }
   programs {
      // Overriding "hide1" program for a right-side slide-out animation.
      program { name: "hide1";
         script {
            new x, y, w, h;

            custom_state(PART:"base", "default", 0.0);
            set_state_val(PART:"base", STATE_REL1, 1.0, 0.0);
            set_state_val(PART:"base", STATE_REL2, 2.0, 1.0);
            get_geometry(PART:"efl.swallow.event", x, y, w, h);
            set_state_val(PART:"base", STATE_REL2_OFFSET, -w, 0);
         }
      }
   }
}

// This group defines a top panel, inheriting from "efl/panel/left" and
// adapting the layout for a horizontal, top-aligned panel.
group { name: "efl/panel/top";
   data.item: "version" "123";
   inherit: "efl/panel/left";
   parts {
      // Overriding "base" for a top-aligned layout.
      part { name: "base";
         description { state: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel1.to_x: "all";
            rel1.to_y: "all";
            rel2.relative: 1.0 0.0;
            rel2.to_x: "all";
            rel2.to_y: "efl.swallow.event";
         }
      }
      // Overriding "efl.swallow.event" for a horizontal handle at the bottom
      // of the panel area.
      part { name: "efl.swallow.event";
         description { state: "default" 0.0;
            min: 30 30; max: 999999 30;
            align: 0.5 1.0;
            rel1.relative: 0.0 1.0;
            rel2.relative: 1.0 1.0;
         }
         description { state: "hidden" 0.0;
            align: 0.5 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 0.0;
         }
      }
      // Overriding icon images for a top panel (up/down arrows).
      part { name: "icn";
         description { state: "default" 0.0;
            image.normal: "i-arrow-u";
         }
         description { state: "hidden" 0.0;
            image.normal: "i-arrow-d";
         }
      }
   }
   programs {
      // Overriding "hide1" for a slide-up animation.
      program { name: "hide1";
         script {
            new x, y, w, h;
            custom_state(PART:"base", "default", 0.0);
            set_state_val(PART:"base", STATE_REL1, 0.0, -1.0);
            set_state_val(PART:"base", STATE_REL2, 1.0, 0.0);
            get_geometry(PART:"efl.swallow.event", x, y, w, h);
            set_state_val(PART:"base", STATE_REL1_OFFSET, 0, h);
         }
      }
      // For top/bottom panels, the icon direction is independent of LTR/RTL mode.
      // This overrides the program from "efl/panel/left" to just set the icon state.
      program { signal: "efl,action,show"; source: "efl";
         action: STATE_SET "default" 0.0;
         target: "icn";
      }
      // The RTL/LTR handling for icon state is simplified since direction doesn't change.
      program { signal: "edje,state,rtl"; source: "edje";
         script {
            new st[31];
            new Float:vl;
            get_state(PART:"efl.swallow.event", st, 30, vl);
            if (!strcmp(st, "default"))
              set_state(PART:"icn", "default", 0.0);
            else
              set_state(PART:"icn", "hidden", 0.0);
         }
      }
      program { signal: "edje,state,ltr"; source: "edje";
         script {
            new st[31];
            new Float:vl;
            get_state(PART:"efl.swallow.event", st, 30, vl);
            if (!strcmp(st, "default"))
              set_state(PART:"icn", "default", 0.0);
            else
              set_state(PART:"icn", "hidden", 0.0);
         }
      }
      // Overriding to set the icon state to hidden when the panel hides.
      program { signal: "efl,action,hide"; source: "efl";
         action: STATE_SET "hidden" 0.0;
         target: "icn";
      }
   }
}

// This group defines a bottom panel, inheriting from "efl/panel/top"
// and adjusting the layout for a bottom-aligned panel.
group { name: "efl/panel/bottom";
   data.item: "version" "123";
   inherit: "efl/panel/top";
   parts {
      // Overriding "base" for a bottom-aligned layout.
      part { name: "base";
         description { state: "default" 0.0;
            rel1.relative: 0.0 1.0;
            rel1.to_x: "all";
            rel1.to_y: "efl.swallow.event";
            rel2.relative: 1.0 1.0;
            rel2.to_x: "all";
            rel2.to_y: "all";
         }
      }
      // Overriding "efl.swallow.event" for a handle at the top of the panel area.
      part { name: "efl.swallow.event";
         description { state: "default" 0.0;
            align: 0.5 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 0.0;
         }
         description { state: "hidden" 0.0;
            align: 0.5 1.0;
            rel1.relative: 0.0 1.0;
            rel2.relative: 1.0 1.0;
         }
      }
      // Overriding icon images for a bottom panel.
      part { name: "icn";
         description { state: "default" 0.0;
            image.normal: "i-arrow-d";
         }
         description { state: "hidden" 0.0;
            image.normal: "i-arrow-u";
         }
      }
   }
   programs {
      // Overriding "hide1" for a slide-down animation.
      program { name: "hide1";
         script {
            new x, y, w, h;
            custom_state(PART:"base", "default", 0.0);
            set_state_val(PART:"base", STATE_REL1, 0.0, 1.0);
            set_state_val(PART:"base", STATE_REL2, 1.0, 2.0);
            get_geometry(PART:"efl.swallow.event", x, y, w, h);
            set_state_val(PART:"base", STATE_REL2_OFFSET, 0, -h);
         }
      }
   }
}

