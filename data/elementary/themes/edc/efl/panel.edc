// This group defines a basic panel layout. It serves as a container
// for content, which is managed by the application.
group { name: "efl/panel";
   data.item: "version" "123";
   data.item: "handler_size" "30";
   parts {
      // The "efl.content" part is a SWALLOW type, which acts as a placeholder
      // where the application can place its own content (e.g., widgets).
      part { name: "efl.content"; type: SWALLOW;
         description { state: "default" 0.0;
         }
      }
   }
}

// This group defines a panel for the left side of a scroller.
// It manages the visibility of the panel content and its background.
group { name: "efl/scroller/panel/left";
   data.item: "version" "123";
   parts {
      // "efl.panel_area" is a SWALLOW part that defines the area where the panel
      // content will be displayed. It is initially not visible.
      part { name: "efl.panel_area"; type: SWALLOW;
         description { state: "default" 0.0;
            rel2.relative: 0.0 1.0;
            align: 0.0 0.5;
            fixed: 1 1;
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // "efl.event_area" is a SWALLOW part, likely used for handling events
      // to toggle the panel's visibility. It's positioned to the right of the panel area.
      part { name: "efl.event_area"; type: SWALLOW;
         description { state: "default" 0.0;
            rel.to: "efl.panel_area";
            rel1.relative: 1.0 0.0;
            rel2.relative: 1.0 1.0;
            align: 0.0 0.5;
            fixed: 1 1;
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // "access.outline" is a transparent rectangle for accessibility purposes,
      // outlining the panel area.
      part { name: "access.outline"; type: RECT;
         repeat_events: 1;
         description { state: "default" 0.0;
            rel.to: "efl.panel_area";
            color: 0 0 0 0; // no cc - Transparent color (#00000000)
         }
      }
      // "bg" is the background rectangle for the panel.
      // It uses a color class, allowing for theme-based styling.
      part { name: "bg"; type: RECT;
         description { state: "default" 0.0;
            rel.to: "efl.panel_area";
            color_class: "/bg/normal/panel";
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // "efl.content" is where the actual content of the panel is swallowed.
      part { name: "efl.content"; type: SWALLOW;
         description { state: "default" 0.0;
            rel.to: "efl.panel_area";
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
   }
   // Programs define the behavior of the group in response to signals.
   programs {
      // When "efl,state,content,visible" is received, all parts are made visible
      // by changing their state to "visible".
      program { signal: "efl,state,content,visible"; source: "efl";
         action: STATE_SET "visible" 0.0;
         target: "efl.panel_area";
         target: "efl.event_area";
         target: "bg";
         target: "efl.content";
      }
      // When "efl,state,content,hidden" is received, all parts are hidden
      // by reverting their state to "default".
      program { signal: "efl,state,content,hidden"; source: "efl";
         action: STATE_SET "default" 0.0;
         target: "efl.panel_area";
         target: "efl.event_area";
         target: "bg";
         target: "efl.content";
      }
   }
}

// This group defines a panel for the right side of a scroller,
// with a layout mirrored from the left panel.
group { name: "efl/scroller/panel/right";
   data.item: "version" "123";
   parts {
      part { name: "efl.event_area"; type: SWALLOW;
         description { state: "default" 0.0;
            rel2.relative: 0.0 1.0;
            align: 0.0 0.5;
            fixed: 1 1;
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "efl.panel_area"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1 {
               relative: 1.0 0.0;
               to: "efl.event_area";
            }
            rel2 {
               relative: 1.0 1.0;
               to: "efl.event_area";
            }
            align: 0.0 0.5;
            fixed: 1 1;
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "access.outline"; type: RECT;
         repeat_events: 1;
         description { state: "default" 0.0;
            rel1.to: "efl.panel_area";
            rel2.to: "efl.panel_area";
            color: 0 0 0 0; // no cc
         }
      }
      part { name: "bg"; type: RECT;
         description { state: "default" 0.0;
            rel1.to: "efl.panel_area";
            rel2.to: "efl.panel_area";
            color_class: "/bg/normal/panel";
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "efl.content"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1.to: "efl.panel_area";
            rel2.to: "efl.panel_area";
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
   }
   programs {
      program { signal: "efl,state,content,visible"; source: "efl";
         action: STATE_SET "visible" 0.0;
         target: "efl.panel_area";
         target: "efl.event_area";
         target: "bg";
         target: "efl.content";
      }
      program { signal: "efl,state,content,hidden"; source: "efl";
         action: STATE_SET "default" 0.0;
         target: "efl.panel_area";
         target: "efl.event_area";
         target: "bg";
         target: "efl.content";
      }
   }
}

// This group defines a panel for the top of a scroller.
// The layout is adjusted for a horizontal panel at the top.
group { name: "efl/scroller/panel/top";
   data.item: "version" "123";
   parts {
      part { name: "efl.panel_area"; type: SWALLOW;
         description { state: "default" 0.0;
            rel2.relative: 1.0 0.0;
            align: 0.5 0.0;
            fixed: 1 1;
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "efl.event_area"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1 {
               relative: 0.0 1.0;
               to: "efl.panel_area";
            }
            rel2 {
               relative: 1.0 1.0;
               to: "efl.panel_area";
            }
            align: 0.5 0.0;
            fixed: 1 1;
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "access.outline"; type: RECT;
         repeat_events: 1;
         description { state: "default" 0.0;
            rel1.to: "efl.panel_area";
            rel2.to: "efl.panel_area";
            color: 0 0 0 0; // no cc
         }
      }
      part { name: "bg"; type: RECT;
         description { state: "default" 0.0;
            rel1.to: "efl.panel_area";
            rel2.to: "efl.panel_area";
            color_class: "/bg/normal/panel";
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "efl.content"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1.to: "efl.panel_area";
            rel2.to: "efl.panel_area";
            visible: 0;
         }
         description { state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
   }
   programs {
      program { signal: "efl,state,content,visible"; source: "efl";
         action: STATE_SET "visible" 0.0;
         target: "efl.panel_area";
         target: "efl.event_area";
         target: "bg";
         target: "efl.content";
      }
      program { signal: "efl,state,content,hidden"; source: "efl";
         action: STATE_SET "default" 0.0;
         target: "efl.panel_area";
         target: "efl.event_area";
         target: "bg";
         target: "efl.content";
      }
   }
}

