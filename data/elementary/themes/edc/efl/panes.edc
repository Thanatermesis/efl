               set_int(open, 0);
               get_drag(PART:"efl.bar", dx, dy);
               set_float(drag_y, dy);
               set_drag(PART:"efl.bar", 0.5, 1.0);
               set_state(PART:"dots", "closed", 0.0);
            } else if (get_int(open) == 0) {
               set_int(open, 1);
               set_drag(PART:"efl.bar", 0.5, get_float(drag_y));
               set_state(PART:"dots", "default", 0.0);
            }
         }
      }
   }
}

