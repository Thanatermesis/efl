// Horizontal slider widget.
// This group defines the visual components and behavior for a slider that operates along the horizontal axis.
// It includes a draggable knob, a track, a value label, and handles different states like 'active' and 'disabled'.
group { name: "e/widgets/slider_horizontal";
   parts {
      // The main background part, which also serves as the confinement area for dragging.
      // It expands when the label is shown to make room for it.
      part { name: "bg"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            min: 56 28;
            // Transparent background (RGBA: 0, 0, 0, 0 or #00000000). 'no cc' means no color class is used.
            color: 0 0 0 0; // no cc
            offscale;
         }
         // In the 'active' state (when the label is visible), this part expands to accommodate the label's width.
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            rel2.relative: 0.0 1.0;
            rel2.offset: -5 -1;
            rel2.to_x: "e.text.label";
         }
      }
      // The visual track of the slider.
      part { name: "base"; type: RECT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "bg";
            color_class: "/bg/normal/slider/base";
            min: 8 4;
            max: 99999 4;
            // Fixed height, variable width.
            fixed: 0 1;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/disabled/slider/base";
         }
      }
      // The filled portion of the slider track, indicating the current value.
      // It extends from the start of the 'base' part to the center of the 'knob'.
      part { name: "glow"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            rel1.to: "base";
            rel2.relative: 0.5 1.0;
            rel2.to_x: "knob";
            rel2.to_y: "base";
            color_class: "/fg/normal/slider/bar";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/slider/bar";
         }
      }
      // A clipping rectangle for the label text. Ensures the label doesn't draw outside its designated area.
      part { name: "clip1"; type: RECT;
         description { state: "default" 0.0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // The text label that displays the slider's value.
      // It is initially hidden and becomes visible in the 'active' state.
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         clip_to: "clip1";
         scale: 1;
         description { state: "default" 0.0;
            // Positioned to the right of the slider.
            rel1.offset: -5 4;
            rel1.relative: 1.0 0.0;
            rel2.offset: -5 -5;
            align: 1.0 0.5;
            color_class: "/fg/normal/slider/text";
            text { font: FN; size: 10;
              min: 0 1;
              align: 0.0 0.5;
              text_class: "slider";
            }
            visible: 0;
            max: 0 0;
            fixed: 1 1;
            offscale;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
            max: 99999 99999;
         }
      }
      // A clipping rectangle for the disabled label to prevent rendering issues.
      part { name: "clip2"; type: RECT;
         description { state: "default" 0.0;
            visible: 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // A separate text part for the disabled state to apply a different color.
      // It mirrors the content of 'e.text.label'.
      part { name: "label2"; type: TEXT; mouse_events: 0;
         clip_to: "clip2";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "e.text.label";
            color_class: "/fg/disabled/slider/text";
            text { font: FN; size: 10;
              text_source: "e.text.label";
              align: 0.0 0.5;
              text_class: "slider";
            }
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      // The draggable knob of the slider. Its position is tied to the 'e.dragable.slider' part.
      part { name: "knob";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "e.dragable.slider";
            rel1.offset: -1 -1;
            rel2.offset: 0 0;
            color_class: "/fg/normal/slider/knob";
            image.normal: "i-radio";
            min: 16 16;
            max: 16 16;
            fixed: 1 1;
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/slider/knob";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/slider/knob";
         }
      }
      // Swallow part allowing custom content to be placed along the slider bar.
      part { name: "e.swallow.bar"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1.to_x: "bg";
            rel2.to_x: "bg";
         }
      }
      // The invisible rectangle that handles drag events for the slider.
      // This separation of interaction from visuals allows for more flexible design.
      part { name: "e.dragable.slider"; type: RECT;
         scale: 1;
         // Draggable only along the X-axis.
         dragable.x: 1 1 0;
         dragable.y: 0 0 0;
         dragable.confine: "bg";
         description { state: "default" 0.0;
            min: 16 16;
            max: 16 16;
            rel1.relative: 0.5 0.0;
            rel1.to_x: "bg";
            rel2.relative: 0.5 1.0;
            rel2.to_x: "bg";
            color: 0 0 0 0; // no cc
            fixed: 1 1;
         }
      }
      // Event blocking rectangle, active only in the 'disabled' state to prevent user interaction.
      part { name: "event"; type: RECT;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            visible: 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
   }
   // Programs define the dynamic behavior of the slider in response to events (signals).
   programs {
      // When the user presses the mouse button on the draggable area, change the knob's state to 'clicked'.
      program { signal: "mouse,down,1"; source: "e.dragable.slider";
         action: STATE_SET "clicked" 0.0;
         target: "knob";
      }
      // When the user releases the mouse button, revert the knob's state to 'default'.
      program { signal: "mouse,up,1"; source: "e.dragable.slider";
         action: STATE_SET "default" 0.0;
         target: "knob";
      }
      // When the 'e,action,show,label' signal is received, show the label by setting relevant parts to 'active'.
      program { signal: "e,action,show,label"; source: "e";
         action: STATE_SET "active" 0.0;
         target: "bg";
         target: "e.text.label";
         target: "label2";
      }
      // When the 'e,action,hide,label' signal is received, hide the label.
      program { signal: "e,action,hide,label"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "bg";
         target: "e.text.label";
         target: "label2";
      }
      // When the widget is disabled, update the state of all relevant parts to 'disabled'.
      program { signal: "e,state,disabled"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "event";
         target: "glow";
         target: "base";
         target: "clip1";
         target: "clip2";
         target: "knob";
      }
      // When the widget is enabled, revert parts to their 'default' state.
      program { signal: "e,state,enabled"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "event";
         target: "glow";
         target: "base";
         target: "clip1";
         target: "clip2";
         target: "knob";
      }
   }
}

// Vertical slider widget.
// This group defines a slider that operates along the vertical axis.
// Its structure and behavior are analogous to the horizontal slider, with adjustments for vertical orientation.
group { name: "e/widgets/slider_vertical";
   parts {
      // Main background part. It expands vertically to accommodate the label when visible.
      part { name: "bg"; type: RECT;
         scale: 1;
         description { state: "default" 0.0;
            min: 28 56;
            color: 0 0 0 0; // no cc
            offscale;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            rel2.relative: 1.0 0.0;
            rel2.offset: -1 -5;
            rel2.to_y: "e.text.label";
         }
      }
      // The vertical track of the slider.
      part { name: "base"; type: RECT; mouse_events: 0;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "bg";
            color_class: "/bg/normal/slider/base";
            min: 4 8;
            max: 4 99999;
            // Fixed width, variable height.
            fixed: 1 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/disabled/slider/base";
         }
      }
      // The filled portion of the track. It extends from the 'knob' to the bottom of the 'base'.
      part { name: "glow"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0;
            rel1.relative: 0.0 0.5;
            rel1.to_y: "knob";
            rel1.to_x: "base";
            rel2.to: "base";
            color_class: "/fg/normal/slider/bar";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/slider/bar";
         }
      }
      part { name: "clip1"; type: RECT;
         description { state: "default" 0.0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Text label for the slider's value, positioned below the slider.
      part { name: "e.text.label"; type: TEXT; mouse_events: 0;
         clip_to: "clip1";
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: 0 -1;
            rel1.relative: 0.0 1.0;
            rel2.offset: -1 -1;
            align: 0.5 1.0;
            color_class: "/fg/normal/slider/text";
            text { font: FN; size: 10;
              min: 0 0;
              align: 0.5 0.5;
              text_class: "slider";
            }
            visible: 0;
            max: 0 0;
            fixed: 1 1;
            offscale;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            text.min: 1 1;
            text.ellipsis: -1;
            visible: 1;
            max: 99999 99999;
         }
      }
      part { name: "clip2"; type: RECT;
         description { state: "default" 0.0;
            visible: 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "label2"; type: TEXT; mouse_events: 0;
         clip_to: "clip2";
         scale: 1;
         description { state: "default" 0.0;
            rel1.to: "e.text.label";
            rel2.to: "e.text.label";
            color_class: "/fg/disabled/slider/text";
            text { font: FN; size: 10;
              text_source: "e.text.label";
              align: 0.5 0.5;
              text_class: "slider";
            }
            visible: 0;
         }
         description { state: "active" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "knob";
         scale: 1;
         description { state: "default" 0.0;
            rel1.offset: -1 -1;
            rel1.to: "e.dragable.slider";
            rel2.offset: 0 0;
            rel2.to: "e.dragable.slider";
            color_class: "/fg/normal/slider/knob";
            image.normal: "i-radio";
            min: 16 16;
            max: 16 16;
            fixed: 1 1;
         }
         description { state: "clicked" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/slider/knob";
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/disabled/slider/knob";
         }
      }
      part { name: "e.swallow.bar"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1.to_x: "bg";
            rel2.to_x: "bg";
         }
      }
      // Invisible draggable part for the vertical slider.
      part { name: "e.dragable.slider"; type: RECT;
         scale: 1;
         // Draggable only along the Y-axis. The -1 inverts the direction, so dragging up increases the value.
         dragable.x: 0 0 0;
         dragable.y: -1 1 0;
         dragable.confine: "bg";
         description { state: "default" 0.0;
            min: 16 16;
            max: 16 16;
            rel1.relative: 0.0 0.5;
            rel1.to_x: "bg";
            rel2.relative: 1.0 0.5;
            rel2.to_x: "bg";
            color: 0 0 0 0; // no cc
            fixed: 1 1;
         }
      }
      part { name: "event"; type: RECT;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
            visible: 0;
         }
         description { state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
   }
   // The programs for the vertical slider are identical in function to the horizontal slider's programs,
   // controlling state changes for mouse interaction, label visibility, and enabled/disabled states.
   programs {
      program { signal: "mouse,down,1"; source: "e.dragable.slider";
         action: STATE_SET "clicked" 0.0;
         target: "knob";
      }
      program { signal: "mouse,up,1"; source: "e.dragable.slider";
         action: STATE_SET "default" 0.0;
         target: "knob";
      }
      program { signal: "e,action,show,label"; source: "e";
         action: STATE_SET "active" 0.0;
         target: "bg";
         target: "e.text.label";
         target: "label2";
      }
      program { signal: "e,action,hide,label"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "bg";
         target: "e.text.label";
         target: "label2";
      }
      program { signal: "e,state,disabled"; source: "e";
         action: STATE_SET "disabled" 0.0;
         target: "event";
         target: "glow";
         target: "base";
         target: "clip1";
         target: "clip2";
         target: "knob";
      }
      program { signal: "e,state,enabled"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "event";
         target: "glow";
         target: "base";
         target: "clip1";
         target: "clip2";
         target: "knob";
      }
   }
}
